import { Theme } from "theme_global.slint";
import { ButtonTone, ControlSize, EmptyState, Eyebrow, IconButton, TouchButton } from "kit.slint";
import { Icon } from "kit-icons.slint";
import { NavigationGlobal } from "navigation_global.slint";
import { NotificationGlobal } from "notification_global.slint";
import { AppState } from "app_state_global.slint";

export component NotificationCenter inherits Rectangle {
    callback dismiss();

    /// `severity`: 0 = info, 1 = tip, 2 = warning, 3 = error.
    pure function severity-tint(severity: int) -> color {
        return severity >= 3 ? Theme.feedback-danger
            : severity == 2 ? Theme.feedback-warning
            : severity == 1 ? Theme.accent-brand
            : Theme.feedback-info;
    }

    pure function severity-icon(severity: int) -> string {
        return severity >= 3 ? "warning"
            : severity == 2 ? "warning"
            : severity == 1 ? "star"
            : "info";
    }

    // Entrance: slides in from whichever edge it is docked to.
    property <bool> entered: false;
    init => { self.entered = true; }
    property <length> slide-offset: self.entered
        ? 0px
        : (AppState.edge-panels-mirrored ? -Theme.space-8 : Theme.space-8);

    width: 400px;
    background: Theme.gradient-glass;
    drop-shadow-blur: Theme.elev-3-blur;
    drop-shadow-color: Theme.shadow-key;
    opacity: self.entered ? 1.0 : 0.0;

    animate opacity { duration: Theme.motion-base; easing: ease-out; }

    // Edge facing the canvas: opposite the docked side.
    Rectangle {
        x: AppState.edge-panels-mirrored ? parent.width - Theme.hairline : 0;
        width: Theme.hairline;
        height: parent.height;
        background: Theme.border-strong;
    }

    VerticalLayout {
        width: parent.width;
        height: 100%;
        x: root.slide-offset;
        padding: Theme.space-4;
        spacing: Theme.space-3;

        animate x { duration: Theme.motion-base; easing: ease-out; }

        HorizontalLayout {
            spacing: Theme.space-2;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;

                Eyebrow {
                    text: NavigationGlobal.notification-center-title;
                }

                Text {
                    text: NotificationGlobal.notifications.length;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-2xl;
                    font-weight: Theme.weight-bold;
                }
            }

            if NotificationGlobal.notifications.length > 0: TouchButton {
                text: NotificationGlobal.clear-all-label;
                icon: "trash";
                tone: ButtonTone.ghost;
                size: ControlSize.sm;
                clicked => { NotificationGlobal.clear-all(); }
            }

            IconButton {
                icon: "close";
                tooltip: NavigationGlobal.panel-dismiss-label;
                tooltip-flip: true;
                clicked => { root.dismiss(); }
            }
        }

        if NotificationGlobal.notifications.length == 0: EmptyState {
            vertical-stretch: 1;
            icon: "bell";
            title: NotificationGlobal.empty-placeholder;
        }

        if NotificationGlobal.notifications.length > 0: Flickable {
            vertical-stretch: 1;
            width: 100%;
            viewport-width: self.width;
            viewport-height: list.preferred-height;

            list := VerticalLayout {
                width: parent.viewport-width;
                spacing: Theme.space-2;

                for item in NotificationGlobal.notifications: Rectangle {
                    background: Theme.surface-raised;
                    border-radius: Theme.radius-md;
                    border-width: Theme.hairline;
                    border-color: Theme.border-subtle;
                    clip: true;

                    // Swipe the card sideways to dismiss it, the way a phone
                    // notification behaves. The card follows the finger and
                    // fades as it travels; a completed swipe drops the item.
                    swipe := SwipeGestureHandler {
                        width: 100%;
                        height: 100%;
                        handle-swipe-left: true;
                        handle-swipe-right: true;

                        swiped => { NotificationGlobal.dismiss-item(item.id); }
                    }

                    property <length> swipe-dx: swipe.swiping
                        ? swipe.current-position.x - swipe.pressed-position.x
                        : 0px;

                    // Severity rail.
                    Rectangle {
                        x: 0;
                        width: Theme.indicator-thickness;
                        height: parent.height;
                        background: root.severity-tint(item.severity);
                    }

                    HorizontalLayout {
                        x: parent.swipe-dx;
                        width: 100%;
                        height: 100%;
                        opacity: 1.0 - min(0.85, abs(parent.swipe-dx / 220px));
                        padding: Theme.space-3;
                        padding-left: Theme.space-4;
                        spacing: Theme.space-3;

                        animate x, opacity { duration: Theme.motion-instant; easing: ease-out; }

                        Icon {
                            name: root.severity-icon(item.severity);
                            size: Theme.font-size-lg;
                            tint: root.severity-tint(item.severity);
                        }

                        VerticalLayout {
                            spacing: Theme.space-1;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: Theme.space-2;

                                Text {
                                    text: item.title;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-md;
                                    font-weight: Theme.weight-semibold;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: item.time-label;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-xs;
                                    vertical-alignment: center;
                                }
                            }

                            if item.body != "": Text {
                                text: item.body;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                wrap: word-wrap;
                            }
                        }

                        IconButton {
                            icon: "close";
                            size: ControlSize.sm;
                            tooltip: NotificationGlobal.dismiss-label;
                            tooltip-flip: true;
                            clicked => { NotificationGlobal.dismiss-item(item.id); }
                        }
                    }
                }
            }
        }
    }
}
