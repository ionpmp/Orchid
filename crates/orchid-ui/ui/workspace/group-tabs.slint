import { Theme } from "../theme_global.slint";
import { ControlSize, IconButton, Tooltip } from "../kit.slint";
import { Strings } from "../strings_global.slint";
import { GroupTabModel } from "defs.slint";

/// Tab strip for widgets stacked in a shared layout slot.
export component GroupTabs inherits Rectangle {
    in property <[GroupTabModel]> tabs;

    callback tab-clicked(string);
    callback tab-closed(string);
    callback tab-move-left(string);
    callback tab-move-right(string);
    callback dissolve-clicked();

    /// Mirrors the model's active tab so swipe can step to a neighbour.
    /// Each tab reports itself when it becomes active (the model has no index).
    property <int> active-index: 0;

    pure function neighbour-id(step: int) -> string {
        return tabs[clamp(root.active-index + step, 0, tabs.length - 1)].instance-id;
    }

    height: Theme.toolbar-height;
    background: Theme.surface-sunken;

    Rectangle {
        y: parent.height - Theme.hairline;
        width: parent.width;
        height: Theme.hairline;
        background: Theme.border-default;
    }

    // Swiping across the strip walks the stack, like flicking between pages.
    // Taps still reach the tabs underneath — the handler only grabs once the
    // finger has travelled far enough to count as a swipe.
    swipe := SwipeGestureHandler {
        width: 100%;
        height: 100%;
        handle-swipe-left: true;
        handle-swipe-right: true;

        swiped => {
            root.tab-clicked(root.neighbour-id(
                self.current-position.x < self.pressed-position.x ? 1 : -1
            ));
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: Theme.space-1;
            padding-right: Theme.space-1;
            spacing: Theme.space-1;
            alignment: center;

            for tab[i] in tabs : Rectangle {
                min-width: Theme.control-lg * 2.6;
                max-width: Theme.control-lg * 4;
                height: Theme.control-sm;
                border-radius: Theme.radius-md;
                background: tab.is-active ? Theme.surface-raised
                    : tab-ta.has-hover ? Theme.state-hover
                    : Colors.transparent;

                animate background { duration: Theme.motion-instant; easing: ease-out; }

                // Report position so `neighbour-id` knows where the stack is.
                property <bool> live: tab.is-active;
                init => { if (self.live) { root.active-index = i; } }
                changed live => { if (self.live) { root.active-index = i; } }

                // Accent underline marks the live tab.
                if tab.is-active : Rectangle {
                    x: Theme.space-3;
                    y: parent.height - Theme.indicator-thickness - Theme.space-1;
                    width: parent.width - Theme.space-3 * 2;
                    height: Theme.indicator-thickness;
                    border-radius: self.height / 2;
                    background: Theme.accent-brand;
                }

                Tooltip {
                    text: tab.title;
                    shown: tab-ta.has-hover;
                    x: 0;
                    y: parent.height + Theme.space-1;
                }

                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-1;

                    tab-ta := TouchArea {
                        horizontal-stretch: 1;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.tab-clicked(tab.instance-id); }

                        Text {
                            width: 100%;
                            height: 100%;
                            text: tab.title;
                            color: tab.is-active ? Theme.text-primary : Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            font-weight: tab.is-active ? Theme.weight-semibold : Theme.weight-medium;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }

                    if i > 0 : IconButton {
                        icon: "chevron-left";
                        size: ControlSize.sm;
                        tooltip: Strings.group-tooltip-move-left;
                        clicked => { root.tab-move-left(tab.instance-id); }
                    }

                    if i + 1 < tabs.length : IconButton {
                        icon: "chevron-right";
                        size: ControlSize.sm;
                        tooltip: Strings.group-tooltip-move-right;
                        clicked => { root.tab-move-right(tab.instance-id); }
                    }

                    IconButton {
                        icon: "close";
                        size: ControlSize.sm;
                        tooltip: Strings.group-tooltip-close-tab;
                        clicked => { root.tab-closed(tab.instance-id); }
                    }
                }
            }

            IconButton {
                icon: "layers";
                size: ControlSize.sm;
                tooltip: Strings.group-tooltip-dissolve;
                tooltip-flip: true;
                clicked => { root.dissolve-clicked(); }
            }
        }
    }
}
