import { Theme } from "../theme_global.slint";
import { ButtonTone, TouchButton } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { WidgetCloseConfirmDialog } from "defs.slint";

export component WidgetCloseConfirmDialog inherits Rectangle {
    in property <WidgetCloseConfirmDialog> dialog;
    callback save();
    callback discard();
    callback cancel();

    property <bool> entered: false;
    init => { self.entered = true; }

    background: Theme.scrim;
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-fast; easing: ease-out; }

    backdrop-ta := TouchArea {
        clicked => { root.cancel(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.entered ? 0px : Theme.space-5);
        width: 440px;
        height: lay.preferred-height;

        animate y { duration: Theme.motion-base; easing: ease-out; }
        background: Theme.gradient-glass;
        border-radius: Theme.radius-xl;
        border-width: Theme.hairline;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.elev-3-blur;
        drop-shadow-offset-y: Theme.elev-3-y;
        drop-shadow-color: Theme.shadow-key;

        TouchArea { }

        lay := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-4;

            HorizontalLayout {
                spacing: Theme.space-3;

                Rectangle {
                    min-width: Theme.control-md;
                    max-width: Theme.control-md;
                    min-height: Theme.control-md;
                    max-height: Theme.control-md;
                    border-radius: Theme.radius-md;
                    background: Theme.feedback-warning-soft;

                    Icon {
                        name: "warning";
                        size: Theme.font-size-xl;
                        tint: Theme.feedback-warning;
                    }
                }

                Text {
                    text: dialog.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-xl;
                    font-weight: Theme.weight-bold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }

            Text {
                text: dialog.message;
                color: Theme.text-secondary;
                font-size: Theme.font-size-md;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;

                TouchButton {
                    text: dialog.cancel-label;
                    tone: ButtonTone.ghost;
                    clicked => { root.cancel(); }
                }

                TouchButton {
                    text: dialog.discard-label;
                    tone: ButtonTone.danger;
                    clicked => { root.discard(); }
                }

                TouchButton {
                    text: dialog.save-label;
                    tone: ButtonTone.filled;
                    clicked => { root.save(); }
                }
            }
        }
    }
}
