import { Theme } from "../theme_global.slint";
import { ButtonTone, Divider, ToggleSwitch, TouchButton } from "../kit.slint";
import { ComboBox, LineEdit } from "std-widgets.slint";
import { WidgetSettingsDialog } from "defs.slint";

export component WidgetSettingsDialog inherits Rectangle {
    in property <WidgetSettingsDialog> dialog;
    callback field-changed(string, string);
    callback dismiss();

    property <bool> entered: false;
    init => { self.entered = true; }

    background: Theme.scrim;
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-fast; easing: ease-out; }

    backdrop-ta := TouchArea {
        clicked => { root.dismiss(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.entered ? 0px : Theme.space-5);
        width: min(460px, parent.width - Theme.space-6);
        height: min(lay.preferred-height, parent.height - Theme.space-6);

        animate y { duration: Theme.motion-base; easing: ease-out; }
        background: Theme.gradient-glass;
        border-radius: Theme.radius-xl;
        border-width: Theme.hairline;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.elev-3-blur;
        drop-shadow-offset-y: Theme.elev-3-y;
        drop-shadow-color: Theme.shadow-key;
        clip: true;

        // Swallow clicks so they don't dismiss via the backdrop.
        TouchArea { }

        lay := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-4;

            Text {
                text: dialog.title;
                color: Theme.text-primary;
                font-size: Theme.font-size-xl;
                font-weight: Theme.weight-bold;
            }

            Divider { }

            Flickable {
                vertical-stretch: 1;
                viewport-width: parent.width - Theme.space-10;
                viewport-height: field-list.preferred-height;
                height: min(field-list.preferred-height, 320px);

                field-list := VerticalLayout {
                    width: parent.viewport-width;
                    spacing: Theme.space-1;

                    for row in dialog.fields: HorizontalLayout {
                        spacing: Theme.space-3;
                        min-height: Theme.row-height;

                        Text {
                            width: 42%;
                            text: row.label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-md;
                            wrap: no-wrap;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        if row.kind == 0 : Text {
                            horizontal-stretch: 1;
                            text: row.value;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        if row.kind == 1 : Rectangle {
                            horizontal-stretch: 1;
                            ToggleSwitch {
                                x: 0;
                                y: (parent.height - self.height) / 2;
                                checked: row.bool-value;
                                toggled => {
                                    root.field-changed(row.key, row.bool-value ? "false" : "true");
                                }
                            }
                        }

                        if row.kind == 2 : LineEdit {
                            horizontal-stretch: 1;
                            text: row.value;
                            font-size: Theme.font-size-md;
                            accepted(text) => {
                                root.field-changed(row.key, text);
                            }
                        }

                        if row.kind == 3 : ComboBox {
                            horizontal-stretch: 1;
                            model: row.combo-options;
                            current-index: row.combo-index;
                            selected(_value) => {
                                root.field-changed(row.key, row.combo-values[self.current-index]);
                            }
                        }
                    }
                }
            }

            TouchButton {
                text: dialog.close-label;
                tone: ButtonTone.filled;
                wide: true;
                clicked => { root.dismiss(); }
            }
        }
    }
}
