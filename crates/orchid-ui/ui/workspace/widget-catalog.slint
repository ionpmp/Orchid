import { Theme } from "../theme_global.slint";
import { ButtonTone, ControlSize, EmptyState, Eyebrow, Grabber, IconButton, TouchButton } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { Strings } from "../strings_global.slint";
import { WidgetCatalog } from "../widget_catalog_global.slint";

/// Wide catalog tile: icon on the left, title + wrapped description on the right.
component CatalogCard inherits Rectangle {
    in property <string> type-id;
    in property <string> label;
    in property <string> description;
    in property <string> glyph;
    in property <bool> card-visible: true;
    callback pick(string);

    // ASCII/BMP only — Slint's default font on Windows lacks color emoji.
    pure function get-icon(type_id: string) -> string {
        return
            type_id == "terminal" ? ">_" :
            type_id == "weather" ? "W" :
            type_id == "moon" ? "O" :
            type_id == "jyotish" ? "*" :
            type_id == "clock" ? "C" :
            type_id == "system" ? "S" :
            type_id == "rss" ? "N" :
            type_id == "recent-files" ? "R" :
            type_id == "search" || type_id == "universal-search" ? "/" :
            type_id == "media" || type_id == "media-player" ? "M" :
            type_id == "audio-player" ? "A" :
            type_id == "video-player" ? "Vp" :
            type_id == "media-viewer" ? "MV" :
            type_id == "password" || type_id == "password-manager" ? "*" :
            type_id == "viewer" ? "Vi" :
            type_id == "browser" ? "Br" :
            type_id == "document-editor" ? "D" :
            type_id == "file-manager" ? "#" :
            type_id == "processes" ? "P" :
            type_id == "calculator" ? "=" :
            type_id == "notes" ? "Nt" :
            type_id == "calendar" ? "Ca" :
            "*";
    }

    horizontal-stretch: 1;
    min-width: 240px;
    height: root.card-visible ? Theme.control-xl + Theme.space-6 : 0px;
    visible: root.card-visible;
    background: card-ta.has-hover ? Theme.surface-overlay : Theme.surface-raised;
    border-radius: Theme.radius-lg;
    border-width: Theme.hairline;
    border-color: card-ta.has-hover ? Theme.accent-muted : Theme.border-default;
    drop-shadow-blur: card-ta.has-hover ? Theme.elev-2-blur : Theme.elev-1-blur;
    drop-shadow-offset-y: card-ta.has-hover ? Theme.elev-2-y : Theme.elev-1-y;
    drop-shadow-color: Theme.shadow-ambient;
    clip: true;

    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    card-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.pick(root.type-id); }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: Theme.space-4;
        spacing: Theme.space-4;
        alignment: center;

        Rectangle {
            min-width: Theme.control-md;
            max-width: Theme.control-md;
            min-height: Theme.control-md;
            max-height: Theme.control-md;
            background: card-ta.has-hover ? Theme.gradient-accent : Theme.accent-soft;
            border-radius: Theme.radius-md;
            drop-shadow-blur: card-ta.has-hover ? Theme.elev-glow-blur : 0px;
            drop-shadow-color: Theme.accent-glow;

            animate background, drop-shadow-blur {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            Text {
                width: 100%;
                height: 100%;
                text: root.get-icon(root.type-id);
                color: card-ta.has-hover ? Theme.accent-contrast : Theme.accent-brand;
                font-size: Theme.font-size-md;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-1;
            alignment: center;

            Text {
                text: root.label;
                color: Theme.text-primary;
                font-size: Theme.font-size-md;
                font-weight: Theme.weight-semibold;
                wrap: no-wrap;
                overflow: elide;
            }

            Text {
                text: root.description;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
}

/// Widget picker: 2-column card grid with room for descriptions.
export component WidgetCatalogPanel inherits Rectangle {
    callback pick(string);
    callback dismiss();
    callback search-changed(string);

    /// Bottom-sheet presentation for narrow canvases: full width, anchored to
    /// the bottom edge, with a grab handle instead of a floating card.
    in property <bool> sheet: false;

    property <bool> entered: false;
    init => { self.entered = true; }
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-base; easing: ease-out; }

    width: 880px;
    height: 660px;
    background: Theme.gradient-glass;
    border-radius: Theme.radius-xl;
    border-width: Theme.hairline;
    border-color: Theme.border-strong;
    drop-shadow-blur: Theme.elev-3-blur;
    drop-shadow-offset-y: Theme.elev-3-y;
    drop-shadow-color: Theme.shadow-key;
    clip: true;

    property <string> draft-query: "";
    /// 0 = default (logical), 1 = A–Z, 2 = Z–A
    property <int> sort-mode: 0;

    pure function sort-label() -> string {
        return root.sort-mode == 1 ? Strings.catalog-sort-name-asc
            : root.sort-mode == 2 ? Strings.catalog-sort-name-desc
            : Strings.catalog-sort-default;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        y: root.entered ? 0px : Theme.space-4;
        padding: Theme.space-5;
        spacing: Theme.space-4;

        animate y { duration: Theme.motion-base; easing: ease-out; }

        if root.sheet : Grabber { }

        HorizontalLayout {
            spacing: Theme.space-3;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;

                Eyebrow { text: Strings.dock-add-label; }

                Text {
                    text: Strings.catalog-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-2xl;
                    font-weight: Theme.weight-bold;
                    vertical-alignment: center;
                }
            }

            TouchButton {
                text: root.sort-label();
                icon: "sliders";
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                clicked => {
                    root.sort-mode = root.sort-mode >= 2 ? 0 : root.sort-mode + 1;
                }
            }

            IconButton {
                icon: "close";
                tooltip-flip: true;
                clicked => { root.dismiss(); }
            }
        }

        Rectangle {
            height: Theme.control-lg;
            background: Theme.surface-sunken;
            border-radius: Theme.radius-pill;
            border-width: Theme.hairline;
            border-color: catalog-input.has-focus ? Theme.border-focus : Theme.border-default;
            clip: true;

            animate border-color { duration: Theme.motion-fast; easing: ease-out; }

            HorizontalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-5;
                spacing: Theme.space-3;

                Icon {
                    name: "search";
                    size: Theme.font-size-lg;
                    tint: catalog-input.has-focus ? Theme.accent-brand : Theme.text-tertiary;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    background: transparent;

                    if root.draft-query == "" : Text {
                        x: 0;
                        width: parent.width;
                        height: 100%;
                        text: Strings.catalog-search-placeholder;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-md;
                        vertical-alignment: center;
                    }

                    catalog-input := TextInput {
                        x: 0;
                        width: parent.width;
                        height: 100%;
                        text <=> root.draft-query;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        vertical-alignment: center;
                        single-line: true;
                        edited => {
                            root.search-changed(self.text);
                        }
                    }
                }
            }
        }

        if WidgetCatalog.is-empty : EmptyState {
            vertical-stretch: 1;
            icon: "search";
            title: Strings.catalog-no-results;
        }

        if !WidgetCatalog.is-empty : Flickable {
            vertical-stretch: 1;
            height: 420px;
            width: 100%;
            viewport-width: self.width;
            viewport-height: 580px;

            VerticalLayout {
                width: parent.viewport-width;
                spacing: 8px;
                padding-right: 2px;

                // ---- Default (logical) order ----
                if root.sort-mode == 0 : VerticalLayout {
                    width: 100%;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        height: Theme.control-xl + Theme.space-6;
                        CatalogCard {
                            type-id: "terminal"; glyph: ">_"; label: Strings.dock-widget-terminal;
                            description: Strings.widget-terminal-desc;
                            card-visible: WidgetCatalog.show-terminal;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "weather"; glyph: "W"; label: Strings.dock-widget-weather;
                            description: Strings.widget-weather-desc;
                            card-visible: WidgetCatalog.show-weather;
                            pick(id) => { root.pick(id); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: Theme.control-xl + Theme.space-6;
                        CatalogCard {
                            type-id: "moon"; glyph: "O"; label: Strings.dock-widget-moon;
                            description: Strings.widget-moon-desc;
                            card-visible: WidgetCatalog.show-moon;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "jyotish"; glyph: "*"; label: Strings.dock-widget-jyotish;
                            description: Strings.widget-jyotish-desc;
                            card-visible: WidgetCatalog.show-jyotish;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "clock"; glyph: "C"; label: Strings.dock-widget-clock;
                            description: Strings.widget-clock-desc;
                            card-visible: WidgetCatalog.show-clock;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "system"; glyph: "S"; label: Strings.dock-widget-system;
                            description: Strings.widget-system-desc;
                            card-visible: WidgetCatalog.show-system;
                            pick(id) => { root.pick(id); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: Theme.control-xl + Theme.space-6;
                        CatalogCard {
                            type-id: "rss"; glyph: "N"; label: Strings.dock-widget-rss;
                            description: Strings.widget-rss-desc;
                            card-visible: WidgetCatalog.show-rss;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "recent-files"; glyph: "R"; label: Strings.dock-widget-recent-files;
                            description: Strings.widget-recent-files-desc;
                            card-visible: WidgetCatalog.show-recent-files;
                            pick(id) => { root.pick(id); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: Theme.control-xl + Theme.space-6;
                        CatalogCard {
                            type-id: "search"; glyph: "/"; label: Strings.dock-widget-search;
                            description: Strings.widget-search-desc;
                            card-visible: WidgetCatalog.show-search;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "media"; glyph: "N"; label: Strings.dock-widget-media;
                            description: Strings.widget-media-desc;
                            card-visible: WidgetCatalog.show-media;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "audio-player"; glyph: "♪"; label: Strings.dock-widget-audio-player;
                            description: Strings.widget-audio-player-desc;
                            card-visible: WidgetCatalog.show-audio-player;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "video-player"; glyph: "▶"; label: Strings.dock-widget-video-player;
                            description: Strings.widget-video-player-desc;
                            card-visible: WidgetCatalog.show-video-player;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "media-viewer"; glyph: "🎞"; label: Strings.dock-widget-media-viewer;
                            description: Strings.widget-media-viewer-desc;
                            card-visible: WidgetCatalog.show-media-viewer;
                            pick(id) => { root.pick(id); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: Theme.control-xl + Theme.space-6;
                        CatalogCard {
                            type-id: "password"; glyph: "*"; label: Strings.dock-widget-password;
                            description: Strings.widget-password-desc;
                            card-visible: WidgetCatalog.show-password;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "viewer"; glyph: "V"; label: Strings.dock-widget-viewer;
                            description: Strings.widget-viewer-desc;
                            card-visible: WidgetCatalog.show-viewer;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "browser"; glyph: "Br"; label: Strings.dock-widget-browser;
                            description: Strings.widget-browser-desc;
                            card-visible: WidgetCatalog.show-browser;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "document-editor"; glyph: "D"; label: Strings.dock-widget-document-editor;
                            description: Strings.widget-document-editor-desc;
                            card-visible: WidgetCatalog.show-document-editor;
                            pick(id) => { root.pick(id); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: Theme.control-xl + Theme.space-6;
                        CatalogCard {
                            type-id: "file-manager"; glyph: "#"; label: Strings.dock-widget-fm;
                            description: Strings.widget-fm-desc;
                            card-visible: WidgetCatalog.show-file-manager;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "processes"; glyph: "P"; label: Strings.dock-widget-processes;
                            description: Strings.widget-processes-desc;
                            card-visible: WidgetCatalog.show-processes;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "calculator"; glyph: "="; label: Strings.dock-widget-calculator;
                            description: Strings.widget-calculator-desc;
                            card-visible: WidgetCatalog.show-calculator;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "notes"; glyph: "≡"; label: Strings.dock-widget-notes;
                            description: Strings.widget-notes-desc;
                            card-visible: WidgetCatalog.show-notes;
                            pick(id) => { root.pick(id); }
                        }
                        CatalogCard {
                            type-id: "calendar"; glyph: "▦"; label: Strings.dock-widget-calendar;
                            description: Strings.widget-calendar-desc;
                            card-visible: WidgetCatalog.show-calendar;
                            pick(id) => { root.pick(id); }
                        }
                    }
                }

                // ---- A–Z ----
                if root.sort-mode == 1 : VerticalLayout {
                    width: 100%;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        height: Theme.control-xl + Theme.space-6;
                        CatalogCard {
                            type-id: "file-manager"; glyph: "#"; label: Strings.dock-widget-fm;
                            description: Strings.widget-fm-desc;
