import { Theme } from "theme_global.slint";
import { ButtonTone, ControlSize, Divider, Eyebrow, Grabber, ListTile, ToggleSwitch, TouchButton } from "kit.slint";
import { Strings } from "strings_global.slint";
import { SettingsGlobal } from "settings_global.slint";
import { ComboBox, LineEdit } from "std-widgets.slint";

export component SettingsPanel inherits Rectangle {
    callback dismiss();
    callback section-selected(int);
    callback field-changed(string, string, string);
    callback open-config();

    /// Bottom-sheet presentation for narrow canvases.
    in property <bool> sheet: false;

    property <bool> entered: false;
    init => { self.entered = true; }
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-base; easing: ease-out; }

    background: Theme.gradient-glass;
    border-radius: Theme.radius-xl;
    border-width: Theme.hairline;
    border-color: Theme.border-strong;
    drop-shadow-blur: Theme.elev-3-blur;
    drop-shadow-offset-y: Theme.elev-3-y;
    drop-shadow-color: Theme.shadow-key;
    clip: true;

    if root.sheet : Grabber {
        x: (parent.width - self.width) / 2;
        y: Theme.space-2;
    }

    HorizontalLayout {
        y: root.sheet ? Theme.space-4 : 0px;
        height: parent.height - self.y;
        padding: 0;
        spacing: 0;

        // Section rail; narrows on a sheet so the content column keeps room.
        Rectangle {
            width: root.sheet ? 168px : 240px;
            background: Theme.surface-sunken;

            Rectangle {
                x: parent.width - Theme.hairline;
                width: Theme.hairline;
                height: parent.height;
                background: Theme.border-default;
            }

            VerticalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-1;

                Eyebrow {
                    text: SettingsGlobal.panel-title;
                    horizontal-stretch: 1;
                }

                for sec[i] in SettingsGlobal.sections: ListTile {
                    title: sec.label;
                    icon: "sliders";
                    selected: i == SettingsGlobal.selected-section-index;
                    horizontal-stretch: 1;
                    clicked => { root.section-selected(i); }
                }
            }
        }

        // Content
        VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;
            horizontal-stretch: 1;

            VerticalLayout {
                spacing: Theme.space-2;

                Text {
                    text: SettingsGlobal.panel-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-2xl;
                    font-weight: Theme.weight-bold;
                }

                Text {
                    text: SettingsGlobal.hint-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-md;
                    wrap: word-wrap;
                }
            }

            if SettingsGlobal.coming-soon-text != "" : Text {
                text: SettingsGlobal.coming-soon-text;
                color: Theme.text-secondary;
                font-size: Theme.font-size-md;
                wrap: word-wrap;
            }

            if SettingsGlobal.config-path != "" : VerticalLayout {
                spacing: Theme.space-2;

                Text {
                    text: SettingsGlobal.config-path;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;

                    TouchButton {
                        text: Strings.settings_open_config_file;
                        icon: "undock";
                        tone: ButtonTone.neutral;
                        size: ControlSize.sm;
                        tooltip: Strings.settings_open_in_editor;
                        clicked => { root.open-config(); }
                    }
                }
            }

            Divider { }

            Flickable {
                vertical-stretch: 1;
                viewport-width: parent.width;
                viewport-height: field-list.preferred-height;

                field-list := VerticalLayout {
                    width: parent.viewport-width;
                    spacing: Theme.space-1;

                    for row in SettingsGlobal.fields: Rectangle {
                        min-height: Theme.row-height;
                        border-radius: Theme.radius-md;
                        background: field-row-ta.has-hover ? Theme.state-hover : Colors.transparent;

                        animate background { duration: Theme.motion-instant; easing: ease-out; }

                        field-row-ta := TouchArea { }

                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-3;
                            spacing: Theme.space-4;

                            Text {
                                width: 40%;
                                text: row.label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-md;
                                wrap: no-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            if row.kind == 0 : Text {
                                horizontal-stretch: 1;
                                text: row.value;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }

                            if row.kind == 1 : HorizontalLayout {
                                horizontal-stretch: 1;
                                alignment: start;

                                ToggleSwitch {
                                    checked: row.bool-value;
                                    label: row.label;
                                    toggled => {
                                        root.field-changed(
                                            SettingsGlobal.current-section-id,
                                            row.key,
                                            row.bool-value ? "false" : "true",
                                        );
                                    }
                                }
                            }

                            if row.kind == 2 : LineEdit {
                                horizontal-stretch: 1;
                                text: row.value;
                                font-size: Theme.font-size-md;
                                accepted(text) => {
                                    root.field-changed(
                                        SettingsGlobal.current-section-id,
                                        row.key,
                                        text,
                                    );
                                }
                            }

                            if row.kind == 3 : ComboBox {
                                horizontal-stretch: 1;
                                model: row.combo-options;
                                current-index: row.combo-index;
                                selected(_value) => {
                                    root.field-changed(
                                        SettingsGlobal.current-section-id,
                                        row.key,
                                        row.combo-values[self.current-index],
                                    );
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;

                TouchButton {
                    text: Strings.settings_panel_ok;
                    icon: "check";
                    tone: ButtonTone.filled;
                    clicked => { root.dismiss(); }
                }
            }
        }
    }
}
