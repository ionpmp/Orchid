import { Theme } from "theme_global.slint";
import { ButtonTone, Eyebrow, GlassCard, TouchButton } from "kit.slint";
import { OnboardingGlobal } from "onboarding_global.slint";

export component OnboardingOverlay inherits Rectangle {
    callback next-clicked();
    callback back-clicked();
    callback skip-clicked();

    property <bool> on-last-step:
        OnboardingGlobal.current-step + 1 >= OnboardingGlobal.step-count;

    property <bool> entered: false;
    init => { self.entered = true; }

    width: 100%;
    height: 100%;
    background: Theme.scrim;
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-base; easing: ease-out; }

    TouchArea {
        // Block clicks to content beneath the tour.
    }

    card := GlassCard {
        width: min(parent.width - 64px, 620px);
        x: (parent.width - self.width) / 2;
        // Rises into place instead of snapping in.
        y: (parent.height - self.height) / 2 + (root.entered ? 0px : Theme.space-6);
        elevation: 3;

        animate y { duration: Theme.motion-slow; easing: ease-out; }

        // Accent bloom keeps the tour card feeling like a lit stage.
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: parent.border-radius;
            background: Theme.gradient-hero;
        }

        VerticalLayout {
            padding: Theme.space-8;
            spacing: Theme.space-4;

            Eyebrow {
                text: OnboardingGlobal.step-progress-label;
            }

            Text {
                text: OnboardingGlobal.step-title;
                color: Theme.text-primary;
                font-size: Theme.font-size-3xl;
                font-weight: Theme.weight-bold;
                wrap: word-wrap;
            }

            Text {
                text: OnboardingGlobal.step-body;
                color: Theme.text-secondary;
                font-size: Theme.font-size-lg;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            // Step pips double as a progress read-out.
            HorizontalLayout {
                spacing: Theme.space-1;
                alignment: start;
                padding-top: Theme.space-2;

                for step[i] in OnboardingGlobal.step-count: Rectangle {
                    min-width: i == OnboardingGlobal.current-step ? Theme.space-6 : Theme.space-2;
                    max-width: i == OnboardingGlobal.current-step ? Theme.space-6 : Theme.space-2;
                    min-height: Theme.space-2;
                    max-height: Theme.space-2;
                    border-radius: self.height / 2;
                    background: i == OnboardingGlobal.current-step
                        ? Theme.accent-brand
                        : Theme.border-strong;

                    animate min-width, max-width, background {
                        duration: Theme.motion-base;
                        easing: ease-out;
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-2;
                padding-top: Theme.space-4;

                TouchButton {
                    text: OnboardingGlobal.skip-label;
                    tone: ButtonTone.ghost;
                    clicked => { root.skip-clicked(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                if OnboardingGlobal.current-step > 0: TouchButton {
                    text: OnboardingGlobal.back-label;
                    icon: "chevron-left";
                    tone: ButtonTone.neutral;
                    clicked => { root.back-clicked(); }
                }

                TouchButton {
                    text: root.on-last-step
                        ? OnboardingGlobal.finish-label
                        : OnboardingGlobal.next-label;
                    icon: root.on-last-step ? "check" : "chevron-right";
                    tone: ButtonTone.filled;
                    clicked => { root.next-clicked(); }
                }
            }
        }
    }
}
