import { Theme } from "../theme_global.slint";
import { Strings } from "../strings_global.slint";
import {
    Badge, ButtonTone, Chip, ControlSize, Divider, EmptyState, Eyebrow,
    IconButton, ListTile, ProgressTrack, Tooltip, TouchButton,
} from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { PasswordModel } from "../workspace/defs.slint";
import { PasswordAddDialog } from "password-add-dialog.slint";

export component PasswordView inherits Rectangle {
    in property <PasswordModel> model;

    callback search-changed(string);
    callback entry-clicked(string);
    callback copy-password(string);
    callback copy-username(string);
    callback copy-totp(string);
    callback open-url(string);
    callback unlock-submit(string);
    callback unlock-biometric();
    callback lock-vault();
    callback add-entry-request();
    callback add-entry-commit(string, string, string, string, string, string);
    callback add-entry-cancel();
    callback add-entry-generate-password();
    callback edit-entry-request();
    callback generate-request();
    callback group-clicked(string);

    property <string> unlock-passphrase: "";

    pure function color-label-tint(name: string) -> color {
        return name == "red" ? Theme.feedback-danger
            : name == "orange" ? #f97316
            : name == "yellow" ? Theme.feedback-warning
            : name == "green" ? Theme.feedback-success
            : name == "blue" ? Theme.feedback-info
            : name == "purple" ? #a855f7
            : Theme.accent-brand;
    }

    background: transparent;

    // Locked state — centred unlock card.
    if !model.is-unlocked : VerticalLayout {
        alignment: center;
        padding: Theme.space-6;
        spacing: Theme.space-4;

        Rectangle {
            horizontal-stretch: 0;
            max-width: 400px;
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-subtle;
            drop-shadow-blur: Theme.elev-2-blur;
            drop-shadow-offset-y: Theme.elev-2-y;
            drop-shadow-color: Theme.shadow-ambient;
            clip: true;

            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.gradient-hero;
            }

            VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-4;
                alignment: center;

                Rectangle {
                    min-width: Theme.control-lg;
                    max-width: Theme.control-lg;
                    min-height: Theme.control-lg;
                    max-height: Theme.control-lg;
                    border-radius: Theme.radius-lg;
                    background: Theme.accent-soft;
                    border-width: Theme.hairline;
                    border-color: Theme.accent-muted;

                    Icon {
                        name: "lock";
                        size: Theme.font-size-2xl;
                        tint: Theme.accent-brand;
                    }
                }

                Text {
                    text: model.lock-reason != "" ? model.lock-reason : Strings.password_locked;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-lg;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Eyebrow {
                    text: Strings.password_unlock_label;
                    horizontal-alignment: center;
                }

                // Passphrase field — cinema SearchField language, password input.
                Rectangle {
                    height: Theme.control-md;
                    background: Theme.surface-sunken;
                    border-radius: Theme.radius-pill;
                    border-width: Theme.hairline;
                    border-color: unlock-fs.has-focus ? Theme.border-focus : Theme.border-default;
                    horizontal-stretch: 1;

                    animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                    unlock-fs := FocusScope {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;

                        init => {
                            if (model.request-autofocus) {
                                self.focus();
                            }
                        }

                        TouchArea {
                            clicked => { unlock-fs.focus(); }
                        }

                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-4;
                            spacing: Theme.space-2;

                            Icon {
                                name: "lock";
                                size: Theme.font-size-lg;
                                tint: unlock-fs.has-focus ? Theme.accent-brand : Theme.text-tertiary;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 100%;
                                background: transparent;

                                if unlock-input.text == "" : Text {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: Strings.password_unlock_placeholder;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-md;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                unlock-input := TextInput {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.unlock-passphrase;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-md;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    single-line: true;
                                    input-type: password;
                                    edited => {
                                        root.unlock-passphrase = self.text;
                                    }
                                    accepted => {
                                        root.unlock-submit(root.unlock-passphrase);
                                        root.unlock-passphrase = "";
                                    }
                                }
                            }
                        }
                    }
                }

                if model.unlock-error != "" : Rectangle {
                    background: Theme.feedback-danger-soft;
                    border-radius: Theme.radius-md;
                    border-width: Theme.hairline;
                    border-color: Theme.feedback-danger.with-alpha(0.4);
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        padding: Theme.space-3;
                        spacing: Theme.space-2;

                        Icon {
                            name: "warning";
                            size: Theme.font-size-lg;
                            tint: Theme.feedback-danger;
                        }

                        Text {
                            text: model.unlock-error;
                            color: Theme.feedback-danger;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: center;

                    TouchButton {
                        text: Strings.password_unlock_submit;
                        icon: "lock";
                        tone: ButtonTone.filled;
                        size: ControlSize.md;
                        tooltip: Strings.password_unlock_submit;
                        clicked => {
                            root.unlock-submit(root.unlock-passphrase);
                            root.unlock-passphrase = "";
                        }
                    }

                    if model.biometric-available : TouchButton {
                        text: Strings.password_unlock_biometric;
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        tooltip: Strings.password_unlock_biometric;
                        clicked => { root.unlock-biometric(); }
                    }
                }
            }
        }
    }

    // Unlocked state
    if model.is-unlocked : VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;

        // Search + chrome
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: center;

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-sm;
                background: Theme.surface-sunken;
                border-radius: Theme.radius-pill;
                border-width: Theme.hairline;
                border-color: search-fs.has-focus ? Theme.border-focus : Theme.border-default;

                animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                search-fs := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;

                    init => {
                        if (model.request-autofocus) {
                            self.focus();
                        }
                    }

                    TouchArea {
                        clicked => { search-fs.focus(); }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-2;

                        Icon {
                            name: "search";
                            size: Theme.font-size-md;
                            tint: search-fs.has-focus ? Theme.accent-brand : Theme.text-tertiary;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100%;
                            background: transparent;

                            if search-input.text == "" : Text {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: Strings.password_search_placeholder;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-md;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            search-input := TextInput {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                text: model.search-query;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                single-line: true;
                                edited => {
                                    root.search-changed(self.text);
                                }
                            }
                        }
                    }
                }
            }

            IconButton {
                icon: "plus";
                size: ControlSize.sm;
                tooltip: Strings.password_action_add;
                clicked => { root.add-entry-request(); }
            }

            IconButton {
                icon: "refresh";
                size: ControlSize.sm;
                tooltip: Strings.password_action_generate;
                clicked => { root.generate-request(); }
            }

            IconButton {
                icon: "lock";
                size: ControlSize.sm;
                tooltip: Strings.password_action_lock;
                tooltip-flip: true;
                clicked => { root.lock-vault(); }
            }
        }

        if model.groups.length > 0 : HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            Chip {
                text: Strings.password_group_all;
                selected: model.selected-group-id == "";
                clicked => { root.group-clicked(""); }
            }
            for g[i] in model.groups : Chip {
                text: g.name;
                selected: g.selected;
                clicked => { root.group-clicked(g.id); }
            }
        }

        // Two-column split
        HorizontalLayout {
            spacing: Theme.space-3;
            vertical-stretch: 1;

            // Left: entries list
            Rectangle {
                width: parent.width * 0.4;
                background: Theme.gradient-glass;
                border-radius: Theme.radius-lg;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;
                clip: true;

                Flickable {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: list-layout.preferred-height;
                    interactive: true;

                    list-layout := VerticalLayout {
                        padding: Theme.space-2;
                        spacing: Theme.space-1;

                        if model.entries.length == 0 : EmptyState {
                            min-height: 160px;
                            icon: "lock";
                            title: Strings.password_no_entries;
                        }

                        for e[i] in model.entries : Rectangle {
                            horizontal-stretch: 1;
                            height: entry-tile.preferred-height;

                            entry-tile := ListTile {
                                width: 100%;
                                title: e.title;
                                subtitle: e.username;
                                selected: model.selected.has-selection && model.selected.id == e.id;
                                clicked => { root.entry-clicked(e.id); }

                                if e.color-label != "" : Rectangle {
                                    width: Theme.space-2;
                                    height: Theme.space-4;
                                    border-radius: Theme.radius-pill;
                                    background: root.color-label-tint(e.color-label);
                                    vertical-stretch: 0;
                                }

                                if e.has-totp : Badge {
                                    text: "OTP";
                                    tint: Theme.accent-brand;
                                }
                            }

                            Tooltip {
                                text: e.username != "" ? e.title + " — " + e.username : e.title;
                                shown: entry-tile.hovered;
                                x: Theme.space-3;
                                y: parent.height + Theme.space-1;
                            }
                        }
                    }
                }
            }

            // Right: detail pane
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.gradient-glass;
                border-radius: Theme.radius-lg;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;
                clip: true;

                if !model.selected.has-selection : EmptyState {
                    icon: "lock";
                    title: Strings.password_select_entry;
                }

                if model.selected.has-selection : Flickable {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: detail-layout.preferred-height;
                    interactive: true;

                    detail-layout := VerticalLayout {
                        padding: Theme.space-5;
                        spacing: Theme.space-4;

                        HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: start;
                            TouchButton {
                                text: Strings.password_action_edit;
                                tone: ButtonTone.neutral;
                                size: ControlSize.sm;
                                tooltip: Strings.password_action_edit;
                                clicked => { root.edit-entry-request(); }
                            }
                        }

                        // Title
                        Rectangle {
                            height: title-text.preferred-height;

                            title-ta := TouchArea { }

                            Tooltip {
                                text: model.selected.title;
                                shown: title-ta.has-hover && model.selected.title != "";
                                x: 0;
                                y: parent.height + Theme.space-1;
                            }

                            title-text := Text {
                                text: model.selected.title;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-xl;
                                font-weight: Theme.weight-bold;
                                wrap: no-wrap;
                                overflow: elide;
                                width: 100%;
                            }
                        }

                        Divider { }

                        // Username row
                        VerticalLayout {
                            spacing: Theme.space-2;

                            Eyebrow {
                                text: Strings.password_label_username;
                            }

                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: center;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Theme.control-sm;
                                    background: Theme.surface-sunken;
                                    border-radius: Theme.radius-md;
                                    border-width: Theme.hairline;
                                    border-color: Theme.border-subtle;

                                    user-val-ta := TouchArea { }

                                    Tooltip {
                                        text: model.selected.username;
                                        shown: user-val-ta.has-hover && model.selected.username != "";
                                        x: Theme.space-2;
                                        y: parent.height + Theme.space-1;
                                    }

                                    Text {
                                        x: Theme.space-3;
                                        width: parent.width - Theme.space-6;
                                        height: 100%;
                                        text: model.selected.username;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-md;
                                        vertical-alignment: center;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }

                                TouchButton {
                                    text: Strings.password_copy_username;
                                    tone: ButtonTone.neutral;
                                    size: ControlSize.sm;
                                    tooltip: Strings.password_copy_username;
                                    clicked => { root.copy-username(model.selected.id); }
                                }
                            }
                        }

                        // Password row
                        VerticalLayout {
                            spacing: Theme.space-2;

                            Eyebrow {
                                text: Strings.password_label_password;
                            }

                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: center;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Theme.control-sm;
                                    background: Theme.surface-sunken;
                                    border-radius: Theme.radius-md;
                                    border-width: Theme.hairline;
                                    border-color: Theme.border-subtle;

                                    Text {
                                        x: Theme.space-3;
                                        width: parent.width - Theme.space-6;
                                        height: 100%;
                                        text: "••••••••••";
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-md;
                                        font-family: Theme.font-family-mono;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchButton {
                                    text: Strings.password_copy_password;
                                    tone: ButtonTone.tonal;
                                    size: ControlSize.sm;
                                    tooltip: Strings.password_copy_password;
                                    clicked => { root.copy-password(model.selected.id); }
                                }
                            }
                        }

                        // URL row
                        if model.selected.url != "" : VerticalLayout {
                            spacing: Theme.space-2;

                            Eyebrow {
                                text: Strings.password_label_url;
                            }

                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: center;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: Theme.control-sm;
                                    background: Theme.surface-sunken;
                                    border-radius: Theme.radius-md;
                                    border-width: Theme.hairline;
                                    border-color: Theme.border-subtle;

                                    url-val-ta := TouchArea { }

                                    Tooltip {
                                        text: model.selected.url;
                                        shown: url-val-ta.has-hover && model.selected.url != "";
                                        x: Theme.space-2;
                                        y: parent.height + Theme.space-1;
                                    }

                                    Text {
                                        x: Theme.space-3;
                                        width: parent.width - Theme.space-6;
                                        height: 100%;
                                        text: model.selected.url;
                                        color: Theme.accent-brand;
                                        font-size: Theme.font-size-md;
                                        vertical-alignment: center;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }

                                TouchButton {
                                    text: Strings.password_open_url;
                                    icon: "undock";
                                    tone: ButtonTone.neutral;
                                    size: ControlSize.sm;
                                    tooltip: Strings.password_open_url;
                                    clicked => { root.open-url(model.selected.url); }
                                }
                            }
                        }

                        // TOTP row
                        if model.selected.totp-code != "" : VerticalLayout {
                            spacing: Theme.space-2;

                            Eyebrow {
                                text: Strings.password_label_totp;
                            }

                            Rectangle {
                                background: Theme.surface-sunken;
                                border-radius: Theme.radius-lg;
                                border-width: Theme.hairline;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: Theme.space-3;
                                    spacing: Theme.space-3;

                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        alignment: center;

                                        Text {
                                            text: model.selected.totp-code;
                                            color: Theme.text-primary;
                                            font-family: Theme.font-family-mono;
                                            font-size: Theme.font-size-2xl;
                                            font-weight: Theme.weight-bold;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        Text {
                                            text: model.selected.totp-remaining-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            font-family: Theme.font-family-mono;
                                            vertical-alignment: center;
                                        }

                                        TouchButton {
                                            text: Strings.password_copy_totp;
                                            tone: ButtonTone.neutral;
                                            size: ControlSize.sm;
                                            tooltip: Strings.password_copy_totp;
                                            clicked => { root.copy-totp(model.selected.id); }
                                        }
                                    }

                                    ProgressTrack {
                                        value: model.selected.totp-remaining / 30.0;
                                        fill: model.selected.totp-remaining <= 5 ? Theme.feedback-danger
                                            : model.selected.totp-remaining <= 10 ? Theme.feedback-warning
                                            : Theme.gradient-accent;
                                    }
                                }
                            }
                        }

                        // Notes
                        if model.selected.notes != "" : VerticalLayout {
                            spacing: Theme.space-2;

                            Eyebrow {
                                text: Strings.password_label_notes;
                            }

                            Text {
                                text: model.selected.notes;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                wrap: word-wrap;
                            }
                        }

                        // Tags
                        if model.selected.tags.length > 0 : HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: start;

                            for tag[j] in model.selected.tags : Chip {
                                text: tag.label;
                            }
                        }
                    }
                }
            }
        }

        // Toast (copy feedback)
        if model.toast-visible : Rectangle {
            height: Theme.control-sm;
            background: Theme.gradient-accent;
            border-radius: Theme.radius-pill;
            drop-shadow-blur: Theme.elev-glow-blur;
            drop-shadow-offset-y: Theme.elev-1-y;
            drop-shadow-color: Theme.accent-glow;

            Text {
                text: model.toast-message;
                color: Theme.accent-contrast;
                font-size: Theme.font-size-sm;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if model.add-dialog.visible : PasswordAddDialog {
        width: parent.width;
        height: parent.height;
        state: model.add-dialog;
        commit(title, username, password, url, notes, group) => {
            root.add-entry-commit(title, username, password, url, notes, group);
        }
        cancel => { root.add-entry-cancel(); }
        generate-password => { root.add-entry-generate-password(); }
    }
}
