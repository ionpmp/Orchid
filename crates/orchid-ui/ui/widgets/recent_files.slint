import { Theme } from "../theme_global.slint";
import { EmptyState, Tooltip } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { Strings } from "../strings_global.slint";
import { RecentFilesModel } from "../workspace/defs.slint";

export component RecentFilesView inherits Rectangle {
    in property <RecentFilesModel> model;

    callback item-clicked(string);

    background: transparent;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        if !model.has-items : EmptyState {
            vertical-stretch: 1;
            icon: "layers";
            title: model.empty-state-text;
        }

        if model.has-items : Flickable {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            interactive: true;
            viewport-width: self.width;
            viewport-height: list.preferred-height.max(self.height);

            list := VerticalLayout {
                width: parent.viewport-width;
                spacing: Theme.space-2;

                for item[i] in model.items : Rectangle {
                    height: Theme.control-xl;
                    background: item-ta.has-hover ? Theme.surface-raised : Theme.surface-sunken;
                    border-radius: Theme.radius-lg;
                    border-width: Theme.hairline;
                    border-color: item-ta.has-hover ? Theme.border-subtle : Colors.transparent;

                    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

                    item-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.item-clicked(item.path);
                        }
                    }

                    Tooltip {
                        x: Theme.space-3;
                        y: parent.height - Theme.space-1;
                        shown: item-ta.has-hover;
                        text: item.path != "" ? item.path : Strings.recent-files-open-hint;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-3;

                        Rectangle {
                            min-width: Theme.control-md;
                            max-width: Theme.control-md;
                            min-height: Theme.control-md;
                            max-height: Theme.control-md;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-md;
                            background: Theme.accent-soft;

                            Icon {
                                name: "layers";
                                size: Theme.font-size-xl;
                                tint: Theme.accent-brand;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                font-weight: Theme.weight-semibold;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: item.path;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: item.opened;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-xs;
                            }
                        }
                    }
                }
            }
        }
    }
}
