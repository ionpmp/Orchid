import { Theme } from "../theme_global.slint";
import { EmptyState, ListTile, Tooltip } from "../kit.slint";
import { Strings } from "../strings_global.slint";
import { RecentFilesModel } from "../workspace/defs.slint";

export component RecentFilesView inherits Rectangle {
    in property <RecentFilesModel> model;

    callback item-clicked(string);

    background: transparent;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        if !model.has-items : EmptyState {
            vertical-stretch: 1;
            icon: "layers";
            title: model.empty-state-text;
        }

        if model.has-items : Flickable {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            interactive: true;
            viewport-width: self.width;
            viewport-height: list.preferred-height.max(self.height);

            list := VerticalLayout {
                width: parent.viewport-width;
                spacing: Theme.space-1;

                for item[i] in model.items : Rectangle {
                    horizontal-stretch: 1;
                    height: file-tile.preferred-height;

                    file-tile := ListTile {
                        width: 100%;
                        title: item.name;
                        subtitle: item.path;
                        icon: "layers";
                        clicked => {
                            root.item-clicked(item.path);
                        }

                        if item.opened != "" : Text {
                            text: item.opened;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-xs;
                            vertical-alignment: center;
                        }
                    }

                    Tooltip {
                        x: Theme.space-3;
                        y: parent.height + Theme.space-1;
                        shown: file-tile.hovered;
                        text: item.path != "" ? item.path : Strings.recent-files-open-hint;
                    }
                }
            }
        }
    }
}
