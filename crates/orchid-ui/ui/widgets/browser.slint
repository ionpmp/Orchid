import { Theme } from "../theme_global.slint";
import { ControlSize, IconButton, Tooltip } from "../kit.slint";
import { BrowserModel } from "../workspace/defs.slint";

component BrowserToolBtn inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();

    width: max(Theme.control-md, label-txt.preferred-width + Theme.space-4);
    height: Theme.control-md;
    border-radius: Theme.radius-pill;
    background: ta.pressed ? Theme.state-press :
        ta.has-hover ? Theme.state-hover : Colors.transparent;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: Theme.motion-fast; easing: ease-out; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    label-txt := Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: !root.enabled ? Theme.text-disabled : Theme.text-secondary;
        font-size: Theme.font-size-md;
        font-weight: Theme.weight-medium;
        font-family: Theme.font-family-sans;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Tooltip {
        text: root.tip;
        shown: ta.has-hover && root.tip != "";
        x: (parent.width - self.width) / 2;
        y: parent.height + Theme.space-1;
    }
}

export component BrowserView inherits Rectangle {
    in property <BrowserModel> model;

    callback select-tab(int);
    callback new-tab();
    callback close-tab(int);
    callback navigate(string);
    callback command(string);
    callback open-external();
    callback find(string, bool);
    callback toggle-bookmark();
    callback open-bookmark(int);
    callback remove-bookmark(int);
    callback embed-bounds(length, length, length, length, bool);

    background: transparent;

    property <string> draft-url: model.url;
    property <int> synced-active: model.active-index;
    property <string> synced-url: model.url;
    property <int> last-focus-gen: 0;
    property <int> last-find-gen: 0;
    property <int> last-downloads-gen: 0;
    property <bool> find-open: false;
    property <bool> bookmarks-open: false;
    property <bool> downloads-open: false;
    property <string> find-query: "";
    property <int> drag-index: -1;
    property <bool> tab-dragged: false;

    function fire-embed() {
        if (model.webview-available && host.width > 8px && host.height > 8px) {
            root.embed-bounds(host.absolute-position.x, host.absolute-position.y, host.width, host.height, true);
        } else {
            root.embed-bounds(0, 0, 0, 0, false);
        }
    }

    function chrome-handled(event: KeyEvent) -> bool {
        if (event.modifiers.control && event.modifiers.shift && (event.text == "t" || event.text == "T")) {
            root.command("reopen-closed");
            return true;
        }
        if (event.modifiers.control && event.modifiers.shift && event.text == Key.Tab) {
            root.command("prev-tab");
            return true;
        }
        if (event.modifiers.control && event.text == Key.Tab) {
            root.command("next-tab");
            return true;
        }
        if (event.modifiers.control && event.text == Key.PageDown) {
            root.command("next-tab");
            return true;
        }
        if (event.modifiers.control && event.text == Key.PageUp) {
            root.command("prev-tab");
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "1") {
            root.select-tab(0);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "2") {
            root.select-tab(1);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "3") {
            root.select-tab(2);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "4") {
            root.select-tab(3);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "5") {
            root.select-tab(4);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "6") {
            root.select-tab(5);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "7") {
            root.select-tab(6);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "8") {
            root.select-tab(7);
            return true;
        }
        if (event.modifiers.control && !event.modifiers.shift && event.text == "9") {
            if (model.tabs.length > 0) {
                root.select-tab(model.tabs.length - 1);
            }
            return true;
        }
        if (event.modifiers.control && (event.text == "t" || event.text == "T")) {
            root.new-tab();
            return true;
        }
        if (event.modifiers.control && (event.text == "j" || event.text == "J")) {
            root.downloads-open = !root.downloads-open;
            return true;
        }
        if (event.modifiers.control && (event.text == "w" || event.text == "W")) {
            root.close-tab(model.active-index);
            return true;
        }
        if (event.modifiers.control && (event.text == "l" || event.text == "L")) {
            address.focus();
            address.select-all();
            return true;
        }
        if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
            root.command(model.is-loading ? "stop" : "reload");
            return true;
        }
        if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
            root.find-open = true;
            find-input.focus();
            return true;
        }
        if (event.modifiers.control && (event.text == "d" || event.text == "D")) {
            root.toggle-bookmark();
            return true;
        }
        if (event.modifiers.control && (event.text == "+" || event.text == "=")) {
            root.command("zoom-in");
            return true;
        }
        if (event.modifiers.control && (event.text == "-" || event.text == "_")) {
            root.command("zoom-out");
            return true;
        }
        if (event.modifiers.control && event.text == "0") {
            root.command("zoom-reset");
            return true;
        }
        if (event.text == Key.F5) {
            root.command("reload");
            return true;
        }
        if (event.modifiers.alt && event.text == Key.LeftArrow) {
            root.command("back");
            return true;
        }
        if (event.modifiers.alt && event.text == Key.RightArrow) {
            root.command("forward");
            return true;
        }
        if (event.modifiers.alt && event.text == Key.Home) {
            root.command("home");
            return true;
        }
        if (event.text == Key.Escape) {
            if (root.find-open) {
                root.find-open = false;
                return true;
            }
            if (root.downloads-open) {
                root.downloads-open = false;
                return true;
            }
            if (root.bookmarks-open) {
                root.bookmarks-open = false;
                return true;
            }
            if (model.is-loading) {
                root.command("stop");
                return true;
            }
        }
        return false;
    }

    changed model => {
        if model.active-index != root.synced-active {
            root.draft-url = model.url;
            root.synced-active = model.active-index;
            root.synced-url = model.url;
        } else if model.url != root.synced-url && root.draft-url == root.synced-url {
            root.draft-url = model.url;
            root.synced-url = model.url;
        } else if root.draft-url == model.url {
            root.synced-url = model.url;
        }
        if model.focus-address-gen != root.last-focus-gen {
            let bump = model.focus-address-gen > root.last-focus-gen;
            root.last-focus-gen = model.focus-address-gen;
            if bump {
                address.focus();
                address.select-all();
            }
        }
        if model.show-find-gen != root.last-find-gen {
            let bump = model.show-find-gen > root.last-find-gen;
            root.last-find-gen = model.show-find-gen;
            if bump {
                root.find-open = true;
                find-input.focus();
            }
        }
        if model.show-downloads-gen != root.last-downloads-gen {
            let bump = model.show-downloads-gen > root.last-downloads-gen;
            root.last-downloads-gen = model.show-downloads-gen;
            if bump {
                root.downloads-open = true;
            }
        }
        root.fire-embed();
    }

    chrome := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (root.chrome-handled(event)) {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0;

            Rectangle {
                height: Theme.toolbar-height;
                background: Theme.surface-sunken;

                Rectangle {
                    y: parent.height - Theme.hairline;
                    width: parent.width;
                    height: Theme.hairline;
                    background: Theme.border-subtle;
                }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    alignment: start;

                    Flickable {
                        vertical-stretch: 0;
                        viewport-height: self.height;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 2px;
                            alignment: start;

                            for tab[i] in model.tabs : Rectangle {
                                width: max(120px, min(200px, tab-label.preferred-width + (tab.has-icon ? 22px : 0) + (tab.is-active ? 44px : 28px)));
                                height: Theme.control-md;
                                y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-md;
                                background: tab.is-active ? Theme.surface-raised
                                    : tab-ta.has-hover ? Theme.state-hover : Colors.transparent;

                                animate background { duration: Theme.motion-instant; easing: ease-out; }

                                // Accent underline marks the live tab.
                                if tab.is-active : Rectangle {
                                    x: Theme.space-3;
                                    y: parent.height - Theme.indicator-thickness;
                                    width: parent.width - Theme.space-3 * 2;
                                    height: Theme.indicator-thickness;
                                    border-radius: self.height / 2;
                                    background: Theme.accent-brand;
                                }

                                tab-ta := TouchArea {
                                    clicked => {
                                        if (!root.tab-dragged) {
                                            root.select-tab(i);
                                        }
                                        root.tab-dragged = false;
                                    }
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            root.drag-index = i;
                                            root.tab-dragged = false;
                                        }
                                        if (event.kind == PointerEventKind.up) {
                                            if (event.button == PointerEventButton.middle) {
                                                root.close-tab(i);
                                            }
                                            root.drag-index = -1;
                                        }
                                    }
                                    moved => {
                                        if (root.drag-index != i) {
                                            return;
                                        }
                                        if (self.mouse-x > self.width + 10px && i + 1 < model.tabs.length) {
                                            root.command("move-tab:" + i + ":" + (i + 1));
                                            root.drag-index = i + 1;
                                            root.tab-dragged = true;
                                        } else if (self.mouse-x < -10px && i > 0) {
                                            root.command("move-tab:" + i + ":" + (i - 1));
                                            root.drag-index = i - 1;
                                            root.tab-dragged = true;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-1;
                                    spacing: Theme.space-2;

                                    if tab.has-icon : Image {
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        source: tab.icon;
                                    }

                                    tab-label := Text {
                                        text: tab.title == "" ? model.untitled-label : tab.title;
                                        color: tab.is-active ? Theme.text-primary : Theme.text-secondary;
                                        font-size: Theme.font-size-sm;
                                        font-weight: tab.is-active ? Theme.weight-semibold : Theme.weight-medium;
                                        font-family: Theme.font-family-sans;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if tab.is-active || tab-ta.has-hover : IconButton {
                                        icon: "close";
                                        size: ControlSize.xs;
                                        y: (parent.height - self.height) / 2;
                                        clicked => { root.close-tab(i); }
                                    }
                                }
                            }
                        }
                    }

                    BrowserToolBtn {
                        label: "+";
                        tip: model.new-tab-tip;
                        clicked => { root.new-tab(); }
                    }
                }
            }

            Rectangle {
                height: Theme.toolbar-height;
                background: Theme.gradient-chrome;

                Rectangle {
                    y: parent.height - Theme.hairline;
                    width: parent.width;
                    height: Theme.hairline;
                    background: Theme.border-subtle;
                }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    alignment: start;

                    BrowserToolBtn {
                        label: model.back-label;
                        enabled: model.webview-available && model.can-go-back;
                        clicked => { root.command("back"); }
                    }
                    BrowserToolBtn {
                        label: model.forward-label;
                        enabled: model.webview-available && model.can-go-forward;
                        clicked => { root.command("forward"); }
                    }
                    BrowserToolBtn {
                        label: model.is-loading ? model.stop-label : model.reload-label;
                        enabled: model.webview-available;
                        clicked => { root.command(model.is-loading ? "stop" : "reload"); }
                    }
                    BrowserToolBtn {
                        label: model.home-label;
                        enabled: model.webview-available;
                        clicked => { root.command("home"); }
                    }
                    if model.zoom-percent != 100 : BrowserToolBtn {
                        label: model.zoom-percent + "%";
                        enabled: model.webview-available;
                        clicked => { root.command("zoom-reset"); }
                    }

                    // Address bar: a pill that lights up while it has focus.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.control-md;
                        y: (parent.height - self.height) / 2;
                        background: Theme.surface-sunken;
                        border-radius: Theme.radius-pill;
                        border-width: address.has-focus ? 2px : Theme.hairline;
                        border-color: address.has-focus ? Theme.border-focus : Theme.border-default;

                        animate border-width, border-color {
                            duration: Theme.motion-fast;
                            easing: ease-out;
                        }

                        if root.draft-url == "" : Text {
                            x: Theme.space-4;
                            width: parent.width - Theme.space-8;
                            height: 100%;
                            text: model.address-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-md;
                            font-family: Theme.font-family-sans;
                            vertical-alignment: center;
                        }

                        address := TextInput {
                            x: Theme.space-4;
                            width: parent.width - Theme.space-8;
                            height: 100%;
                            text: root.draft-url;
                            edited => { root.draft-url = self.text; }
                            accepted => { root.navigate(root.draft-url); }
                            single-line: true;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            font-family: Theme.font-family-sans;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.modifiers.control && (event.text == "l" || event.text == "L")) {
                                    self.select-all();
                                    return accept;
                                }
                                if (root.chrome-handled(event)) {
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    BrowserToolBtn {
                        label: model.is-bookmarked ? "★" : "☆";
                        tip: model.bookmark-tip;
                        enabled: model.url != "" && model.url != "about:blank";
                        clicked => { root.toggle-bookmark(); }
                    }
                    BrowserToolBtn {
                        label: model.go-label;
                        enabled: true;
                        clicked => { root.navigate(root.draft-url); }
                    }
                    BrowserToolBtn {
                        label: model.bookmarks-label;
                        clicked => { root.bookmarks-open = !root.bookmarks-open; }
                    }
                    BrowserToolBtn {
                        label: model.has-active-download ? model.downloads-label + " ●" : model.downloads-label;
                        clicked => { root.downloads-open = !root.downloads-open; }
                    }
                    BrowserToolBtn {
                        label: model.find-label;
                        enabled: model.webview-available;
                        clicked => {
                            root.find-open = true;
                            find-input.focus();
                        }
                    }
                    BrowserToolBtn {
                        label: model.open-label;
                        clicked => { root.open-external(); }
                    }
                }
            }

            Rectangle {
                height: root.find-open ? 32px : 0;
                clip: true;
                background: Theme.surface-base;
                visible: root.find-open;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: model.find-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        if find-input.text == "" : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: model.find-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        find-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.find-query;
                            single-line: true;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-sans;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return) {
                                    root.find(root.find-query, !event.modifiers.shift);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                if (root.chrome-handled(event)) {
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    BrowserToolBtn {
                        label: "↑";
                        tip: model.find-prev-tip;
                        clicked => { root.find(root.find-query, false); }
                    }
                    BrowserToolBtn {
                        label: "↓";
                        tip: model.find-next-tip;
                        clicked => { root.find(root.find-query, true); }
                    }
                    BrowserToolBtn {
                        label: "×";
                        tip: model.find-close-tip;
                        clicked => { root.find-open = false; }
                    }
                }
            }

            if root.find-open : Rectangle { height: 1px; background: Theme.border-default; }

            Rectangle {
                height: root.bookmarks-open ? 88px : 0;
                clip: true;
                background: Theme.surface-base;
                visible: root.bookmarks-open;

                if model.bookmarks.length == 0 : Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: model.bookmarks-empty;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: parent.width;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;

                        for bm[i] in model.bookmarks : Rectangle {
                            height: 24px;
                            border-radius: Theme.radius-md;
                            background: bm-ta.has-hover ? Theme.surface-raised : transparent;

                            bm-ta := TouchArea {
                                clicked => { root.open-bookmark(i); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 4px;
                                spacing: 4px;

                                Text {
                                    text: bm.title == "" ? bm.url : bm.title;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    font-family: Theme.font-family-sans;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius-md;
                                    background: rm-ta.has-hover ? Theme.surface-base : transparent;
                                    rm-ta := TouchArea {
                                        clicked => { root.remove-bookmark(i); }
                                    }
                                    Text {
                                        width: 100%; height: 100%;
                                        text: "×";
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.bookmarks-open : Rectangle { height: 1px; background: Theme.border-default; }

            Rectangle {
                height: root.downloads-open ? 110px : 0;
                clip: true;
                background: Theme.surface-base;
                visible: root.downloads-open;

                if model.downloads.length == 0 : Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: model.downloads-empty;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: parent.width;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        for dl[i] in model.downloads : Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-md;
                            background: Theme.surface-raised;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 4px;
                                spacing: 6px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: dl.filename;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: dl.status-label + (dl.progress >= 0 ? " " + dl.progress + "%" : "");
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                    }
                                }

                                if dl.in-progress : BrowserToolBtn {
                                    label: model.download-cancel-label;
                                    clicked => { root.command("download-cancel:" + dl.id); }
                                }
                                if !dl.in-progress && dl.state == 1 : BrowserToolBtn {
                                    label: model.download-open-label;
                                    clicked => { root.command("download-open:" + dl.id); }
                                }
                                if !dl.in-progress && dl.state == 1 : BrowserToolBtn {
                                    label: model.download-show-label;
                                    clicked => { root.command("download-show:" + dl.id); }
                                }
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius-md;
                                    background: dl-rm.has-hover ? Theme.surface-base : transparent;
                                    dl-rm := TouchArea {
                                        clicked => { root.command("download-remove:" + i); }
                                    }
                                    Text {
                                        width: 100%; height: 100%;
                                        text: "×";
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.downloads-open : Rectangle { height: 1px; background: Theme.border-default; }

            if !model.webview-available : Text {
                height: 20px;
                text: model.unavailable-label;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }

            embed-slot := Rectangle {
                vertical-stretch: 1;
                background: Theme.surface-base;
                clip: true;

                host := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    visible: model.webview-available;
                    changed width => { root.fire-embed(); }
                    changed height => { root.fire-embed(); }
                    changed absolute-position => { root.fire-embed(); }
                    changed visible => { root.fire-embed(); }
                    property <length> ax: self.absolute-position.x;
                    property <length> ay: self.absolute-position.y;
                    changed ax => { root.fire-embed(); }
                    changed ay => { root.fire-embed(); }
                }
            }
        }
    }
}
