import { Theme } from "../theme_global.slint";
import { Badge, EmptyState, Tooltip } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { Strings } from "../strings_global.slint";
import { SearchModel } from "../workspace/defs.slint";

export component SearchView inherits Rectangle {
    forward-focus: input;
    in property <SearchModel> model;

    callback query-changed(string);
    callback candidate-activated(string);
    callback selection-changed(int);
    callback escape-pressed();

    background: transparent;

    // ASCII/BMP glyphs — color emoji and many Unicode symbols are missing in Slint's default font on Windows.
    pure function source-glyph(name: string) -> string {
        return
            name == "files" ? "/" :
            name == "commands" ? ">" :
            name == "settings" ? "*" :
            ".";
    }

    init => {
        if (model.request-autofocus) {
            input.focus();
        }
    }

    changed model => {
        if (model.request-autofocus) {
            input.focus();
        }
    }

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;

        Rectangle {
            height: Theme.control-lg;
            background: Theme.surface-sunken;
            border-radius: Theme.radius-pill;
            border-width: Theme.hairline;
            border-color: input.has-focus
                ? Theme.border-focus
                : Theme.border-default;
            horizontal-stretch: 1;

            animate border-color { duration: Theme.motion-fast; easing: ease-out; }

            HorizontalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-5;
                spacing: Theme.space-3;

                Icon {
                    name: "search";
                    size: Theme.font-size-xl;
                    tint: input.has-focus ? Theme.accent-brand : Theme.text-tertiary;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    background: transparent;

                    if input.text == "" : Text {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: model.placeholder-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-lg;
                        vertical-alignment: center;
                    }

                    input := TextInput {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: model.query;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-lg;
                        vertical-alignment: center;
                        single-line: true;
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.escape-pressed();
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.selection-changed(model.selected-index + 1);
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.selection-changed(model.selected-index - 1);
                                return accept;
                            }
                            if (event.text == Key.Return) {
                                if (model.selected-index >= 0
                                    && model.selected-index < model.candidates.length)
                                {
                                    root.candidate-activated(
                                        model.candidates[model.selected-index].id
                                    );
                                }
                                return accept;
                            }
                            return reject;
                        }
                        accepted => {
                            if (model.selected-index >= 0
                                && model.selected-index < model.candidates.length)
                            {
                                root.candidate-activated(
                                    model.candidates[model.selected-index].id
                                );
                            }
                        }
                        edited => {
                            root.query-changed(self.text);
                        }
                    }
                }
            }
        }

        if model.is-searching : Text {
            text: model.searching-text;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
        }

        if model.error != "" : Text {
            text: model.error;
            color: Theme.feedback-danger;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
        }

        if model.query == "" && model.candidates.length == 0 : EmptyState {
            vertical-stretch: 1;
            icon: "search";
            title: model.empty-state-text;
        }

        if model.query != "" && model.candidates.length == 0 && !model.is-searching
            : EmptyState {
            vertical-stretch: 1;
            icon: "info";
            title: model.no-results-text;
        }

        if model.candidates.length > 0 : Flickable {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            interactive: true;
            viewport-width: self.width;
            viewport-height: cand-list.preferred-height.max(self.height);

            cand-list := VerticalLayout {
                width: parent.viewport-width;
                spacing: 2px;

                for cand[i] in model.candidates : Rectangle {
                    property <bool> is-selected: i == model.selected-index;

                    height: Theme.control-lg;
                    background: self.is-selected ? Theme.state-selected
                        : cand-ta.has-hover ? Theme.state-hover
                        : Colors.transparent;
                    border-radius: Theme.radius-md;

                    animate background { duration: Theme.motion-instant; easing: ease-out; }

                    // Accent rail on the keyboard-selected row.
                    if self.is-selected : Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: Theme.indicator-thickness;
                        height: parent.height * 0.55;
                        border-radius: self.width / 2;
                        background: Theme.accent-brand;
                    }

                    cand-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.selection-changed(i);
                            root.candidate-activated(cand.id);
                        }
                    }

                    Tooltip {
                        text: cand.subtitle != ""
                            ? cand.title + " — " + cand.subtitle
                            : cand.title != "" ? cand.title : Strings.search-open-hint;
                        shown: cand-ta.has-hover;
                        x: Theme.space-2;
                        y: parent.height - Theme.space-1;
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-3;

                        // Source tile — a colour anchor per result kind.
                        Rectangle {
                            min-width: Theme.icon-button-sm;
                            max-width: Theme.icon-button-sm;
                            min-height: Theme.icon-button-sm;
                            max-height: Theme.icon-button-sm;
                            border-radius: Theme.radius-sm;
                            background: Theme.accent-soft;

                            Text {
                                width: 100%;
                                height: 100%;
                                text: source-glyph(cand.source-icon);
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-md;
                                font-weight: Theme.weight-bold;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: cand.title;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                font-weight: Theme.weight-semibold;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            if cand.subtitle != "" : Text {
                                text: cand.subtitle;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }

                        if cand.shortcut != "" : Badge {
                            text: cand.shortcut;
                            tint: Theme.text-tertiary;
                        }
                    }
                }
            }
        }
    }
}
