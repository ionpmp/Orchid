import { Theme } from "../theme_global.slint";
import { VideoPlayerModel } from "../workspace/defs.slint";
import { SearchField } from "search-field.slint";

export component VideoPlayerView inherits Rectangle {
    in property <VideoPlayerModel> model;

    callback command(string);

    background: transparent;
    clip: true;

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == " " {
                root.command("play-pause");
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.command(event.modifiers.shift ? "seek-back-10" : "seek-back-5");
                return accept;
            }
            if event.text == Key.RightArrow {
                root.command(event.modifiers.shift ? "seek-fwd-10" : "seek-fwd-5");
                return accept;
            }
            if event.text == Key.UpArrow {
                root.command("vol-up");
                return accept;
            }
            if event.text == Key.DownArrow {
                root.command("vol-down");
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                root.command("mute");
                return accept;
            }
            if event.text == "s" || event.text == "S" {
                root.command("shuffle");
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                root.command("repeat");
                return accept;
            }
            if event.text == "n" || event.text == "N" {
                root.command("next");
                return accept;
            }
            if event.text == "p" || event.text == "P" {
                root.command("prev");
                return accept;
            }
            if event.text == "k" || event.text == "K" {
                root.command("speed");
                return accept;
            }
            if event.text == "1" {
                root.command("tab:0");
                return accept;
            }
            if event.text == "2" {
                root.command("tab:1");
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Video surface
            Rectangle {
                height: parent.height * 0.48;
                background: #111111;
                border-radius: Theme.radius-md;
                clip: true;

                if root.model.has-video : Image {
                    width: 100%;
                    height: 100%;
                    source: root.model.frame;
                    image-fit: contain;
                }

                if !root.model.has-video : VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "▶";
                        color: Theme.text-tertiary;
                        font-size: 36px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.model.has-track ? root.model.title : root.model.no-track-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                if !root.model.engine-available : Rectangle {
                    background: #000000aa;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.model.engine-missing-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Now playing + transport
            Text {
                text: root.model.has-track ? root.model.title : root.model.no-track-label;
                color: Theme.text-primary;
                font-size: Theme.font-size-md;
                font-weight: 600;
                overflow: elide;
            }

            // Progress
            TouchArea {
                height: 10px;
                width: 100%;
                clicked => {
                    if self.width > 0 {
                        root.command("seek-frac:" + (self.mouse-x / self.width));
                    }
                }
                Rectangle {
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    width: 100%;
                    background: Theme.surface-raised;
                    border-radius: 2px;
                    Rectangle {
                        height: 100%;
                        width: parent.width * root.model.progress;
                        background: Theme.accent-brand;
                        border-radius: 2px;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.model.position-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.model.duration-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                TouchArea {
                    width: 32px; height: 28px;
                    clicked => { root.command("prev"); }
                    Text { text: "|◀"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
                TouchArea {
                    width: 40px; height: 32px;
                    clicked => { root.command("play-pause"); }
                    Rectangle {
                        background: Theme.accent-brand;
                        border-radius: Theme.radius-md;
                        Text {
                            text: root.model.is-playing ? "❚❚" : "▶";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                TouchArea {
                    width: 32px; height: 28px;
                    clicked => { root.command("next"); }
                    Text { text: "▶|"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                }
                TouchArea {
                    width: 36px; height: 28px;
                    clicked => { root.command("shuffle"); }
                    Text {
                        text: "⇄";
                        color: root.model.shuffle ? Theme.accent-brand : Theme.text-tertiary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    width: 36px; height: 28px;
                    clicked => { root.command("repeat"); }
                    Text {
                        text: root.model.repeat == 2 ? "1" : "↻";
                        color: root.model.repeat > 0 ? Theme.accent-brand : Theme.text-tertiary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    width: 36px; height: 28px;
                    clicked => { root.command("mute"); }
                    Text {
                        text: root.model.muted ? "M" : "V";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.model.speed-label != "" : Text {
                    text: root.model.speed-label;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }

            // Tabs + actions
            HorizontalLayout {
                spacing: 6px;
                TouchArea {
                    height: 28px;
                    clicked => { root.command("tab:0"); }
                    Rectangle {
                        background: root.model.browse-tab == 0 ? Theme.surface-raised : transparent;
                        border-radius: Theme.radius-md;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.model.tab-library + " (" + root.model.library-count + ")";
                                color: root.model.browse-tab == 0 ? Theme.text-primary : Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                TouchArea {
                    height: 28px;
                    clicked => { root.command("tab:1"); }
                    Rectangle {
                        background: root.model.browse-tab == 1 ? Theme.surface-raised : transparent;
                        border-radius: Theme.radius-md;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.model.tab-queue + " (" + root.model.queue-count + ")";
                                color: root.model.browse-tab == 1 ? Theme.text-primary : Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                TouchArea {
                    height: 28px;
                    clicked => { root.command("open-file"); }
                    Text {
                        text: root.model.open-file-label;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    height: 28px;
                    clicked => { root.command("add-folder"); }
                    Text {
                        text: root.model.add-folder-label;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    height: 28px;
                    clicked => { root.command("rescan"); }
                    Text {
                        text: root.model.rescan-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
            }

            SearchField {
                field-height: 28px;
                query: root.model.search-query;
                placeholder: root.model.search-placeholder;
                edited(q) => { root.command("search:" + q); }
            }

            if root.model.empty-hint != "" : Text {
                text: root.model.empty-hint;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Roots chips (library tab)
            if root.model.browse-tab == 0 && root.model.has-library-roots : HorizontalLayout {
                spacing: 4px;
                height: 24px;
                for root-item[idx] in root.model.roots : TouchArea {
                    height: 24px;
                    clicked => { root.command("remove-root:" + root-item.path); }
                    Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            Text {
                                text: root-item.label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "×";
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if root.model.browse-tab == 1 && root.model.queue-count > 0 : TouchArea {
                height: 24px;
                clicked => { root.command("clear-queue"); }
                Text {
                    text: root.model.clear-queue-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }
            }

            // Item list
            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 2px;
                    for item[idx] in root.model.items : Rectangle {
                        height: 36px;
                        background: item.is-current ? Theme.surface-raised : transparent;
                        border-radius: Theme.radius-md;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 4px;
                            spacing: 6px;
                            TouchArea {
                                horizontal-stretch: 1;
                                clicked => { root.command("play:" + item.path); }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: item.title;
                                        color: item.is-current ? Theme.accent-brand : Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: item.subtitle;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        overflow: elide;
                                    }
                                }
                            }
                            if root.model.browse-tab == 0 : TouchArea {
                                width: 28px;
                                clicked => { root.command("enqueue:" + item.path); }
                                Text {
                                    text: "+";
                                    color: Theme.text-tertiary;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if root.model.browse-tab == 1 : TouchArea {
                                width: 28px;
                                clicked => { root.command("remove-queue:" + item.path); }
                                Text {
                                    text: "×";
                                    color: Theme.text-tertiary;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
