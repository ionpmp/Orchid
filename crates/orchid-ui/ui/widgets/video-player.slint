import { ListView } from "std-widgets.slint";
import { Theme } from "../theme_global.slint";
import { ButtonTone, ControlSize, IconButton, TouchButton, TouchSlider } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { VideoPlayerModel } from "../workspace/defs.slint";
import { SearchField } from "search-field.slint";

component PlayerTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();

    height: Theme.control-sm;
    min-width: tab-label.preferred-width + Theme.space-6;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-pill;
    background: root.selected ? Theme.accent-soft : (tab-hit.has-hover ? Theme.surface-base : transparent);
    border-width: Theme.hairline;
    border-color: root.selected ? Theme.accent-muted : transparent;

    animate background { duration: Theme.motion-fast; easing: ease-out; }

    tab-label := Text {
        x: Theme.space-3;
        width: parent.width - Theme.space-6;
        height: 100%;
        text: root.label;
        color: root.selected ? Theme.accent-brand : Theme.text-secondary;
        font-size: Theme.font-size-sm;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    tab-hit := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

component HeroPlay inherits Rectangle {
    in property <bool> playing;
    callback activated();

    width: Theme.control-md;
    height: Theme.control-md;
    border-radius: self.width / 2;
    background: Theme.gradient-accent;
    drop-shadow-blur: play-hit.has-hover ? Theme.elev-glow-blur : Theme.elev-1-blur;
    drop-shadow-color: Theme.accent-glow;
    accessible-role: AccessibleRole.button;

    animate drop-shadow-blur { duration: Theme.motion-fast; easing: ease-out; }

    play-hit := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.playing ? "pause" : "play";
        size: Theme.font-size-xl;
        tint: Theme.accent-contrast;
    }
}

export component VideoPlayerView inherits Rectangle {
    in property <VideoPlayerModel> model;

    callback command(string);

    background: transparent;
    clip: true;

    property <int> applied-scroll-gen: -1;
    property <string> q-drag-path: "";
    property <int> q-drag-from: -1;
    property <int> q-drop-index: -1;
    property <length> q-row-stride: Theme.row-height + Theme.space-1;
    property <bool> seeking: false;
    property <float> seek-hold: 0;
    property <bool> vol-drag: false;
    property <float> vol-hold: 0;

    function begin-seek(v: float) {
        root.seeking = true;
        root.seek-hold = v;
        root.command("seek-frac:" + v);
    }

    function begin-volume(v: float) {
        root.vol-drag = true;
        root.vol-hold = v;
        root.command("volume:" + (v * 150));
    }

    scroll-apply-timer := Timer {
        interval: 16ms;
        running: root.model.browse-tab == 1 && root.model.scroll-gen != root.applied-scroll-gen;
        triggered => {
            root.scroll-to-current();
            root.applied-scroll-gen = root.model.scroll-gen;
        }
    }

    public function scroll-to-current() {
        if root.model.current-track-index < 0 {
            return;
        }
        let y = root.q-row-stride * root.model.current-track-index;
        let margin = browse-list.visible-height / 3;
        let max-y = max(0px, browse-list.viewport-height - browse-list.visible-height);
        browse-list.viewport-y = -min(max-y, max(0px, y - margin));
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == " " {
                root.command("play-pause");
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.command(event.modifiers.shift ? "seek-back-10" : "seek-back-5");
                return accept;
            }
            if event.text == Key.RightArrow {
                root.command(event.modifiers.shift ? "seek-fwd-10" : "seek-fwd-5");
                return accept;
            }
            if event.text == Key.UpArrow {
                root.command("vol-up");
                return accept;
            }
            if event.text == Key.DownArrow {
                root.command("vol-down");
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                root.command("mute");
                return accept;
            }
            if event.text == "s" || event.text == "S" {
                root.command("shuffle");
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                root.command("repeat");
                return accept;
            }
            if event.text == "n" || event.text == "N" {
                root.command("next");
                return accept;
            }
            if event.text == "p" || event.text == "P" {
                root.command("prev");
                return accept;
            }
            if event.text == "k" || event.text == "K" {
                root.command("speed");
                return accept;
            }
            if event.text == "1" {
                root.command("tab:0");
                return accept;
            }
            if event.text == "2" {
                root.command("tab:1");
                return accept;
            }
            if event.text == Key.Home {
                root.command("queue-first");
                return accept;
            }
            if event.text == Key.End {
                root.command("queue-last");
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;

            Rectangle {
                vertical-stretch: 3;
                min-height: 120px;
                background: #111111;
                border-radius: Theme.radius-md;
                clip: true;

                if root.model.has-video : Image {
                    width: 100%;
                    height: 100%;
                    source: root.model.frame;
                    image-fit: contain;
                }

                if !root.model.has-video : VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-1;
                    Text {
                        text: "▶";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-3xl;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.model.has-track ? root.model.title : root.model.no-track-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                if !root.model.engine-available : Rectangle {
                    background: #000000aa;
                    VerticalLayout {
                        alignment: center;
                        padding: Theme.space-3;
                        Text {
                            text: root.model.engine-missing-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            Text {
                text: root.model.has-track ? root.model.title : root.model.no-track-label;
                color: Theme.text-primary;
                font-size: Theme.font-size-md;
                font-weight: Theme.weight-semibold;
                overflow: elide;
                vertical-stretch: 0;
            }

            HorizontalLayout {
                height: Theme.touch-target;
                spacing: Theme.space-2;
                vertical-stretch: 0;
                Text {
                    min-width: Theme.space-10 + Theme.space-6;
                    text: root.model.position-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    font-family: Theme.font-family-mono;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                seek-slider := TouchSlider {
                    value: root.seeking ? root.seek-hold : root.model.progress;
                    value-changed(v) => { root.begin-seek(v); }
                    changed scrubbing => {
                        if !self.scrubbing {
                            root.seeking = false;
                        }
                    }
                }
                Text {
                    min-width: Theme.space-10 + Theme.space-6;
                    text: root.model.duration-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    font-family: Theme.font-family-mono;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                height: Theme.control-md;
                alignment: center;
                spacing: Theme.space-2;
                vertical-stretch: 0;
                IconButton {
                    icon: "skip-prev";
                    size: ControlSize.md;
                    clicked => { focus-scope.focus(); root.command("prev"); }
                }
                HeroPlay {
                    playing: root.model.is-playing;
                    activated => { focus-scope.focus(); root.command("play-pause"); }
                }
                IconButton {
                    icon: "skip-next";
                    size: ControlSize.md;
                    clicked => { focus-scope.focus(); root.command("next"); }
                }
            }

            HorizontalLayout {
                height: Theme.touch-target;
                spacing: Theme.space-1;
                vertical-stretch: 0;
                IconButton {
                    icon: "shuffle";
                    size: ControlSize.sm;
                    active: root.model.shuffle;
                    clicked => { root.command("shuffle"); }
                }
                IconButton {
                    icon: root.model.repeat == 2 ? "repeat-one" : "repeat";
                    size: ControlSize.sm;
                    active: root.model.repeat > 0;
                    clicked => { root.command("repeat"); }
                }
                IconButton {
                    icon: root.model.muted ? "volume-off" : "volume";
                    size: ControlSize.sm;
                    active: root.model.muted;
                    clicked => { root.command("mute"); }
                }
                Text {
                    min-width: Theme.space-10;
                    text: root.model.volume + "%";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    font-family: Theme.font-family-mono;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                vol-slider := TouchSlider {
                    value: root.vol-drag ? root.vol-hold : min(1.0, root.model.volume / 150.0);
                    value-changed(v) => { root.begin-volume(v); }
                    changed scrubbing => {
                        if !self.scrubbing {
                            root.vol-drag = false;
                        }
                    }
                }
                TouchButton {
                    text: root.model.speed-label != "" ? root.model.speed-label : "1×";
                    active: root.model.speed-label != "";
                    size: ControlSize.xs;
                    tone: ButtonTone.ghost;
                    clicked => { root.command("speed"); }
                }
            }

            Flickable {
                height: Theme.toolbar-height;
                vertical-stretch: 0;
                viewport-height: self.height;
                viewport-width: tab-row.preferred-width;
                tab-row := HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    PlayerTab {
                        label: root.model.tab-library + " (" + root.model.library-count + ")";
                        selected: root.model.browse-tab == 0;
                        activated => { focus-scope.focus(); root.command("tab:0"); }
                    }
                    PlayerTab {
                        label: root.model.tab-queue + " (" + root.model.queue-count + ")";
                        selected: root.model.browse-tab == 1;
                        activated => { focus-scope.focus(); root.command("tab:1"); }
                    }
                    TouchButton {
                        text: root.model.open-file-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("open-file"); }
                    }
                    TouchButton {
                        icon: "plus";
                        text: root.model.add-folder-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("add-folder"); }
                    }
                    TouchButton {
                        icon: "refresh";
                        text: root.model.rescan-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("rescan"); }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-1;
                height: Theme.toolbar-height;
                vertical-stretch: 0;

                if root.model.browse-filter != "" : TouchButton {
                    icon: "chevron-left";
                    text: root.model.browse-filter-label != "" ? root.model.browse-filter-label : root.model.back-label;
                    max-width: 220px;
                    size: ControlSize.sm;
                    tone: ButtonTone.ghost;
                    clicked => { root.command("clear-filter"); }
                }

                SearchField {
                    horizontal-stretch: 1;
                    field-height: Theme.control-sm;
                    query: root.model.search-query;
                    placeholder: root.model.search-placeholder;
                    edited(q) => { root.command("search:" + q); }
                    escape-pressed => { root.command("clear-search"); }
                }

                if root.model.search-query != "" && root.model.items.length > 0 : IconButton {
                    icon: "play";
                    size: ControlSize.sm;
                    tooltip: root.model.play-group-label;
                    clicked => { root.command("play-search"); }
                }
                if root.model.search-query != "" && root.model.items.length > 0 : IconButton {
                    icon: "plus";
                    size: ControlSize.sm;
                    tooltip: root.model.enqueue-label;
                    clicked => { root.command("enqueue-search"); }
                }
            }

            if root.model.browse-tab == 1 : Flickable {
                height: Theme.toolbar-height;
                vertical-stretch: 0;
                viewport-height: self.height;
                viewport-width: queue-tools.preferred-width;
                queue-tools := HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    if root.model.queue-stats-label != "" : Text {
                        text: root.model.queue-stats-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if root.model.current-track-index >= 0 : TouchButton {
                        text: root.model.jump-to-current-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.scroll-to-current(); }
                    }
                    if root.model.items.length > 1 : TouchButton {
                        icon: "shuffle";
                        text: root.model.reshuffle-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("reshuffle"); }
                    }
                    if root.model.queue-count > 0 : TouchButton {
                        text: root.model.clear-queue-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.danger;
                        clicked => { root.command("clear-queue"); }
                    }
                }
            }

            if root.model.browse-tab == 0 && root.model.has-library-roots : Flickable {
                height: Theme.control-sm;
                vertical-stretch: 0;
                viewport-height: self.height;
                viewport-width: root-row.preferred-width;
                root-row := HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    for root-item in root.model.roots : Rectangle {
                        height: Theme.control-xs;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: Theme.radius-pill;
                        background: Theme.surface-base;
                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-1;
                            spacing: Theme.space-1;
                            alignment: center;
                            Text {
                                text: root-item.label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: "close";
                                size: ControlSize.xs;
                                tooltip: root.model.remove-root-label;
                                clicked => { root.command("remove-root:" + root-item.path); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 2;
                horizontal-stretch: 1;
                min-height: Theme.row-height * 2;
                clip: true;

                if root.model.empty-hint != "" : VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    padding: Theme.space-4;
                    Text {
                        text: root.model.empty-hint;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.model.empty-hint == "" && root.model.browse-tab == 0 && root.model.groups.length > 0 : ListView {
                    width: 100%;
                    height: 100%;
                    for g in root.model.groups : Rectangle {
                        height: root.q-row-stride;
                        Rectangle {
                            y: 0;
                            height: Theme.row-height;
                            background: g-ta.has-hover ? Theme.surface-base : transparent;
                            border-radius: Theme.radius-md;
                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-1;
                                spacing: Theme.space-2;
                                alignment: center;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    g-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { focus-scope.focus(); root.command("open-group:" + g.key); }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Theme.space-2;
                                        Text {
                                            text: g.label;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: g.count;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                IconButton {
                                    icon: "play";
                                    size: ControlSize.sm;
                                    tooltip: root.model.play-group-label;
                                    clicked => { root.command("play-group:" + g.key); }
                                }
                                IconButton {
                                    icon: "plus";
                                    size: ControlSize.sm;
                                    tooltip: root.model.enqueue-label;
                                    clicked => { root.command("enqueue-group:" + g.key); }
                                }
                            }
                        }
                    }
                }

                browse-list := ListView {
                    width: 100%;
                    height: 100%;
                    visible: root.model.empty-hint == "" && root.model.items.length > 0 && root.model.groups.length == 0;
                    for item[i] in root.model.items : track-row := Rectangle {
                        height: root.q-row-stride;
                        Rectangle {
                            y: 0;
                            height: Theme.row-height;
                            background: root.q-drag-path == item.path
                                ? Theme.surface-base
                                : (item.is-current ? Theme.accent-soft : (item-ta.has-hover ? Theme.surface-base : transparent));
                            opacity: root.q-drag-path == item.path ? 0.55 : 1.0;
                            border-radius: Theme.radius-md;

                            if root.q-drag-path != "" && root.q-drop-index == i && root.q-drag-path != item.path : Rectangle {
                                y: 0;
                                height: 2px;
                                width: 100%;
                                background: Theme.accent-brand;
                            }

                            if item.is-current : Rectangle {
                                x: Theme.space-1;
                                y: Theme.space-2;
                                width: 3px;
                                height: parent.height - Theme.space-4;
                                border-radius: 2px;
                                background: Theme.accent-brand;
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-1;
                                spacing: Theme.space-1;
                                alignment: center;

                                if root.model.browse-tab == 1 : Rectangle {
                                    width: Theme.control-xs;
                                    height: Theme.control-xs;
                                    vertical-stretch: 0;
                                    Icon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "grip";
                                        size: Theme.font-size-md;
                                        tint: Theme.text-tertiary;
                                    }
                                    TouchArea {
                                        mouse-cursor: root.q-drag-path == item.path ? MouseCursor.grabbing : MouseCursor.grab;
                                        pointer-event(e) => {
                                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                                root.q-drag-path = item.path;
                                                root.q-drag-from = i;
                                                root.q-drop-index = i;
                                            }
                                            if root.q-drag-path == item.path && e.kind == PointerEventKind.move {
                                                let content-y = track-row.y + self.absolute-position.y - track-row.absolute-position.y + self.mouse-y;
                                                let raw = content-y / root.q-row-stride;
                                                let idx = min(root.model.items.length - 1, max(0, floor(raw)));
                                                root.q-drop-index = idx;
                                            }
                                            if root.q-drag-path == item.path && e.kind == PointerEventKind.up {
                                                if root.q-drop-index >= 0 && root.q-drop-index != root.q-drag-from {
                                                    root.command("queue-move-to:" + root.q-drop-index + "|" + root.q-drag-path);
                                                }
                                                root.q-drag-path = "";
                                                root.q-drag-from = -1;
                                                root.q-drop-index = -1;
                                            }
                                            if e.kind == PointerEventKind.cancel {
                                                root.q-drag-path = "";
                                                root.q-drag-from = -1;
                                                root.q-drop-index = -1;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    item-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            focus-scope.focus();
                                            if root.model.browse-tab == 1 {
                                                root.command("queue-play:" + item.path);
                                            } else {
                                                root.command("play:" + item.path);
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: item.title;
                                            color: item.is-current ? Theme.accent-brand : Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            font-weight: item.is-current ? Theme.weight-semibold : Theme.weight-regular;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.subtitle;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            overflow: elide;
                                        }
                                    }
                                }

                                if item.duration-label != "" : Text {
                                    text: item.duration-label;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    font-family: Theme.font-family-mono;
                                    vertical-alignment: center;
                                }
                                if root.model.browse-tab == 0 : IconButton {
                                    icon: "plus";
                                    size: ControlSize.sm;
                                    tooltip: root.model.enqueue-label;
                                    clicked => { root.command("enqueue:" + item.path); }
                                }
                                if root.model.browse-tab == 0 : IconButton {
                                    icon: "skip-next";
                                    size: ControlSize.sm;
                                    tooltip: root.model.play-next-label;
                                    clicked => { root.command("play-next:" + item.path); }
                                }
                                if root.model.browse-tab == 1 : IconButton {
                                    icon: "chevron-up";
                                    size: ControlSize.xs;
                                    tooltip: root.model.move-up-label;
                                    clicked => { root.command("queue-up:" + item.path); }
                                }
                                if root.model.browse-tab == 1 : IconButton {
                                    icon: "chevron-down";
                                    size: ControlSize.xs;
                                    tooltip: root.model.move-down-label;
                                    clicked => { root.command("queue-down:" + item.path); }
                                }
                                if root.model.browse-tab == 1 : IconButton {
                                    icon: "close";
                                    size: ControlSize.xs;
                                    tooltip: root.model.remove-label;
                                    clicked => { root.command("remove-queue:" + item.path); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
