import { Theme } from "../theme_global.slint";
import {
    JyotishModel, JyotishPanchangaRow, JyotishPlanetEntry, JyotishDayChipModel,
    JyotishMonthCellModel, JyotishMonthRowModel, JyotishYearRowModel, JyotishAntarRowModel,
    JyotishProfileCalCell, JyotishRectifyModel,
} from "../workspace/defs.slint";
import { SearchField } from "search-field.slint";

component NavBtn inherits TouchArea {
    in property <string> glyph;

    width: 28px;
    height: 28px;

    Rectangle {
        background: root.has-hover ? Theme.surface-raised : transparent;
        border-radius: Theme.radius-md;
        Text {
            width: 100%; height: 100%;
            text: root.glyph;
            color: Theme.text-primary;
            font-size: Theme.font-size-md;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component PillBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> danger: false;
    callback clicked();

    height: 26px;
    width: max(32px, lbl.preferred-width + 16px);
    border-radius: Theme.radius-md;
    background: root.active ? Theme.accent-brand :
        root.danger ? #e35d6a :
        ta.has-hover ? Theme.surface-raised : Theme.surface-base;
    border-width: root.active || root.danger ? 0 : 1px;
    border-color: Theme.border-default;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    lbl := Text {
        width: 100%; height: 100%;
        text: root.label;
        color: (root.active || root.danger) ? Theme.surface-base : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-weight: Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }
}

/// Compact ± stepper row for birth time / UTC offset.
component ProfileStepper inherits HorizontalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <string> empty-text;
    in property <int> small-step: 1;
    in property <int> large-step: 30;
    callback nudge(int);

    spacing: 4px;
    alignment: center;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-size-sm;
        vertical-alignment: center;
        min-width: 52px;
    }
    PillBtn {
        label: "«";
        clicked => { root.nudge(-root.large-step); }
    }
    PillBtn {
        label: "−";
        clicked => { root.nudge(-root.small-step); }
    }
    Text {
        text: root.value-text == "" ? root.empty-text : root.value-text;
        color: root.value-text == "" ? Theme.text-tertiary : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-family: Theme.font-family-mono;
        vertical-alignment: center;
        horizontal-alignment: center;
        min-width: 88px;
        horizontal-stretch: 1;
        wrap: no-wrap;
        overflow: elide;
    }
    PillBtn {
        label: "+";
        clicked => { root.nudge(root.small-step); }
    }
    PillBtn {
        label: "»";
        clicked => { root.nudge(root.large-step); }
    }
}

/// Birth-date picker: day grid, or month / twelve-year jump sheets.
component ProfileDateCal inherits VerticalLayout {
    in property <string> label;
    in property <string> selected-text;
    in property <string> empty-text;
    in property <int> mode;
    in property <string> month-title;
    in property <string> year-title;
    in property <[string]> weekday-headers;
    in property <[JyotishProfileCalCell]> cells;
    callback nav(int);
    callback set-mode(int);
    callback pick(int);

    spacing: 6px;
    property <int> cols: root.mode == 0 ? 7 : 3;
    property <length> cell-h: root.mode == 0 ? 26px : 32px;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-size-sm;
    }

    Text {
        text: root.selected-text == "" ? root.empty-text : root.selected-text;
        color: root.selected-text == "" ? Theme.text-tertiary : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-family: Theme.font-family-mono;
    }

    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        PillBtn { label: "◀"; clicked => { root.nav(-1); } }
        if root.mode == 0 : PillBtn {
            label: root.month-title;
            clicked => { root.set-mode(1); }
        }
        PillBtn {
            label: root.year-title;
            clicked => { root.set-mode(root.mode == 2 ? 0 : 2); }
        }
        PillBtn { label: "▶"; clicked => { root.nav(1); } }
    }

    if root.mode == 0 : HorizontalLayout {
        spacing: 2px;
        height: 16px;
        for wd[i] in root.weekday-headers : Text {
            horizontal-stretch: 1;
            text: wd;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
        }
    }

    GridLayout {
        spacing: 2px;
        for cell[j] in root.cells : Rectangle {
            row: j / root.cols;
            col: mod(j, root.cols);
            height: root.cell-h;
            border-radius: Theme.radius-md;
            background: cell.is-selected ? Theme.accent-brand :
                (cal-cell-ta.has-hover ? Theme.surface-raised : transparent);
            border-width: !cell.is-selected && cell.is-today ? 1px : 0;
            border-color: Theme.border-default;
            cal-cell-ta := TouchArea {
                clicked => { root.pick(root.mode == 0 ? j : cell.value); }
            }
            Text {
                width: 100%; height: 100%;
                text: cell.label;
                color: cell.is-selected ? Theme.surface-base :
                    (cell.is-outside ? Theme.text-tertiary : Theme.text-primary);
                font-size: Theme.font-size-sm;
                font-weight: cell.is-selected || cell.is-today ? Theme.weight-semibold : Theme.weight-regular;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component TimeWheel inherits Rectangle {
    in property <string> label;
    in property <[string]> items;
    in property <int> selected;
    callback pick(int);

    background: Theme.surface-base;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;
    horizontal-stretch: 1;

    VerticalLayout {
        padding-top: 4px;
        spacing: 2px;

        Text {
            text: root.label;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
        }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: wheel.preferred-height;

            wheel := VerticalLayout {
                spacing: 1px;
                for item[i] in root.items : Rectangle {
                    height: 26px;
                    background: root.selected == i ? Theme.accent-brand :
                        (wheel-ta.has-hover ? Theme.surface-raised : transparent);
                    border-radius: Theme.radius-md;
                    wheel-ta := TouchArea {
                        clicked => { root.pick(i); }
                    }
                    Text {
                        width: 100%; height: 100%;
                        text: item;
                        color: root.selected == i ? Theme.surface-base : Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        font-family: Theme.font-family-mono;
                        font-weight: root.selected == i ? Theme.weight-semibold : Theme.weight-regular;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

/// Side-by-side hour (0–23) and minute (0–59) wheels.
component ProfileTimeSelect inherits VerticalLayout {
    in property <string> label;
    in property <string> selected-text;
    in property <string> empty-text;
    in property <string> hour-label;
    in property <string> minute-label;
    in property <[string]> hour-items;
    in property <[string]> minute-items;
    in property <int> hour;
    in property <int> minute;
    callback set-time(int, int);

    spacing: 6px;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-size-sm;
    }

    Text {
        text: root.selected-text == "" ? root.empty-text : root.selected-text;
        color: root.selected-text == "" ? Theme.text-tertiary : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-family: Theme.font-family-mono;
    }

    HorizontalLayout {
        spacing: 6px;
        height: 148px;

        TimeWheel {
            label: root.hour-label;
            items: root.hour-items;
            selected: root.hour;
            pick(h) => { root.set-time(h, root.minute < 0 ? 0 : root.minute); }
        }
        TimeWheel {
            label: root.minute-label;
            items: root.minute-items;
            selected: root.minute;
            pick(m) => { root.set-time(root.hour < 0 ? 12 : root.hour, m); }
        }
    }
}

component LinkBtn inherits TouchArea {
    in property <string> label;

    height: 22px;
    width: lbl.preferred-width + 16px;

    Rectangle {
        background: root.has-hover ? Theme.surface-raised : transparent;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-default;
        lbl := Text {
            width: 100%; height: 100%;
            text: root.label;
            color: Theme.accent-brand;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ColorDot inherits Rectangle {
    in property <int> color-code;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.color-code == 0 ? #34c759 : root.color-code == 1 ? #ffcc00 : #ff3b30;
}

component ScoreBar inherits Rectangle {
    in property <int> green;
    in property <int> yellow;
    in property <int> red;

    height: 6px;
    border-radius: 3px;
    clip: true;
    background: Theme.surface-raised;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        Rectangle { background: #34c759; horizontal-stretch: root.green + 0.0; }
        Rectangle { background: #ffcc00; horizontal-stretch: root.yellow + 0.0; }
        Rectangle { background: #ff3b30; horizontal-stretch: root.red + 0.0; }
    }
}

export component JyotishView inherits Rectangle {
    in property <JyotishModel> model;

    callback prev-day();
    callback next-day();
    callback go-today();
    callback select-tab(int);
    callback select-offset(int);
    callback month-nav(int);
    callback year-nav(int);
    callback open-month(int);
    callback open-year(int);
    callback select-life-year(int);
    callback rectify-start();
    callback rectify-set-window(int, int);
    callback rectify-answer(int, int);
    callback rectify-add-event(int, int);
    callback rectify-remove-event(int);
    callback rectify-next();
    callback rectify-back();
    callback rectify-refine();
    callback rectify-accept();
    callback rectify-cancel();
    callback export-day();
    callback export-week();
    callback open-cities();
    callback close-cities();
    callback select-city(int);
    callback remove-city(int);
    callback search-cities(string);
    callback add-city(string, float, float);
    callback open-profiles();
    callback close-profiles();
    callback select-profile(int);
    callback remove-profile(int);
    callback begin-add-profile();
    callback begin-edit-profile(int);
    callback cancel-edit-profile();
    callback set-profile-gender(int);
    callback search-birth-places(string);
    callback set-birth-place(string, float, float, string);
    callback nav-profile-cal(int);
    callback set-profile-cal-mode(int);
    callback set-profile-cal-day(int);
    callback set-profile-time(int, int);
    callback nudge-profile-offset(int);
    callback upsert-profile(int, string, int, string, string, int, string, float, float);

    property <int> draft-event-kind: 0;
    property <int> draft-event-year: 2000;
    property <string> draft-profile-name;

    background: transparent;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Tab bar
        HorizontalLayout {
            spacing: 4px;
            for tab-label[i] in model.tab-labels : PillBtn {
                label: tab-label;
                active: model.active-tab == i;
                horizontal-stretch: 1;
                clicked => { root.select-tab(i); }
            }
        }

        if model.active-tab == 0 : Flickable {
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-height: day-col.preferred-height;

            day-col := VerticalLayout {
                width: parent.width;
                spacing: 10px;

                // Date navigation
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    NavBtn {
                        glyph: "<";
                        clicked => { root.prev-day(); }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: model.date-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            font-weight: Theme.weight-semibold;
                            horizontal-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }

                        location-ta := TouchArea {
                            clicked => { root.open-cities(); }

                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                width: 100%;

                                Text {
                                    text: model.current-locating ? model.current-locating-label
                                        : (model.current-failed && model.location-name == "" ? model.current-failed-label
                                            : (model.location-name == ""
                                                ? (model.active-city-index == 0 ? model.current-location-label : model.empty-location)
                                                : model.location-name));
                                    color: model.location-name == "" && !model.current-locating ? Theme.text-tertiary : Theme.text-secondary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                Text {
                                    text: ">";
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    NavBtn {
                        glyph: ">";
                        clicked => { root.next-day(); }
                    }
                }

                if model.cities.length > 0 : Flickable {
                    height: 28px;
                    viewport-height: self.height;
                    viewport-width: city-row.preferred-width.max(self.width);
                    interactive: true;

                    city-row := HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        for city[i] in model.cities : Rectangle {
                            height: 24px;
                            width: max(48px, city-label.preferred-width + 16px);
                            background: city.active ? Theme.accent-brand : Theme.surface-base;
                            border-radius: Theme.radius-md;

                            city-ta := TouchArea {
                                clicked => { root.select-city(i); }
                            }

                            city-label := Text {
                                text: city.is-current
                                    ? (model.current-locating ? model.current-locating-label
                                        : (model.current-failed ? model.current-failed-label
                                            : (city.name != "" ? city.name : model.current-location-label)))
                                    : city.name;
                                color: city.active ? Theme.surface-base : Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }

                Flickable {
                    height: 28px;
                    viewport-height: self.height;
                    viewport-width: profile-row.preferred-width.max(self.width);
                    interactive: true;

                    profile-row := HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        for profile[i] in model.profiles : Rectangle {
                            height: 24px;
                            width: max(48px, profile-label.preferred-width + 16px);
                            background: profile.active ? Theme.accent-brand : Theme.surface-base;
                            border-radius: Theme.radius-md;

                            profile-ta := TouchArea {
                                clicked => { root.select-profile(i); }
                            }

                            profile-label := Text {
                                text: profile.name;
                                color: profile.active ? Theme.surface-base : Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            height: 24px;
                            width: max(48px, profile-add-label.preferred-width + 16px);
                            background: profile-add-ta.has-hover ? Theme.surface-raised : Theme.surface-base;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-default;

                            profile-add-ta := TouchArea {
                                clicked => { root.open-profiles(); }
                            }
                            profile-add-label := Text {
                                text: model.profiles.length == 0 ? model.profiles-empty-label : model.profiles-add-label;
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }

                if !model.is-today : today-btn := TouchArea {
                    height: 22px;
                    clicked => { root.go-today(); }
                    Rectangle {
                        background: today-btn.has-hover ? Theme.surface-raised : transparent;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        Text {
                            width: 100%; height: 100%;
                            text: model.today-label;
                            color: Theme.accent-brand;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if model.is-loading : Text {
                    text: model.loading-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }

                if !model.is-loading : HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    ColorDot { color-code: model.score-color; y: (parent.height - self.height) / 2; }
                    Text {
                        text: model.score-label + " " + model.score-value;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    Text {
                        text: model.personal-badge;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }

                if !model.is-loading : HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    ColorDot { color-code: model.score-color; y: (parent.height - self.height) / 2; }
                    Text {
                        text: model.headline;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-medium;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }

                if !model.is-loading && model.summary != "" : Text {
                    text: model.summary;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                if !model.is-loading : HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        ColorDot { color-code: model.now-score-color; y: (parent.height - self.height) / 2; }
                        Text {
                            text: model.score-now-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        ColorDot { color-code: model.day-score-color; y: (parent.height - self.height) / 2; }
                        Text {
                            text: model.score-day-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }
                }

                if !model.is-loading && model.factors.length > 0 : VerticalLayout {
                    spacing: 2px;
                    for f[i] in model.factors : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: f.delta-text;
                            color: f.valence == 0 ? #34c759 : (f.valence == 1 ? #ff3b30 : Theme.text-tertiary);
                            font-size: Theme.font-size-sm;
                            font-weight: Theme.weight-medium;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: f.label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                if !model.is-loading && model.influences.length > 0 : VerticalLayout {
                    spacing: 2px;
                    for line[i] in model.influences : Text {
                        text: "· " + line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                if !model.is-loading && model.advice.length > 0 : VerticalLayout {
                    spacing: 2px;
                    for line[i] in model.advice : Text {
                        text: line;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }


                if !model.is-loading && model.has-dasha-now : VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: model.dasha-now-title;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-medium;
                    }
                    Text {
                        text: model.dasha-maha-label + ": " + model.dasha-maha-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                    Text {
                        text: model.dasha-antar-label + ": " + model.dasha-antar-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                    Text {
                        text: model.dasha-pratyantar-label + ": " + model.dasha-pratyantar-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                // 7-day strip
                if !model.is-loading && model.week-strip.length > 0 : HorizontalLayout {
                    spacing: 4px;
                    for chip[i] in model.week-strip : Rectangle {
                        height: 52px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-md;
                        background: chip.is-selected ? Theme.accent-brand : (chip-ta.has-hover ? Theme.surface-raised : transparent);

                        chip-ta := TouchArea {
                            clicked => { root.select-offset(chip.offset); }
                        }

                        VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: chip.weekday;
                                color: chip.is-selected ? Theme.surface-base : Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: chip.day-num;
                                color: chip.is-selected ? Theme.surface-base : Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                font-weight: Theme.weight-medium;
                                horizontal-alignment: center;
                            }
                            ColorDot {
                                color-code: chip.color;
                                x: (parent.width - self.width) / 2;
                            }
                        }
                    }
                }

                if !model.is-loading : Rectangle {
                    height: 1px;
                    background: Theme.border-default;
                    horizontal-stretch: 1;
                }

                // Panchanga rows
                if !model.is-loading : VerticalLayout {
                    spacing: 0px;
                    for entry[i] in model.panchanga : Rectangle {
                        height: 22px;

                        row-ta := TouchArea { }
                        if row-ta.has-hover && (entry.label != "" || entry.value != "") : Rectangle {
                            x: parent.x;
                            y: parent.height + 2px;
                            width: row-hint.preferred-width + 12px;
                            height: row-hint.preferred-height + 6px;
                            background: Theme.surface-raised;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: Theme.border-default;
                            z: 100;
                            row-hint := Text {
                                x: 6px; y: 3px;
                                text: entry.label + ": " + entry.value;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;
                            width: 100%;
                            height: 100%;

                            Text {
                                text: entry.label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: entry.value;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Sun times
                if !model.is-loading && (model.sunrise-text != "" || model.sunset-text != "") : HorizontalLayout {
                    spacing: 12px;
                    alignment: space-around;

                    if model.sunrise-text != "" : Text {
                        text: model.sunrise-label + " " + model.sunrise-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    if model.sunset-text != "" : Text {
                        text: model.sunset-label + " " + model.sunset-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }

                // Inauspicious daylight windows
                if !model.is-loading && model.rahukalam-text != "" : VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: model.rahukalam-label + " " + model.rahukalam-text;
                        color: model.in-rahukalam ? #ff3b30 : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        font-weight: model.in-rahukalam ? Theme.weight-semibold : Theme.weight-medium;
                        wrap: word-wrap;
                    }
                    if model.yamagandam-text != "" : Text {
                        text: model.yamagandam-label + " " + model.yamagandam-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                    if model.gulika-text != "" : Text {
                        text: model.gulika-label + " " + model.gulika-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                if !model.is-loading && model.disclaimer != "" : Text {
                    text: model.disclaimer;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                if !model.is-loading : HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    LinkBtn {
                        label: model.export-day-label;
                        clicked => { root.export-day(); }
                    }
                    LinkBtn {
                        label: model.export-week-label;
                        clicked => { root.export-week(); }
                    }
                }

                // Graha table
                if !model.is-loading && model.show-planets && model.planets.length > 0 : VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: model.planets-title;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-semibold;
                    }

                    for planet[i] in model.planets : Rectangle {
                        height: 20px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            width: 100%;
                            height: 100%;

                            Text {
                                text: planet.graha;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: planet.rashi;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: planet.degree-text + (planet.is-retrograde ? " R" : "");
                                color: planet.is-retrograde ? Theme.accent-brand : Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                wrap: no-wrap;
                                overflow: elide;
                                min-width: 56px;
                            }
                        }
                    }
                }

                if !model.is-loading : Text {
                    text: model.ayanamsa-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        if model.active-tab == 1 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                NavBtn {
                    glyph: "◀";
                    clicked => { root.month-nav(-1); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: model.month-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-md;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                NavBtn {
                    glyph: "▶";
                    clicked => { root.month-nav(1); }
                }
            }

            HorizontalLayout {
                spacing: 2px;
                height: 18px;
                for wd[i] in model.weekday-headers : Text {
                    horizontal-stretch: 1;
                    text: wd;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-medium;
                    horizontal-alignment: center;
                }
            }

            GridLayout {
                spacing: 2px;
                vertical-stretch: 1;

                for pad in model.month-first-weekday : Rectangle {
                    row: pad / 7;
                    col: mod(pad, 7);
                }

                for cell[j] in model.month-cells : Rectangle {
                    row: (j + model.month-first-weekday) / 7;
                    col: mod(j + model.month-first-weekday, 7);
                    height: 30px;
                    border-radius: Theme.radius-md;
                    background: cell.is-selected ? Theme.surface-raised : (cell-ta.has-hover ? Theme.surface-raised : transparent);
                    border-width: cell.is-selected || cell.is-today ? 1px : 0;
                    border-color: cell.is-selected ? Theme.accent-brand : Theme.border-default;

                    cell-ta := TouchArea {
                        clicked => { root.select-offset(cell.offset); }
                    }
                    if cell-ta.has-hover : Rectangle {
                        y: parent.height + 2px;
                        x: 0;
                        width: tip.preferred-width + 10px;
                        height: tip.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 50;
                        tip := Text {
                            x: 5px; y: 3px;
                            text: cell.color == 0 ? model.legend-green : (cell.color == 1 ? model.legend-yellow : model.legend-red);
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: cell.day;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                        }
                        ColorDot {
                            color-code: cell.color;
                            x: (parent.width - self.width) / 2;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    ColorDot { color-code: 0; y: (parent.height - self.height) / 2; }
                    Text { text: model.legend-green; color: Theme.text-tertiary; font-size: Theme.font-size-sm; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    ColorDot { color-code: 1; y: (parent.height - self.height) / 2; }
                    Text { text: model.legend-yellow; color: Theme.text-tertiary; font-size: Theme.font-size-sm; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    ColorDot { color-code: 2; y: (parent.height - self.height) / 2; }
                    Text { text: model.legend-red; color: Theme.text-tertiary; font-size: Theme.font-size-sm; vertical-alignment: center; }
                }
            }
        }

            Text {
                text: model.month-selected-hint;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

        if model.active-tab == 2 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                NavBtn {
                    glyph: "◀";
                    clicked => { root.year-nav(-1); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: model.year-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-md;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                NavBtn {
                    glyph: "▶";
                    clicked => { root.year-nav(1); }
                }
            }


            if model.gochara-note != "" : Text {
                text: model.gochara-note;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-width: parent.width;
                viewport-height: year-col.preferred-height;

                year-col := VerticalLayout {
                    width: parent.width;
                    spacing: 4px;
                    for row[i] in model.year-months : Rectangle {
                        height: 34px;
                        border-radius: Theme.radius-md;
                        background: month-ta.has-hover ? Theme.surface-raised : transparent;

                        month-ta := TouchArea {
                            clicked => { root.open-month(row.month-offset); }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: row.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                min-width: 72px;
                                vertical-alignment: center;
                            }
                            ScoreBar {
                                horizontal-stretch: 1;
                                y: (parent.height - self.height) / 2;
                                green: row.green;
                                yellow: row.yellow;
                                red: row.red;
                            }
                        }
                    }
                }
            }
        }

        if model.active-tab == 3 : Flickable {
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-height: life-col.preferred-height;

            life-col := VerticalLayout {
                width: parent.width;
                spacing: 8px;

                if !model.has-birth-data : VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: model.birth-prompt;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    PillBtn {
                        label: model.profiles-add-label;
                        clicked => { root.open-profiles(); }
                    }
                }

                if model.has-birth-data : VerticalLayout {
                    spacing: 4px;
                    if model.gochara-note != "" : Text {
                        text: model.gochara-note;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    for row[i] in model.life-years : VerticalLayout {
                        spacing: 2px;
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-md;
                            background: row.is-selected ? Theme.surface-raised : (year-ta.has-hover ? Theme.surface-raised : transparent);
                            border-width: row.is-current ? 1px : 0px;
                            border-color: Theme.accent-brand;

                            year-ta := TouchArea {
                                clicked => { root.select-life-year(row.year); }
                            }

                            VerticalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                padding-top: 3px;
                                padding-bottom: 3px;
                                spacing: 3px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: space-between;
                                    Text {
                                        text: row.year;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        font-weight: Theme.weight-medium;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.dasha;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                                ScoreBar {
                                    green: row.green;
                                    yellow: row.yellow;
                                    red: row.red;
                                }
                            }
                        }
                        if row.is-selected && model.life-antars.length > 0 : VerticalLayout {
                            spacing: 2px;
                            padding-left: 10px;
                            Text {
                                text: model.life-antars-title;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                font-weight: Theme.weight-medium;
                            }
                            for antar[j] in model.life-antars : Rectangle {
                                height: 28px;
                                border-radius: Theme.radius-md;
                                background: antar.is-current ? Theme.accent-brand : transparent;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    alignment: space-between;
                                    Text {
                                        text: antar.lord;
                                        color: antar.is-current ? Theme.surface-base : Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: antar.range;
                                        color: antar.is-current ? Theme.surface-base : Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                PillBtn {
                    label: model.rectify-button-label;
                    clicked => { root.rectify-start(); }
                }
            }
        }
    }

    // Location picker overlay
    if model.picker-open : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000088;
        z: 50;

        TouchArea {
            clicked => { root.close-cities(); }
        }

        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            background: Theme.surface-raised;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-default;

            // Eat backdrop clicks so the panel stays open while interacting.
            TouchArea { }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: model.picker-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: max(56px, close-label.preferred-width + 16px);
                        height: 28px;
                        background: close-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                        border-radius: Theme.radius-md;

                        close-ta := TouchArea {
                            clicked => { root.close-cities(); }
                        }
                        close-label := Text {
                            text: model.close-picker-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if model.cities-hint != "" : Text {
                    text: model.cities-hint;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                SearchField {
                    query: model.search-query;
                    placeholder: model.search-placeholder;
                    edited(q) => { root.search-cities(q); }
                    escape-pressed => { root.close-cities(); }
                }

                if model.cities.length > 0 : Flickable {
                    height: min(96px, cities-list.preferred-height);
                    viewport-width: self.width;
                    viewport-height: cities-list.preferred-height;
                    interactive: true;

                    cities-list := VerticalLayout {
                        spacing: 4px;

                        for city[i] in model.cities : Rectangle {
                            height: 32px;
                            background: city.active ? Theme.accent-brand : (saved-ta.has-hover ? Theme.surface-base : transparent);
                            border-radius: Theme.radius-md;

                            saved-ta := TouchArea {
                                clicked => { root.select-city(i); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 4px;
                                spacing: 4px;

                                Text {
                                    text: city.is-current
                                        ? (model.current-locating ? model.current-locating-label
                                            : (model.current-failed ? model.current-failed-label
                                                : (city.name != "" ? city.name : model.current-location-label)))
                                        : city.name;
                                    color: city.active ? Theme.surface-base : Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                if !city.is-current && model.cities.length > 2 : Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    y: 2px;
                                    background: remove-ta.has-hover ? Theme.surface-raised : transparent;
                                    border-radius: Theme.radius-md;

                                    remove-ta := TouchArea {
                                        clicked => { root.remove-city(i); }
                                    }
                                    if remove-ta.has-hover : Rectangle {
                                        x: parent.x - remove-hint.preferred-width;
                                        y: parent.height + 2px;
                                        width: remove-hint.preferred-width + 12px;
                                        height: remove-hint.preferred-height + 6px;
                                        background: Theme.surface-raised;
                                        border-radius: Theme.radius-md;
                                        border-width: 1px;
                                        border-color: Theme.border-default;
                                        z: 100;
                                        remove-hint := Text {
                                            x: 6px; y: 3px;
                                            text: model.remove-city-hint;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-size-sm;
                                        }
                                    }
                                    Text {
                                        text: "x";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-default;
                    horizontal-stretch: 1;
                }

                if model.search-busy : Text {
                    text: model.searching-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }

                if !model.search-busy && model.search-query != "" && model.search-results.length == 0 : Text {
                    text: model.no-results-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: results-list.preferred-height.max(self.height);
                    interactive: true;

                    results-list := VerticalLayout {
                        spacing: 4px;

                        for hit[i] in model.search-results : Rectangle {
                            height: 48px;
                            background: hit-ta.has-hover ? Theme.surface-base : transparent;
                            border-radius: Theme.radius-md;

                            hit-ta := TouchArea {
                                clicked => {
                                    root.add-city(hit.name, hit.latitude, hit.longitude);
                                }
                            }
                            if hit-ta.has-hover : Rectangle {
                                x: parent.x + 8px;
                                y: parent.height - 2px;
                                width: add-hint.preferred-width + 12px;
                                height: add-hint.preferred-height + 6px;
                                background: Theme.surface-raised;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-default;
                                z: 100;
                                add-hint := Text {
                                    x: 6px; y: 3px;
                                    text: model.add-city-hint;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-size-sm;
                                }
                            }

                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 2px;

                                Text {
                                    text: hit.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                                if hit.detail != "" : Text {
                                    text: hit.detail;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Birth-profile picker overlay
    if model.profile-picker-open : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000088;
        z: 60;

        TouchArea {
            clicked => { root.close-profiles(); }
        }

        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            background: Theme.surface-raised;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-default;

            TouchArea { }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: model.profiles-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: max(56px, profile-close-label.preferred-width + 16px);
                        height: 28px;
                        background: profile-close-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                        border-radius: Theme.radius-md;

                        profile-close-ta := TouchArea {
                            clicked => { root.close-profiles(); }
                        }
                        profile-close-label := Text {
                            text: model.profiles-close-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if model.profiles-hint != "" : Text {
                    text: model.profiles-hint;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                if !model.profile-editing : VerticalLayout {
                    spacing: 4px;
                    vertical-stretch: 1;

                    Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: profiles-list.preferred-height.max(self.height);

                        profiles-list := VerticalLayout {
                            spacing: 4px;

                            for profile[i] in model.profiles : Rectangle {
                                height: 36px;
                                background: profile.active ? Theme.accent-brand : (profile-row-ta.has-hover ? Theme.surface-base : transparent);
                                border-radius: Theme.radius-md;

                                profile-row-ta := TouchArea {
                                    clicked => { root.select-profile(i); }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    spacing: 4px;

                                    Text {
                                        text: profile.name;
                                        color: profile.active ? Theme.surface-base : Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }

                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        y: 4px;
                                        background: edit-ta.has-hover ? Theme.surface-raised : transparent;
                                        border-radius: Theme.radius-md;
                                        edit-ta := TouchArea {
                                            clicked => {
                                                root.draft-profile-name = profile.name;
                                                root.begin-edit-profile(i);
                                            }
                                        }
                                        Text {
                                            text: "...";
                                            color: profile.active ? Theme.surface-base : Theme.text-secondary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if model.profiles.length > 0 : Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        y: 4px;
                                        background: rem-ta.has-hover ? Theme.surface-raised : transparent;
                                        border-radius: Theme.radius-md;
                                        rem-ta := TouchArea {
                                            clicked => { root.remove-profile(i); }
                                        }
                                        Text {
                                            text: "x";
                                            color: profile.active ? Theme.surface-base : Theme.text-secondary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    PillBtn {
                        label: model.profiles-add-label;
                        clicked => {
                            root.draft-profile-name = "";
                            root.begin-add-profile();
                        }
                    }
                }

                if model.profile-editing : Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: profile-edit-form.preferred-height;

                    profile-edit-form := VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: model.profile-edit-index < 0 ? model.profiles-add-label : model.profiles-edit-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-medium;
                    }

                    Rectangle {
                        height: 32px;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        name-input := TextInput {
                            x: 8px;
                            y: 0px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: root.draft-profile-name == "" && model.profile-edit-name != "" ? model.profile-edit-name : root.draft-profile-name;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.draft-profile-name = self.text; }
                        }
                        if name-input.text == "" : Text {
                            x: 8px;
                            y: 0px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: model.profile-name-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        for g-label[gi] in model.gender-labels : PillBtn {
                            label: g-label;
                            active: model.profile-edit-gender == gi;
                            horizontal-stretch: 1;
                            clicked => { root.set-profile-gender(gi); }
                        }
                    }

                    ProfileDateCal {
                        label: model.profile-date-label;
                        selected-text: model.profile-edit-date;
                        empty-text: model.profile-date-placeholder;
                        mode: model.profile-cal-mode;
                        month-title: model.profile-cal-month-title;
                        year-title: model.profile-cal-year-title;
                        weekday-headers: model.weekday-headers;
                        cells: model.profile-cal-cells;
                        nav(d) => { root.nav-profile-cal(d); }
                        set-mode(m) => { root.set-profile-cal-mode(m); }
                        pick(v) => { root.set-profile-cal-day(v); }
                    }

                    ProfileTimeSelect {
                        label: model.profile-time-label;
                        selected-text: model.profile-edit-time;
                        empty-text: model.profile-time-placeholder;
                        hour-label: model.profile-hour-label;
                        minute-label: model.profile-minute-label;
                        hour-items: model.profile-hour-items;
                        minute-items: model.profile-minute-items;
                        hour: model.profile-edit-hour;
                        minute: model.profile-edit-minute;
                        set-time(h, m) => { root.set-profile-time(h, m); }
                    }

                    ProfileStepper {
                        label: model.profile-offset-label;
                        value-text: model.profile-edit-offset-text;
                        empty-text: model.profile-offset-placeholder;
                        small-step: 30;
                        large-step: 60;
                        nudge(d) => { root.nudge-profile-offset(d); }
                    }

                    Rectangle {
                        height: model.profile-edit-place-coords == "" ? 28px : 42px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: model.profile-place-placeholder;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: model.profile-edit-place-name == "" ? "-" : model.profile-edit-place-name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    font-weight: Theme.weight-medium;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                            if model.profile-edit-place-coords != "" : Text {
                                text: model.profile-edit-place-coords;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                font-family: Theme.font-family-mono;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }

                    SearchField {
                        query: model.profile-search-query;
                        placeholder: model.profile-place-search-placeholder;
                        edited(q) => { root.search-birth-places(q); }
                    }

                    if model.profile-search-busy : Text {
                        text: model.searching-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                    }

                    if !model.profile-search-busy && model.profile-search-query != "" && model.profile-search-results.length == 0 : Text {
                        text: model.no-results-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                    }

                    Flickable {
                        height: min(120px, place-results.preferred-height);
                        viewport-width: self.width;
                        viewport-height: place-results.preferred-height;
                        interactive: true;

                        place-results := VerticalLayout {
                            spacing: 4px;
                            for hit[hi] in model.profile-search-results : Rectangle {
                                height: 40px;
                                background: place-hit-ta.has-hover ? Theme.surface-base : transparent;
                                border-radius: Theme.radius-md;
                                place-hit-ta := TouchArea {
                                    clicked => {
                                        root.set-birth-place(hit.name, hit.latitude, hit.longitude, hit.timezone);
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 2px;
                                    Text {
                                        text: hit.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                    if hit.detail != "" : Text {
                                        text: hit.detail;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        PillBtn {
                            label: model.profiles-cancel-label;
                            clicked => { root.cancel-edit-profile(); }
                        }
                        PillBtn {
                            label: model.profiles-save-label;
                            active: true;
                            clicked => {
                                root.upsert-profile(
                                    model.profile-edit-index,
                                    name-input.text == "" ? model.profile-edit-name : name-input.text,
                                    model.profile-edit-gender,
                                    model.profile-edit-date,
                                    model.profile-edit-time,
                                    model.profile-edit-offset,
                                    "",
                                    0,
                                    0
                                );
                                root.draft-profile-name = "";
                            }
                        }
                    }
                }
                }
            }
        }
    }

    // Rectification wizard overlay
    if model.rectify.step > 0 : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000088;
        z: 200;

        TouchArea { }

        Rectangle {
            x: 8px; y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            background: Theme.surface-base;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-default;

            TouchArea { }

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;
                    Text {
                        text: model.rectify.title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-semibold;
                        horizontal-stretch: 1;
                    }
                    if model.rectify.can-go-back : PillBtn {
                        label: model.rectify.back-label;
                        clicked => { root.rectify-back(); }
                    }
                    PillBtn {
                        label: model.rectify.cancel-label;
                        clicked => { root.rectify-cancel(); }
                    }
                }

                if model.rectify.progress-text != "" : Text {
                    text: model.rectify.progress-text + " · " + model.rectify.step-title;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }

                // Step 1: uncertainty window
                if model.rectify.step == 1 : VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;
                    alignment: center;

                    if model.rectify.window-labels.length > 0 : PillBtn {
                        label: model.rectify.window-labels[0];
                        clicked => { root.rectify-set-window(720, 30); }
                    }
                    if model.rectify.window-labels.length > 1 : PillBtn {
                        label: model.rectify.window-labels[1];
                        clicked => { root.rectify-set-window(720, 120); }
                    }
                    if model.rectify.window-labels.length > 2 : PillBtn {
                        label: model.rectify.window-labels[2];
                        clicked => { root.rectify-set-window(720, 360); }
                    }
                    if model.rectify.window-labels.length > 3 : PillBtn {
                        label: model.rectify.window-labels[3];
                        clicked => { root.rectify-set-window(-1, -1); }
                    }
                }

                // Step 2: quiz
                if model.rectify.step == 2 : VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    Text {
                        text: "" + (model.rectify.question-idx + 1) + " / " + model.rectify.question-total;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: model.rectify.question;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-medium;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        for opt[oi] in model.rectify.options : PillBtn {
                            label: opt;
                            clicked => { root.rectify-answer(model.rectify.question-idx, oi); }
                        }
                    }
                }

                // Step 3: life events
                if model.rectify.step == 3 : VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    if model.rectify.events.length > 0 : VerticalLayout {
                        spacing: 2px;
                        for ev[ei] in model.rectify.events : HorizontalLayout {
                            spacing: 6px;
                            alignment: space-between;
                            Text {
                                text: ev;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            PillBtn {
                                label: "x";
                                danger: true;
                                clicked => { root.rectify-remove-event(ei); }
                            }
                        }
                    }


                    if model.rectify.error-text != "" : Text {
                        text: model.rectify.error-text;
                        color: #ff3b30;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-default;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        for kind[ki] in model.rectify.event-kinds : PillBtn {
                            label: kind;
                            active: root.draft-event-kind == ki;
                            clicked => { root.draft-event-kind = ki; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        PillBtn {
                            label: "−";
                            clicked => { root.draft-event-year = max(model.rectify.event-year-min, root.draft-event-year - 1); }
                        }
                        Text {
                            text: model.rectify.year-placeholder + ": " + root.draft-event-year;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                        PillBtn {
                            label: "+";
                            clicked => { root.draft-event-year = min(model.rectify.event-year-max, root.draft-event-year + 1); }
                        }
                        PillBtn {
                            label: model.rectify.add-event-label;
                            clicked => { root.rectify-add-event(root.draft-event-kind, root.draft-event-year); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    PillBtn {
                        label: model.rectify.next-label;
                        active: true;
                        clicked => { root.rectify-next(); }
                    }
                }

                // Step 4: candidates
                if model.rectify.step == 4 : VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    Flickable {
                        vertical-stretch: 1;
                        viewport-width: parent.width;
                        viewport-height: cand-col.preferred-height;

                        cand-col := VerticalLayout {
                            width: parent.width;
                            spacing: 4px;
                            for c[ci] in model.rectify.candidates : VerticalLayout {
                                spacing: 1px;
                                Text {
                                    text: c.range + "  " + c.rashi + "  " + c.confidence + "%";
                                    color: c.is-top ? Theme.accent-brand : Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    font-weight: c.is-top ? Theme.weight-semibold : Theme.weight-regular;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: c.breakdown;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if model.rectify.can-refine : PillBtn {
                        label: model.rectify.refine-label;
                        clicked => { root.rectify-refine(); }
                    }
                    PillBtn {
                        label: model.rectify.accept-label;
                        active: true;
                        clicked => { root.rectify-accept(); }
                    }
                }
            }
        }
    }
}
