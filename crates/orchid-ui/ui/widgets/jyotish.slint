import { Theme } from "../theme_global.slint";
import {
    ButtonTone, Chip, ControlSize, Divider, EmptyState, Eyebrow,
    IconButton, ListTile, Tooltip, TouchButton,
} from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import {
    JyotishModel, JyotishProfileCalCell,
} from "../workspace/defs.slint";
import { SearchField } from "search-field.slint";

/// Compact ± stepper row for birth time / UTC offset.
component ProfileStepper inherits HorizontalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <string> empty-text;
    in property <int> small-step: 1;
    in property <int> large-step: 30;
    callback nudge(int);

    spacing: Theme.space-1;
    alignment: center;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-size-sm;
        vertical-alignment: center;
        min-width: 52px;
    }
    TouchButton {
        text: "«";
        tone: ButtonTone.neutral;
        size: ControlSize.sm;
        clicked => { root.nudge(-root.large-step); }
    }
    TouchButton {
        text: "−";
        tone: ButtonTone.neutral;
        size: ControlSize.sm;
        clicked => { root.nudge(-root.small-step); }
    }
    Text {
        text: root.value-text == "" ? root.empty-text : root.value-text;
        color: root.value-text == "" ? Theme.text-tertiary : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-family: Theme.font-family-mono;
        vertical-alignment: center;
        horizontal-alignment: center;
        min-width: 88px;
        horizontal-stretch: 1;
        wrap: no-wrap;
        overflow: elide;
    }
    TouchButton {
        text: "+";
        tone: ButtonTone.neutral;
        size: ControlSize.sm;
        clicked => { root.nudge(root.small-step); }
    }
    TouchButton {
        text: "»";
        tone: ButtonTone.neutral;
        size: ControlSize.sm;
        clicked => { root.nudge(root.large-step); }
    }
}

/// Birth-date picker: day grid, or month / twelve-year jump sheets.
component ProfileDateCal inherits VerticalLayout {
    in property <string> label;
    in property <string> selected-text;
    in property <string> empty-text;
    in property <int> mode;
    in property <string> month-title;
    in property <string> year-title;
    in property <[string]> weekday-headers;
    in property <[JyotishProfileCalCell]> cells;
    callback nav(int);
    callback set-mode(int);
    callback pick(int);

    spacing: Theme.space-2;
    property <int> cols: root.mode == 0 ? 7 : 3;
    property <length> cell-h: root.mode == 0 ? Theme.control-sm : Theme.control-md;

    Eyebrow { text: root.label; }

    Text {
        text: root.selected-text == "" ? root.empty-text : root.selected-text;
        color: root.selected-text == "" ? Theme.text-tertiary : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-family: Theme.font-family-mono;
    }

    HorizontalLayout {
        spacing: Theme.space-1;
        alignment: center;
        IconButton {
            icon: "chevron-left";
            size: ControlSize.sm;
            clicked => { root.nav(-1); }
        }
        if root.mode == 0 : TouchButton {
            text: root.month-title;
            tone: ButtonTone.neutral;
            size: ControlSize.sm;
            clicked => { root.set-mode(1); }
        }
        TouchButton {
            text: root.year-title;
            tone: ButtonTone.neutral;
            size: ControlSize.sm;
            clicked => { root.set-mode(root.mode == 2 ? 0 : 2); }
        }
        IconButton {
            icon: "chevron-right";
            size: ControlSize.sm;
            clicked => { root.nav(1); }
        }
    }

    if root.mode == 0 : HorizontalLayout {
        spacing: Theme.space-1;
        height: Theme.font-size-md;
        for wd[i] in root.weekday-headers : Text {
            horizontal-stretch: 1;
            text: wd;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
        }
    }

    GridLayout {
        spacing: Theme.space-1;
        for cell[j] in root.cells : Rectangle {
            row: j / root.cols;
            col: mod(j, root.cols);
            height: root.cell-h;
            border-radius: Theme.radius-md;
            background: cell.is-selected ? Theme.accent-soft :
                (cal-cell-ta.has-hover ? Theme.state-hover : Colors.transparent);
            border-width: cell.is-selected || cell.is-today ? Theme.hairline : 0;
            border-color: cell.is-selected ? Theme.accent-muted : Theme.border-default;
            animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

            cal-cell-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.pick(root.mode == 0 ? j : cell.value); }
            }
            Text {
                width: 100%; height: 100%;
                text: cell.label;
                color: cell.is-selected ? Theme.accent-brand :
                    (cell.is-outside ? Theme.text-tertiary : Theme.text-primary);
                font-size: Theme.font-size-sm;
                font-weight: cell.is-selected || cell.is-today ? Theme.weight-semibold : Theme.weight-regular;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component TimeWheel inherits Rectangle {
    in property <string> label;
    in property <[string]> items;
    in property <int> selected;
    callback pick(int);

    background: Theme.surface-sunken;
    border-radius: Theme.radius-md;
    border-width: Theme.hairline;
    border-color: Theme.border-subtle;
    clip: true;
    horizontal-stretch: 1;

    VerticalLayout {
        padding-top: Theme.space-2;
        spacing: Theme.space-1;

        Text {
            text: root.label;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: center;
        }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: wheel.preferred-height;

            wheel := VerticalLayout {
                spacing: 1px;
                for item[i] in root.items : Rectangle {
                    height: Theme.control-sm;
                    background: root.selected == i ? Theme.accent-soft :
                        (wheel-ta.has-hover ? Theme.state-hover : Colors.transparent);
                    border-radius: Theme.radius-md;
                    animate background { duration: Theme.motion-fast; easing: ease-out; }

                    wheel-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.pick(i); }
                    }
                    Text {
                        width: 100%; height: 100%;
                        text: item;
                        color: root.selected == i ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        font-family: Theme.font-family-mono;
                        font-weight: root.selected == i ? Theme.weight-semibold : Theme.weight-regular;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

/// Side-by-side hour (0–23) and minute (0–59) wheels.
component ProfileTimeSelect inherits VerticalLayout {
    in property <string> label;
    in property <string> selected-text;
    in property <string> empty-text;
    in property <string> hour-label;
    in property <string> minute-label;
    in property <[string]> hour-items;
    in property <[string]> minute-items;
    in property <int> hour;
    in property <int> minute;
    callback set-time(int, int);

    spacing: Theme.space-2;

    Eyebrow { text: root.label; }

    Text {
        text: root.selected-text == "" ? root.empty-text : root.selected-text;
        color: root.selected-text == "" ? Theme.text-tertiary : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-family: Theme.font-family-mono;
    }

    HorizontalLayout {
        spacing: Theme.space-2;
        height: 148px;

        TimeWheel {
            label: root.hour-label;
            items: root.hour-items;
            selected: root.hour;
            pick(h) => { root.set-time(h, root.minute < 0 ? 0 : root.minute); }
        }
        TimeWheel {
            label: root.minute-label;
            items: root.minute-items;
            selected: root.minute;
            pick(m) => { root.set-time(root.hour < 0 ? 12 : root.hour, m); }
        }
    }
}

component ColorDot inherits Rectangle {
    in property <int> color-code;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.color-code == 0 ? Theme.feedback-success
        : root.color-code == 1 ? Theme.feedback-warning
        : Theme.feedback-danger;
}

component ScoreBar inherits Rectangle {
    in property <int> green;
    in property <int> yellow;
    in property <int> red;

    height: Theme.space-2;
    border-radius: self.height / 2;
    clip: true;
    background: Theme.surface-sunken;
    border-width: Theme.hairline;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        Rectangle { background: Theme.feedback-success; horizontal-stretch: root.green + 0.0; }
        Rectangle { background: Theme.feedback-warning; horizontal-stretch: root.yellow + 0.0; }
        Rectangle { background: Theme.feedback-danger; horizontal-stretch: root.red + 0.0; }
    }
}

export component JyotishView inherits Rectangle {
    in property <JyotishModel> model;

    callback prev-day();
    callback next-day();
    callback go-today();
    callback select-tab(int);
    callback select-offset(int);
    callback month-nav(int);
    callback year-nav(int);
    callback open-month(int);
    callback open-year(int);
    callback select-life-year(int);
    callback rectify-start();
    callback rectify-set-window(int, int);
    callback rectify-answer(int, int);
    callback rectify-add-event(int, int);
    callback rectify-remove-event(int);
    callback rectify-next();
    callback rectify-back();
    callback rectify-refine();
    callback rectify-accept();
    callback rectify-cancel();
    callback export-day();
    callback export-week();
    callback open-cities();
    callback close-cities();
    callback select-city(int);
    callback remove-city(int);
    callback search-cities(string);
    callback add-city(string, float, float);
    callback open-profiles();
    callback close-profiles();
    callback select-profile(int);
    callback remove-profile(int);
    callback begin-add-profile();
    callback begin-edit-profile(int);
    callback cancel-edit-profile();
    callback set-profile-gender(int);
    callback search-birth-places(string);
    callback set-birth-place(string, float, float, string);
    callback nav-profile-cal(int);
    callback set-profile-cal-mode(int);
    callback set-profile-cal-day(int);
    callback set-profile-time(int, int);
    callback nudge-profile-offset(int);
    callback upsert-profile(int, string, int, string, string, int, string, float, float);

    property <int> draft-event-kind: 0;
    property <int> draft-event-year: 2000;
    property <string> draft-profile-name;

    background: transparent;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-3;

        // Tab chips
        Flickable {
            height: Theme.control-sm;
            viewport-height: self.height;
            viewport-width: tab-row.preferred-width.max(self.width);
            interactive: true;

            tab-row := HorizontalLayout {
                spacing: Theme.space-1;
                for tab-label[i] in model.tab-labels : Chip {
                    text: tab-label;
                    selected: model.active-tab == i;
                    clicked => { root.select-tab(i); }
                }
            }
        }

        if model.active-tab == 0 : Flickable {
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-height: day-col.preferred-height;

            day-col := VerticalLayout {
                width: parent.width;
                spacing: Theme.space-3;

                // Date navigation
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: center;

                    IconButton {
                        icon: "chevron-left";
                        size: ControlSize.md;
                        clicked => { root.prev-day(); }
                    }

                    VerticalLayout {
                        spacing: Theme.space-1;
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: model.date-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-lg;
                            font-weight: Theme.weight-semibold;
                            horizontal-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }

                        Rectangle {
                            height: Theme.control-sm;
                            border-radius: Theme.radius-pill;
                            background: location-ta.has-hover ? Theme.state-hover : Colors.transparent;
                            animate background { duration: Theme.motion-fast; easing: ease-out; }

                            location-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.open-cities(); }
                            }

                            HorizontalLayout {
                                spacing: Theme.space-1;
                                alignment: center;
                                width: 100%;
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-1;

                                Text {
                                    text: model.current-locating ? model.current-locating-label
                                        : (model.current-failed && model.location-name == "" ? model.current-failed-label
                                            : (model.location-name == ""
                                                ? (model.active-city-index == 0 ? model.current-location-label : model.empty-location)
                                                : model.location-name));
                                    color: model.location-name == "" && !model.current-locating ? Theme.text-tertiary : Theme.text-secondary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                Icon {
                                    name: "chevron-right";
                                    size: Theme.font-size-md;
                                    tint: Theme.text-tertiary;
                                }
                            }
                        }
                    }

                    IconButton {
                        icon: "chevron-right";
                        size: ControlSize.md;
                        clicked => { root.next-day(); }
                    }
                }

                if model.cities.length > 0 : Flickable {
                    height: Theme.control-sm;
                    viewport-height: self.height;
                    viewport-width: city-row.preferred-width.max(self.width);
                    interactive: true;

                    city-row := HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: center;

                        for city[i] in model.cities : Chip {
                            text: city.is-current
                                ? (model.current-locating ? model.current-locating-label
                                    : (model.current-failed ? model.current-failed-label
                                        : (city.name != "" ? city.name : model.current-location-label)))
                                : city.name;
                            selected: city.active;
                            clicked => { root.select-city(i); }
                        }
                    }
                }

                Flickable {
                    height: Theme.control-sm;
                    viewport-height: self.height;
                    viewport-width: profile-row.preferred-width.max(self.width);
                    interactive: true;

                    profile-row := HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: center;

                        for profile[i] in model.profiles : Chip {
                            text: profile.name;
                            selected: profile.active;
                            clicked => { root.select-profile(i); }
                        }

                        TouchButton {
                            text: model.profiles.length == 0 ? model.profiles-empty-label : model.profiles-add-label;
                            tone: ButtonTone.outline;
                            size: ControlSize.sm;
                            clicked => { root.open-profiles(); }
                        }
                    }
                }

                if !model.is-today : TouchButton {
                    text: model.today-label;
                    tone: ButtonTone.ghost;
                    size: ControlSize.sm;
                    clicked => { root.go-today(); }
                }

                if model.is-loading : Text {
                    text: model.loading-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }

                // Day score hero card
                if !model.is-loading : Rectangle {
                    background: Theme.gradient-glass;
                    border-radius: Theme.radius-xl;
                    border-width: Theme.hairline;
                    border-color: Theme.border-subtle;
                    clip: true;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: Theme.gradient-hero;
                    }

                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: Theme.space-2;
                        alignment: center;

                        HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: center;
                            ColorDot { color-code: model.score-color; y: (parent.height - self.height) / 2; }
                            Text {
                                text: model.score-label + " " + model.score-value;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                            if model.personal-badge != "" : Text {
                                text: model.personal-badge;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: model.headline;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            font-weight: Theme.weight-semibold;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        if model.summary != "" : Text {
                            text: model.summary;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-4;
                            alignment: center;
                            HorizontalLayout {
                                spacing: Theme.space-1;
                                ColorDot { color-code: model.now-score-color; y: (parent.height - self.height) / 2; }
                                Text {
                                    text: model.score-now-label;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-1;
                                ColorDot { color-code: model.day-score-color; y: (parent.height - self.height) / 2; }
                                Text {
                                    text: model.score-day-label;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if !model.is-loading && model.factors.length > 0 : VerticalLayout {
                    spacing: Theme.space-1;
                    for f[i] in model.factors : HorizontalLayout {
                        spacing: Theme.space-2;
                        Text {
                            text: f.delta-text;
                            color: f.valence == 0 ? Theme.feedback-success
                                : (f.valence == 1 ? Theme.feedback-danger : Theme.text-tertiary);
                            font-size: Theme.font-size-sm;
                            font-weight: Theme.weight-medium;
                            horizontal-stretch: 0;
                        }
                        Text {
                            text: f.label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                if !model.is-loading && model.influences.length > 0 : VerticalLayout {
                    spacing: Theme.space-1;
                    for line[i] in model.influences : Text {
                        text: "· " + line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                if !model.is-loading && model.advice.length > 0 : VerticalLayout {
                    spacing: Theme.space-1;
                    for line[i] in model.advice : Text {
                        text: line;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }

                if !model.is-loading && model.has-dasha-now : VerticalLayout {
                    spacing: Theme.space-1;
                    Eyebrow { text: model.dasha-now-title; }
                    Text {
                        text: model.dasha-maha-label + ": " + model.dasha-maha-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                    Text {
                        text: model.dasha-antar-label + ": " + model.dasha-antar-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                    Text {
                        text: model.dasha-pratyantar-label + ": " + model.dasha-pratyantar-text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                // 7-day strip
                if !model.is-loading && model.week-strip.length > 0 : HorizontalLayout {
                    spacing: Theme.space-1;
                    for chip[i] in model.week-strip : Rectangle {
                        height: 56px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-lg;
                        background: chip.is-selected ? Theme.accent-soft
                            : (chip-ta.has-hover ? Theme.state-hover : Theme.surface-sunken);
                        border-width: Theme.hairline;
                        border-color: chip.is-selected ? Theme.accent-muted : Theme.border-subtle;
                        animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

                        chip-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.select-offset(chip.offset); }
                        }

                        VerticalLayout {
                            padding-top: Theme.space-2;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-1;
                            alignment: center;

                            Text {
                                text: chip.weekday;
                                color: chip.is-selected ? Theme.accent-brand : Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: chip.day-num;
                                color: chip.is-selected ? Theme.accent-brand : Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                font-weight: Theme.weight-medium;
                                horizontal-alignment: center;
                            }
                            ColorDot {
                                color-code: chip.color;
                                x: (parent.width - self.width) / 2;
                            }
                        }
                    }
                }

                if !model.is-loading : Divider { }

                // Panchanga rows
                if !model.is-loading : VerticalLayout {
                    spacing: 0px;
                    for entry[i] in model.panchanga : Rectangle {
                        height: Theme.row-height * 0.72;
                        border-radius: Theme.radius-md;
                        background: row-ta.has-hover ? Theme.state-hover : Colors.transparent;
                        animate background { duration: Theme.motion-instant; easing: ease-out; }

                        row-ta := TouchArea { }
                        if row-ta.has-hover && (entry.label != "" || entry.value != "") : Tooltip {
                            text: entry.label + ": " + entry.value;
                            shown: true;
                            x: 0;
                            y: parent.height + Theme.space-1;
                        }

                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            spacing: Theme.space-2;
                            alignment: space-between;
                            width: 100%;
                            height: 100%;

                            Text {
                                text: entry.label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: entry.value;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Sun times
                if !model.is-loading && (model.sunrise-text != "" || model.sunset-text != "") : HorizontalLayout {
                    spacing: Theme.space-4;
                    alignment: space-around;

                    if model.sunrise-text != "" : Text {
                        text: model.sunrise-label + " " + model.sunrise-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                    if model.sunset-text != "" : Text {
                        text: model.sunset-label + " " + model.sunset-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }

                // Inauspicious daylight windows
                if !model.is-loading && model.rahukalam-text != "" : VerticalLayout {
                    spacing: Theme.space-1;
                    Text {
                        text: model.rahukalam-label + " " + model.rahukalam-text;
                        color: model.in-rahukalam ? Theme.feedback-danger : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        font-weight: model.in-rahukalam ? Theme.weight-semibold : Theme.weight-medium;
                        wrap: word-wrap;
                    }
                    if model.yamagandam-text != "" : Text {
                        text: model.yamagandam-label + " " + model.yamagandam-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                    if model.gulika-text != "" : Text {
                        text: model.gulika-label + " " + model.gulika-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }

                if !model.is-loading && model.disclaimer != "" : Text {
                    text: model.disclaimer;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                if !model.is-loading : HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: center;
                    TouchButton {
                        text: model.export-day-label;
                        tone: ButtonTone.outline;
                        size: ControlSize.sm;
                        clicked => { root.export-day(); }
                    }
                    TouchButton {
                        text: model.export-week-label;
                        tone: ButtonTone.outline;
                        size: ControlSize.sm;
                        clicked => { root.export-week(); }
                    }
                }

                // Graha table
                if !model.is-loading && model.show-planets && model.planets.length > 0 : VerticalLayout {
                    spacing: Theme.space-1;

                    Eyebrow { text: model.planets-title; }

                    for planet[i] in model.planets : Rectangle {
                        height: Theme.control-sm;
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: space-between;
                            width: 100%;
                            height: 100%;

                            Text {
                                text: planet.graha;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: planet.rashi;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: planet.degree-text + (planet.is-retrograde ? " R" : "");
                                color: planet.is-retrograde ? Theme.accent-brand : Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                wrap: no-wrap;
                                overflow: elide;
                                min-width: 56px;
                            }
                        }
                    }
                }

                if !model.is-loading : Text {
                    text: model.ayanamsa-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        if model.active-tab == 1 : VerticalLayout {
            vertical-stretch: 1;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: center;
                IconButton {
                    icon: "chevron-left";
                    size: ControlSize.md;
                    clicked => { root.month-nav(-1); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: model.month-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-lg;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: "chevron-right";
                    size: ControlSize.md;
                    clicked => { root.month-nav(1); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-1;
                height: Theme.font-size-md;
                for wd[i] in model.weekday-headers : Text {
                    horizontal-stretch: 1;
                    text: wd;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-medium;
                    horizontal-alignment: center;
                }
            }

            GridLayout {
                spacing: Theme.space-1;
                vertical-stretch: 1;

                for pad in model.month-first-weekday : Rectangle {
                    row: pad / 7;
                    col: mod(pad, 7);
                }

                for cell[j] in model.month-cells : Rectangle {
                    row: (j + model.month-first-weekday) / 7;
                    col: mod(j + model.month-first-weekday, 7);
                    height: Theme.control-md;
                    border-radius: Theme.radius-md;
                    background: cell.is-selected ? Theme.accent-soft
                        : (cell-ta.has-hover ? Theme.state-hover : Colors.transparent);
                    border-width: cell.is-selected || cell.is-today ? Theme.hairline : 0;
                    border-color: cell.is-selected ? Theme.accent-muted : Theme.border-default;
                    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

                    cell-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.select-offset(cell.offset); }
                    }
                    if cell-ta.has-hover : Tooltip {
                        text: cell.color == 0 ? model.legend-green
                            : (cell.color == 1 ? model.legend-yellow : model.legend-red);
                        shown: true;
                        x: 0;
                        y: parent.height + Theme.space-1;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-1;
                        Text {
                            text: cell.day;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                        }
                        ColorDot {
                            color-code: cell.color;
                            x: (parent.width - self.width) / 2;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-4;
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    ColorDot { color-code: 0; y: (parent.height - self.height) / 2; }
                    Text { text: model.legend-green; color: Theme.text-tertiary; font-size: Theme.font-size-sm; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    ColorDot { color-code: 1; y: (parent.height - self.height) / 2; }
                    Text { text: model.legend-yellow; color: Theme.text-tertiary; font-size: Theme.font-size-sm; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    ColorDot { color-code: 2; y: (parent.height - self.height) / 2; }
                    Text { text: model.legend-red; color: Theme.text-tertiary; font-size: Theme.font-size-sm; vertical-alignment: center; }
                }
            }

            Text {
                text: model.month-selected-hint;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if model.active-tab == 2 : VerticalLayout {
            vertical-stretch: 1;
            spacing: Theme.space-2;

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: center;
                IconButton {
                    icon: "chevron-left";
                    size: ControlSize.md;
                    clicked => { root.year-nav(-1); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: model.year-title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-lg;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: "chevron-right";
                    size: ControlSize.md;
                    clicked => { root.year-nav(1); }
                }
            }

            if model.gochara-note != "" : Text {
                text: model.gochara-note;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            Flickable {
                vertical-stretch: 1;
                viewport-width: parent.width;
                viewport-height: year-col.preferred-height;

                year-col := VerticalLayout {
                    width: parent.width;
                    spacing: Theme.space-1;
                    for row[i] in model.year-months : Rectangle {
                        height: Theme.control-md;
                        border-radius: Theme.radius-md;
                        background: month-ta.has-hover ? Theme.state-hover : Colors.transparent;
                        animate background { duration: Theme.motion-fast; easing: ease-out; }

                        month-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.open-month(row.month-offset); }
                        }

                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            spacing: Theme.space-2;
                            alignment: center;

                            Text {
                                text: row.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                min-width: 72px;
                                vertical-alignment: center;
                            }
                            ScoreBar {
                                horizontal-stretch: 1;
                                y: (parent.height - self.height) / 2;
                                green: row.green;
                                yellow: row.yellow;
                                red: row.red;
                            }
                        }
                    }
                }
            }
        }

        if model.active-tab == 3 : Flickable {
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-height: life-col.preferred-height;

            life-col := VerticalLayout {
                width: parent.width;
                spacing: Theme.space-3;

                if !model.has-birth-data : VerticalLayout {
                    spacing: Theme.space-3;
                    EmptyState {
                        icon: "star";
                        title: model.birth-prompt;
                        hint: model.profiles-hint;
                    }
                    TouchButton {
                        text: model.profiles-add-label;
                        tone: ButtonTone.filled;
                        size: ControlSize.md;
                        clicked => { root.open-profiles(); }
                    }
                }

                if model.has-birth-data : VerticalLayout {
                    spacing: Theme.space-1;
                    if model.gochara-note != "" : Text {
                        text: model.gochara-note;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    for row[i] in model.life-years : VerticalLayout {
                        spacing: Theme.space-1;
                        Rectangle {
                            height: Theme.control-lg;
                            border-radius: Theme.radius-md;
                            background: row.is-selected ? Theme.state-selected
                                : (year-ta.has-hover ? Theme.state-hover : Colors.transparent);
                            border-width: row.is-current ? Theme.hairline : 0px;
                            border-color: Theme.accent-muted;
                            animate background { duration: Theme.motion-fast; easing: ease-out; }

                            year-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.select-life-year(row.year); }
                            }

                            VerticalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-2;
                                padding-top: Theme.space-1;
                                padding-bottom: Theme.space-1;
                                spacing: Theme.space-1;

                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    alignment: space-between;
                                    Text {
                                        text: row.year;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        font-weight: Theme.weight-medium;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: row.dasha;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                                ScoreBar {
                                    green: row.green;
                                    yellow: row.yellow;
                                    red: row.red;
                                }
                            }
                        }
                        if row.is-selected && model.life-antars.length > 0 : VerticalLayout {
                            spacing: Theme.space-1;
                            padding-left: Theme.space-3;
                            Eyebrow { text: model.life-antars-title; }
                            for antar[j] in model.life-antars : Rectangle {
                                height: Theme.control-sm;
                                border-radius: Theme.radius-md;
                                background: antar.is-current ? Theme.accent-soft : Colors.transparent;
                                border-width: antar.is-current ? Theme.hairline : 0;
                                border-color: Theme.accent-muted;
                                HorizontalLayout {
                                    padding-left: Theme.space-2;
                                    padding-right: Theme.space-2;
                                    spacing: Theme.space-2;
                                    alignment: space-between;
                                    Text {
                                        text: antar.lord;
                                        color: antar.is-current ? Theme.accent-brand : Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: antar.range;
                                        color: antar.is-current ? Theme.accent-brand : Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                TouchButton {
                    text: model.rectify-button-label;
                    tone: ButtonTone.tonal;
                    size: ControlSize.md;
                    clicked => { root.rectify-start(); }
                }
            }
        }
    }

    // Location picker overlay
    if model.picker-open : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        z: 50;

        TouchArea {
            clicked => { root.close-cities(); }
        }

        Rectangle {
            x: Theme.space-3;
            y: Theme.space-3;
            width: parent.width - Theme.space-6;
            height: parent.height - Theme.space-6;
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.elev-3-blur;
            drop-shadow-offset-y: Theme.elev-3-y;
            drop-shadow-color: Theme.shadow-key;

            // Eat backdrop clicks so the panel stays open while interacting.
            TouchArea { }

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: space-between;

                    Text {
                        text: model.picker-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-lg;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        icon: "close";
                        size: ControlSize.sm;
                        tooltip: model.close-picker-label;
                        tooltip-flip: true;
                        clicked => { root.close-cities(); }
                    }
                }

                if model.cities-hint != "" : Text {
                    text: model.cities-hint;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                SearchField {
                    query: model.search-query;
                    placeholder: model.search-placeholder;
                    edited(q) => { root.search-cities(q); }
                    escape-pressed => { root.close-cities(); }
                }

                if model.cities.length > 0 : Flickable {
                    height: min(140px, cities-list.preferred-height);
                    viewport-width: self.width;
                    viewport-height: cities-list.preferred-height;
                    interactive: true;

                    cities-list := VerticalLayout {
                        spacing: Theme.space-1;

                        for city[i] in model.cities : Rectangle {
                            height: Theme.row-height;
                            background: city.active ? Theme.state-selected
                                : saved-ta.has-hover ? Theme.state-hover
                                : Colors.transparent;
                            border-radius: Theme.radius-md;
                            animate background { duration: Theme.motion-fast; easing: ease-out; }

                            saved-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.select-city(i); }
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-1;
                                spacing: Theme.space-1;

                                Text {
                                    text: city.is-current
                                        ? (model.current-locating ? model.current-locating-label
                                            : (model.current-failed ? model.current-failed-label
                                                : (city.name != "" ? city.name : model.current-location-label)))
                                        : city.name;
                                    color: city.active ? Theme.accent-brand : Theme.text-primary;
                                    font-size: Theme.font-size-md;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                if !city.is-current && model.cities.length > 2 : IconButton {
                                    icon: "trash";
                                    size: ControlSize.sm;
                                    danger: true;
                                    tooltip: model.remove-city-hint;
                                    tooltip-flip: true;
                                    clicked => { root.remove-city(i); }
                                }
                            }
                        }
                    }
                }

                Divider { }

                if model.search-busy : Text {
                    text: model.searching-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }

                if !model.search-busy && model.search-query != "" && model.search-results.length == 0 : Text {
                    text: model.no-results-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: results-list.preferred-height.max(self.height);
                    interactive: true;

                    results-list := VerticalLayout {
                        spacing: Theme.space-1;

                        for hit[i] in model.search-results : ListTile {
                            title: hit.name;
                            subtitle: hit.detail;
                            clicked => {
                                root.add-city(hit.name, hit.latitude, hit.longitude);
                            }
                        }
                    }
                }
            }
        }
    }

    // Birth-profile picker overlay
    if model.profile-picker-open : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        z: 60;

        TouchArea {
            clicked => { root.close-profiles(); }
        }

        Rectangle {
            x: Theme.space-3;
            y: Theme.space-3;
            width: parent.width - Theme.space-6;
            height: parent.height - Theme.space-6;
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.elev-3-blur;
            drop-shadow-offset-y: Theme.elev-3-y;
            drop-shadow-color: Theme.shadow-key;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: space-between;

                    Text {
                        text: model.profiles-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-lg;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        icon: "close";
                        size: ControlSize.sm;
                        tooltip: model.profiles-close-label;
                        tooltip-flip: true;
                        clicked => { root.close-profiles(); }
                    }
                }

                if model.profiles-hint != "" : Text {
                    text: model.profiles-hint;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }

                if !model.profile-editing : VerticalLayout {
                    spacing: Theme.space-2;
                    vertical-stretch: 1;

                    Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: profiles-list.preferred-height.max(self.height);

                        profiles-list := VerticalLayout {
                            spacing: Theme.space-1;

                            for profile[i] in model.profiles : Rectangle {
                                height: Theme.row-height;
                                background: profile.active ? Theme.state-selected
                                    : (profile-row-ta.has-hover ? Theme.state-hover : Colors.transparent);
                                border-radius: Theme.radius-md;
                                animate background { duration: Theme.motion-fast; easing: ease-out; }

                                profile-row-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.select-profile(i); }
                                }

                                HorizontalLayout {
                                    padding-left: Theme.space-3;
                                    padding-right: Theme.space-1;
                                    spacing: Theme.space-1;

                                    Text {
                                        text: profile.name;
                                        color: profile.active ? Theme.accent-brand : Theme.text-primary;
                                        font-size: Theme.font-size-md;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }

                                    IconButton {
                                        icon: "more";
                                        size: ControlSize.sm;
                                        tooltip-flip: true;
                                        clicked => {
                                            root.draft-profile-name = profile.name;
                                            root.begin-edit-profile(i);
                                        }
                                    }

                                    if model.profiles.length > 0 : IconButton {
                                        icon: "trash";
                                        size: ControlSize.sm;
                                        danger: true;
                                        tooltip-flip: true;
                                        clicked => { root.remove-profile(i); }
                                    }
                                }
                            }
                        }
                    }

                    TouchButton {
                        text: model.profiles-add-label;
                        tone: ButtonTone.filled;
                        size: ControlSize.md;
                        clicked => {
                            root.draft-profile-name = "";
                            root.begin-add-profile();
                        }
                    }
                }

                if model.profile-editing : Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: profile-edit-form.preferred-height;

                    profile-edit-form := VerticalLayout {
                        spacing: Theme.space-2;

                        Text {
                            text: model.profile-edit-index < 0 ? model.profiles-add-label : model.profiles-edit-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-weight: Theme.weight-medium;
                        }

                        Rectangle {
                            height: Theme.control-md;
                            background: Theme.surface-sunken;
                            border-radius: Theme.radius-pill;
                            border-width: Theme.hairline;
                            border-color: Theme.border-default;
                            name-input := TextInput {
                                x: Theme.space-3;
                                y: 0px;
                                width: parent.width - Theme.space-6;
                                height: parent.height;
                                text: root.draft-profile-name == "" && model.profile-edit-name != "" ? model.profile-edit-name : root.draft-profile-name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { root.draft-profile-name = self.text; }
                            }
                            if name-input.text == "" : Text {
                                x: Theme.space-3;
                                y: 0px;
                                width: parent.width - Theme.space-6;
                                height: parent.height;
                                text: model.profile-name-placeholder;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-1;
                            for g-label[gi] in model.gender-labels : Chip {
                                text: g-label;
                                selected: model.profile-edit-gender == gi;
                                horizontal-stretch: 1;
                                clicked => { root.set-profile-gender(gi); }
                            }
                        }

                        ProfileDateCal {
                            label: model.profile-date-label;
                            selected-text: model.profile-edit-date;
                            empty-text: model.profile-date-placeholder;
                            mode: model.profile-cal-mode;
                            month-title: model.profile-cal-month-title;
                            year-title: model.profile-cal-year-title;
                            weekday-headers: model.weekday-headers;
                            cells: model.profile-cal-cells;
                            nav(d) => { root.nav-profile-cal(d); }
                            set-mode(m) => { root.set-profile-cal-mode(m); }
                            pick(v) => { root.set-profile-cal-day(v); }
                        }

                        ProfileTimeSelect {
                            label: model.profile-time-label;
                            selected-text: model.profile-edit-time;
                            empty-text: model.profile-time-placeholder;
                            hour-label: model.profile-hour-label;
                            minute-label: model.profile-minute-label;
                            hour-items: model.profile-hour-items;
                            minute-items: model.profile-minute-items;
                            hour: model.profile-edit-hour;
                            minute: model.profile-edit-minute;
                            set-time(h, m) => { root.set-profile-time(h, m); }
                        }

                        ProfileStepper {
                            label: model.profile-offset-label;
                            value-text: model.profile-edit-offset-text;
                            empty-text: model.profile-offset-placeholder;
                            small-step: 30;
                            large-step: 60;
                            nudge(d) => { root.nudge-profile-offset(d); }
                        }

                        Rectangle {
                            height: model.profile-edit-place-coords == "" ? Theme.control-md : Theme.control-lg;
                            background: Theme.surface-sunken;
                            border-radius: Theme.radius-md;
                            border-width: Theme.hairline;
                            border-color: Theme.border-subtle;
                            VerticalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-3;
                                padding-top: Theme.space-2;
                                padding-bottom: Theme.space-2;
                                spacing: Theme.space-1;
                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    Text {
                                        text: model.profile-place-placeholder;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: model.profile-edit-place-name == "" ? "-" : model.profile-edit-place-name;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        font-weight: Theme.weight-medium;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                                if model.profile-edit-place-coords != "" : Text {
                                    text: model.profile-edit-place-coords;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    font-family: Theme.font-family-mono;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }

                        SearchField {
                            query: model.profile-search-query;
                            placeholder: model.profile-place-search-placeholder;
                            edited(q) => { root.search-birth-places(q); }
                        }

                        if model.profile-search-busy : Text {
                            text: model.searching-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                        }

                        if !model.profile-search-busy && model.profile-search-query != "" && model.profile-search-results.length == 0 : Text {
                            text: model.no-results-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                        }

                        Flickable {
                            height: min(120px, place-results.preferred-height);
                            viewport-width: self.width;
                            viewport-height: place-results.preferred-height;
                            interactive: true;

                            place-results := VerticalLayout {
                                spacing: Theme.space-1;
                                for hit[hi] in model.profile-search-results : ListTile {
                                    title: hit.name;
                                    subtitle: hit.detail;
                                    clicked => {
                                        root.set-birth-place(hit.name, hit.latitude, hit.longitude, hit.timezone);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-2;
                            TouchButton {
                                text: model.profiles-cancel-label;
                                tone: ButtonTone.ghost;
                                size: ControlSize.md;
                                clicked => { root.cancel-edit-profile(); }
                            }
                            TouchButton {
                                text: model.profiles-save-label;
                                tone: ButtonTone.filled;
                                size: ControlSize.md;
                                clicked => {
                                    root.upsert-profile(
                                        model.profile-edit-index,
                                        name-input.text == "" ? model.profile-edit-name : name-input.text,
                                        model.profile-edit-gender,
                                        model.profile-edit-date,
                                        model.profile-edit-time,
                                        model.profile-edit-offset,
                                        "",
                                        0,
                                        0
                                    );
                                    root.draft-profile-name = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Rectification wizard overlay
    if model.rectify.step > 0 : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        z: 200;

        TouchArea { }

        Rectangle {
            x: Theme.space-2;
            y: Theme.space-2;
            width: parent.width - Theme.space-4;
            height: parent.height - Theme.space-4;
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.elev-3-blur;
            drop-shadow-offset-y: Theme.elev-3-y;
            drop-shadow-color: Theme.shadow-key;

            TouchArea { }

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: space-between;
                    Text {
                        text: model.rectify.title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-lg;
                        font-weight: Theme.weight-semibold;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if model.rectify.can-go-back : TouchButton {
                        text: model.rectify.back-label;
                        tone: ButtonTone.ghost;
                        size: ControlSize.sm;
                        clicked => { root.rectify-back(); }
                    }
                    TouchButton {
                        text: model.rectify.cancel-label;
                        tone: ButtonTone.neutral;
                        size: ControlSize.sm;
                        clicked => { root.rectify-cancel(); }
                    }
                }

                if model.rectify.progress-text != "" : Text {
                    text: model.rectify.progress-text + " · " + model.rectify.step-title;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }

                // Step 1: uncertainty window
                if model.rectify.step == 1 : VerticalLayout {
                    spacing: Theme.space-2;
                    vertical-stretch: 1;
                    alignment: center;

                    if model.rectify.window-labels.length > 0 : TouchButton {
                        text: model.rectify.window-labels[0];
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        wide: true;
                        clicked => { root.rectify-set-window(720, 30); }
                    }
                    if model.rectify.window-labels.length > 1 : TouchButton {
                        text: model.rectify.window-labels[1];
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        wide: true;
                        clicked => { root.rectify-set-window(720, 120); }
                    }
                    if model.rectify.window-labels.length > 2 : TouchButton {
                        text: model.rectify.window-labels[2];
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        wide: true;
                        clicked => { root.rectify-set-window(720, 360); }
                    }
                    if model.rectify.window-labels.length > 3 : TouchButton {
                        text: model.rectify.window-labels[3];
                        tone: ButtonTone.outline;
                        size: ControlSize.md;
                        wide: true;
                        clicked => { root.rectify-set-window(-1, -1); }
                    }
                }

                // Step 2: quiz
                if model.rectify.step == 2 : VerticalLayout {
                    spacing: Theme.space-3;
                    vertical-stretch: 1;

                    Text {
                        text: "" + (model.rectify.question-idx + 1) + " / " + model.rectify.question-total;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: model.rectify.question;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-medium;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    VerticalLayout {
                        spacing: Theme.space-2;
                        for opt[oi] in model.rectify.options : TouchButton {
                            text: opt;
                            tone: ButtonTone.neutral;
                            size: ControlSize.md;
                            wide: true;
                            clicked => { root.rectify-answer(model.rectify.question-idx, oi); }
                        }
                    }
                }

                // Step 3: life events
                if model.rectify.step == 3 : VerticalLayout {
                    spacing: Theme.space-3;
                    vertical-stretch: 1;

                    if model.rectify.events.length > 0 : VerticalLayout {
                        spacing: Theme.space-1;
                        for ev[ei] in model.rectify.events : HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: space-between;
                            Text {
                                text: ev;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                icon: "trash";
                                size: ControlSize.sm;
                                danger: true;
                                clicked => { root.rectify-remove-event(ei); }
                            }
                        }
                    }

                    if model.rectify.error-text != "" : Text {
                        text: model.rectify.error-text;
                        color: Theme.feedback-danger;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    Divider { }

                    HorizontalLayout {
                        spacing: Theme.space-1;
                        for kind[ki] in model.rectify.event-kinds : Chip {
                            text: kind;
                            selected: root.draft-event-kind == ki;
                            clicked => { root.draft-event-kind = ki; }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: center;
                        IconButton {
                            icon: "minus";
                            size: ControlSize.sm;
                            clicked => { root.draft-event-year = max(model.rectify.event-year-min, root.draft-event-year - 1); }
                        }
                        Text {
                            text: model.rectify.year-placeholder + ": " + root.draft-event-year;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon: "plus";
                            size: ControlSize.sm;
                            clicked => { root.draft-event-year = min(model.rectify.event-year-max, root.draft-event-year + 1); }
                        }
                        TouchButton {
                            text: model.rectify.add-event-label;
                            tone: ButtonTone.tonal;
                            size: ControlSize.sm;
                            clicked => { root.rectify-add-event(root.draft-event-kind, root.draft-event-year); }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    TouchButton {
                        text: model.rectify.next-label;
                        tone: ButtonTone.filled;
                        size: ControlSize.md;
                        wide: true;
                        clicked => { root.rectify-next(); }
                    }
                }

                // Step 4: candidates
                if model.rectify.step == 4 : VerticalLayout {
                    spacing: Theme.space-2;
                    vertical-stretch: 1;

                    Flickable {
                        vertical-stretch: 1;
                        viewport-width: parent.width;
                        viewport-height: cand-col.preferred-height;

                        cand-col := VerticalLayout {
                            width: parent.width;
                            spacing: Theme.space-2;
                            for c[ci] in model.rectify.candidates : VerticalLayout {
                                spacing: Theme.space-1;
                                Text {
                                    text: c.range + "  " + c.rashi + "  " + c.confidence + "%";
                                    color: c.is-top ? Theme.accent-brand : Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    font-weight: c.is-top ? Theme.weight-semibold : Theme.weight-regular;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: c.breakdown;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if model.rectify.can-refine : TouchButton {
                        text: model.rectify.refine-label;
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        wide: true;
                        clicked => { root.rectify-refine(); }
                    }
                    TouchButton {
                        text: model.rectify.accept-label;
                        tone: ButtonTone.filled;
                        size: ControlSize.md;
                        wide: true;
                        clicked => { root.rectify-accept(); }
                    }
                }
            }
        }
    }
}
