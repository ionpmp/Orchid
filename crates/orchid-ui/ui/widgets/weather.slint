import { Theme } from "../theme_global.slint";
import { Chip, ControlSize, Divider, IconButton, Tooltip } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { WeatherModel } from "../workspace/defs.slint";
import { SearchField } from "search-field.slint";

export component WeatherView inherits Rectangle {
    in property <WeatherModel> model;

    callback open-cities();
    callback close-cities();
    callback select-city(int);
    callback remove-city(int);
    callback search-cities(string);
    callback add-city(string, float, float, string);
    callback select-day(int);
    callback use-my-location();

    // ASCII/BMP glyphs — color emoji missing in Slint's default Windows font.
    pure function weather-icon-glyph(name: string) -> string {
        return
            name == "weather-clear" ? "*" :
            name == "weather-partly-cloudy" ? "+" :
            name == "weather-cloudy" ? "=" :
            name == "weather-overcast" ? "=" :
            name == "weather-fog" ? "~" :
            name == "weather-drizzle" ? "," :
            name == "weather-rain" ? "/" :
            name == "weather-snow" ? "*" :
            name == "weather-sleet" ? "%" :
            name == "weather-thunderstorm" ? "!" :
            name == "weather-hail" ? "%" :
            name == "weather-windy" ? "~" :
            name == "weather-unknown" ? "." :
            ".";
    }

    background: transparent;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: space-between;

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-sm;
                border-radius: Theme.radius-pill;
                background: location-ta.has-hover ? Theme.state-hover : Colors.transparent;
                animate background { duration: Theme.motion-fast; easing: ease-out; }

                location-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-cities(); }
                }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-1;
                    width: 100%;
                    height: 100%;

                    Text {
                        text: model.location;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-lg;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    Icon {
                        name: "chevron-right";
                        size: Theme.font-size-lg;
                        tint: Theme.text-tertiary;
                    }
                }
            }

            // Freshness dot: green live, amber stale, grey idle, red failed.
            Rectangle {
                width: Theme.control-xs;
                height: Theme.control-xs;
                y: (parent.height - self.height) / 2;

                status-ta := TouchArea { }

                Tooltip {
                    x: parent.width - self.width;
                    y: parent.height + Theme.space-1;
                    shown: status-ta.has-hover;
                    text: model.status-label;
                }

                Rectangle {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background:
                        model.status == 0 ? Theme.feedback-success :
                        model.status == 1 ? Theme.feedback-warning :
                        model.status == 2 ? Theme.text-tertiary :
                        Theme.feedback-danger;
                    drop-shadow-blur: Theme.elev-1-blur;
                    drop-shadow-color: self.background;
                }
            }
        }

        if model.cities.length > 1 : Flickable {
            height: Theme.control-sm;
            viewport-height: self.height;
            viewport-width: city-row.preferred-width.max(self.width);
            interactive: true;

            city-row := HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;

                for city[i] in model.cities : Chip {
                    text: city.name;
                    selected: city.active;
                    clicked => { root.select-city(i); }
                }
            }
        }

        // Current conditions hero.
        Rectangle {
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-subtle;
            clip: true;

            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.gradient-hero;
            }

            HorizontalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-4;

                VerticalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        text: model.current-temp;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-4xl;
                        font-weight: Theme.weight-bold;
                    }

                    Text {
                        text: model.condition-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-md;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    if model.feels-like != "" : Text {
                        text: model.feels-like;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                    }
                }

                if model.condition-icon != "" : Text {
                    text: weather-icon-glyph(model.condition-icon);
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-4xl;
                    vertical-alignment: center;
                }
            }
        }

        if model.humidity != "" || model.wind != "" : HorizontalLayout {
            spacing: Theme.space-2;

            if model.humidity != "" : Rectangle {
                background: Theme.surface-sunken;
                border-radius: Theme.radius-pill;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;
                horizontal-stretch: 0;
                min-height: Theme.control-sm;

                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;

                    Text {
                        text: model.humidity;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
            }

            if model.wind != "" : Rectangle {
                background: Theme.surface-sunken;
                border-radius: Theme.radius-pill;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;
                horizontal-stretch: 0;
                min-height: Theme.control-sm;

                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;

                    Text {
                        text: model.wind;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Divider { }

        if model.day-detail != "" : Text {
            text: model.day-detail;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }

        // Swipe horizontally to see more forecast days (up to 16). Tap a day for details.
        Flickable {
            height: 124px;
            viewport-height: self.height;
            viewport-width: forecast-row.preferred-width.max(self.width);
            interactive: true;

            forecast-row := HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;

                for day[i] in model.forecast : Rectangle {
                    width: 84px;
                    height: 116px;
                    background: day.selected ? Theme.accent-soft
                        : day-ta.has-hover ? Theme.surface-raised
                        : Theme.surface-sunken;
                    border-radius: Theme.radius-lg;
                    border-width: Theme.hairline;
                    border-color: day.selected ? Theme.accent-muted : Theme.border-subtle;
                    drop-shadow-blur: day.selected ? Theme.elev-1-blur : 0px;
                    drop-shadow-offset-y: day.selected ? Theme.elev-1-y : 0px;
                    drop-shadow-color: Theme.shadow-ambient;

                    animate background, border-color, drop-shadow-blur {
                        duration: Theme.motion-fast;
                        easing: ease-out;
                    }

                    day-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.select-day(i); }
                    }

                    VerticalLayout {
                        padding-top: Theme.space-2;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-1;
                        alignment: center;
                        width: 100%;
                        height: 100%;

                        Text {
                            text: day.day-label;
                            color: day.selected ? Theme.accent-brand : Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            font-weight: day.selected ? Theme.weight-semibold : Theme.weight-medium;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: weather-icon-glyph(day.icon);
                            color: Theme.accent-brand;
                            font-size: Theme.font-size-2xl;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: day.range-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            font-weight: Theme.weight-medium;
                            horizontal-alignment: center;
                        }

                        if day.precip-text != "" : Text {
                            text: day.precip-text;
                            color: Theme.feedback-info;
                            font-size: Theme.font-size-xs;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        Text {
            text: model.last-updated;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            horizontal-alignment: end;
        }
    }

    if model.picker-open : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        z: 50;

        TouchArea {
            clicked => { root.close-cities(); }
        }

        Rectangle {
            x: Theme.space-3;
            y: Theme.space-3;
            width: parent.width - Theme.space-6;
            height: parent.height - Theme.space-6;
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-strong;
            drop-shadow-blur: Theme.elev-3-blur;
            drop-shadow-offset-y: Theme.elev-3-y;
            drop-shadow-color: Theme.shadow-key;

            // Eat backdrop clicks so the panel stays open while interacting.
            TouchArea { }

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: space-between;

                    Text {
                        text: model.picker-title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-lg;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        icon: "close";
                        size: ControlSize.sm;
                        tooltip: model.close-picker-label;
                        tooltip-flip: true;
                        clicked => { root.close-cities(); }
                    }
                }

                SearchField {
                    query: model.search-query;
                    placeholder: model.search-placeholder;
                    edited(q) => { root.search-cities(q); }
                    escape-pressed => { root.close-cities(); }
                }

                if model.cities.length > 0 : Flickable {
                    height: min(140px, cities-list.preferred-height);
                    viewport-width: self.width;
                    viewport-height: cities-list.preferred-height;
                    interactive: true;

                    cities-list := VerticalLayout {
                        spacing: Theme.space-1;

                        for city[i] in model.cities : Rectangle {
                            height: Theme.row-height;
                            background: city.active ? Theme.state-selected
                                : saved-ta.has-hover ? Theme.state-hover
                                : transparent;
                            border-radius: Theme.radius-md;
                            animate background { duration: Theme.motion-fast; easing: ease-out; }

                            saved-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.select-city(i); }
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-1;
                                spacing: Theme.space-1;

                                Text {
                                    text: city.name;
                                    color: city.active ? Theme.accent-brand : Theme.text-primary;
                                    font-size: Theme.font-size-md;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                if model.cities.length > 1 : IconButton {
                                    icon: "trash";
                                    size: ControlSize.sm;
                                    danger: true;
                                    tooltip: model.remove-city-hint;
                                    tooltip-flip: true;
                                    clicked => { root.remove-city(i); }
                                }
                            }
                        }
                    }
                }

                Divider { }

                if model.search-busy : Text {
                    text: model.searching-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }

                if !model.search-busy && model.search-query != "" && model.search-results.length == 0 : Text {
                    text: model.no-results-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: results-list.preferred-height.max(self.height);
                    interactive: true;

                    results-list := VerticalLayout {
                        spacing: 4px;

                        for hit[i] in model.search-results : Rectangle {
                            height: Theme.control-lg;
                            background: hit-ta.has-hover ? Theme.state-hover : transparent;
                            border-radius: Theme.radius-md;
                            animate background { duration: Theme.motion-fast; easing: ease-out; }

                            hit-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.add-city(hit.name, hit.latitude, hit.longitude, hit.timezone);
                                }
                            }
                            if hit-ta.has-hover : Rectangle {
                                x: parent.x + 8px;
                                y: parent.height - 2px;
                                width: add-hint.preferred-width + 12px;
                                height: add-hint.preferred-height + 6px;
                                background: Theme.surface-raised;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-default;
                                z: 100;
                                add-hint := Text {
                                    x: 6px; y: 3px;
                                    text: model.add-city-hint;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-size-sm;
                                }
                            }

                            VerticalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-3;
                                spacing: 2px;
                                alignment: center;

                                Text {
                                    text: hit.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-md;
                                    font-weight: Theme.weight-medium;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                                if hit.detail != "" : Text {
                                    text: hit.detail;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
