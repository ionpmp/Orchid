import { Theme } from "../theme_global.slint";
import { Divider, Tooltip } from "../kit.slint";
import { MoonModel } from "../workspace/defs.slint";

/// Geometric moon disk. Lit face + offset shade circle (clipped) yields the phase.
component MoonPhaseDisk inherits Rectangle {
    in property <string> phase-icon;
    in property <float> illumination-fraction;

    private property <length> disk: 116px;
    private property <float> frac: max(0.0, min(1.0, illumination-fraction));
    private property <bool> waxing:
        phase-icon == "moon-new" ||
        phase-icon == "moon-waxing-crescent" ||
        phase-icon == "moon-first-quarter" ||
        phase-icon == "moon-waxing-gibbous" ||
        phase-icon == "moon-full";
    // Shade center moves from concentric (new) to ±2R off-disk (full).
    private property <length> shade-x: waxing ? -disk * 2.0 * frac : disk * 2.0 * frac;

    private property <color> moon-lit: #f2e8d5;
    private property <color> moon-shade: #2a2a35;
    private property <color> mare: #00000028;

    width: disk;
    height: disk;

    // Halo so the disk reads as a light source, not a flat circle.
    Rectangle {
        width: disk;
        height: disk;
        border-radius: disk / 2;
        background: Colors.transparent;
        drop-shadow-blur: Theme.elev-glow-blur;
        drop-shadow-color: moon-lit.with-alpha(0.35 * frac);
    }

    Rectangle {
        width: disk;
        height: disk;
        border-radius: disk / 2;
        clip: true;
        background: moon-lit;
        border-width: Theme.hairline;
        border-color: Theme.border-strong;

        // Soft maria under the shade so only the lit face shows them.
        if frac > 0.25 : Rectangle {
            x: disk * 0.28;
            y: disk * 0.30;
            width: disk * 0.22;
            height: disk * 0.18;
            border-radius: disk * 0.11;
            background: mare;
        }
        if frac > 0.25 : Rectangle {
            x: disk * 0.48;
            y: disk * 0.52;
            width: disk * 0.16;
            height: disk * 0.14;
            border-radius: disk * 0.08;
            background: mare;
        }

        // Unlit portion — same-size disk whose offset sets the terminator.
        Rectangle {
            x: shade-x;
            y: 0;
            width: disk;
            height: disk;
            border-radius: disk / 2;
            background: moon-shade;
        }
    }
}

export component MoonView inherits Rectangle {
    in property <MoonModel> model;

    background: transparent;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        alignment: start;

        // Night-sky stage for the disk.
        Rectangle {
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-subtle;
            clip: true;

            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.gradient-hero;
            }

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-2;
                alignment: center;

                if model.phase-icon != "" : HorizontalLayout {
                    alignment: center;
                    MoonPhaseDisk {
                        phase-icon: model.phase-icon;
                        illumination-fraction: model.illumination-fraction;
                    }
                }

                Text {
                    text: model.phase-label;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-xl;
                    font-weight: Theme.weight-bold;
                    horizontal-alignment: center;
                }

                Text {
                    text: model.illumination;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-md;
                    font-weight: Theme.weight-medium;
                    horizontal-alignment: center;
                }
            }
        }

        Divider { }

        for entry[i] in model.values : Rectangle {
            height: Theme.control-sm;
            border-radius: Theme.radius-sm;
            background: moon-val-ta.has-hover ? Theme.state-hover : Colors.transparent;
            animate background { duration: Theme.motion-fast; easing: ease-out; }

            moon-val-ta := TouchArea { }

            Tooltip {
                x: 0;
                y: parent.height + Theme.space-1;
                shown: moon-val-ta.has-hover && (entry.label != "" || entry.value != "");
                text: entry.label + ": " + entry.value;
            }

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-2;
                alignment: space-between;
                width: 100%;
                height: 100%;

                Text {
                    text: entry.label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: entry.value;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-medium;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
