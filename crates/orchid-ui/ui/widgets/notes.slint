import { Theme } from "../theme_global.slint";
import { ControlSize, IconButton, Tooltip } from "../kit.slint";
import { NotesModel } from "../workspace/defs.slint";

component NotesToolBtn inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    width: max(Theme.control-sm, label-txt.preferred-width + Theme.space-4);
    height: Theme.control-sm;
    border-radius: Theme.radius-pill;
    background: !root.enabled ? Colors.transparent :
        root.active ? Theme.accent-soft :
        ta.pressed ? Theme.state-press :
        ta.has-hover ? Theme.state-hover : Colors.transparent;
    border-width: root.active ? Theme.hairline : 0px;
    border-color: Theme.accent-muted;

    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    label-txt := Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: !root.enabled ? Theme.text-disabled :
            root.active ? Theme.accent-brand : Theme.text-secondary;
        font-size: Theme.font-size-sm;
        font-weight: root.active ? Theme.weight-semibold : Theme.weight-medium;
        font-family: Theme.font-family-sans;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Tooltip {
        text: root.tip;
        shown: ta.has-hover && root.tip != "";
        x: (parent.width - self.width) / 2;
        y: -self.height - Theme.space-2;
    }
}

export component NotesView inherits Rectangle {
    in property <NotesModel> model;

    callback body-changed(string);
    callback title-changed(string);
    callback select-tab(int);
    callback new-tab();
    callback close-tab(int);
    callback toggle-wrap();
    callback toggle-mono();
    callback zoom(int);
    callback clear-note();
    callback find-request(string, bool);

    background: transparent;

    // Local draft so caret survives snapshot patches while typing.
    property <string> draft-text: model.body;
    property <string> draft-title: model.title;
    property <int> synced-active: model.active-index;
    property <string> synced-body: model.body;
    property <bool> find-open: false;
    property <string> find-query: "";
    property <int> last-find-gen: -1;

    changed model => {
        if model.active-index != root.synced-active {
            root.draft-text = model.body;
            root.draft-title = model.title;
            root.synced-active = model.active-index;
            root.synced-body = model.body;
        } else if model.body != root.synced-body && root.draft-text == root.synced-body {
            // External update while not mid-edit.
            root.draft-text = model.body;
            root.synced-body = model.body;
        } else if root.draft-text == model.body {
            root.synced-body = model.body;
        }
        if model.find-gen != root.last-find-gen {
            root.last-find-gen = model.find-gen;
            edit-input.set-selection-offsets(model.find-anchor, model.find-cursor);
            edit-input.focus();
        }
    }

    VerticalLayout {
        spacing: 0;

        // Tab strip
        Rectangle {
            height: Theme.toolbar-height;
            background: Theme.surface-sunken;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;
                alignment: start;

                Flickable {
                    vertical-stretch: 0;
                    viewport-height: self.height;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;

                        for tab[i] in model.tabs : Rectangle {
                            width: max(96px, min(190px, tab-label.preferred-width + (tab.is-active ? 56px : 32px)));
                            height: Theme.control-md;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.radius-md;
                            background: tab.is-active ? Theme.surface-raised
                                : tab-ta.has-hover ? Theme.state-hover : Colors.transparent;

                            animate background { duration: Theme.motion-fast; easing: ease-out; }

                            tab-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.select-tab(i); }
                            }

                            if tab.is-active : Rectangle {
                                y: parent.height - self.height - Theme.space-1;
                                x: Theme.space-3;
                                width: parent.width - Theme.space-6;
                                height: Theme.indicator-thickness;
                                border-radius: Theme.radius-pill;
                                background: Theme.accent-brand;
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-3;
                                padding-right: Theme.space-1;
                                spacing: Theme.space-1;

                                tab-label := Text {
                                    text: tab.title == "" ? model.untitled-label : tab.title;
                                    color: tab.is-active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-size-sm;
                                    font-weight: tab.is-active ? Theme.weight-semibold : Theme.weight-regular;
                                    font-family: Theme.font-family-sans;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if tab.is-active || tab-ta.has-hover : IconButton {
                                    icon: "close";
                                    size: ControlSize.xs;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.close-tab(i); }
                                }
                            }
                        }
                    }
                }

                IconButton {
                    icon: "plus";
                    size: ControlSize.sm;
                    y: (parent.height - self.height) / 2;
                    tooltip: model.tip-new-tab;
                    tooltip-flip: true;
                    clicked => { root.new-tab(); }
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        // Toolbar
        Rectangle {
            height: Theme.toolbar-height;
            background: Theme.surface-base;

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;
                alignment: center;

                NotesToolBtn {
                    label: model.wrap-label;
                    tip: model.tip-wrap;
                    active: model.word-wrap;
                    clicked => { root.toggle-wrap(); }
                }
                NotesToolBtn {
                    label: model.mono-label;
                    tip: model.tip-mono;
                    active: model.mono-font;
                    clicked => { root.toggle-mono(); }
                }
                NotesToolBtn {
                    label: "A−";
                    tip: model.tip-zoom-out;
                    clicked => { root.zoom(-1); }
                }
                NotesToolBtn {
                    label: "A+";
                    tip: model.tip-zoom-in;
                    clicked => { root.zoom(1); }
                }
                NotesToolBtn {
                    label: model.find-label;
                    tip: model.tip-find;
                    active: root.find-open;
                    clicked => {
                        root.find-open = !root.find-open;
                        if (root.find-open) {
                            find-input.focus();
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                NotesToolBtn {
                    label: model.clear-label;
                    tip: model.tip-clear;
                    clicked => { root.clear-note(); }
                }
            }
        }

        // Find bar (always present so Ctrl+F can focus the input)
        Rectangle {
            height: root.find-open ? Theme.toolbar-height : 0px;
            clip: true;
            background: Theme.surface-raised;

            animate height { duration: Theme.motion-fast; easing: ease-out; }

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;
                alignment: center;

                Text {
                    text: model.find-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: Theme.control-sm;
                    background: Theme.surface-sunken;
                    border-radius: Theme.radius-pill;
                    border-width: Theme.hairline;
                    border-color: find-input.has-focus ? Theme.border-focus : Theme.border-default;

                    animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                    if find-input.text == "" : Text {
                        x: Theme.space-4;
                        width: parent.width - Theme.space-8;
                        height: 100%;
                        text: model.find-placeholder;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    find-input := TextInput {
                        x: Theme.space-4;
                        width: parent.width - Theme.space-8;
                        height: 100%;
                        text <=> root.find-query;
                        single-line: true;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        font-family: Theme.font-family-sans;
                        vertical-alignment: center;
                        key-pressed(event) => {
                            if (event.text == Key.Return) {
                                root.find-request(root.find-query, true);
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.find-open = false;
                                edit-input.focus();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                IconButton {
                    icon: "chevron-up";
                    size: ControlSize.sm;
                    tooltip: model.tip-find-prev;
                    tooltip-flip: true;
                    clicked => { root.find-request(root.find-query, false); }
                }
                IconButton {
                    icon: "chevron-down";
                    size: ControlSize.sm;
                    tooltip: model.tip-find-next;
                    tooltip-flip: true;
                    clicked => { root.find-request(root.find-query, true); }
                }
                IconButton {
                    icon: "close";
                    size: ControlSize.sm;
                    tooltip: model.tip-find-close;
                    tooltip-flip: true;
                    clicked => {
                        root.find-open = false;
                        edit-input.focus();
                    }
                }
            }
        }

        if root.find-open : Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        // Title
        Rectangle {
            height: Theme.control-lg;
            background: Theme.surface-base;

            if title-input.text == "" : Text {
                x: Theme.space-4;
                width: parent.width - Theme.space-8;
                height: 100%;
                text: model.title-placeholder;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-xl;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family-sans;
                vertical-alignment: center;
            }

            title-input := TextInput {
                x: Theme.space-4;
                width: parent.width - Theme.space-8;
                height: 100%;
                text: root.draft-title;
                single-line: true;
                color: Theme.text-primary;
                font-size: Theme.font-size-xl;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-family-sans;
                vertical-alignment: center;
                edited => {
                    root.draft-title = self.text;
                    root.title-changed(self.text);
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        // Editor
        Rectangle {
            background: Theme.surface-base;
            vertical-stretch: 1;
            clip: true;

            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, edit-pad.preferred-height);

                edit-pad := HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    padding-top: Theme.space-3;
                    padding-bottom: Theme.space-3;

                    edit-input := TextInput {
                        width: parent.width - Theme.space-8;
                        text: root.draft-text;
                        single-line: false;
                        wrap: model.word-wrap ? word-wrap : no-wrap;
                        color: Theme.text-primary;
                        font-family: model.mono-font ? Theme.font-family-mono : Theme.font-family-sans;
                        font-size: model.font-size * 1px;
                        key-pressed(event) => {
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt)
                            {
                                if (event.text == "f" || event.text == "F") {
                                    root.find-open = true;
                                    find-input.focus();
                                    return accept;
                                }
                                if (event.text == "=" || event.text == "+") {
                                    root.zoom(1);
                                    return accept;
                                }
                                if (event.text == "-") {
                                    root.zoom(-1);
                                    return accept;
                                }
                                if (event.text == "t" || event.text == "T") {
                                    root.new-tab();
                                    return accept;
                                }
                                if (event.text == "w" || event.text == "W") {
                                    root.close-tab(model.active-index);
                                    return accept;
                                }
                            }
                            return reject;
                        }
                        edited => {
                            root.draft-text = self.text;
                            root.synced-body = self.text;
                            root.body-changed(self.text);
                        }
                    }
                }
            }
        }

        // Status bar
        if model.show-status-bar : Rectangle { height: Theme.hairline; background: Theme.border-subtle; }
        if model.show-status-bar : Rectangle {
            height: Theme.control-sm;
            background: Theme.surface-sunken;

            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-4;

                Text {
                    text: model.autosave-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: model.stats-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Text {
                    text: model.font-size-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
