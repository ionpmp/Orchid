import { Theme } from "../../theme_global.slint";
import { ControlSize, IconButton, Tooltip } from "../../kit.slint";
import { Strings } from "../../strings_global.slint";
import { TerminalTabModel } from "../../workspace/defs.slint";

export component TerminalTabs inherits Rectangle {
    in property <[TerminalTabModel]> tabs;
    in property <int> active-tab;

    callback tab-clicked(int);
    callback tab-closed(int);
    callback tab-new();
    callback split-horizontal();
    callback split-vertical();

    height: Theme.toolbar-height;
    background: Theme.surface-sunken;

    Rectangle {
        y: parent.height - Theme.hairline;
        width: 100%;
        height: Theme.hairline;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        padding-left: Theme.space-1;
        padding-right: Theme.space-1;
        spacing: Theme.space-1;
        alignment: center;

        for tab[i] in tabs : Rectangle {
            width: 170px;
            height: Theme.control-sm;
            background: i == active-tab ? Theme.surface-raised
                : tab-ta.has-hover ? Theme.state-hover
                : Colors.transparent;
            border-radius: Theme.radius-md;

            animate background { duration: Theme.motion-fast; easing: ease-out; }

            tab-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.tab-clicked(i); }
            }

            Tooltip {
                x: 0;
                y: parent.height + Theme.space-1;
                shown: tab-ta.has-hover;
                text: tab.title;
            }

            if i == active-tab : Rectangle {
                y: parent.height - self.height - Theme.space-1;
                x: Theme.space-3;
                width: parent.width - Theme.space-6;
                height: Theme.indicator-thickness;
                border-radius: Theme.radius-pill;
                background: Theme.accent-brand;
            }

            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-1;
                spacing: Theme.space-1;

                Text {
                    text: tab.title;
                    color: i == active-tab ? Theme.text-primary : Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    font-weight: i == active-tab ? Theme.weight-semibold : Theme.weight-regular;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: no-wrap;
                    overflow: elide;
                }

                IconButton {
                    icon: "close";
                    size: ControlSize.xs;
                    y: (parent.height - self.height) / 2;
                    tooltip: Strings.terminal-tooltip-tab-close;
                    clicked => { root.tab-closed(i); }
                }
            }
        }

        IconButton {
            icon: "grid";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.terminal-tooltip-split-h;
            tooltip-flip: true;
            clicked => { root.split-horizontal(); }
        }

        IconButton {
            icon: "layers";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.terminal-tooltip-split-v;
            tooltip-flip: true;
            clicked => { root.split-vertical(); }
        }

        IconButton {
            icon: "plus";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.terminal-tooltip-tab-new;
            tooltip-flip: true;
            clicked => { root.tab-new(); }
        }
    }
}
