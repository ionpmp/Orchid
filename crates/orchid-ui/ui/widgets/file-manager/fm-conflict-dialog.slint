import { Theme } from "../../theme_global.slint";
import { ButtonTone, ControlSize, Divider, ToggleSwitch, TouchButton } from "../../kit.slint";
import { Icon } from "../../kit-icons.slint";
import { FmConflictDialog } from "../../workspace/defs.slint";

export component FmConflictDialog inherits Rectangle {
    in property <FmConflictDialog> dialog;
    in-out property <bool> apply-all: false;

    callback choice(string, bool);

    property <bool> entered: false;
    init => { self.entered = true; }

    background: Theme.scrim;
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-fast; easing: ease-out; }

    backdrop-ta := TouchArea {
        clicked => { root.choice("cancel", false); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.entered ? 0px : Theme.space-5);
        width: min(440px, parent.width - Theme.space-8);
        height: min(lay.preferred-height, parent.height - Theme.space-8);

        animate y { duration: Theme.motion-base; easing: ease-out; }
        background: Theme.gradient-glass;
        border-radius: Theme.radius-xl;
        border-width: Theme.hairline;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.elev-3-blur;
        drop-shadow-offset-y: Theme.elev-3-y;
        drop-shadow-color: Theme.shadow-key;
        clip: true;

        TouchArea { }

        lay := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-4;

            HorizontalLayout {
                spacing: Theme.space-3;

                Rectangle {
                    min-width: Theme.control-md;
                    max-width: Theme.control-md;
                    min-height: Theme.control-md;
                    max-height: Theme.control-md;
                    border-radius: Theme.radius-md;
                    background: Theme.feedback-danger-soft;

                    Icon {
                        name: "warning";
                        size: Theme.font-size-xl;
                        tint: Theme.feedback-danger;
                    }
                }

                Text {
                    text: dialog.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-xl;
                    font-weight: Theme.weight-bold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }

            Text {
                text: dialog.message;
                color: Theme.text-secondary;
                font-size: Theme.font-size-md;
                wrap: word-wrap;
            }

            Divider { }

            HorizontalLayout {
                spacing: Theme.space-3;
                min-height: Theme.touch-target;

                Text {
                    text: dialog.apply-all-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-md;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                ToggleSwitch {
                    checked: root.apply-all;
                    toggled => { root.apply-all = !root.apply-all; }
                }
            }

            VerticalLayout {
                spacing: Theme.space-2;

                TouchButton {
                    text: dialog.overwrite-label;
                    tone: ButtonTone.filled;
                    size: ControlSize.md;
                    wide: true;
                    tooltip: dialog.overwrite-label;
                    clicked => { root.choice("overwrite", root.apply-all); }
                }

                HorizontalLayout {
                    spacing: Theme.space-2;

                    TouchButton {
                        text: dialog.skip-label;
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        wide: true;
                        tooltip: dialog.skip-label;
                        clicked => { root.choice("skip", root.apply-all); }
                    }

                    TouchButton {
                        text: dialog.rename-label;
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        wide: true;
                        tooltip: dialog.rename-label;
                        clicked => { root.choice("rename", root.apply-all); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-2;

                    TouchButton {
                        text: dialog.older-label;
                        tone: ButtonTone.ghost;
                        size: ControlSize.md;
                        wide: true;
                        tooltip: dialog.older-label;
                        clicked => { root.choice("older", root.apply-all); }
                    }

                    if dialog.show-resume : TouchButton {
                        text: dialog.resume-label;
                        tone: ButtonTone.ghost;
                        size: ControlSize.md;
                        wide: true;
                        tooltip: dialog.resume-label;
                        clicked => { root.choice("resume", root.apply-all); }
                    }

                    TouchButton {
                        text: dialog.cancel-label;
                        tone: ButtonTone.outline;
                        size: ControlSize.md;
                        wide: true;
                        tooltip: dialog.cancel-label;
                        clicked => { root.choice("cancel", false); }
                    }
                }
            }
        }
    }
}
