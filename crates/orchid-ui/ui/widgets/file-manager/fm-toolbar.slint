import { Theme } from "../../theme_global.slint";
import { Strings } from "../../strings_global.slint";
import { FmTab, FmVisitHistoryItem, FmPathSuggest } from "../../workspace/defs.slint";

export component FmToolbar inherits Rectangle {
    in property <FmTab> tab;
    in property <[FmVisitHistoryItem]> visit-history;
    in property <[FmPathSuggest]> drives;
    in-out property <bool> history-open: false;
    in-out property <bool> drives-open: false;

    callback new-folder();
    callback back();
    callback forward();
    callback up();
    callback home();
    callback history-pick(string);
    callback view-mode-cycle();
    callback sort-cycle();
    callback branch-toggle();
    callback quick-filter-changed(string);
    callback select-toggle();
    callback select-clear();
    in-out property <bool> select-mode: false;
    in property <int> selection-count: 0;

    background: Theme.surface-raised;
    clip: false;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: back-ta.has-hover && tab.can-back ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;
            opacity: tab.can-back ? 1.0 : 0.4;

            // Keep TouchArea enabled so disabled state can still show a hover hint.
            back-ta := TouchArea {
                clicked => {
                    if tab.can-back {
                        root.back();
                    }
                }
            }
            Text { text: "◀"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }

            if back-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: back-hint.preferred-width + 12px;
                height: back-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                back-hint := Text {
                    x: 6px; y: 3px;
                    text: tab.can-back ? Strings.fm-nav-back : Strings.fm-nav-back-disabled;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: fwd-ta.has-hover && tab.can-forward ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;
            opacity: tab.can-forward ? 1.0 : 0.4;

            // Keep TouchArea enabled so disabled state can still show a hover hint.
            fwd-ta := TouchArea {
                clicked => {
                    if tab.can-forward {
                        root.forward();
                    }
                }
            }
            Text { text: "▶"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }

            if fwd-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: fwd-hint.preferred-width + 12px;
                height: fwd-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                fwd-hint := Text {
                    x: 6px; y: 3px;
                    text: tab.can-forward ? Strings.fm-nav-forward : Strings.fm-nav-forward-disabled;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: up-ta.has-hover ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;

            up-ta := TouchArea {
                clicked => { root.up(); }
            }
            Text { text: "▲"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }

            if up-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: up-hint.preferred-width + 12px;
                height: up-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                up-hint := Text {
                    x: 6px; y: 3px;
                    text: Strings.fm-nav-up;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: home-ta.has-hover ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;

            home-ta := TouchArea {
                clicked => { root.home(); }
            }
            Text { text: "🏠"; color: Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: center; }

            if home-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: home-hint.preferred-width + 12px;
                height: home-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                home-hint := Text {
                    x: 6px; y: 3px;
                    text: Strings.fm-nav-home;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: hist-ta.has-hover || root.history-open ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;
            clip: false;
            z: 50;

            hist-ta := TouchArea {
                clicked => {
                    root.drives-open = false;
                    root.history-open = !root.history-open;
                }
            }
            // Clock glyph (history) — rectangles, no emoji.
            Rectangle {
                width: 14px; height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                Rectangle {
                    width: parent.width; height: parent.height;
                    border-radius: parent.width;
                    border-width: 1.5px;
                    border-color: Theme.text-primary;
                    background: transparent;
                }
                Rectangle {
                    x: parent.width / 2 - 1px; y: 3px;
                    width: 2px; height: parent.height * 0.35;
                    background: Theme.text-primary;
                }
                Rectangle {
                    x: parent.width / 2 - 1px; y: parent.height / 2 - 1px;
                    width: parent.width * 0.32; height: 2px;
                    background: Theme.text-primary;
                }
            }

            if hist-ta.has-hover && !root.history-open : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: hist-hint.preferred-width + 12px;
                height: hist-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                hist-hint := Text {
                    x: 6px; y: 3px;
                    text: Strings.fm-nav-history;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }

            if root.history-open : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: 280px;
                height: min(320px, hist-lay.preferred-height + 8px);
                background: Theme.surface-raised;
                border-color: Theme.border-default;
                border-width: 1px;
                border-radius: Theme.radius-md;
                drop-shadow-blur: Theme.reduce-motion ? 0px : 12px;
                drop-shadow-color: #00000060;
                z: 200;
                clip: true;

                hist-lay := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    if root.visit-history.length == 0 : Text {
                        text: Strings.fm-nav-history-empty;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-stretch: 1;
                        height: 36px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    for item in root.visit-history : Rectangle {
                        height: item.is-header ? 22px : 32px;
                        background: !item.is-header && item-ta.has-hover ? Theme.accent-brand : transparent;
                        border-radius: Theme.radius-md;

                        item-ta := TouchArea {
                            enabled: !item.is-header;
                            clicked => {
                                root.history-open = false;
                                root.history-pick(item.path);
                            }
                        }

                        if item.is-header : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }

                        if !item.is-header : HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            if item.frequent : Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                background: Theme.text-primary;
                                border-radius: 4px;
                            }
                            if !item.frequent : Rectangle {
                                width: 8px; height: 8px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 0;
                                Text {
                                    text: item.label;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                                if item.subtitle != "" && item.subtitle != item.label : Text {
                                    text: item.subtitle;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: drv-ta.has-hover || root.drives-open ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;
            clip: false;
            z: 50;

            drv-ta := TouchArea {
                clicked => {
                    root.history-open = false;
                    root.drives-open = !root.drives-open;
                }
            }
            Text {
                text: "C:";
                color: Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if drv-ta.has-hover && !root.drives-open : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: drv-hint.preferred-width + 12px;
                height: drv-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                drv-hint := Text {
                    x: 6px; y: 3px;
                    text: Strings.fm-nav-drives;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }

            if root.drives-open : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: 220px;
                height: min(280px, drv-lay.preferred-height + 8px);
                background: Theme.surface-raised;
                border-color: Theme.border-default;
                border-width: 1px;
                border-radius: Theme.radius-md;
                drop-shadow-blur: Theme.reduce-motion ? 0px : 12px;
                drop-shadow-color: #00000060;
                z: 200;
                clip: true;

                drv-lay := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    if root.drives.length == 0 : Text {
                        text: Strings.fm-nav-drives-empty;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                    }

                    for item in root.drives : Rectangle {
                        height: 28px;
                        background: drow-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        drow-ta := TouchArea {
                            clicked => {
                                root.drives-open = false;
                                root.history-pick(item.path);
                            }
                        }
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: nf-ta.has-hover ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;

            nf-ta := TouchArea {
                clicked => { root.new-folder(); }
            }
            Text { text: "📁+"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }

            if nf-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: nf-hint.preferred-width + 12px;
                height: nf-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                nf-hint := Text {
                    x: 6px; y: 3px;
                    text: Strings.fm-action-new-folder;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle { width: 8px; }

        Rectangle {
            min-width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: root.select-mode || sel-ta.has-hover ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;
            border-width: root.select-mode ? 1px : 0px;
            border-color: Theme.accent-brand;

            sel-ta := TouchArea {
                clicked => { root.select-toggle(); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    Rectangle {
                        x: 0; y: 0; width: 9px; height: 9px;
                        border-width: 1.5px; border-color: root.select-mode ? Theme.accent-brand : Theme.text-primary;
                        background: transparent; border-radius: 1px;
                    }
                    Rectangle {
                        x: 5px; y: 5px; width: 9px; height: 9px;
                        background: root.select-mode ? Theme.accent-brand : Theme.text-primary;
                        border-radius: 1px;
                    }
                }
                Text {
                    text: root.select-mode ? Strings.fm-select-done : Strings.fm-select-mode;
                    color: root.select-mode ? Theme.accent-brand : Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }

        if root.select-mode || root.selection-count > 0 : Rectangle {
            min-width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: clr-ta.has-hover ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;
            clr-ta := TouchArea {
                clicked => { root.select-clear(); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                if root.selection-count > 0 : Text {
                    text: "" + root.selection-count + " " + Strings.fm-select-selected;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Text {
                    text: Strings.fm-select-clear;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { width: 8px; }

        Rectangle {
            width: 36px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-base;
            border-radius: Theme.radius-md;

            sort-ta := TouchArea {
                clicked => { root.sort-cycle(); }
            }
            Text {
                text: tab.sort-by == 0 ? (tab.sort-descending ? "A↓" : "A↑")
                    : tab.sort-by == 1 ? (tab.sort-descending ? "S↓" : "S↑")
                    : tab.sort-by == 2 ? (tab.sort-descending ? "M↓" : "M↑")
                    : (tab.sort-descending ? "T↓" : "T↑");
                color: Theme.accent-brand;
                font-size: Theme.font-size-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if sort-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: sort-hint.preferred-width + 12px;
                height: sort-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                sort-hint := Text {
                    x: 6px; y: 3px;
                    text: Strings.catalog-sort-default;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-base;
            border-radius: Theme.radius-md;

            vm-ta := TouchArea {
                clicked => { root.view-mode-cycle(); }
            }
            // Custom vector representation of the view mode
            Rectangle {
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                // Mode 0: Icons (Grid of 2x2 squares)
                if tab.view-mode == 0 : Rectangle {
                    width: 100%; height: 100%;
                    Rectangle { x: 0; y: 0; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 9px; y: 0; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 0; y: 9px; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 9px; y: 9px; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                }

                // Mode 1: List (3 horizontal lines)
                if tab.view-mode == 1 : Rectangle {
                    width: 100%; height: 100%;
                    Rectangle { x: 0; y: 2px; width: 16px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 0; y: 7px; width: 16px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 0; y: 12px; width: 16px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                }

                // Mode 2: Details (3 lines with small squares on the left)
                if tab.view-mode == 2 : Rectangle {
                    width: 100%; height: 100%;
                    // Row 1
                    Rectangle { x: 0; y: 2px; width: 3px; height: 3px; background: Theme.accent-brand; border-radius: 0.5px; }
                    Rectangle { x: 5px; y: 2px; width: 11px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    // Row 2
                    Rectangle { x: 0; y: 7px; width: 3px; height: 3px; background: Theme.accent-brand; border-radius: 0.5px; }
                    Rectangle { x: 5px; y: 7px; width: 11px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    // Row 3
                    Rectangle { x: 0; y: 12px; width: 3px; height: 3px; background: Theme.accent-brand; border-radius: 0.5px; }
                    Rectangle { x: 5px; y: 12px; width: 11px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                }

                // Mode 3: Gallery (Large frame with small landscape inside)
                if tab.view-mode == 3 : Rectangle {
                    width: 100%; height: 100%;
                    border-width: 1.5px;
                    border-color: Theme.accent-brand;
                    border-radius: 1px;
                    background: transparent;
                    Rectangle {
                        x: 3px; y: 3px;
                        width: 10px; height: 10px;
                        background: Theme.accent-brand;
                        border-radius: 0.5px;
                    }
                }
            }

            if vm-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: vm-hint.preferred-width + 12px;
                height: vm-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                vm-hint := Text {
                    x: 6px; y: 3px;
                    text: tab.view-mode == 0 ? Strings.fm-view-icons : tab.view-mode == 1 ? Strings.fm-view-list : tab.view-mode == 2 ? Strings.fm-view-details : Strings.fm-view-gallery;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle {
            width: 28px; height: 28px;
            y: (parent.height - self.height) / 2;
            background: tab.branch-view || br-ta.has-hover ? Theme.surface-base : transparent;
            border-radius: Theme.radius-md;
            border-width: tab.branch-view ? 1px : 0px;
            border-color: Theme.accent-brand;

            br-ta := TouchArea {
                clicked => { root.branch-toggle(); }
            }
            Text {
                text: "B";
                color: tab.branch-view ? Theme.accent-brand : Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if br-ta.has-hover : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: br-hint.preferred-width + 12px;
                height: br-hint.preferred-height + 6px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 100;
                br-hint := Text {
                    x: 6px; y: 3px;
                    text: Strings.fm-action-branch-view;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                }
            }
        }

        Rectangle { width: 8px; }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-base;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: filter-fs.has-focus ? Theme.accent-brand : Theme.border-default;

            filter-fs := FocusScope {
                width: parent.width;
                height: parent.height;
                TouchArea { clicked => { filter-fs.focus(); } }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: parent.height;

                        if tab.quick-filter == "" : Text {
                            width: parent.width;
                            height: parent.height;
                            text: Strings.fm-quick-filter-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        TextInput {
                            width: parent.width;
                            height: parent.height;
                            text: tab.quick-filter;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.quick-filter-changed(self.text); }
                        }
                    }
                }
            }
        }
    }
}

