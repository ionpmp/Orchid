import { Theme } from "../../theme_global.slint";
import { ControlSize, IconButton } from "../../kit.slint";
import { Icon } from "../../kit-icons.slint";
import { Strings } from "../../strings_global.slint";
import { FmTab, FmVisitHistoryItem, FmPathSuggest, FmBreadcrumb } from "../../workspace/defs.slint";
import { FmBreadcrumbs } from "fm-breadcrumbs.slint";

component FmPickRow inherits Rectangle {
    in property <string> label;
    in property <bool> chosen;
    callback clicked();

    height: Theme.control-sm;
    background: root.chosen ? Theme.accent-soft
        : row-ta.has-hover ? Theme.state-hover
        : transparent;
    border-radius: Theme.radius-md;

    animate background { duration: Theme.motion-fast; easing: ease-out; }

    row-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;

        Rectangle {
            width: Theme.space-2;
            height: Theme.space-2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: root.chosen ? Theme.accent-brand : transparent;
        }

        Text {
            text: root.label;
            color: root.chosen ? Theme.accent-brand : Theme.text-primary;
            font-size: Theme.font-size-sm;
            font-weight: root.chosen ? Theme.weight-semibold : Theme.weight-regular;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component FmToolbar inherits Rectangle {
    in property <FmTab> tab;
    in property <[FmVisitHistoryItem]> visit-history;
    in property <[FmPathSuggest]> drives;
    in property <[FmBreadcrumb]> breadcrumbs;
    in property <[FmPathSuggest]> suggestions;
    in property <bool> drag-active;
    in property <string> drag-drop-target;
    in-out property <bool> history-open: false;
    in-out property <bool> drives-open: false;
    in-out property <bool> view-menu-open: false;
    in-out property <bool> sort-menu-open: false;
    in-out property <bool> editing: false;

    callback new-folder();
    callback back();
    callback forward();
    callback up();
    callback home();
    callback history-pick(string);
    callback breadcrumb-clicked(string);
    callback crumb-drag-hover(string);
    callback crumb-drag-drop(string);
    callback path-edit-changed(string);
    callback path-edit-commit(string);
    callback view-mode-set(int);
    callback sort-column-clicked(int);
    callback branch-toggle();
    callback quick-filter-changed(string);

    background: Theme.surface-raised;
    clip: false;

    property <string> volume-label: tab.breadcrumbs.length > 0 ? tab.breadcrumbs[0].label : "";
    property <string> view-icon: tab.view-mode == 0 ? "grid"
        : tab.view-mode == 1 ? "rows"
        : tab.view-mode == 2 ? "columns"
        : "image";
    property <string> view-label: tab.view-mode == 0 ? Strings.fm-view-icons
        : tab.view-mode == 1 ? Strings.fm-view-list
        : tab.view-mode == 2 ? Strings.fm-view-details
        : Strings.fm-view-gallery;
    property <string> sort-label: tab.sort-by == 0 ? tab.sort-name-label
        : tab.sort-by == 1 ? tab.sort-size-label
        : tab.sort-by == 2 ? tab.sort-modified-label
        : tab.sort-type-label;

    function close-popovers() {
        root.history-open = false;
        root.drives-open = false;
        root.view-menu-open = false;
        root.sort-menu-open = false;
    }

    HorizontalLayout {
        padding-left: Theme.space-1;
        padding-right: Theme.space-1;
        spacing: Theme.space-1;
        alignment: center;

        IconButton {
            icon: "chevron-left";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            opacity: tab.can-back ? 1.0 : 0.4;
            tooltip: tab.can-back ? Strings.fm-nav-back : Strings.fm-nav-back-disabled;
            clicked => {
                if tab.can-back {
                    root.close-popovers();
                    root.back();
                }
            }
        }

        IconButton {
            icon: "chevron-right";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            opacity: tab.can-forward ? 1.0 : 0.4;
            tooltip: tab.can-forward ? Strings.fm-nav-forward : Strings.fm-nav-forward-disabled;
            clicked => {
                if tab.can-forward {
                    root.close-popovers();
                    root.forward();
                }
            }
        }

        IconButton {
            icon: "arrow-up";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.fm-nav-up;
            clicked => {
                root.close-popovers();
                root.up();
            }
        }

        IconButton {
            icon: "home";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.fm-nav-home;
            clicked => {
                root.close-popovers();
                root.home();
            }
        }

        Rectangle {
            width: Theme.icon-button-sm;
            height: Theme.icon-button-sm;
            y: (parent.height - self.height) / 2;
            background: transparent;
            clip: false;
            z: 50;

            IconButton {
                icon: "clock";
                size: ControlSize.sm;
                active: root.history-open;
                tooltip: root.history-open ? "" : Strings.fm-nav-history;
                clicked => {
                    root.drives-open = false;
                    root.view-menu-open = false;
                    root.sort-menu-open = false;
                    root.editing = false;
                    root.history-open = !root.history-open;
                }
            }

            if root.history-open : Rectangle {
                x: 0;
                y: parent.height + Theme.space-1;
                width: 280px;
                height: min(320px, hist-lay.preferred-height + Theme.space-2);
                background: Theme.surface-floating;
                border-color: Theme.border-default;
                border-width: Theme.hairline;
                border-radius: Theme.radius-lg;
                drop-shadow-blur: Theme.elev-2-blur;
                drop-shadow-offset-y: Theme.elev-2-y;
                drop-shadow-color: Theme.shadow-key;
                z: 200;
                clip: true;

                hist-lay := VerticalLayout {
                    padding: Theme.space-1;
                    spacing: Theme.hairline;

                    if root.visit-history.length == 0 : Text {
                        text: Strings.fm-nav-history-empty;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-stretch: 1;
                        height: Theme.control-sm;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    for item in root.visit-history : Rectangle {
                        height: item.is-header ? Theme.space-6 : Theme.space-8;
                        background: !item.is-header && item-ta.has-hover ? Theme.accent-brand : transparent;
                        border-radius: Theme.radius-md;

                        item-ta := TouchArea {
                            enabled: !item.is-header;
                            clicked => {
                                root.history-open = false;
                                root.history-pick(item.path);
                            }
                        }

                        if item.is-header : Text {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }

                        if !item.is-header : HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            spacing: Theme.space-2;

                            if item.frequent : Rectangle {
                                width: Theme.space-2; height: Theme.space-2;
                                y: (parent.height - self.height) / 2;
                                background: Theme.text-primary;
                                border-radius: Theme.radius-xs;
                            }
                            if !item.frequent : Rectangle {
                                width: Theme.space-2; height: Theme.space-2;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 0;
                                Text {
                                    text: item.label;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                                if item.subtitle != "" && item.subtitle != item.label : Text {
                                    text: item.subtitle;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        FmBreadcrumbs {
            horizontal-stretch: 1;
            min-width: 48px;
            height: Theme.control-sm;
            y: (parent.height - self.height) / 2;
            breadcrumbs: root.breadcrumbs;
            suggestions: root.suggestions;
            drag-active: root.drag-active;
            drag-drop-target: root.drag-drop-target;
            editing <=> root.editing;
            clicked(p) => {
                root.close-popovers();
                root.breadcrumb-clicked(p);
            }
            crumb-drag-hover(p) => { root.crumb-drag-hover(p); }
            crumb-drag-drop(p) => { root.crumb-drag-drop(p); }
            edit-changed(t) => { root.path-edit-changed(t); }
            edit-commit(t) => { root.path-edit-commit(t); }
        }

        Rectangle {
            width: root.volume-label == "" ? Theme.icon-button-sm : 52px;
            height: Theme.icon-button-sm;
            y: (parent.height - self.height) / 2;
            background: drv-ta.has-hover || root.drives-open ? Theme.state-hover : Theme.surface-sunken;
            border-radius: Theme.radius-pill;
            clip: false;
            z: 50;

            animate background { duration: Theme.motion-fast; easing: ease-out; }

            drv-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.history-open = false;
                    root.view-menu-open = false;
                    root.sort-menu-open = false;
                    root.editing = false;
                    root.drives-open = !root.drives-open;
                }
            }

            if root.volume-label == "" : Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "drive";
                size: 16px;
                tint: root.drives-open ? Theme.accent-brand : Theme.text-secondary;
            }

            if root.volume-label != "" : Text {
                x: Theme.space-2;
                width: parent.width - Theme.space-4;
                height: parent.height;
                text: root.volume-label;
                color: root.drives-open ? Theme.accent-brand : Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.drives-open : Rectangle {
                x: 0;
                y: parent.height + Theme.space-1;
                width: 220px;
                height: min(280px, drv-lay.preferred-height + Theme.space-2);
                background: Theme.surface-floating;
                border-color: Theme.border-default;
                border-width: Theme.hairline;
                border-radius: Theme.radius-lg;
                drop-shadow-blur: Theme.elev-2-blur;
                drop-shadow-offset-y: Theme.elev-2-y;
                drop-shadow-color: Theme.shadow-key;
                z: 200;
                clip: true;

                drv-lay := VerticalLayout {
                    padding: Theme.space-1;
                    spacing: Theme.hairline;

                    if root.drives.length == 0 : Text {
                        text: Strings.fm-nav-drives-empty;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                    }

                    for item in root.drives : Rectangle {
                        height: Theme.control-xs;
                        background: drow-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        drow-ta := TouchArea {
                            clicked => {
                                root.drives-open = false;
                                root.history-pick(item.path);
                            }
                        }
                        Text {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        IconButton {
            icon: "plus";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.fm-action-new-folder;
            clicked => {
                root.close-popovers();
                root.new-folder();
            }
        }

        IconButton {
            icon: "tree";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            active: tab.branch-view;
            tooltip: Strings.fm-action-branch-view;
            clicked => {
                root.close-popovers();
                root.branch-toggle();
            }
        }

        Rectangle {
            width: Theme.icon-button-sm;
            height: Theme.icon-button-sm;
            y: (parent.height - self.height) / 2;
            clip: false;
            z: 60;

            IconButton {
                icon: "sliders";
                size: ControlSize.sm;
                active: root.sort-menu-open;
                tooltip: root.sort-menu-open ? "" : root.sort-label;
                tooltip-flip: true;
                clicked => {
                    root.history-open = false;
                    root.drives-open = false;
                    root.view-menu-open = false;
                    root.editing = false;
                    root.sort-menu-open = !root.sort-menu-open;
                }
            }

            if root.sort-menu-open : Rectangle {
                x: parent.width - self.width;
                y: parent.height + Theme.space-1;
                width: 180px;
                height: sort-lay.preferred-height + Theme.space-2;
                background: Theme.surface-floating;
                border-color: Theme.border-default;
                border-width: Theme.hairline;
                border-radius: Theme.radius-lg;
                drop-shadow-blur: Theme.elev-2-blur;
                drop-shadow-offset-y: Theme.elev-2-y;
                drop-shadow-color: Theme.shadow-key;
                z: 200;
                clip: true;

                sort-lay := VerticalLayout {
                    padding: Theme.space-1;
                    spacing: Theme.hairline;

                    FmPickRow {
                        label: tab.sort-name-label + (tab.sort-by == 0 ? (tab.sort-descending ? "  ↓" : "  ↑") : "");
                        chosen: tab.sort-by == 0;
                        clicked => {
                            root.sort-menu-open = false;
                            root.sort-column-clicked(0);
                        }
                    }
                    FmPickRow {
                        label: tab.sort-size-label + (tab.sort-by == 1 ? (tab.sort-descending ? "  ↓" : "  ↑") : "");
                        chosen: tab.sort-by == 1;
                        clicked => {
                            root.sort-menu-open = false;
                            root.sort-column-clicked(1);
                        }
                    }
                    FmPickRow {
                        label: tab.sort-modified-label + (tab.sort-by == 2 ? (tab.sort-descending ? "  ↓" : "  ↑") : "");
                        chosen: tab.sort-by == 2;
                        clicked => {
                            root.sort-menu-open = false;
                            root.sort-column-clicked(2);
                        }
                    }
                    FmPickRow {
                        label: tab.sort-type-label + (tab.sort-by == 3 ? (tab.sort-descending ? "  ↓" : "  ↑") : "");
                        chosen: tab.sort-by == 3;
                        clicked => {
                            root.sort-menu-open = false;
                            root.sort-column-clicked(3);
                        }
                    }
                }
            }
        }

        Rectangle {
            width: Theme.icon-button-sm;
            height: Theme.icon-button-sm;
            y: (parent.height - self.height) / 2;
            clip: false;
            z: 60;

            IconButton {
                icon: root.view-icon;
                size: ControlSize.sm;
                active: root.view-menu-open;
                tooltip: root.view-menu-open ? "" : root.view-label;
                tooltip-flip: true;
                clicked => {
                    root.history-open = false;
                    root.drives-open = false;
                    root.sort-menu-open = false;
                    root.editing = false;
                    root.view-menu-open = !root.view-menu-open;
                }
            }

            if root.view-menu-open : Rectangle {
                x: parent.width - self.width;
                y: parent.height + Theme.space-1;
                width: 168px;
                height: view-lay.preferred-height + Theme.space-2;
                background: Theme.surface-floating;
                border-color: Theme.border-default;
                border-width: Theme.hairline;
                border-radius: Theme.radius-lg;
                drop-shadow-blur: Theme.elev-2-blur;
                drop-shadow-offset-y: Theme.elev-2-y;
                drop-shadow-color: Theme.shadow-key;
                z: 200;
                clip: true;

                view-lay := VerticalLayout {
                    padding: Theme.space-1;
                    spacing: Theme.hairline;

                    FmPickRow {
                        label: Strings.fm-view-icons;
                        chosen: tab.view-mode == 0;
                        clicked => {
                            root.view-menu-open = false;
                            root.view-mode-set(0);
                        }
                    }
                    FmPickRow {
                        label: Strings.fm-view-list;
                        chosen: tab.view-mode == 1;
                        clicked => {
                            root.view-menu-open = false;
                            root.view-mode-set(1);
                        }
                    }
                    FmPickRow {
                        label: Strings.fm-view-details;
                        chosen: tab.view-mode == 2;
                        clicked => {
                            root.view-menu-open = false;
                            root.view-mode-set(2);
                        }
                    }
                    FmPickRow {
                        label: Strings.fm-view-gallery;
                        chosen: tab.view-mode == 3;
                        clicked => {
                            root.view-menu-open = false;
                            root.view-mode-set(3);
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 112px;
            height: Theme.icon-button-sm;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-sunken;
            border-radius: Theme.radius-pill;
            border-width: filter-fs.has-focus ? 2px : Theme.hairline;
            border-color: filter-fs.has-focus ? Theme.border-focus : Theme.border-default;

            animate border-width, border-color {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            filter-fs := FocusScope {
                width: parent.width;
                height: parent.height;
                TouchArea {
                    clicked => { filter-input.focus(); }
                }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        name: "search";
                        size: 14px;
                        tint: Theme.text-tertiary;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: parent.height;

                        if tab.quick-filter == "" : Text {
                            width: parent.width;
                            height: parent.height;
                            text: Strings.fm-quick-filter-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        filter-input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            text: tab.quick-filter;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.quick-filter-changed(self.text); }
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    if (tab.quick-filter != "") {
                                        root.quick-filter-changed("");
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
            }
        }
    }
}
