import { Theme } from "../../theme_global.slint";
import { ControlSize, IconButton, Tooltip } from "../../kit.slint";
import { Strings } from "../../strings_global.slint";
import { FmTab, FmVisitHistoryItem, FmPathSuggest } from "../../workspace/defs.slint";

export component FmToolbar inherits Rectangle {
    in property <FmTab> tab;
    in property <[FmVisitHistoryItem]> visit-history;
    in property <[FmPathSuggest]> drives;
    in-out property <bool> history-open: false;
    in-out property <bool> drives-open: false;

    callback new-folder();
    callback back();
    callback forward();
    callback up();
    callback home();
    callback history-pick(string);
    callback view-mode-cycle();
    callback sort-cycle();
    callback branch-toggle();
    callback quick-filter-changed(string);
    callback deselect-all();
    in property <int> selection-count: 0;

    background: Theme.surface-raised;
    clip: false;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;

        // Navigation cluster. Buttons stay clickable while disabled so the
        // tooltip can explain *why* they are unavailable.
        IconButton {
            icon: "chevron-left";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            opacity: tab.can-back ? 1.0 : 0.4;
            tooltip: tab.can-back ? Strings.fm-nav-back : Strings.fm-nav-back-disabled;
            clicked => {
                if tab.can-back {
                    root.back();
                }
            }
        }

        IconButton {
            icon: "chevron-right";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            opacity: tab.can-forward ? 1.0 : 0.4;
            tooltip: tab.can-forward ? Strings.fm-nav-forward : Strings.fm-nav-forward-disabled;
            clicked => {
                if tab.can-forward {
                    root.forward();
                }
            }
        }

        IconButton {
            icon: "arrow-up";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.fm-nav-up;
            clicked => { root.up(); }
        }

        IconButton {
            icon: "home";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.fm-nav-home;
            clicked => { root.home(); }
        }

        // History button plus its popover, wrapped so the list can overflow.
        Rectangle {
            width: Theme.control-md;
            height: Theme.control-md;
            y: (parent.height - self.height) / 2;
            background: transparent;
            clip: false;
            z: 50;

            IconButton {
                icon: "clock";
                size: ControlSize.sm;
                active: root.history-open;
                tooltip: root.history-open ? "" : Strings.fm-nav-history;
                clicked => {
                    root.drives-open = false;
                    root.history-open = !root.history-open;
                }
            }

            if root.history-open : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: 280px;
                height: min(320px, hist-lay.preferred-height + 8px);
                background: Theme.surface-raised;
                border-color: Theme.border-default;
                border-width: 1px;
                border-radius: Theme.radius-md;
                drop-shadow-blur: Theme.reduce-motion ? 0px : 12px;
                drop-shadow-color: #00000060;
                z: 200;
                clip: true;

                hist-lay := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    if root.visit-history.length == 0 : Text {
                        text: Strings.fm-nav-history-empty;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-stretch: 1;
                        height: 36px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    for item in root.visit-history : Rectangle {
                        height: item.is-header ? 22px : 32px;
                        background: !item.is-header && item-ta.has-hover ? Theme.accent-brand : transparent;
                        border-radius: Theme.radius-md;

                        item-ta := TouchArea {
                            enabled: !item.is-header;
                            clicked => {
                                root.history-open = false;
                                root.history-pick(item.path);
                            }
                        }

                        if item.is-header : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }

                        if !item.is-header : HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            if item.frequent : Rectangle {
                                width: 8px; height: 8px;
                                y: (parent.height - self.height) / 2;
                                background: Theme.text-primary;
                                border-radius: 4px;
                            }
                            if !item.frequent : Rectangle {
                                width: 8px; height: 8px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 0;
                                Text {
                                    text: item.label;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                                if item.subtitle != "" && item.subtitle != item.label : Text {
                                    text: item.subtitle;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Drive picker plus its popover.
        Rectangle {
            width: Theme.control-md;
            height: Theme.control-md;
            y: (parent.height - self.height) / 2;
            background: drv-ta.has-hover || root.drives-open ? Theme.state-hover : Colors.transparent;
            border-radius: Theme.radius-md;
            clip: false;
            z: 50;

            animate background { duration: Theme.motion-fast; easing: ease-out; }

            drv-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.history-open = false;
                    root.drives-open = !root.drives-open;
                }
            }
            Text {
                width: 100%;
                height: 100%;
                text: "C:";
                color: root.drives-open ? Theme.accent-brand : Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Tooltip {
                text: Strings.fm-nav-drives;
                shown: drv-ta.has-hover && !root.drives-open;
                x: 0;
                y: parent.height + Theme.space-1;
            }

            if root.drives-open : Rectangle {
                x: 0;
                y: parent.height + 4px;
                width: 220px;
                height: min(280px, drv-lay.preferred-height + 8px);
                background: Theme.surface-raised;
                border-color: Theme.border-default;
                border-width: 1px;
                border-radius: Theme.radius-md;
                drop-shadow-blur: Theme.reduce-motion ? 0px : 12px;
                drop-shadow-color: #00000060;
                z: 200;
                clip: true;

                drv-lay := VerticalLayout {
                    padding: 4px;
                    spacing: 1px;

                    if root.drives.length == 0 : Text {
                        text: Strings.fm-nav-drives-empty;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                    }

                    for item in root.drives : Rectangle {
                        height: 28px;
                        background: drow-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        drow-ta := TouchArea {
                            clicked => {
                                root.drives-open = false;
                                root.history-pick(item.path);
                            }
                        }
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        IconButton {
            icon: "plus";
            size: ControlSize.sm;
            y: (parent.height - self.height) / 2;
            tooltip: Strings.fm-action-new-folder;
            clicked => { root.new-folder(); }
        }

        if root.selection-count > 1 : Rectangle { width: Theme.space-3; }

        // Selection counter doubles as the "deselect all" affordance.
        if root.selection-count > 1 : Rectangle {
            min-width: Theme.control-md;
            height: Theme.control-md;
            y: (parent.height - self.height) / 2;
            background: desel-ta.has-hover ? Theme.state-hover : Theme.accent-soft;
            border-radius: Theme.radius-pill;

            animate background { duration: Theme.motion-fast; easing: ease-out; }

            desel-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.deselect-all(); }
            }
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;
                Text {
                    text: "" + root.selection-count + " " + Strings.fm-select-selected;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Text {
                    text: Strings.fm-action-deselect-all;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { width: Theme.space-3; }

        Rectangle {
            width: 44px;
            height: Theme.control-md;
            y: (parent.height - self.height) / 2;
            background: sort-ta.has-hover ? Theme.state-hover : Theme.surface-sunken;
            border-radius: Theme.radius-pill;

            animate background { duration: Theme.motion-fast; easing: ease-out; }

            sort-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.sort-cycle(); }
            }
            Text {
                width: 100%;
                height: 100%;
                text: tab.sort-by == 0 ? (tab.sort-descending ? "A↓" : "A↑")
                    : tab.sort-by == 1 ? (tab.sort-descending ? "S↓" : "S↑")
                    : tab.sort-by == 2 ? (tab.sort-descending ? "M↓" : "M↑")
                    : (tab.sort-descending ? "T↓" : "T↑");
                color: Theme.accent-brand;
                font-size: Theme.font-size-sm;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Tooltip {
                text: Strings.catalog-sort-default;
                shown: sort-ta.has-hover;
                x: 0;
                y: parent.height + Theme.space-1;
            }
        }

        Rectangle {
            width: Theme.control-md;
            height: Theme.control-md;
            y: (parent.height - self.height) / 2;
            background: vm-ta.has-hover ? Theme.state-hover : Theme.surface-sunken;
            border-radius: Theme.radius-pill;

            animate background { duration: Theme.motion-fast; easing: ease-out; }

            vm-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.view-mode-cycle(); }
            }
            // Custom vector representation of the view mode
            Rectangle {
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                // Mode 0: Icons (Grid of 2x2 squares)
                if tab.view-mode == 0 : Rectangle {
                    width: 100%; height: 100%;
                    Rectangle { x: 0; y: 0; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 9px; y: 0; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 0; y: 9px; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 9px; y: 9px; width: 7px; height: 7px; background: Theme.accent-brand; border-radius: 1px; }
                }

                // Mode 1: List (3 horizontal lines)
                if tab.view-mode == 1 : Rectangle {
                    width: 100%; height: 100%;
                    Rectangle { x: 0; y: 2px; width: 16px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 0; y: 7px; width: 16px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    Rectangle { x: 0; y: 12px; width: 16px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                }

                // Mode 2: Details (3 lines with small squares on the left)
                if tab.view-mode == 2 : Rectangle {
                    width: 100%; height: 100%;
                    // Row 1
                    Rectangle { x: 0; y: 2px; width: 3px; height: 3px; background: Theme.accent-brand; border-radius: 0.5px; }
                    Rectangle { x: 5px; y: 2px; width: 11px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    // Row 2
                    Rectangle { x: 0; y: 7px; width: 3px; height: 3px; background: Theme.accent-brand; border-radius: 0.5px; }
                    Rectangle { x: 5px; y: 7px; width: 11px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                    // Row 3
                    Rectangle { x: 0; y: 12px; width: 3px; height: 3px; background: Theme.accent-brand; border-radius: 0.5px; }
                    Rectangle { x: 5px; y: 12px; width: 11px; height: 2px; background: Theme.accent-brand; border-radius: 1px; }
                }

                // Mode 3: Gallery (Large frame with small landscape inside)
                if tab.view-mode == 3 : Rectangle {
                    width: 100%; height: 100%;
                    border-width: 1.5px;
                    border-color: Theme.accent-brand;
                    border-radius: 1px;
                    background: transparent;
                    Rectangle {
                        x: 3px; y: 3px;
                        width: 10px; height: 10px;
                        background: Theme.accent-brand;
                        border-radius: 0.5px;
                    }
                }
            }

            Tooltip {
                text: tab.view-mode == 0 ? Strings.fm-view-icons : tab.view-mode == 1 ? Strings.fm-view-list : tab.view-mode == 2 ? Strings.fm-view-details : Strings.fm-view-gallery;
                shown: vm-ta.has-hover;
                x: 0;
                y: parent.height + Theme.space-1;
            }
        }

        Rectangle {
            width: Theme.control-md;
            height: Theme.control-md;
            y: (parent.height - self.height) / 2;
            background: tab.branch-view ? Theme.accent-soft
                : br-ta.has-hover ? Theme.state-hover
                : Theme.surface-sunken;
            border-radius: Theme.radius-pill;
            border-width: tab.branch-view ? Theme.hairline : 0px;
            border-color: Theme.accent-muted;

            animate background { duration: Theme.motion-fast; easing: ease-out; }

            br-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.branch-toggle(); }
            }
            Text {
                width: 100%;
                height: 100%;
                text: "B";
                color: tab.branch-view ? Theme.accent-brand : Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Tooltip {
                text: Strings.fm-action-branch-view;
                shown: br-ta.has-hover;
                x: 0;
                y: parent.height + Theme.space-1;
            }
        }

        Rectangle { width: Theme.space-3; }

        // Quick filter field.
        Rectangle {
            horizontal-stretch: 1;
            height: Theme.control-md;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-sunken;
            border-radius: Theme.radius-pill;
            border-width: filter-fs.has-focus ? 2px : Theme.hairline;
            border-color: filter-fs.has-focus ? Theme.border-focus : Theme.border-default;

            animate border-width, border-color {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            filter-fs := FocusScope {
                width: parent.width;
                height: parent.height;
                TouchArea { clicked => { filter-fs.focus(); } }

                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-2;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: parent.height;

                        if tab.quick-filter == "" : Text {
                            width: parent.width;
                            height: parent.height;
                            text: Strings.fm-quick-filter-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        TextInput {
                            width: parent.width;
                            height: parent.height;
                            text: tab.quick-filter;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.quick-filter-changed(self.text); }
                        }
                    }
                }
            }
        }
    }
}

