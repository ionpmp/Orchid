import { Theme } from "../../theme_global.slint";
import { Strings } from "../../strings_global.slint";
import { ShortcutBindings } from "../../shortcuts_global.slint";
import { FmPane as FmPaneModel, FmRenameState, FmVisitHistoryItem, FmPathSuggest } from "../../workspace/defs.slint";
import { FmTabs } from "fm-tabs.slint";
import { FmToolbar } from "fm-toolbar.slint";
import { FmBreadcrumbs } from "fm-breadcrumbs.slint";
import { FmEntryList } from "fm-entry-list.slint";
import { FmEntryGrid } from "fm-entry-grid.slint";

export component FmPane inherits Rectangle {
    in property <FmPaneModel> pane;
    in property <int> pane-index;
    in property <bool> is-active;
    in property <string> clipboard-hint;
    in property <string> activity-hint;
    in property <bool> transfer-active;
    in property <float> transfer-progress;
    in property <bool> transfer-paused;
    in property <int> transfer-queue;
    in property <FmRenameState> rename;
    in property <bool> drag-active;
    in property <string> drag-drop-target;
    in property <bool> drag-pane-target;
    in property <[FmVisitHistoryItem]> visit-history;
    in property <[FmPathSuggest]> path-suggestions;
    in property <[FmPathSuggest]> drives;

    callback tab-clicked(int, string);
    callback tab-closed(int, string);
    callback tab-new();
    callback new-folder();
    callback nav-back();
    callback nav-forward();
    callback nav-up();
    callback nav-home();
    callback history-pick(string);
    callback breadcrumb-clicked(string);
    callback path-edit-changed(string);
    callback path-edit-commit(string);
    callback view-mode-cycle();
    callback sort-cycle();
    callback sort-column-clicked(int);
    callback quick-filter-changed(string);
    callback entry-clicked(string, bool);
    callback entry-shift-clicked(string);
    callback entry-double-clicked(string, bool);
    callback entry-context(string, length, length);
    callback pane-focused();
    callback select-all();
    callback selection-command(string);
    callback nav-command(string);
    callback marquee-select(int, int, bool, int);
    callback delete-selected();
    callback copy-selected();
    callback paste-clipboard();
    callback rename-selected();
    callback deselect-all();
    callback open-selected();
    callback move-selection(int, bool);
    callback rename-commit(string, string);
    callback rename-cancel();
    callback entry-drag-start(string);
    callback entry-drag-hover(string);
    callback entry-drag-drop(string);
    callback entry-drag-cancel();
    callback pane-drag-hover();
    callback drop-on-current-dir();
    callback entry-drag-scroll(length, length, length, length);
    callback viewport-changed(length, length, length);
    callback error-action();
    callback crumb-drag-hover(string);
    callback crumb-drag-drop(string);

    background: Theme.surface-base;
    clip: false;
    property <bool> history-open: false;
    property <bool> drives-open: false;
    property <bool> address-editing: false;

    property <bool> grid-view: pane.tabs.length > pane.active-tab && pane.active-tab >= 0
        && (pane.tabs[pane.active-tab].view-mode == 0 || pane.tabs[pane.active-tab].view-mode == 3);
    property <length> grid-tile: grid-view && pane.tabs[pane.active-tab].view-mode == 3 ? 220px : 100px;
    property <int> grid-cols: max(1, floor((root.width - 8px) / (grid-tile + 8px)));

    function named-key(t: string) -> string {
        if (t == Key.F1) { return "F1"; }
        if (t == Key.F2) { return "F2"; }
        if (t == Key.F3) { return "F3"; }
        if (t == Key.F4) { return "F4"; }
        if (t == Key.F5) { return "F5"; }
        if (t == Key.F6) { return "F6"; }
        if (t == Key.F7) { return "F7"; }
        if (t == Key.F8) { return "F8"; }
        if (t == Key.F9) { return "F9"; }
        if (t == Key.F10) { return "F10"; }
        if (t == Key.F11) { return "F11"; }
        if (t == Key.F12) { return "F12"; }
        if (t == Key.Return) { return "Enter"; }
        if (t == Key.Delete) { return "Delete"; }
        if (t == Key.Backspace) { return "Backspace"; }
        if (t == Key.Escape) { return "Escape"; }
        if (t == Key.Tab) { return "Tab"; }
        if (t == Key.Insert) { return "Insert"; }
        if (t == Key.Home) { return "Home"; }
        if (t == Key.End) { return "End"; }
        if (t == Key.PageUp) { return "PageUp"; }
        if (t == Key.PageDown) { return "PageDown"; }
        if (t == Key.UpArrow) { return "ArrowUp"; }
        if (t == Key.DownArrow) { return "ArrowDown"; }
        if (t == Key.LeftArrow) { return "ArrowLeft"; }
        if (t == Key.RightArrow) { return "ArrowRight"; }
        if (t == " ") { return "Space"; }
        return t;
    }

    function dispatch-fm-action(act: string) -> bool {
        if (act == "") { return false; }
        if (act == "fs.select-all") { root.select-all(); return true; }
        if (act == "fs.deselect-all") { root.deselect-all(); return true; }
        if (act == "fs.invert-selection") { root.selection-command("invert"); return true; }
        if (act == "fs.select-mask-add") { root.selection-command("mask-add"); return true; }
        if (act == "fs.select-mask-sub") { root.selection-command("mask-sub"); return true; }
        if (act == "fs.copy") { root.copy-selected(); return true; }
        if (act == "fs.cut") { root.nav-command("cut"); return true; }
        if (act == "fs.paste") { root.paste-clipboard(); return true; }
        if (act == "fs.rename") { root.rename-selected(); return true; }
        if (act == "fs.delete") { root.delete-selected(); return true; }
        if (act == "fs.delete-permanent") { root.nav-command("delete-perm"); return true; }
        if (act == "fs.new-folder") { root.new-folder(); return true; }
        if (act == "fs.new-file") { root.nav-command("new-file"); return true; }
        if (act == "viewer.open") { root.nav-command("view"); return true; }
        if (act == "viewer.edit") { root.nav-command("edit"); return true; }
        if (act == "fs.copy-to-other") { root.nav-command("copy-other"); return true; }
        if (act == "fs.move-to-other") { root.nav-command("move-other"); return true; }
        if (act == "fs.open-tab") { root.nav-command("open-tab"); return true; }
        if (act == "fs.open-other-pane") { root.nav-command("other-pane"); return true; }
        if (act == "fs.branch-view") { root.nav-command("branch"); return true; }
        if (act == "fs.find") { root.nav-command("find"); return true; }
        if (act == "fs.properties") { root.nav-command("properties"); return true; }
        if (act == "fs.address-bar") { root.address-editing = true; return true; }
        if (act == "fs.tab-new") { root.tab-new(); return true; }
        if (act == "fs.drive-root") { root.nav-command("drive-root"); return true; }
        if (act == "fs.drives-menu") {
            root.drives-open = !root.drives-open;
            root.history-open = false;
            return true;
        }
        return false;
    }

    pane-keys := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.is-active;
        key-pressed(event) => {
            if (!root.is-active) {
                return reject;
            }
            if (rename.active && event.text == Key.Escape) {
                root.rename-cancel();
                return accept;
            }
            if (drag-active && event.text == Key.Escape) {
                root.entry-drag-cancel();
                return accept;
            }
            if (transfer-active && event.text == Key.Escape) {
                root.nav-command("cancel");
                return accept;
            }
            if (!rename.active && !root.address-editing) {
                if (dispatch-fm-action(ShortcutBindings.resolve-fm-action(
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    event.modifiers.meta,
                    named-key(event.text),
                ))) {
                    return accept;
                }
                if (event.text == Key.Delete && !event.modifiers.shift) {
                    root.delete-selected();
                    return accept;
                }
                if (event.modifiers.control && event.modifiers.shift
                    && (event.text == "n" || event.text == "N")) {
                    root.new-folder();
                    return accept;
                }
            }
            if (event.text == Key.Return) {
                if (!rename.active) {
                    root.open-selected();
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.Backspace) {
                if (!rename.active) {
                    root.nav-up();
                    return accept;
                }
                return reject;
            }
            if (event.modifiers.control && event.text == Key.PageUp) {
                if (!rename.active) {
                    root.nav-up();
                    return accept;
                }
                return reject;
            }
            if (!rename.active) {
                if (event.text == Key.UpArrow) {
                    root.move-selection(root.grid-view ? -root.grid-cols : -1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.move-selection(root.grid-view ? root.grid-cols : 1, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    if (root.grid-view) {
                        root.move-selection(-1, event.modifiers.shift);
                        return accept;
                    }
                    return reject;
                }
                if (event.text == Key.RightArrow) {
                    if (root.grid-view) {
                        root.move-selection(1, event.modifiers.shift);
                        return accept;
                    }
                    return reject;
                }
                if (event.text == Key.Home) {
                    root.move-selection(-100000, event.modifiers.shift);
                    return accept;
                }
                if (event.text == Key.End) {
                    root.move-selection(100000, event.modifiers.shift);
                    return accept;
                }
            }
            if (event.text == Key.Escape) {
                if (root.history-open) {
                    root.history-open = false;
                    return accept;
                }
                if (root.drives-open) {
                    root.drives-open = false;
                    return accept;
                }
                if (root.address-editing) {
                    root.address-editing = false;
                    return accept;
                }
                root.deselect-all();
                return accept;
            }
            return reject;
        }
    }

    pane-ta := TouchArea {
        clicked => {
            root.history-open = false;
            root.drives-open = false;
            root.address-editing = false;
            root.pane-focused();
            pane-keys.focus();
        }
    }

    VerticalLayout {
        spacing: 0;

        FmTabs {
            height: 32px;
            tabs: pane.tabs;
            active-tab: pane.active-tab;
            tab-clicked(idx, id) => { root.tab-clicked(idx, id); }
            tab-closed(idx, id) => { root.tab-closed(idx, id); }
            tab-new => { root.tab-new(); }
        }

        if pane.tabs.length > pane.active-tab && pane.active-tab >= 0 : VerticalLayout {
            spacing: 0;
            vertical-stretch: 1;

            FmToolbar {
                height: 36px;
                z: 50;
                clip: false;
                tab: pane.tabs[pane.active-tab];
                visit-history: root.visit-history;
                drives: root.drives;
                history-open <=> root.history-open;
                drives-open <=> root.drives-open;
                new-folder => { root.new-folder(); }
                back => { root.nav-back(); }
                forward => { root.nav-forward(); }
                up => { root.nav-up(); }
                home => { root.nav-home(); }
                history-pick(path) => { root.history-pick(path); }
                view-mode-cycle => { root.view-mode-cycle(); }
                sort-cycle => { root.sort-cycle(); }
                branch-toggle => { root.nav-command("branch"); }
                quick-filter-changed(q) => { root.quick-filter-changed(q); }
            }

            FmBreadcrumbs {
                height: 28px;
                z: 40;
                clip: false;
                breadcrumbs: pane.tabs[pane.active-tab].breadcrumbs;
                suggestions: root.path-suggestions;
                drag-active: root.drag-active;
                drag-drop-target: root.drag-drop-target;
                editing <=> root.address-editing;
                clicked(p) => { root.breadcrumb-clicked(p); }
                crumb-drag-hover(p) => { root.crumb-drag-hover(p); }
                crumb-drag-drop(p) => { root.crumb-drag-drop(p); }
                edit-changed(t) => { root.path-edit-changed(t); }
                edit-commit(t) => { root.path-edit-commit(t); }
            }

            Rectangle {
                vertical-stretch: 1;

                listing-bg-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { root.history-open = false; root.drives-open = false; root.address-editing = false; }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.entry-context("", self.mouse-x, self.mouse-y);
                        }
                    }
                }

                if pane.tabs[pane.active-tab].is-loading : TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.entry-context("", self.mouse-x, self.mouse-y);
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: Strings.fm-loading;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-md;
                            horizontal-alignment: center;
                        }
                    }
                }

                if !pane.tabs[pane.active-tab].is-loading
                    && pane.tabs[pane.active-tab].error == ""
                    && pane.tabs[pane.active-tab].entry-total-count == 0 : TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.entry-context("", self.mouse-x, self.mouse-y);
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: Strings.fm-empty-folder;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-md;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                if !pane.tabs[pane.active-tab].is-loading
                    && pane.tabs[pane.active-tab].error == ""
                    && pane.tabs[pane.active-tab].entry-total-count > 0
                    && (pane.tabs[pane.active-tab].view-mode == 1 || pane.tabs[pane.active-tab].view-mode == 2) :
                    FmEntryList {
                        width: parent.width;
                        height: parent.height;
                        entries: pane.tabs[pane.active-tab].entries;
                        entry-total-count: pane.tabs[pane.active-tab].entry-total-count;
                        virtual-pad-top: pane.tabs[pane.active-tab].virtual-pad-top;
                        virtual-content-height: pane.tabs[pane.active-tab].virtual-content-height;
                        listing-id: pane.tabs[pane.active-tab].id + "|" + pane.tabs[pane.active-tab].path-display + "|" + pane.tabs[pane.active-tab].quick-filter;
                        rename: root.rename;
                        drag-active: root.drag-active;
                        drag-drop-target: root.drag-drop-target;
                        details: pane.tabs[pane.active-tab].view-mode == 2;
                        sort-by: pane.tabs[pane.active-tab].sort-by;
                        sort-descending: pane.tabs[pane.active-tab].sort-descending;
                        sort-name-label: pane.tabs[pane.active-tab].sort-name-label;
                        sort-size-label: pane.tabs[pane.active-tab].sort-size-label;
                        sort-modified-label: pane.tabs[pane.active-tab].sort-modified-label;
                        sort-type-label: pane.tabs[pane.active-tab].sort-type-label;
                        selection-count: pane.tabs[pane.active-tab].selection-count;
                        entry-clicked(p, ctrl) => {
                            root.history-open = false;
                            root.address-editing = false;
                            root.pane-focused();
                            root.entry-clicked(p, ctrl);
                        }
                        entry-shift-clicked(p) => {
                            root.pane-focused();
                            root.entry-shift-clicked(p);
                        }
                        entry-double-clicked(p, is_dir) => {
                            root.pane-focused();
                            root.entry-double-clicked(p, is_dir);
                        }
                        entry-context(p, x, y) => { root.entry-context(p, x, y); }
                        sort-column-clicked(col) => { root.sort-column-clicked(col); }
                        rename-commit(old, new) => { root.rename-commit(old, new); }
                        rename-cancel => { root.rename-cancel(); }
                        entry-drag-start(p) => { root.entry-drag-start(p); }
                        entry-drag-hover(p) => { root.entry-drag-hover(p); }
                        entry-drag-drop(p) => { root.entry-drag-drop(p); }
                        entry-drag-cancel => { root.entry-drag-cancel(); }
                        pane-drag-hover => { root.pane-drag-hover(); }
                        drop-on-current-dir => { root.drop-on-current-dir(); }
                        drag-scroll-changed(mx, my, vy, w) => { root.entry-drag-scroll(mx, my, vy, w); }
                        viewport-changed(y, h, w) => { root.viewport-changed(y, h, w); }
                        marquee-select(a, b, add) => { root.marquee-select(a, b, add, 1); }
                    }

                if !pane.tabs[pane.active-tab].is-loading
                    && pane.tabs[pane.active-tab].error == ""
                    && pane.tabs[pane.active-tab].entry-total-count > 0
                    && (pane.tabs[pane.active-tab].view-mode == 0 || pane.tabs[pane.active-tab].view-mode == 3) :
                    FmEntryGrid {
                        width: parent.width;
                        height: parent.height;
                        entries: pane.tabs[pane.active-tab].entries;
                        entry-total-count: pane.tabs[pane.active-tab].entry-total-count;
                        virtual-pad-top: pane.tabs[pane.active-tab].virtual-pad-top;
                        virtual-content-height: pane.tabs[pane.active-tab].virtual-content-height;
                        virtual-first-index: pane.tabs[pane.active-tab].virtual-first-index;
                        listing-id: pane.tabs[pane.active-tab].id + "|" + pane.tabs[pane.active-tab].path-display + "|" + pane.tabs[pane.active-tab].quick-filter;
                        rename: root.rename;
                        drag-active: root.drag-active;
                        drag-drop-target: root.drag-drop-target;
                        large: pane.tabs[pane.active-tab].view-mode == 3;
                        selection-count: pane.tabs[pane.active-tab].selection-count;
                        entry-clicked(p, ctrl) => {
                            root.history-open = false;
                            root.address-editing = false;
                            root.pane-focused();
                            root.entry-clicked(p, ctrl);
                        }
                        entry-shift-clicked(p) => {
                            root.pane-focused();
                            root.entry-shift-clicked(p);
                        }
                        entry-double-clicked(p, is_dir) => {
                            root.pane-focused();
                            root.entry-double-clicked(p, is_dir);
                        }
                        entry-context(p, x, y) => { root.entry-context(p, x, y); }
                        rename-commit(old, new) => { root.rename-commit(old, new); }
                        rename-cancel => { root.rename-cancel(); }
                        entry-drag-start(p) => { root.entry-drag-start(p); }
                        entry-drag-hover(p) => { root.entry-drag-hover(p); }
                        entry-drag-drop(p) => { root.entry-drag-drop(p); }
                        entry-drag-cancel => { root.entry-drag-cancel(); }
                        pane-drag-hover => { root.pane-drag-hover(); }
                        drop-on-current-dir => { root.drop-on-current-dir(); }
                        drag-scroll-changed(mx, my, vy, w) => { root.entry-drag-scroll(mx, my, vy, w); }
                        viewport-changed(y, h, w) => { root.viewport-changed(y, h, w); }
                        marquee-select(a, b, add, cols) => { root.marquee-select(a, b, add, cols); }
                    }

                if pane.tabs[pane.active-tab].error != "" : VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: pane.tabs[pane.active-tab].error;
                        color: #ef4444;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    if pane.tabs[pane.active-tab].error-action-label != "" : Rectangle {
                        height: 32px;
                        background: err-action-ta.has-hover ? Theme.accent-brand : Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        err-action-ta := TouchArea {
                            clicked => { root.error-action(); }
                        }

                        Text {
                            text: pane.tabs[pane.active-tab].error-action-label;
                            color: err-action-ta.has-hover ? Theme.text-primary : Theme.accent-brand;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: transfer-active && transfer-progress > 0 ? 27px : 24px;
                background: Theme.surface-raised;
                VerticalLayout {
                    if transfer-active && transfer-progress > 0 : Rectangle {
                        height: 3px;
                        background: Theme.border-default;
                        Rectangle {
                            width: parent.width * transfer-progress;
                            height: parent.height;
                            background: Theme.accent-brand;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100%;

                            status-ta := TouchArea { }

                            Text {
                                text: pane.tabs[pane.active-tab].status-text;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }

                        if activity-hint != "" : Rectangle {
                            height: 100%;

                            activity-ta := TouchArea { }

                            Text {
                                text: activity-hint;
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }

                        if transfer-active : Rectangle {
                            height: 100%;
                            pause-ta := TouchArea {
                                clicked => { root.nav-command(root.transfer-paused ? "resume" : "pause"); }
                            }
                            Text {
                                text: root.transfer-paused ? Strings.fm-transfer-resume : Strings.fm-transfer-pause;
                                color: pause-ta.has-hover ? Theme.text-primary : Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                        }

                        if transfer-active : Rectangle {
                            height: 100%;
                            xfer-cancel-ta := TouchArea {
                                clicked => { root.nav-command("cancel"); }
                            }
                            Text {
                                text: Strings.fm-transfer-cancel;
                                color: xfer-cancel-ta.has-hover ? Theme.text-primary : Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                        }

                        if transfer-queue > 0 : Rectangle {
                            height: 100%;
                            Text {
                                text: "+" + transfer-queue;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                        }

                        if clipboard-hint != "" : Rectangle {
                            height: 100%;

                            clipboard-ta := TouchArea { }

                            Text {
                                text: clipboard-hint;
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}

