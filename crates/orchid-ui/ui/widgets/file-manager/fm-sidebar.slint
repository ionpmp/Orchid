import { Theme } from "../../theme_global.slint";
import { Eyebrow } from "../../kit.slint";
import { FmSidebarItem } from "../../workspace/defs.slint";
import { FmSidebarIcon } from "fm-icons.slint";

export component FmSidebar inherits Rectangle {
    in property <[FmSidebarItem]> items;
    callback clicked(string);

    background: transparent;

    Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: self.width;
        viewport-height: vlay.preferred-height;

        vlay := VerticalLayout {
            spacing: 2px;
            padding: Theme.space-2;

            for item[i] in items : Rectangle {
                height: item.is-section-header ? Theme.control-sm : Theme.row-height;
                background: item.is-active
                    ? Theme.state-selected
                    : (item-ta.has-hover && !item.is-section-header ? Theme.state-hover : transparent);
                border-radius: Theme.radius-md;

                animate background { duration: Theme.motion-fast; easing: ease-out; }

                item-ta := TouchArea {
                    enabled: !item.is-section-header;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.clicked(item.id); }
                }

                // Accent rail marks the active place.
                if item.is-active : Rectangle {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    width: Theme.indicator-thickness;
                    height: parent.height * 0.5;
                    border-radius: Theme.radius-pill;
                    background: Theme.accent-brand;
                }

                HorizontalLayout {
                    padding-left: Theme.space-3 + (item.indent * Theme.space-3);
                    padding-right: Theme.space-3;
                    spacing: Theme.space-3;

                    if !item.is-section-header : FmSidebarIcon {
                        y: (parent.height - self.height) / 2;
                        icon-size: 18px;
                        icon-id: item.icon;
                    }

                    if item.is-section-header : Eyebrow {
                        text: item.label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if !item.is-section-header : Text {
                        text: item.label;
                        color: item.is-active ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-weight: item.is-active ? Theme.weight-semibold : Theme.weight-regular;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}
