import { Theme } from "../../theme_global.slint";
import { FmBreadcrumb, FmPathSuggest } from "../../workspace/defs.slint";

export component FmBreadcrumbs inherits Rectangle {
    in property <[FmBreadcrumb]> breadcrumbs;
    in property <[FmPathSuggest]> suggestions;
    in property <bool> drag-active;
    in property <string> drag-drop-target;
    in-out property <bool> editing: false;

    callback clicked(string);
    callback crumb-drag-hover(string);
    callback crumb-drag-drop(string);
    callback edit-changed(string);
    callback edit-commit(string);

    property <string> draft: "";
    property <bool> suggest-hover: false;

    background: Theme.surface-base;
    clip: false;

    changed editing => {
        if (root.editing) {
            root.suggest-hover = false;
            if (root.breadcrumbs.length > 0) {
                root.draft = root.breadcrumbs[root.breadcrumbs.length - 1].path;
            }
            root.edit-changed(root.draft);
        } else {
            root.suggest-hover = false;
            root.draft = "";
            root.edit-changed("");
        }
    }

    if !root.editing : Flickable {
        width: parent.width;
        height: parent.height;
        viewport-width: hlay.preferred-width;
        viewport-height: self.height;

        hlay := HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: Theme.space-1;
            alignment: start;

            for crumb[i] in breadcrumbs : HorizontalLayout {
                spacing: Theme.space-1;
                if i > 0 : Text {
                    text: "›";
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-md;
                    vertical-alignment: center;
                }

                Rectangle {
                    min-height: Theme.control-sm;
                    y: (parent.height - self.height) / 2;
                    background: (drag-active && crumb.path == drag-drop-target) ? Theme.accent-soft
                        : crumb-ta.has-hover ? Theme.state-hover
                        : Colors.transparent;
                    border-radius: Theme.radius-pill;
                    border-width: (drag-active && crumb.path == drag-drop-target) ? Theme.hairline : 0px;
                    border-color: Theme.accent-muted;

                    animate background { duration: Theme.motion-fast; easing: ease-out; }

                    crumb-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.clicked(crumb.path); }
                        pointer-event(e) => {
                            if (drag-active) {
                                if (e.kind == PointerEventKind.move) {
                                    root.crumb-drag-hover(crumb.path);
                                }
                                if (e.kind == PointerEventKind.up) {
                                    root.crumb-drag-drop(crumb.path);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        Text {
                            text: crumb.label;
                            color: i == breadcrumbs.length - 1 ? Theme.text-primary : Theme.text-secondary;
                            font-weight: i == breadcrumbs.length - 1 ? Theme.weight-semibold : Theme.weight-medium;
                            font-size: Theme.font-size-md;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 24px;
                height: 100%;
                TouchArea {
                    clicked => { root.editing = true; }
                }
            }
        }
    }

    if root.editing : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.surface-sunken;
        border-width: Theme.hairline;
        border-color: Theme.border-focus;
        border-radius: Theme.radius-pill;
        clip: false;
        z: 50;

        path-in := TextInput {
            x: Theme.space-4;
            width: parent.width - Theme.space-8;
            height: parent.height;
            text: root.draft;
            color: Theme.text-primary;
            font-size: Theme.font-size-md;
            font-family: Theme.font-family-mono;
            vertical-alignment: center;
            single-line: true;
            init => { self.focus(); }
            edited => {
                root.draft = self.text;
                root.edit-changed(self.text);
            }
            accepted => {
                root.editing = false;
                root.edit-commit(self.text);
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.editing = false;
                    return accept;
                }
                if (event.text == Key.Tab && root.suggestions.length > 0) {
                    root.draft = root.suggestions[0].path;
                    root.edit-changed(root.draft);
                    return accept;
                }
                return reject;
            }
            changed has-focus => {
                if (!self.has-focus) {
                    blur-timer.running = false;
                    blur-timer.running = true;
                }
            }
        }

        blur-timer := Timer {
            interval: 150ms;
            running: false;
            triggered => {
                if (!root.suggest-hover) {
                    root.editing = false;
                }
                self.running = false;
            }
        }

        if root.suggestions.length > 0 : Rectangle {
            x: 0;
            y: parent.height + Theme.space-1;
            width: parent.width;
            height: min(320px, suggest-lay.preferred-height + Theme.space-2);
            background: Theme.surface-floating;
            border-color: Theme.border-strong;
            border-width: Theme.hairline;
            border-radius: Theme.radius-lg;
            drop-shadow-blur: Theme.elev-2-blur;
            drop-shadow-offset-y: Theme.elev-2-y;
            drop-shadow-color: Theme.shadow-key;
            z: 200;
            clip: true;

            suggest-lay := VerticalLayout {
                padding: Theme.space-1;
                spacing: 1px;
                for item in root.suggestions : Rectangle {
                    height: Theme.row-height;
                    background: item-ta.has-hover ? Theme.state-selected : transparent;
                    border-radius: Theme.radius-md;
                    animate background { duration: Theme.motion-instant; easing: ease-out; }
                    item-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.suggest-hover = true;
                            }
                        }
                        clicked => {
                            root.suggest-hover = false;
                            root.editing = false;
                            root.edit-commit(item.path);
                        }
                    }
                    Text {
                        x: Theme.space-3;
                        width: parent.width - Theme.space-6;
                        height: parent.height;
                        text: item.label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
