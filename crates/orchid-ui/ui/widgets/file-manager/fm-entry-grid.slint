import { Theme } from "../../theme_global.slint";
import { FmEntry, FmRenameState } from "../../workspace/defs.slint";
import { FmEntryIcon } from "fm-icons.slint";

export component FmEntryGrid inherits Rectangle {
    in property <[FmEntry]> entries;
    in property <int> entry-total-count;
    in property <length> virtual-pad-top;
    in property <length> virtual-content-height;
    in property <int> virtual-first-index;
    in property <string> listing-id;
    in property <bool> large;
    in property <FmRenameState> rename;
    in property <bool> drag-active;
    in property <string> drag-drop-target;
    in property <int> selection-count;
    in-out property <bool> select-mode: false;

    property <string> pressing-path: "";
    property <string> pending-exclusive: "";
    property <string> pending-toggle: "";
    property <length> press-x: 0px;
    property <length> press-y: 0px;
    property <length> drag-threshold: 6px;
    property <length> marquee-threshold: 10px;
    property <bool> press-empty: false;
    property <bool> marquee-active: false;
    property <bool> marquee-origin-ready: false;
    property <length> marquee-x0: 0px;
    property <length> marquee-y0: 0px;
    property <length> marquee-x1: 0px;
    property <length> marquee-y1: 0px;
    property <bool> marquee-additive: false;

    callback entry-clicked(string, bool);
    callback entry-shift-clicked(string);
    callback entry-double-clicked(string, bool);
    callback entry-context(string, length, length);
    callback rename-commit(string, string);
    callback rename-cancel();
    callback entry-drag-start(string);
    callback entry-drag-hover(string);
    callback entry-drag-drop(string);
    callback entry-drag-cancel();
    callback pane-drag-hover();
    callback drop-on-current-dir();
    callback drag-scroll-changed(length, length, length, length);
    callback viewport-changed(length, length, length);
    callback marquee-select(int, int, bool, int);
    callback empty-clicked();

    property <length> tile-size: large ? 220px : 100px;
    property <length> tile-height: large ? 240px : 120px;
    property <length> tile-spacing: 8px;
    property <int> columns: max(1, floor((root.width - tile-spacing) / (tile-size + tile-spacing)));
    property <bool> virtualized: virtual-content-height > 0px;
    property <int> total-count: entry-total-count > 0 ? entry-total-count : entries.length;
    property <int> first-index: virtualized ? max(0, virtual-first-index) : 0;

    function cancel-press() {
        root.pressing-path = "";
        root.pending-exclusive = "";
        root.pending-toggle = "";
    }

    function row-top(r: int) -> length {
        return tile-spacing + r * (tile-height + tile-spacing);
    }

    function col-left(c: int) -> length {
        return tile-spacing + c * (tile-size + tile-spacing);
    }

    function row-count() -> int {
        if (total-count <= 0 || columns <= 0) { return 0; }
        return floor((total-count + columns - 1) / columns);
    }

    function first-overlap-row(ry0: length, ry1: length) -> int {
        let n = row-count();
        if (n <= 0) { return -1; }
        let guess = max(0, min(n - 1, floor((ry0 - tile-spacing) / (tile-height + tile-spacing))));
        if (ry0 < row-top(guess) + tile-height && ry1 > row-top(guess)) {
            return guess;
        }
        if (guess + 1 < n && ry0 < row-top(guess + 1) + tile-height && ry1 > row-top(guess + 1)) {
            return guess + 1;
        }
        return -1;
    }

    function last-overlap-row(ry0: length, ry1: length) -> int {
        let n = row-count();
        if (n <= 0) { return -1; }
        let guess = max(0, min(n - 1, floor((ry1 - tile-spacing - 0.5px) / (tile-height + tile-spacing))));
        if (ry0 < row-top(guess) + tile-height && ry1 > row-top(guess)) {
            return guess;
        }
        if (guess > 0 && ry0 < row-top(guess - 1) + tile-height && ry1 > row-top(guess - 1)) {
            return guess - 1;
        }
        return -1;
    }

    function first-overlap-col(rx0: length, rx1: length) -> int {
        let guess = max(0, min(columns - 1, floor((rx0 - tile-spacing) / (tile-size + tile-spacing))));
        if (rx0 < col-left(guess) + tile-size && rx1 > col-left(guess)) {
            return guess;
        }
        if (guess + 1 < columns && rx0 < col-left(guess + 1) + tile-size && rx1 > col-left(guess + 1)) {
            return guess + 1;
        }
        return -1;
    }

    function last-overlap-col(rx0: length, rx1: length) -> int {
        let guess = max(0, min(columns - 1, floor((rx1 - tile-spacing - 0.5px) / (tile-size + tile-spacing))));
        if (rx0 < col-left(guess) + tile-size && rx1 > col-left(guess)) {
            return guess;
        }
        if (guess > 0 && rx0 < col-left(guess - 1) + tile-size && rx1 > col-left(guess - 1)) {
            return guess - 1;
        }
        return -1;
    }

    function finish-empty-gesture() {
        let rx0 = min(root.marquee-x0, root.marquee-x1);
        let rx1 = max(root.marquee-x0, root.marquee-x1);
        let ry0 = min(root.marquee-y0, root.marquee-y1);
        let ry1 = max(root.marquee-y0, root.marquee-y1);
        let dragged = root.marquee-active
            && (abs(rx1 - rx0) >= root.marquee-threshold
                || abs(ry1 - ry0) >= root.marquee-threshold);
        let r0 = root.first-overlap-row(ry0, ry1);
        let r1 = root.last-overlap-row(ry0, ry1);
        let c0 = root.first-overlap-col(rx0, rx1);
        let c1 = root.last-overlap-col(rx0, rx1);
        root.press-empty = false;
        root.marquee-active = false;
        root.marquee-origin-ready = false;
        if (dragged && r0 >= 0 && r1 >= 0 && c0 >= 0 && c1 >= 0) {
            root.select-mode = true;
            root.marquee-select(r0 * columns + c0, r1 * columns + c1, root.marquee-additive, columns);
        } else if (!root.marquee-additive) {
            root.empty-clicked();
        }
    }

    background: transparent;

    // Tiles are recycled by the repeater, so a press can outlive the tile it
    // started on. Drop the gesture whenever the virtual window moves.
    property <int> tile-count: entries.length;

    changed tile-count => {
        root.cancel-press();
    }

    changed first-index => {
        root.cancel-press();
    }

    changed listing-id => {
        grid-flick.viewport-y = 0px;
        root.cancel-press();
        root.press-empty = false;
        root.marquee-active = false;
        root.marquee-origin-ready = false;
        root.select-mode = false;
    }

    hold-timer := Timer {
        interval: 500ms;
        running: root.pressing-path != "" && !root.drag-active && !root.select-mode;
        triggered => {
            if (root.pressing-path != "") {
                root.select-mode = true;
                root.entry-clicked(root.pressing-path, true);
                root.cancel-press();
            }
        }
    }

    grid-flick := Flickable {
        width: parent.width;
        height: parent.height;
        interactive: !root.drag-active && !root.press-empty && !root.marquee-active;
        viewport-width: self.width;
        viewport-height: virtualized
            ? max(self.height, virtual-content-height)
            : max(self.height, ceil(entries.length / columns) * (tile-height + tile-spacing) + tile-spacing);

        changed viewport-y => {
            root.viewport-changed(self.viewport-y, self.height, self.width);
            if (drag-active) {
                root.drag-scroll-changed(bg-ta.mouse-x, bg-ta.mouse-y, self.viewport-y, self.width);
            }
        }

        changed width => {
            root.viewport-changed(self.viewport-y, self.height, self.width);
        }

        changed height => {
            root.viewport-changed(self.viewport-y, self.height, self.width);
        }

        bg-ta := TouchArea {
            y: grid-flick.viewport-y;
            width: grid-flick.width;
            height: grid-flick.height;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                    root.entry-context("", self.mouse-x, self.mouse-y);
                }
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left
                    && !root.drag-active) {
                    root.press-empty = true;
                    root.marquee-active = false;
                    root.marquee-origin-ready = false;
                    root.marquee-x0 = self.mouse-x;
                    root.marquee-y0 = self.mouse-y + grid-flick.viewport-y;
                    root.marquee-x1 = self.mouse-x;
                    root.marquee-y1 = self.mouse-y + grid-flick.viewport-y;
                    root.marquee-additive = e.modifiers.control;
                }
                if (drag-active) {
                    if (e.kind == PointerEventKind.move) {
                        root.pane-drag-hover();
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.drop-on-current-dir();
                    }
                }
            }
        }

        for entry[i] in entries : Rectangle {
            x: tile-spacing + (mod(first-index + i, columns) * (tile-size + tile-spacing));
            y: tile-spacing + (floor((first-index + i) / columns) * (tile-height + tile-spacing));
            width: tile-size;
            height: tile-height;
            background: entry.is-selected
                ? #4d82ff44
                : (tile-ta.has-hover ? Theme.surface-raised : transparent);
            border-radius: Theme.radius-md;
            border-width: entry.is-selected || (drag-active && entry.is-dir && entry.path == drag-drop-target) ? 2px : 0px;
            border-color: Theme.accent-brand;

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                Rectangle {
                    height: tile-size - 32px;
                    background: Theme.surface-base;
                    border-radius: Theme.radius-md;

                    if entry.has-thumbnail : Image {
                        source: entry.thumbnail;
                        image-fit: contain;
                        width: entry.thumbnail-is-icon
                            ? min(parent.width - 8px, max(1px, entry.thumbnail-width * 2px))
                            : parent.width - 8px;
                        height: entry.thumbnail-is-icon
                            ? min(parent.height - 8px, max(1px, entry.thumbnail-height * 2px))
                            : parent.height - 8px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if !entry.has-thumbnail : Rectangle {
                        width: parent.width;
                        height: parent.height;

                        FmEntryIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-size: large ? 64px : 36px;
                            is-dir: entry.is-dir;
                            is-encrypted: entry.is-encrypted;
                            is-managed: entry.is-managed;
                        }
                    }
                }

                if rename.active && entry.path == rename.path : rename-fs := FocusScope {
                    horizontal-stretch: 1;

                    key-pressed(e) => {
                        if (e.text == Key.Return) {
                            root.rename-commit(rename.path, rename-input.text);
                            return accept;
                        }
                        if (e.text == Key.Escape) {
                            root.rename-cancel();
                            return accept;
                        }
                        return reject;
                    }

                    rename-input := TextInput {
                        text: rename.proposed-name;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                        single-line: true;
                    }

                    init => { rename-fs.focus(); }
                }

                if !rename.active || entry.path != rename.path : Text {
                    text: entry.name;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            if entry.is-starred : Text {
                x: parent.width - 20px;
                y: 4px;
                text: "*";
                color: #eab308;
                font-size: Theme.font-size-sm;
            }

            tile-ta := TouchArea {
                width: 100%;
                height: 100%;
                enabled: !(rename.active && entry.path == rename.path);
                double-clicked => {
                    root.cancel-press();
                    root.entry-double-clicked(entry.path, entry.is-dir);
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.cancel-press();
                        if (e.modifiers.shift) {
                            root.entry-shift-clicked(entry.path);
                        } else if (e.modifiers.control || root.select-mode) {
                            root.pending-toggle = entry.path;
                        } else if (entry.is-selected) {
                            root.pending-exclusive = entry.path;
                        } else {
                            root.entry-clicked(entry.path, false);
                        }
                        root.pressing-path = entry.path;
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                    }
                    if (pressing-path != "" && e.kind == PointerEventKind.move) {
                        if (abs(self.mouse-x - press-x) >= drag-threshold
                            || abs(self.mouse-y - press-y) >= drag-threshold) {
                            let dragged-path = root.pressing-path;
                            root.cancel-press();
                            root.entry-drag-start(dragged-path);
                        }
                    }
                    if (drag-active && entry.is-dir) {
                        if (e.kind == PointerEventKind.move) {
                            root.entry-drag-hover(entry.path);
                        }
                        if (e.kind == PointerEventKind.up) {
                            root.entry-drag-drop(entry.path);
                        }
                    }
                    if (e.kind == PointerEventKind.up) {
                        if (drag-active && !entry.is-dir) {
                            root.drop-on-current-dir();
                        }
                        // Commit against the path captured on press, not the
                        // tile's current entry: the tile may have been recycled.
                        if (!root.drag-active && root.pressing-path != "") {
                            if (root.pending-toggle != "") {
                                root.entry-clicked(root.pending-toggle, true);
                            } else if (root.pending-exclusive != "") {
                                root.entry-clicked(root.pending-exclusive, false);
                            }
                        }
                        root.cancel-press();
                    }
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                        root.entry-context(entry.path, self.mouse-x, self.mouse-y);
                    }
                }
            }

        }
    }

    if root.marquee-active : Rectangle {
        x: min(root.marquee-x0, root.marquee-x1);
        y: min(root.marquee-y0, root.marquee-y1) - grid-flick.viewport-y;
        width: max(1px, abs(root.marquee-x1 - root.marquee-x0));
        height: max(1px, abs(root.marquee-y1 - root.marquee-y0));
        background: #4d82ff33;
        border-width: 1px;
        border-color: Theme.accent-brand;
    }

    if root.press-empty : TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                let x = self.mouse-x;
                let y = self.mouse-y + grid-flick.viewport-y;
                if (!root.marquee-origin-ready) {
                    root.marquee-x0 = x;
                    root.marquee-y0 = y;
                    root.marquee-x1 = x;
                    root.marquee-y1 = y;
                    root.marquee-origin-ready = true;
                } else {
                    root.marquee-x1 = x;
                    root.marquee-y1 = y;
                    if (abs(root.marquee-x1 - root.marquee-x0) >= root.marquee-threshold
                        || abs(root.marquee-y1 - root.marquee-y0) >= root.marquee-threshold) {
                        root.marquee-active = true;
                    }
                }
            }
            if (e.kind == PointerEventKind.up) {
                if (root.marquee-origin-ready) {
                    root.marquee-x1 = self.mouse-x;
                    root.marquee-y1 = self.mouse-y + grid-flick.viewport-y;
                }
                root.finish-empty-gesture();
            }
        }
    }
}

