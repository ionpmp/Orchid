import { Theme } from "../../theme_global.slint";
import { ButtonTone, Chip, ControlSize, Divider, Eyebrow, IconButton, ToggleSwitch, TouchButton } from "../../kit.slint";
import { Icon } from "../../kit-icons.slint";
import { FmFindState } from "../../workspace/defs.slint";

export component FmFindDialog inherits Rectangle {
    in property <FmFindState> state;
    callback commit(string);
    callback cancel();

    property <string> name-text: "";
    property <string> content-text: "";
    property <string> size-min: "";
    property <string> size-max: "";
    property <string> days: "";
    property <string> exif-text: "";
    property <string> gps-text: "";
    property <bool> name-regex-on: false;
    property <bool> content-regex-on: false;
    property <bool> case-on: false;
    property <bool> recursive-on: true;
    property <bool> archives-on: false;
    property <bool> indexed-on: false;
    property <bool> save-on: true;
    property <bool> files-on: true;
    property <bool> folders-on: true;
    property <bool> hidden-on: false;
    property <bool> readonly-on: false;
    property <bool> system-on: false;
    property <bool> entered: false;

    init => { self.entered = true; }

    background: Theme.scrim;
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-fast; easing: ease-out; }

    backdrop-ta := TouchArea {
        clicked => { root.cancel(); }
    }

    function packed-payload() -> string {
        return root.name-text + "\n"
            + root.content-text + "\n"
            + (root.name-regex-on ? "1" : "0") + "\n"
            + (root.content-regex-on ? "1" : "0") + "\n"
            + (root.case-on ? "1" : "0") + "\n"
            + (root.recursive-on ? "1" : "0") + "\n"
            + (root.archives-on ? "1" : "0") + "\n"
            + (root.indexed-on ? "1" : "0") + "\n"
            + (root.save-on ? "1" : "0") + "\n"
            + root.size-min + "\n"
            + root.size-max + "\n"
            + root.days + "\n"
            + (root.files-on ? "1" : "0") + "\n"
            + (root.folders-on ? "1" : "0") + "\n"
            + (root.hidden-on ? "1" : "0") + "\n"
            + (root.readonly-on ? "1" : "0") + "\n"
            + (root.system-on ? "1" : "0") + "\n"
            + root.exif-text + "\n"
            + root.gps-text + "\n";
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.entered ? 0px : Theme.space-5);
        width: min(480px, parent.width - Theme.space-8);
        height: min(lay.preferred-height, parent.height - Theme.space-8);

        animate y { duration: Theme.motion-base; easing: ease-out; }
        background: Theme.gradient-glass;
        border-radius: Theme.radius-xl;
        border-width: Theme.hairline;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.elev-3-blur;
        drop-shadow-offset-y: Theme.elev-3-y;
        drop-shadow-color: Theme.shadow-key;
        clip: true;

        TouchArea { }

        lay := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-4;

            HorizontalLayout {
                spacing: Theme.space-3;

                Rectangle {
                    min-width: Theme.control-md;
                    max-width: Theme.control-md;
                    min-height: Theme.control-md;
                    max-height: Theme.control-md;
                    border-radius: Theme.radius-md;
                    background: Theme.accent-soft;

                    Icon {
                        name: "search";
                        size: Theme.font-size-xl;
                        tint: Theme.accent-brand;
                    }
                }

                Text {
                    text: state.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-xl;
                    font-weight: Theme.weight-bold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                IconButton {
                    icon: "close";
                    size: ControlSize.sm;
                    tooltip: state.cancel-label;
                    tooltip-flip: true;
                    clicked => { root.cancel(); }
                }
            }

            if state.hint != "" : Text {
                text: state.hint;
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
                wrap: word-wrap;
            }

            Divider { }

            Flickable {
                vertical-stretch: 1;
                viewport-width: parent.width - Theme.space-10;
                viewport-height: body.preferred-height;
                height: min(body.preferred-height, 420px);

                body := VerticalLayout {
                    width: parent.viewport-width;
                    spacing: Theme.space-4;

                    VerticalLayout {
                        spacing: Theme.space-2;

                        Eyebrow { text: state.name-label; }

                        Rectangle {
                            height: Theme.control-md;
                            background: Theme.surface-sunken;
                            border-radius: Theme.radius-pill;
                            border-width: Theme.hairline;
                            border-color: name-fs.has-focus ? Theme.border-focus : Theme.border-default;
                            animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                            name-fs := FocusScope {
                                width: parent.width;
                                height: parent.height;
                                TouchArea { clicked => { name-fs.focus(); } }

                                HorizontalLayout {
                                    padding-left: Theme.space-4;
                                    padding-right: Theme.space-4;

                                    TextInput {
                                        text: root.name-text;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-md;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        single-line: true;
                                        edited => { root.name-text = self.text; }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        Eyebrow { text: state.content-label; }

                        Rectangle {
                            height: Theme.control-md;
                            background: Theme.surface-sunken;
                            border-radius: Theme.radius-pill;
                            border-width: Theme.hairline;
                            border-color: content-fs.has-focus ? Theme.border-focus : Theme.border-default;
                            animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                            content-fs := FocusScope {
                                width: parent.width;
                                height: parent.height;
                                TouchArea { clicked => { content-fs.focus(); } }

                                HorizontalLayout {
                                    padding-left: Theme.space-4;
                                    padding-right: Theme.space-4;

                                    TextInput {
                                        text: root.content-text;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-md;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        single-line: true;
                                        edited => { root.content-text = self.text; }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        HorizontalLayout {
                            spacing: Theme.space-2;

                            Chip {
                                text: state.name-regex-label;
                                selected: root.name-regex-on;
                                clicked => { root.name-regex-on = !root.name-regex-on; }
                            }
                            Chip {
                                text: state.content-regex-label;
                                selected: root.content-regex-on;
                                clicked => { root.content-regex-on = !root.content-regex-on; }
                            }
                            Chip {
                                text: state.case-label;
                                selected: root.case-on;
                                clicked => { root.case-on = !root.case-on; }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-2;

                            Chip {
                                text: state.recursive-label;
                                selected: root.recursive-on;
                                clicked => { root.recursive-on = !root.recursive-on; }
                            }
                            Chip {
                                text: state.archives-label;
                                selected: root.archives-on;
                                clicked => { root.archives-on = !root.archives-on; }
                            }
                            Chip {
                                text: state.indexed-label;
                                selected: root.indexed-on;
                                clicked => { root.indexed-on = !root.indexed-on; }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-2;

                            Chip {
                                text: state.files-label;
                                selected: root.files-on;
                                clicked => { root.files-on = !root.files-on; }
                            }
                            Chip {
                                text: state.folders-label;
                                selected: root.folders-on;
                                clicked => { root.folders-on = !root.folders-on; }
                            }
                            Chip {
                                text: state.hidden-label;
                                selected: root.hidden-on;
                                clicked => { root.hidden-on = !root.hidden-on; }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-2;

                            Chip {
                                text: state.readonly-label;
                                selected: root.readonly-on;
                                clicked => { root.readonly-on = !root.readonly-on; }
                            }
                            Chip {
                                text: state.system-label;
                                selected: root.system-on;
                                clicked => { root.system-on = !root.system-on; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-3;
                        min-height: Theme.touch-target;

                        Text {
                            text: state.save-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        ToggleSwitch {
                            checked: root.save-on;
                            toggled => { root.save-on = !root.save-on; }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-3;

                        VerticalLayout {
                            spacing: Theme.space-2;
                            horizontal-stretch: 1;

                            Eyebrow { text: state.size-min-label; }

                            Rectangle {
                                height: Theme.control-md;
                                background: Theme.surface-sunken;
                                border-radius: Theme.radius-pill;
                                border-width: Theme.hairline;
                                border-color: size-min-fs.has-focus ? Theme.border-focus : Theme.border-default;
                                animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                                size-min-fs := FocusScope {
                                    width: parent.width;
                                    height: parent.height;
                                    TouchArea { clicked => { size-min-fs.focus(); } }

                                    HorizontalLayout {
                                        padding-left: Theme.space-4;
                                        padding-right: Theme.space-4;

                                        TextInput {
                                            text: root.size-min;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            single-line: true;
                                            edited => { root.size-min = self.text; }
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.space-2;
                            horizontal-stretch: 1;

                            Eyebrow { text: state.size-max-label; }

                            Rectangle {
                                height: Theme.control-md;
                                background: Theme.surface-sunken;
                                border-radius: Theme.radius-pill;
                                border-width: Theme.hairline;
                                border-color: size-max-fs.has-focus ? Theme.border-focus : Theme.border-default;
                                animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                                size-max-fs := FocusScope {
                                    width: parent.width;
                                    height: parent.height;
                                    TouchArea { clicked => { size-max-fs.focus(); } }

                                    HorizontalLayout {
                                        padding-left: Theme.space-4;
                                        padding-right: Theme.space-4;

                                        TextInput {
                                            text: root.size-max;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            single-line: true;
                                            edited => { root.size-max = self.text; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        Eyebrow { text: state.days-label; }

                        Rectangle {
                            height: Theme.control-md;
                            background: Theme.surface-sunken;
                            border-radius: Theme.radius-pill;
                            border-width: Theme.hairline;
                            border-color: days-fs.has-focus ? Theme.border-focus : Theme.border-default;
                            animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                            days-fs := FocusScope {
                                width: parent.width;
                                height: parent.height;
                                TouchArea { clicked => { days-fs.focus(); } }

                                HorizontalLayout {
                                    padding-left: Theme.space-4;
                                    padding-right: Theme.space-4;

                                    TextInput {
                                        text: root.days;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-md;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        single-line: true;
                                        edited => { root.days = self.text; }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-3;

                        VerticalLayout {
                            spacing: Theme.space-2;
                            horizontal-stretch: 1;

                            Eyebrow { text: state.exif-label; }

                            Rectangle {
                                height: Theme.control-md;
                                background: Theme.surface-sunken;
                                border-radius: Theme.radius-pill;
                                border-width: Theme.hairline;
                                border-color: exif-fs.has-focus ? Theme.border-focus : Theme.border-default;
                                animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                                exif-fs := FocusScope {
                                    width: parent.width;
                                    height: parent.height;
                                    TouchArea { clicked => { exif-fs.focus(); } }

                                    HorizontalLayout {
                                        padding-left: Theme.space-4;
                                        padding-right: Theme.space-4;

                                        TextInput {
                                            text: root.exif-text;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            single-line: true;
                                            edited => { root.exif-text = self.text; }
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.space-2;
                            horizontal-stretch: 1;

                            Eyebrow { text: state.gps-label; }

                            Rectangle {
                                height: Theme.control-md;
                                background: Theme.surface-sunken;
                                border-radius: Theme.radius-pill;
                                border-width: Theme.hairline;
                                border-color: gps-fs.has-focus ? Theme.border-focus : Theme.border-default;
                                animate border-color { duration: Theme.motion-fast; easing: ease-out; }

                                gps-fs := FocusScope {
                                    width: parent.width;
                                    height: parent.height;
                                    TouchArea { clicked => { gps-fs.focus(); } }

                                    HorizontalLayout {
                                        padding-left: Theme.space-4;
                                        padding-right: Theme.space-4;

                                        TextInput {
                                            text: root.gps-text;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            single-line: true;
                                            edited => { root.gps-text = self.text; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Divider { }

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;

                TouchButton {
                    text: state.cancel-label;
                    tone: ButtonTone.ghost;
                    size: ControlSize.md;
                    tooltip: state.cancel-label;
                    clicked => { root.cancel(); }
                }

                TouchButton {
                    text: state.ok-label;
                    icon: "search";
                    tone: ButtonTone.filled;
                    size: ControlSize.md;
                    tooltip: state.ok-label;
                    clicked => { root.commit(root.packed-payload()); }
                }
            }
        }
    }
}
