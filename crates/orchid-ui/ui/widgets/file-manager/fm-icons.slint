import { Theme } from "../../theme_global.slint";

/// Folder / file glyphs drawn with rectangles (no emoji / font dependency).
export component FmEntryIcon inherits Rectangle {
    in property <bool> is-dir;
    in property <bool> is-encrypted;
    in property <bool> is-managed;
    in property <length> icon-size: 16px;

    width: icon-size;
    height: icon-size;
    background: transparent;

    if is-dir : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        Rectangle {
            x: parent.width * 0.05;
            y: parent.height * 0.1;
            width: parent.width * 0.4;
            height: parent.height * 0.15;
            background: Theme.accent-brand;
            border-radius: max(1px, parent.width * 0.05);
        }
        Rectangle {
            x: parent.width * 0.05;
            y: parent.height * 0.22;
            width: parent.width * 0.9;
            height: parent.height * 0.68;
            background: Theme.accent-brand;
            border-radius: max(1px, parent.width * 0.05);
        }
    }

    if !is-dir && !is-encrypted && !is-managed : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        Rectangle {
            x: parent.width * 0.15;
            y: parent.height * 0.05;
            width: parent.width * 0.7;
            height: parent.height * 0.9;
            background: Theme.text-tertiary;
            border-radius: max(1px, parent.width * 0.05);
        }
        Rectangle {
            x: parent.width * 0.55;
            y: parent.height * 0.05;
            width: parent.width * 0.3;
            height: parent.height * 0.3;
            background: Theme.surface-raised;
            border-bottom-left-radius: max(1px, parent.width * 0.05);
        }
    }

    if !is-dir && is-encrypted : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        // Padlock shackle
        Rectangle {
            x: (parent.width - parent.width * 0.4) / 2;
            y: parent.height * 0.1;
            width: parent.width * 0.4;
            height: parent.height * 0.4;
            border-width: max(1.5px, parent.width * 0.08);
            border-color: Theme.accent-brand;
            background: transparent;
            border-radius: parent.width * 0.2;
        }
        // Padlock body
        Rectangle {
            x: (parent.width - parent.width * 0.6) / 2;
            y: parent.height * 0.4;
            width: parent.width * 0.6;
            height: parent.height * 0.45;
            background: Theme.accent-brand;
            border-radius: max(1px, parent.width * 0.08);
        }
    }

    if !is-dir && is-managed && !is-encrypted : Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        Rectangle {
            x: parent.width * 0.125;
            y: parent.height * 0.125;
            width: parent.width * 0.75;
            height: parent.height * 0.75;
            border-width: max(1.5px, parent.width * 0.08);
            border-color: Theme.accent-brand;
            background: transparent;
            border-radius: max(1px, parent.width * 0.08);
        }
        Rectangle {
            x: parent.width * 0.25;
            y: parent.height * 0.35;
            width: parent.width * 0.5;
            height: max(1.5px, parent.height * 0.08);
            background: Theme.accent-brand;
        }
        Rectangle {
            x: parent.width * 0.25;
            y: parent.height * 0.55;
            width: parent.width * 0.5;
            height: max(1.5px, parent.height * 0.08);
            background: Theme.accent-brand;
        }
    }
}

/// Sidebar item icons drawn with rectangles.
export component FmSidebarIcon inherits Rectangle {
    in property <string> icon-id;
    in property <length> icon-size: 14px;

    width: icon-size;
    height: icon-size;
    background: transparent;

    if icon-id == "sidebar-favorites" || icon-id == "sidebar-starred" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.15;
            y: parent.height * 0.35;
            width: parent.width * 0.7;
            height: parent.height * 0.35;
            background: Theme.accent-brand;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.35;
            y: parent.height * 0.15;
            width: parent.width * 0.3;
            height: parent.height * 0.7;
            background: Theme.accent-brand;
            border-radius: 1px;
        }
    }

    if icon-id == "sidebar-tags" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle { x: 3px; y: 3px; width: 2px; height: parent.height - 6px; background: Theme.accent-brand; }
        Rectangle { x: parent.width - 5px; y: 3px; width: 2px; height: parent.height - 6px; background: Theme.accent-brand; }
        Rectangle { x: 2px; y: 4px; width: parent.width - 4px; height: 2px; background: Theme.accent-brand; }
        Rectangle { x: 2px; y: parent.height - 6px; width: parent.width - 4px; height: 2px; background: Theme.accent-brand; }
    }

    if icon-id == "sidebar-recent" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: 1px; y: 1px;
            width: parent.width - 2px; height: parent.height - 2px;
            border-radius: parent.width;
            border-width: 1.5px;
            border-color: Theme.accent-brand;
            background: transparent;
        }
        Rectangle {
            x: parent.width / 2 - 1px; y: 3px;
            width: 2px; height: parent.height * 0.35;
            background: Theme.accent-brand;
        }
    }

    if icon-id == "sidebar-categories" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle { x: 3px; y: 3px; width: 8px; height: 2px; background: Theme.text-tertiary; }
        Rectangle { x: 3px; y: 7px; width: 10px; height: 2px; background: Theme.text-tertiary; }
        Rectangle { x: 3px; y: 11px; width: 6px; height: 2px; background: Theme.text-tertiary; }
    }

    if icon-id == "sidebar-images" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: 1px; y: 2px;
            width: parent.width - 2px; height: parent.height - 4px;
            border-width: 1.5px; border-color: Theme.accent-brand;
            background: transparent; border-radius: 2px;
        }
        Rectangle {
            x: 3px; y: parent.height - 7px;
            width: parent.width * 0.45; height: 3px;
            background: Theme.border-default;
        }
    }

    if icon-id == "sidebar-documents" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: 3px; y: 1px;
            width: parent.width - 6px; height: parent.height - 2px;
            background: Theme.accent-brand; border-radius: 2px;
        }
        Rectangle { x: 5px; y: 4px; width: parent.width - 10px; height: 1.5px; background: Theme.surface-base; }
        Rectangle { x: 5px; y: 7px; width: parent.width - 10px; height: 1.5px; background: Theme.surface-base; }
        Rectangle { x: 5px; y: 10px; width: parent.width - 12px; height: 1.5px; background: Theme.surface-base; }
    }

    if icon-id == "sidebar-video" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle { x: 3px; y: 3px; width: 3px; height: parent.height - 6px; background: Theme.accent-brand; }
        Rectangle { x: 6px; y: 5px; width: 3px; height: parent.height - 10px; background: Theme.accent-brand; }
        Rectangle { x: 9px; y: 7px; width: 3px; height: parent.height - 14px; background: Theme.accent-brand; }
    }

    if icon-id == "sidebar-audio" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle { x: 2px; y: parent.height * 0.45; width: 2px; height: parent.height * 0.3; background: Theme.accent-brand; }
        Rectangle { x: 5px; y: parent.height * 0.3; width: 2px; height: parent.height * 0.45; background: Theme.accent-brand; }
        Rectangle { x: 8px; y: parent.height * 0.2; width: 2px; height: parent.height * 0.55; background: Theme.accent-brand; }
        Rectangle { x: 11px; y: parent.height * 0.35; width: 2px; height: parent.height * 0.4; background: Theme.accent-brand; }
    }

    if icon-id == "sidebar-archives" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: 2px; y: 2px;
            width: parent.width - 4px; height: parent.height - 4px;
            background: Theme.accent-brand; border-radius: 2px;
        }
        Rectangle {
            x: 2px; y: parent.height / 2 - 1px;
            width: parent.width - 4px; height: 2px;
            background: Theme.surface-base;
        }
    }

    if icon-id == "sidebar-managed" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: 1px; y: 1px;
            width: parent.width - 2px; height: parent.height - 2px;
            border-width: 1.5px; border-color: Theme.accent-brand;
            background: transparent; border-radius: 2px;
        }
        Rectangle { x: 4px; y: 4px; width: parent.width - 8px; height: 2px; background: Theme.accent-brand; }
        Rectangle { x: 4px; y: 8px; width: parent.width - 8px; height: 2px; background: Theme.accent-brand; }
    }

    if icon-id == "sidebar-network" || icon-id == "sidebar-mount" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.15; y: parent.height * 0.15;
            width: parent.width * 0.7; height: parent.height * 0.7;
            border-radius: parent.width;
            border-width: 1.5px; border-color: Theme.accent-brand;
            background: transparent;
        }
        Rectangle {
            x: parent.width * 0.35; y: parent.height * 0.35;
            width: parent.width * 0.3; height: parent.height * 0.3;
            border-radius: parent.width;
            background: Theme.accent-brand;
        }
    }
}

/// Context-menu action glyphs. Drawn with rectangles so they stay visible
/// on Windows (Slint's default font has no emoji / many Unicode symbols).
export component FmActionIcon inherits Rectangle {
    in property <string> icon-id;
    in property <length> icon-size: 14px;
    in property <color> ink: Theme.text-primary;

    width: icon-size;
    height: icon-size;
    background: transparent;

    if icon-id == "action-open" || icon-id == "action-open-with" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.2;
            y: parent.height * 0.22;
            width: parent.width * 0.22;
            height: parent.height * 0.56;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.28;
            width: parent.width * 0.42;
            height: parent.height * 0.44;
            background: root.ink;
        }
    }

    if icon-id == "widget-viewer" || icon-id == "action-reveal" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.05;
            y: parent.height * 0.32;
            width: parent.width * 0.9;
            height: parent.height * 0.36;
            border-radius: parent.height;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
        }
        Rectangle {
            x: parent.width * 0.36;
            y: parent.height * 0.36;
            width: parent.width * 0.28;
            height: parent.height * 0.28;
            border-radius: parent.width;
            background: root.ink;
        }
    }

    if icon-id == "action-copy" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.08;
            y: parent.height * 0.22;
            width: parent.width * 0.58;
            height: parent.height * 0.7;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.32;
            y: parent.height * 0.08;
            width: parent.width * 0.58;
            height: parent.height * 0.7;
            border-width: 1.5px;
            border-color: root.ink;
            background: Theme.surface-raised;
            border-radius: 1px;
        }
    }

    if icon-id == "action-cut" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.18;
            y: parent.height * 0.42;
            width: parent.width * 0.64;
            height: 2px;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.12;
            y: parent.height * 0.12;
            width: parent.width * 0.28;
            height: parent.height * 0.28;
            border-radius: parent.width;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
        }
        Rectangle {
            x: parent.width * 0.6;
            y: parent.height * 0.6;
            width: parent.width * 0.28;
            height: parent.height * 0.28;
            border-radius: parent.width;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
        }
    }

    if icon-id == "action-paste" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.18;
            y: parent.height * 0.18;
            width: parent.width * 0.64;
            height: parent.height * 0.74;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.32;
            y: parent.height * 0.08;
            width: parent.width * 0.36;
            height: parent.height * 0.18;
            background: root.ink;
            border-radius: 1px;
        }
    }

    if icon-id == "action-rename" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.18;
            y: parent.height * 0.72;
            width: parent.width * 0.64;
            height: 2px;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.28;
            y: parent.height * 0.18;
            width: 2px;
            height: parent.height * 0.5;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.28;
            y: parent.height * 0.18;
            width: parent.width * 0.42;
            height: 2px;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.28;
            y: parent.height * 0.42;
            width: parent.width * 0.3;
            height: 2px;
            background: root.ink;
        }
    }

    if icon-id == "action-delete" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.22;
            y: parent.height * 0.28;
            width: parent.width * 0.56;
            height: parent.height * 0.6;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.16;
            y: parent.height * 0.18;
            width: parent.width * 0.68;
            height: 2px;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.08;
            width: parent.width * 0.24;
            height: parent.height * 0.14;
            background: root.ink;
            border-radius: 1px;
        }
    }

    if icon-id == "action-tag" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.12;
            y: parent.height * 0.22;
            width: parent.width * 0.55;
            height: parent.height * 0.56;
            background: root.ink;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.55;
            y: parent.height * 0.28;
            width: parent.width * 0.32;
            height: parent.height * 0.44;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.22;
            y: parent.height * 0.38;
            width: parent.width * 0.16;
            height: parent.height * 0.16;
            border-radius: parent.width;
            background: Theme.surface-raised;
        }
    }

    if icon-id == "action-color" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.15;
            y: parent.height * 0.15;
            width: parent.width * 0.7;
            height: parent.height * 0.7;
            border-radius: parent.width;
            background: root.ink;
        }
    }

    if icon-id == "action-star" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.15;
            y: parent.height * 0.38;
            width: parent.width * 0.7;
            height: parent.height * 0.24;
            background: root.ink;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.38;
            y: parent.height * 0.15;
            width: parent.width * 0.24;
            height: parent.height * 0.7;
            background: root.ink;
            border-radius: 1px;
        }
    }

    if icon-id == "action-encrypt" || icon-id == "action-decrypt" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.3;
            y: parent.height * 0.1;
            width: parent.width * 0.4;
            height: parent.height * 0.4;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
            border-radius: parent.width * 0.2;
        }
        Rectangle {
            x: parent.width * 0.2;
            y: parent.height * 0.4;
            width: parent.width * 0.6;
            height: parent.height * 0.45;
            background: root.ink;
            border-radius: 1px;
        }
    }

    if icon-id == "action-managed" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.12;
