    if icon-id == "action-select-all" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.08;
            y: parent.height * 0.08;
            width: parent.width * 0.55;
            height: parent.height * 0.55;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
            border-radius: 1px;
