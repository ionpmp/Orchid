            x: parent.width * 0.36;
            y: parent.height * 0.36;
            width: parent.width * 0.55;
            height: parent.height * 0.55;
            background: root.ink;
            border-radius: 1px;
        }
    }

    if icon-id == "action-deselect" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.18;
            y: parent.height * 0.18;
            width: parent.width * 0.64;
            height: parent.height * 0.64;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
            border-radius: 1px;
        }
    }

    if icon-id == "action-properties" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.18;
            y: parent.height * 0.18;
            width: parent.width * 0.64;
            height: parent.height * 0.64;
            border-radius: parent.width;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
        }
        Rectangle {
            x: parent.width * 0.46;
            y: parent.height * 0.28;
            width: 2px;
            height: parent.height * 0.16;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.46;
            y: parent.height * 0.5;
            width: 2px;
            height: parent.height * 0.22;
            background: root.ink;
        }
    }

    if icon-id == "action-new-folder" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.08;
            y: parent.height * 0.18;
            width: parent.width * 0.36;
            height: parent.height * 0.16;
            background: root.ink;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.08;
            y: parent.height * 0.3;
            width: parent.width * 0.84;
            height: parent.height * 0.58;
            background: root.ink;
            border-radius: 1px;
        }
    }

    if icon-id == "action-new-file" : Rectangle {
        width: parent.width;
        height: parent.height;
        Rectangle {
            x: parent.width * 0.22;
            y: parent.height * 0.08;
            width: parent.width * 0.56;
            height: parent.height * 0.84;
            border-width: 1.5px;
            border-color: root.ink;
            background: transparent;
            border-radius: 1px;
        }
        Rectangle {
            x: parent.width * 0.5;
            y: parent.height * 0.08;
            width: parent.width * 0.28;
            height: parent.height * 0.22;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.34;
            y: parent.height * 0.48;
            width: parent.width * 0.32;
            height: 2px;
            background: root.ink;
        }
        Rectangle {
            x: parent.width * 0.46;
            y: parent.height * 0.36;
            width: 2px;
            height: parent.height * 0.32;
            background: root.ink;
        }
    }
}
