import { Theme } from "../../theme_global.slint";
import { Strings } from "../../strings_global.slint";
import { FileManagerModel } from "../../workspace/defs.slint";
import { FmSidebar } from "fm-sidebar.slint";
import { FmPane } from "fm-pane.slint";
import { FmContextMenu } from "fm-context-menu.slint";
import { FmConfirmDialog } from "fm-confirm-dialog.slint";
import { FmConflictDialog } from "fm-conflict-dialog.slint";
import { FmTagDialog } from "fm-tag-dialog.slint";
import { FmPassphraseDialog } from "fm-passphrase-dialog.slint";
import { FmManagedPolicyDialog } from "fm-managed-policy-dialog.slint";
import { FmRenameDialog } from "fm-rename-dialog.slint";
import { FmFindDialog } from "fm-find-dialog.slint";

export component FileManagerView inherits Rectangle {
    in property <FileManagerModel> model;

    callback sidebar-clicked(string);
    callback pane-clicked(int);
    callback tab-clicked(int, string);
    callback tab-closed(int, string);
    callback tab-new(int);
    callback new-folder(int);
    callback nav-back(int);
    callback nav-forward(int);
    callback nav-up(int);
    callback nav-home(int);
    callback history-pick(int, string);
    callback breadcrumb-clicked(int, string);
    callback path-edit-changed(int, string);
    callback path-edit-commit(int, string);
    callback view-mode-cycle(int);
    callback sort-cycle(int);
    callback sort-column-clicked(int, int);
    callback quick-filter-changed(int, string);

    callback entry-clicked(int, string, bool);
    callback entry-shift-clicked(int, string);
    callback entry-double-clicked(int, string, bool);
    callback entry-context(int, string, length, length);

    callback context-action(string, [string]);
    callback context-dismiss();

    callback confirm-yes();
    callback confirm-no();
    callback conflict-choice(string, bool);

    callback rename-commit(string, string);
    callback rename-cancel();

    callback tag-commit(string);
    callback tag-cancel();

    callback passphrase-commit(string);
    callback passphrase-cancel();
    callback passphrase-biometric();

    callback managed-policy-close();

    callback select-all(int);
    callback selection-command(int, string);
    callback nav-command(int, string);
    callback marquee-select(int, int, int, bool, int);
    callback delete-selected(int);
    callback copy-selected(int);
    callback paste-clipboard(int);
    callback rename-selected(int);
    callback deselect-all(int);
    callback open-selected(int);
    callback move-selection(int, int, bool);
    callback entry-drag-start(int, string);
    callback entry-drag-hover(int, string);
    callback entry-drag-drop(int, string);
    callback entry-drag-cancel(int);
    callback pane-drag-hover(int);
    callback drop-on-current-dir(int);
    callback entry-drag-scroll(int, length, length, length, length);
    callback viewport-changed(int, length, length, length);
    callback error-action(int);

    background: transparent;

    VerticalLayout {
        spacing: 0;

    HorizontalLayout {
        spacing: 0;
        vertical-stretch: 1;

        // Navigation sidebar only in dual-pane. Single-pane is the listing alone.
        if model.dual-pane : Rectangle {
            width: 180px;
            background: Theme.surface-base;
            border-color: Theme.border-default;
            // Slint doesn't support per-side borders; draw a divider.
            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Theme.border-default;
            }

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0;

                FmSidebar {
                    vertical-stretch: 1;
                    width: parent.width;
                    items: model.sidebar-items;
                    clicked(id) => { root.sidebar-clicked(id); }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            if !model.dual-pane : FmPane {
                width: parent.width;
                height: parent.height;
                pane-index: 0;
                pane: model.panes[0];
                is-active: true;
                clipboard-hint: model.clipboard-indicator;
                activity-hint: model.activity-indicator;
                transfer-active: model.transfer-active;
                transfer-progress: model.transfer-progress;
                transfer-paused: model.transfer-paused;
                transfer-queue: model.transfer-queue;
                rename: model.rename;
                drag-active: model.drag-active;
                drag-drop-target: model.drag-drop-target;
                drag-pane-target: model.drag-active && model.drag-target-pane == 0;
                visit-history: model.visit-history;
                drives: model.drives;
                path-suggestions: model.path-suggestions;
                tab-clicked(idx, id) => { root.tab-clicked(0, id); }
                tab-closed(idx, id) => { root.tab-closed(0, id); }
                tab-new => { root.tab-new(0); }
                new-folder => { root.new-folder(0); }
                nav-back => { root.nav-back(0); }
                nav-forward => { root.nav-forward(0); }
                nav-up => { root.nav-up(0); }
                nav-home => { root.nav-home(0); }
                history-pick(path) => { root.history-pick(0, path); }
                breadcrumb-clicked(p) => { root.breadcrumb-clicked(0, p); }
                path-edit-changed(t) => { root.path-edit-changed(0, t); }
                path-edit-commit(t) => { root.path-edit-commit(0, t); }
                view-mode-cycle => { root.view-mode-cycle(0); }
                sort-cycle => { root.sort-cycle(0); }
                sort-column-clicked(col) => { root.sort-column-clicked(0, col); }
                quick-filter-changed(q) => { root.quick-filter-changed(0, q); }
                entry-clicked(p, ctrl) => { root.entry-clicked(0, p, ctrl); }
                entry-shift-clicked(p) => { root.entry-shift-clicked(0, p); }
                entry-double-clicked(p, is_dir) => { root.entry-double-clicked(0, p, is_dir); }
                entry-context(p, x, y) => { root.entry-context(0, p, x, y); }
                pane-focused => { root.pane-clicked(0); }
                select-all => { root.select-all(0); }
                selection-command(cmd) => { root.selection-command(0, cmd); }
                nav-command(cmd) => { root.nav-command(0, cmd); }
                marquee-select(a, b, add, cols) => { root.marquee-select(0, a, b, add, cols); }
                delete-selected => { root.delete-selected(0); }
                copy-selected => { root.copy-selected(0); }
                paste-clipboard => { root.paste-clipboard(0); }
                rename-selected => { root.rename-selected(0); }
                deselect-all => { root.deselect-all(0); }
                open-selected => { root.open-selected(0); }
                move-selection(delta, extend) => { root.move-selection(0, delta, extend); }
                rename-commit(old, new) => { root.rename-commit(old, new); }
                rename-cancel => { root.rename-cancel(); }
                entry-drag-start(p) => { root.entry-drag-start(0, p); }
                entry-drag-hover(p) => { root.entry-drag-hover(0, p); }
                entry-drag-drop(p) => { root.entry-drag-drop(0, p); }
                entry-drag-cancel => { root.entry-drag-cancel(0); }
                pane-drag-hover => { root.pane-drag-hover(0); }
                drop-on-current-dir => { root.drop-on-current-dir(0); }
                entry-drag-scroll(mx, my, vy, w) => { root.entry-drag-scroll(0, mx, my, vy, w); }
                viewport-changed(y, h, w) => { root.viewport-changed(0, y, h, w); }
                error-action => { root.error-action(0); }
                crumb-drag-hover(p) => { root.entry-drag-hover(0, p); }
                crumb-drag-drop(p) => { root.entry-drag-drop(0, p); }
            }

            if model.dual-pane : HorizontalLayout {
                spacing: 1px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-color: (model.drag-active && model.drag-target-pane == 0) || model.active-pane == 0
                        ? Theme.accent-brand : transparent;
                    border-width: model.drag-active && model.drag-target-pane == 0 ? 2px : 1px;
                    border-radius: Theme.radius-md;

                    FmPane {
                        width: parent.width;
                        height: parent.height;
                        pane-index: 0;
                        pane: model.panes[0];
                        is-active: model.active-pane == 0;
                        clipboard-hint: model.clipboard-indicator;
                activity-hint: model.activity-indicator;
                transfer-active: model.transfer-active;
                transfer-progress: model.transfer-progress;
                transfer-paused: model.transfer-paused;
                transfer-queue: model.transfer-queue;
                        rename: model.rename;
                        drag-active: model.drag-active;
                        drag-drop-target: model.drag-drop-target;
                        drag-pane-target: model.drag-active && model.drag-target-pane == 0;
                        visit-history: model.visit-history;
                drives: model.drives;
                        path-suggestions: model.path-suggestions;
                        tab-clicked(idx, id) => { root.tab-clicked(0, id); }
                        tab-closed(idx, id) => { root.tab-closed(0, id); }
                        tab-new => { root.tab-new(0); }
                        new-folder => { root.new-folder(0); }
                        nav-back => { root.nav-back(0); }
                        nav-forward => { root.nav-forward(0); }
                        nav-up => { root.nav-up(0); }
                        nav-home => { root.nav-home(0); }
                        history-pick(path) => { root.history-pick(0, path); }
                        breadcrumb-clicked(p) => { root.breadcrumb-clicked(0, p); }
                        path-edit-changed(t) => { root.path-edit-changed(0, t); }
                        path-edit-commit(t) => { root.path-edit-commit(0, t); }
                        view-mode-cycle => { root.view-mode-cycle(0); }
                        sort-cycle => { root.sort-cycle(0); }
                        sort-column-clicked(col) => { root.sort-column-clicked(0, col); }
                        quick-filter-changed(q) => { root.quick-filter-changed(0, q); }
                        entry-clicked(p, ctrl) => { root.entry-clicked(0, p, ctrl); }
                        entry-shift-clicked(p) => { root.entry-shift-clicked(0, p); }
                        entry-double-clicked(p, is_dir) => { root.entry-double-clicked(0, p, is_dir); }
                        entry-context(p, x, y) => { root.entry-context(0, p, x, y); }
                        pane-focused => { root.pane-clicked(0); }
                        select-all => { root.select-all(0); }
                        selection-command(cmd) => { root.selection-command(0, cmd); }
                nav-command(cmd) => { root.nav-command(0, cmd); }
                        marquee-select(a, b, add, cols) => { root.marquee-select(0, a, b, add, cols); }
                        delete-selected => { root.delete-selected(0); }
                        copy-selected => { root.copy-selected(0); }
                        paste-clipboard => { root.paste-clipboard(0); }
                        rename-selected => { root.rename-selected(0); }
                        deselect-all => { root.deselect-all(0); }
                        open-selected => { root.open-selected(0); }
                        move-selection(delta, extend) => { root.move-selection(0, delta, extend); }
                        rename-commit(old, new) => { root.rename-commit(old, new); }
                        rename-cancel => { root.rename-cancel(); }
                        entry-drag-start(p) => { root.entry-drag-start(0, p); }
                        entry-drag-hover(p) => { root.entry-drag-hover(0, p); }
                        entry-drag-drop(p) => { root.entry-drag-drop(0, p); }
                        entry-drag-cancel => { root.entry-drag-cancel(0); }
                        pane-drag-hover => { root.pane-drag-hover(0); }
                        drop-on-current-dir => { root.drop-on-current-dir(0); }
                        entry-drag-scroll(mx, my, vy, w) => { root.entry-drag-scroll(0, mx, my, vy, w); }
                        viewport-changed(y, h, w) => { root.viewport-changed(0, y, h, w); }
                        error-action => { root.error-action(0); }
                        crumb-drag-hover(p) => { root.entry-drag-hover(0, p); }
                        crumb-drag-drop(p) => { root.entry-drag-drop(0, p); }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    border-color: (model.drag-active && model.drag-target-pane == 1) || model.active-pane == 1
                        ? Theme.accent-brand : transparent;
                    border-width: model.drag-active && model.drag-target-pane == 1 ? 2px : 1px;
                    border-radius: Theme.radius-md;

                    FmPane {
                        width: parent.width;
                        height: parent.height;
                        pane-index: 1;
                        pane: model.panes[1];
                        is-active: model.active-pane == 1;
                        clipboard-hint: model.clipboard-indicator;
                activity-hint: model.activity-indicator;
                transfer-active: model.transfer-active;
                transfer-progress: model.transfer-progress;
                transfer-paused: model.transfer-paused;
                transfer-queue: model.transfer-queue;
                        rename: model.rename;
                        drag-active: model.drag-active;
                        drag-drop-target: model.drag-drop-target;
                        drag-pane-target: model.drag-active && model.drag-target-pane == 1;
                        visit-history: model.visit-history;
                drives: model.drives;
                        path-suggestions: model.path-suggestions;
                        tab-clicked(idx, id) => { root.tab-clicked(1, id); }
                        tab-closed(idx, id) => { root.tab-closed(1, id); }
                        tab-new => { root.tab-new(1); }
                        new-folder => { root.new-folder(1); }
                        nav-back => { root.nav-back(1); }
                        nav-forward => { root.nav-forward(1); }
                        nav-up => { root.nav-up(1); }
                        nav-home => { root.nav-home(1); }
                        history-pick(path) => { root.history-pick(1, path); }
                        breadcrumb-clicked(p) => { root.breadcrumb-clicked(1, p); }
                        path-edit-changed(t) => { root.path-edit-changed(1, t); }
                        path-edit-commit(t) => { root.path-edit-commit(1, t); }
                        view-mode-cycle => { root.view-mode-cycle(1); }
                        sort-cycle => { root.sort-cycle(1); }
                        sort-column-clicked(col) => { root.sort-column-clicked(1, col); }
                        quick-filter-changed(q) => { root.quick-filter-changed(1, q); }
                        entry-clicked(p, ctrl) => { root.entry-clicked(1, p, ctrl); }
                        entry-shift-clicked(p) => { root.entry-shift-clicked(1, p); }
                        entry-double-clicked(p, is_dir) => { root.entry-double-clicked(1, p, is_dir); }
                        entry-context(p, x, y) => { root.entry-context(1, p, x, y); }
                        pane-focused => { root.pane-clicked(1); }
                        select-all => { root.select-all(1); }
                        selection-command(cmd) => { root.selection-command(1, cmd); }
                        nav-command(cmd) => { root.nav-command(1, cmd); }
                        marquee-select(a, b, add, cols) => { root.marquee-select(1, a, b, add, cols); }
                        delete-selected => { root.delete-selected(1); }
                        copy-selected => { root.copy-selected(1); }
                        paste-clipboard => { root.paste-clipboard(1); }
                        rename-selected => { root.rename-selected(1); }
                        deselect-all => { root.deselect-all(1); }
                        open-selected => { root.open-selected(1); }
                        move-selection(delta, extend) => { root.move-selection(1, delta, extend); }
                        rename-commit(old, new) => { root.rename-commit(old, new); }
                        rename-cancel => { root.rename-cancel(); }
                        entry-drag-start(p) => { root.entry-drag-start(1, p); }
                        entry-drag-hover(p) => { root.entry-drag-hover(1, p); }
                        entry-drag-drop(p) => { root.entry-drag-drop(1, p); }
                        entry-drag-cancel => { root.entry-drag-cancel(1); }
                        pane-drag-hover => { root.pane-drag-hover(1); }
                        drop-on-current-dir => { root.drop-on-current-dir(1); }
                        entry-drag-scroll(mx, my, vy, w) => { root.entry-drag-scroll(1, mx, my, vy, w); }
                        viewport-changed(y, h, w) => { root.viewport-changed(1, y, h, w); }
                        error-action => { root.error-action(1); }
                        crumb-drag-hover(p) => { root.entry-drag-hover(1, p); }
                        crumb-drag-drop(p) => { root.entry-drag-drop(1, p); }
                    }
                }
            }
        }
    }

        if model.single-click-open : Rectangle {
            height: 48px;
            background: Theme.surface-raised;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    background: copy-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                    border-radius: Theme.radius-md;
                    copy-ta := TouchArea { clicked => { root.copy-selected(model.active-pane); } }
                    Text {
                        text: Strings.fm-action-copy;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    background: cut-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                    border-radius: Theme.radius-md;
                    cut-ta := TouchArea { clicked => { root.nav-command(model.active-pane, "cut"); } }
                    Text {
                        text: Strings.fm-action-cut;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    background: paste-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                    border-radius: Theme.radius-md;
                    paste-ta := TouchArea { clicked => { root.paste-clipboard(model.active-pane); } }
                    Text {
                        text: Strings.fm-action-paste;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    background: del-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                    border-radius: Theme.radius-md;
                    del-ta := TouchArea { clicked => { root.delete-selected(model.active-pane); } }
                    Text {
                        text: Strings.fm-action-delete;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    background: rn-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                    border-radius: Theme.radius-md;
                    rn-ta := TouchArea { clicked => { root.rename-selected(model.active-pane); } }
                    Text {
                        text: Strings.fm-action-rename;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    background: nf-ta.has-hover ? Theme.accent-brand : Theme.surface-base;
                    border-radius: Theme.radius-md;
                    nf-ta := TouchArea { clicked => { root.new-folder(model.active-pane); } }
                    Text {
                        text: Strings.fm-action-new-folder;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if model.context-menu.visible : FmContextMenu {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        menu: model.context-menu;
        action-clicked(id) => { root.context-action(id, model.context-menu.target-paths); }
        dismiss => { root.context-dismiss(); }
    }

    if model.confirm-dialog.visible : FmConfirmDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        dialog: model.confirm-dialog;
        yes => { root.confirm-yes(); }
        no => { root.confirm-no(); }
    }

    if model.conflict-dialog.visible : FmConflictDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        dialog: model.conflict-dialog;
        choice(c, all) => { root.conflict-choice(c, all); }
    }

    if model.tag.active : FmTagDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        state: model.tag;
        commit(tag) => { root.tag-commit(tag); }
        cancel => { root.tag-cancel(); }
    }

    if model.passphrase.active : FmPassphraseDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        state: model.passphrase;
        commit(pw) => { root.passphrase-commit(pw); }
        cancel => { root.passphrase-cancel(); }
        biometric => { root.passphrase-biometric(); }
    }

    if model.managed-policy.active : FmManagedPolicyDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        state: model.managed-policy;
        close => { root.managed-policy-close(); }
    }

    if model.find.active : FmFindDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        state: model.find;
        commit(packed) => { root.rename-commit("orchid:find", packed); }
        cancel => { root.rename-cancel(); }
    }

    if model.rename.active && (model.rename.path == "" || model.rename.path == "orchid:select-mask" || model.rename.path == "orchid:batch-rename" || model.rename.path == "orchid:conflict-rename" || model.rename.path == "orchid:tool") : FmRenameDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        state: model.rename;
        commit(old, new) => { root.rename-commit(old, new); }
        cancel => { root.rename-cancel(); }
    }
}

