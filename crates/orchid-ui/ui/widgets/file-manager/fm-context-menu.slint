import { Theme } from "../../theme_global.slint";
import { BottomSheet, Divider, GlassCard } from "../../kit.slint";
import { Icon } from "../../kit-icons.slint";
import { FmContextMenu } from "../../workspace/defs.slint";
import { FmContextSubmenu } from "fm-context-submenu.slint";
import { FmActionIcon } from "fm-icons.slint";

/// Shared action list for the cursor popover and the cinema bottom sheet.
component FmContextMenuBody inherits VerticalLayout {
    in property <FmContextMenu> menu;
    /// Finger-sized rows for bottom-sheet presentation.
    in property <bool> touch-rows: false;
    /// Expand submenus inline (sheet) instead of a hover flyout (popover).
    in property <bool> inline-submenus: false;

    callback action-clicked(string);

    property <string> open-submenu: "";
    property <length> row-height: touch-rows ? Theme.row-height : Theme.control-sm;
    property <length> icon-size: touch-rows ? Theme.font-size-lg : Theme.font-size-md;

    padding: Theme.space-2;
    spacing: Theme.space-1;

    if menu.info-visible : VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        spacing: Theme.space-1;

        Text {
            text: menu.info-name;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            font-weight: Theme.weight-semibold;
            overflow: elide;
        }
        if menu.info-type != "" : Text {
            text: menu.info-type;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
        if menu.info-size != "" : Text {
            text: menu.info-size;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
        if menu.info-modified != "" : Text {
            text: menu.info-modified;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
        if menu.info-mime != "" : Text {
            text: menu.info-mime;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }
    }

    if menu.info-visible : Divider { }

    for action[i] in menu.actions : VerticalLayout {
        spacing: 0;

        Rectangle {
            height: action.is-separator ? Theme.space-3 : root.row-height;
            clip: false;
            background: transparent;

            if action.is-separator : Divider {
                y: (parent.height - self.height) / 2;
                width: parent.width;
            }

            if !action.is-separator : Rectangle {
                width: 100%;
                height: 100%;
                border-radius: Theme.radius-md;
                opacity: action.enabled || action.has-submenu ? 1.0 : 0.4;
                background: act-ta.pressed && (action.enabled || action.has-submenu) ? Theme.state-press
                    : act-ta.has-hover && (action.enabled || action.has-submenu) ? Theme.state-hover
                    : Colors.transparent;

                animate background { duration: Theme.motion-instant; easing: ease-out; }

                act-ta := TouchArea {
                    enabled: (action.enabled && !action.is-separator)
                        || (action.has-submenu && !action.is-separator);
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        if (action.has-submenu && root.inline-submenus) {
                            root.open-submenu = root.open-submenu == action.id ? "" : action.id;
                        } else if (action.enabled && !action.is-separator) {
                            root.action-clicked(action.id);
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-3;

                    FmActionIcon {
                        y: (parent.height - self.height) / 2;
                        icon-size: root.icon-size;
                        icon-id: action.icon;
                    }
                    Text {
                        text: action.label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if action.shortcut != "" && !root.inline-submenus : Text {
                        text: action.shortcut;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                    }
                    if action.has-submenu : Icon {
                        name: root.inline-submenus && root.open-submenu == action.id
                            ? "chevron-down" : "chevron-right";
                        size: Theme.font-size-sm;
                        tint: Theme.text-tertiary;
                        y: (parent.height - self.height) / 2;
                    }
                }

                if action.has-submenu && !root.inline-submenus && act-ta.has-hover : FmContextSubmenu {
                    x: parent.width - Theme.hairline;
                    y: 0;
                    width: 220px;
                    height: self.preferred-height;
                    actions: action.children;
                    action-clicked(id) => { root.action-clicked(id); }
                }
            }
        }

        if action.has-submenu && root.inline-submenus && root.open-submenu == action.id : VerticalLayout {
            padding-left: Theme.space-4;
            spacing: Theme.space-1;

            for child in action.children : Rectangle {
                height: child.is-separator ? Theme.space-3 : root.row-height;
                background: transparent;

                if child.is-separator : Divider {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                }

                if !child.is-separator : Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: Theme.radius-md;
                    opacity: child.enabled ? 1.0 : 0.4;
                    background: child-ta.pressed && child.enabled ? Theme.state-press
                        : child-ta.has-hover && child.enabled ? Theme.state-hover
                        : Colors.transparent;

                    animate background { duration: Theme.motion-instant; easing: ease-out; }

                    child-ta := TouchArea {
                        enabled: child.enabled && !child.is-separator;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.action-clicked(child.id); }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-3;

                        if child.swatch-color != "" : Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: Theme.font-size-md;
                            height: Theme.font-size-md;
                            border-radius: self.height / 2;
                            border-width: child.swatch-color == "none" ? Theme.hairline : 0px;
                            border-color: Theme.border-default;
                            background: child.swatch-color == "red" ? #ef4444
                                      : child.swatch-color == "orange" ? #f97316
                                      : child.swatch-color == "yellow" ? #eab308
                                      : child.swatch-color == "green" ? #22c55e
                                      : child.swatch-color == "blue" ? #3b82f6
                                      : child.swatch-color == "purple" ? #a855f7
                                      : child.swatch-color == "gray" ? #9ca3af
                                      : transparent;
                        }
                        if child.swatch-color == "" : FmActionIcon {
                            y: (parent.height - self.height) / 2;
                            icon-size: root.icon-size;
                            icon-id: child.icon;
                        }
                        Text {
                            text: child.label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            font-weight: Theme.weight-medium;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

export component FmContextMenu inherits Rectangle {
    in property <FmContextMenu> menu;
    callback action-clicked(string);
    callback dismiss();

    /// Bottom-sheet presentation on narrow / tablet panes.
    property <bool> sheet: root.width < 560px;

    background: transparent;

    if root.sheet : BottomSheet {
        width: 100%;
        height: 100%;
        max-sheet-height: root.height * 0.78;
        dismissed => { root.dismiss(); }

        Flickable {
            viewport-width: self.width;
            height: min(body.preferred-height, root.height * 0.65);
            viewport-height: body.preferred-height;

            body := FmContextMenuBody {
                width: parent.width;
                menu: root.menu;
                touch-rows: true;
                inline-submenus: true;
                action-clicked(id) => { root.action-clicked(id); }
            }
        }
    }

    if !root.sheet : TouchArea {
        clicked => { root.dismiss(); }
    }

    if !root.sheet : GlassCard {
        x: menu.x;
        y: menu.y;
        width: 280px;
        height: lay.preferred-height + Theme.space-4;
        elevation: 2;
        clip: false;

        // Keep clicks on the popover from hitting the dismiss area.
        TouchArea { }

        lay := FmContextMenuBody {
            width: parent.width;
            menu: root.menu;
            touch-rows: false;
            inline-submenus: false;
            action-clicked(id) => { root.action-clicked(id); }
        }
    }
}
