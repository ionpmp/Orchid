import { Theme } from "../theme_global.slint";
import { AgentModel } from "../workspace/defs.slint";

export component AgentView inherits Rectangle {
    in property <AgentModel> model;

    callback send(string);
    callback confirm-write();
    callback dismiss-write();
    callback clear-chat();

    background: transparent;

    // The composer stays local so a snapshot does not move the caret.
    property <string> draft: "";

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.space-2;
        padding: Theme.space-2;

        if root.model.pending-path != "" : Rectangle {
            width: 100%;
            border-radius: Theme.radius-md;
            background: Theme.accent-soft;
            VerticalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-1;
                Text {
                    text: root.model.pending-label + " " + root.model.pending-path;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }
                if root.model.pending-preview != "" : Text {
                    text: root.model.pending-preview;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Rectangle {
                        width: confirm-label.preferred-width + Theme.space-4;
                        height: Theme.control-sm;
                        border-radius: Theme.radius-pill;
                        background: Theme.accent-brand;
                        confirm-touch := TouchArea {
                            clicked => { root.confirm-write(); }
                        }
                        confirm-label := Text {
                            width: 100%;
                            height: 100%;
                            text: root.model.confirm-label;
                            color: Theme.text-on-accent;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: dismiss-label.preferred-width + Theme.space-4;
                        height: Theme.control-sm;
                        border-radius: Theme.radius-pill;
                        background: dismiss-touch.has-hover ? Theme.state-hover : Colors.transparent;
                        dismiss-touch := TouchArea {
                            clicked => { root.dismiss-write(); }
                        }
                        dismiss-label := Text {
                            width: 100%;
                            height: 100%;
                            text: root.model.dismiss-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if root.model.status != "" : Text {
            text: root.model.status;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }

        if root.model.lines.length == 0 : Text {
            text: root.model.empty-label;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if root.model.lines.length > 0 : Flickable {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            viewport-height: transcript.preferred-height;
            transcript := VerticalLayout {
                width: parent.width;
                spacing: Theme.space-2;
                for line in root.model.lines : VerticalLayout {
                    spacing: 0;
                    Text {
                        text: line.role;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-xs;
                        font-weight: Theme.weight-semibold;
                    }
                    Text {
                        text: line.text;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        wrap: word-wrap;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            Rectangle {
                horizontal-stretch: 1;
                height: Theme.control-md;
                border-radius: Theme.radius-md;
                background: Theme.surface-raised;
                border-width: Theme.hairline;
                border-color: composer.has-focus ? Theme.accent-brand : Theme.border-subtle;
                if root.draft == "" : Text {
                    x: Theme.space-2;
                    width: parent.width - Theme.space-4;
                    height: 100%;
                    text: root.model.placeholder;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                composer := TextInput {
                    x: Theme.space-2;
                    width: parent.width - Theme.space-4;
                    height: 100%;
                    text: root.draft;
                    single-line: true;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    edited => { root.draft = self.text; }
                    accepted => {
                        if (root.draft != "") {
                            root.send(root.draft);
                            root.draft = "";
                        }
                    }
                }
            }

            Rectangle {
                width: send-label.preferred-width + Theme.space-4;
                height: Theme.control-md;
                border-radius: Theme.radius-pill;
                background: root.draft == "" ? Theme.state-hover : Theme.accent-brand;
                send-touch := TouchArea {
                    enabled: root.draft != "";
                    clicked => {
                        root.send(root.draft);
                        root.draft = "";
                    }
                }
                send-label := Text {
                    width: 100%;
                    height: 100%;
                    text: root.model.send-label;
                    color: root.draft == "" ? Theme.text-disabled : Theme.text-on-accent;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: clear-label.preferred-width + Theme.space-4;
                height: Theme.control-md;
                border-radius: Theme.radius-pill;
                background: clear-touch.has-hover ? Theme.state-hover : Colors.transparent;
                clear-touch := TouchArea {
                    clicked => { root.clear-chat(); }
                }
                clear-label := Text {
                    width: 100%;
                    height: 100%;
                    text: root.model.clear-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
