import { Theme } from "../theme_global.slint";
import { ControlSize, EmptyState, IconButton, ProgressTrack, Tooltip } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { Strings } from "../strings_global.slint";
import { MediaModel } from "../workspace/defs.slint";

export component MediaView inherits Rectangle {
    in property <MediaModel> model;

    callback play-pause();
    callback next();
    callback previous();

    background: transparent;

    if !model.has-session : EmptyState {
        width: 100%;
        height: 100%;
        icon: "play";
        title: model.empty-state-text;
    }

    // Now-playing card: artwork bleeds an accent glow behind the transport.
    if model.has-session : VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;

        HorizontalLayout {
            spacing: Theme.space-4;

            // Album art with a soft bloom so the widget reads as media, not a form.
            Rectangle {
                min-width: 104px;
                max-width: 104px;
                min-height: 104px;
                max-height: 104px;
                background: Theme.surface-sunken;
                border-radius: Theme.radius-lg;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;
                drop-shadow-blur: Theme.elev-2-blur;
                drop-shadow-offset-y: Theme.elev-2-y;
                drop-shadow-color: Theme.shadow-key;
                clip: true;

                if model.has-thumbnail : Image {
                    width: parent.width;
                    height: parent.height;
                    source: model.thumbnail;
                    image-fit: cover;
                }

                if !model.has-thumbnail : Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.gradient-hero;
                    Icon {
                        name: "play";
                        size: 34px;
                        tint: Theme.accent-brand;
                    }
                }

                // Playing pulse in the corner of the artwork.
                if model.is-playing : Rectangle {
                    x: parent.width - self.width - Theme.space-2;
                    y: parent.height - self.height - Theme.space-2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.feedback-success;
                }
            }

            // Track metadata.
            Rectangle {
                horizontal-stretch: 1;

                meta-ta := TouchArea { }

                Tooltip {
                    x: 0;
                    y: parent.height + Theme.space-1;
                    shown: meta-ta.has-hover && model.title != "";
                    text: model.album != ""
                        ? model.title + " — " + model.artist + " — " + model.album
                        : model.artist != ""
                            ? model.title + " — " + model.artist
                            : model.title;
                }

                VerticalLayout {
                    alignment: center;
                    width: 100%;
                    height: 100%;
                    spacing: Theme.space-1;

                    if model.source-app != "" : Text {
                        text: model.source-app.to-uppercase();
                        color: Theme.text-eyebrow;
                        font-size: Theme.font-size-xs;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: Theme.tracking-wide;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    Text {
                        text: model.title;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-xl;
                        font-weight: Theme.weight-bold;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    Text {
                        text: model.artist;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-md;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    if model.album != "" : Text {
                        text: model.album;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
            }
        }

        ProgressTrack {
            value: model.progress;
        }

        HorizontalLayout {
            alignment: space-between;

            Text {
                text: model.position;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                font-family: Theme.font-family-mono;
            }

            Text {
                text: model.duration;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                font-family: Theme.font-family-mono;
            }
        }

        // Transport: oversized play control flanked by skip buttons.
        HorizontalLayout {
            spacing: Theme.space-4;
            alignment: center;
            padding-top: Theme.space-2;

            IconButton {
                icon: "skip-prev";
                size: ControlSize.lg;
                tooltip: Strings.media_previous;
                clicked => { root.previous(); }
            }

            play := Rectangle {
                min-width: Theme.control-xl;
                max-width: Theme.control-xl;
                min-height: Theme.control-xl;
                max-height: Theme.control-xl;
                border-radius: Theme.control-xl / 2;
                background: Theme.gradient-accent;
                drop-shadow-blur: pp-ta.pressed ? 0px : Theme.elev-glow-blur;
                drop-shadow-offset-y: pp-ta.pressed ? 0px : Theme.elev-1-y;
                drop-shadow-color: Theme.accent-glow;

                animate drop-shadow-blur, drop-shadow-offset-y {
                    duration: Theme.motion-instant;
                    easing: ease-out;
                }

                pp-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.play-pause(); }
                }

                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: parent.border-radius;
                    background: pp-ta.pressed ? Theme.state-press
                        : pp-ta.has-hover ? Theme.state-hover
                        : Colors.transparent;
                    animate background { duration: Theme.motion-instant; easing: ease-out; }
                }

                Icon {
                    name: model.is-playing ? "pause" : "play";
                    size: Theme.control-xl * 0.4;
                    tint: Theme.accent-contrast;
                }

                Tooltip {
                    x: (parent.width - self.width) / 2;
                    y: parent.height + Theme.space-2;
                    shown: pp-ta.has-hover;
                    text: model.is-playing ? Strings.media_pause : Strings.media_play;
                }
            }

            IconButton {
                icon: "skip-next";
                size: ControlSize.lg;
                tooltip: Strings.media_next;
                clicked => { root.next(); }
            }
        }
    }
}
