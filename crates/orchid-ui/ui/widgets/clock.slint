import { Theme } from "../theme_global.slint";
import { ControlSize, Divider, Eyebrow, IconButton, ListTile, Tooltip } from "../kit.slint";
import { SearchField } from "search-field.slint";
import { ClockModel } from "../workspace/defs.slint";

export component ClockView inherits Rectangle {
    in property <ClockModel> model;

    callback open-cities();
    callback close-cities();
    callback remove-city(int);
    callback move-city(int, int);
    callback search-cities(string);
    callback add-city(string, string);

    background: transparent;

    VerticalLayout {
        padding: Theme.space-4;
        spacing: Theme.space-3;
        alignment: start;

        // Local time hero — an oversized readout on a lit card.
        if model.cities.length > 0 : Rectangle {
            background: Theme.gradient-glass;
            border-radius: Theme.radius-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-subtle;
            clip: true;

            // Accent bloom behind the numerals.
            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.gradient-hero;
            }

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-1;
                alignment: center;

                Eyebrow {
                    // Prefer geolocated city name for Local; fall back to "Local".
                    text: model.cities[0].is-local
                        ? (model.cities[0].name != "" ? model.cities[0].name : model.local-label)
                        : model.cities[0].name;
                    horizontal-alignment: center;
                }

                Text {
                    text: model.cities[0].time-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-display;
                    font-weight: Theme.weight-bold;
                    horizontal-alignment: center;
                    font-family: Theme.font-family-mono;
                }

                if model.cities[0].date-text != "" : Text {
                    text: model.cities[0].date-text;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                }

                if model.cities[0].timezone != "" || model.cities[0].offset-text != "" : Text {
                    text: model.cities[0].timezone != "" && model.cities[0].offset-text != ""
                        ? model.cities[0].timezone + " · " + model.cities[0].offset-text
                        : (model.cities[0].timezone != "" ? model.cities[0].timezone : model.cities[0].offset-text);
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: space-between;

            Eyebrow {
                text: model.add-cities-label;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            IconButton {
                icon: "plus";
                size: ControlSize.sm;
                tooltip: model.cities-hint;
                tooltip-flip: true;
                clicked => { root.open-cities(); }
            }
        }

        Divider { }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: city-list.preferred-height.max(self.height);
            interactive: true;

            city-list := VerticalLayout {
                spacing: Theme.space-2;

                for city[i] in model.cities : Rectangle {
                    height: city.is-local ? 0px : Theme.control-lg;
                    visible: !city.is-local;
                    background: row-ta.has-hover ? Theme.surface-raised : Theme.surface-sunken;
                    border-radius: Theme.radius-md;
                    border-width: Theme.hairline;
                    border-color: row-ta.has-hover ? Theme.border-subtle : Colors.transparent;

                    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

                    row-ta := TouchArea { }

                    HorizontalLayout {
                        padding-left: Theme.space-3;
                        padding-right: Theme.space-3;
                        spacing: Theme.space-2;

                        VerticalLayout {
                            spacing: 1px;
                            vertical-stretch: 1;
                            alignment: center;

                            Text {
                                text: city.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                font-weight: Theme.weight-medium;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: Theme.space-2;
                                if city.date-text != "" : Text {
                                    text: city.date-text;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                }
                                if city.day-label != "" : Text {
                                    text: city.day-label;
                                    color: Theme.accent-brand;
                                    font-size: Theme.font-size-sm;
                                }
                                if city.offset-text != "" : Text {
                                    text: city.offset-text;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                }
                            }
                        }

                        Text {
                            text: city.time-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-xl;
                            font-weight: Theme.weight-bold;
                            font-family: Theme.font-family-mono;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    if model.picker-open : Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: Theme.scrim;
        z: 50;

        FocusScope {
            width: 100%;
            height: 100%;
            forward-focus: search-input;

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-cities();
                    return accept;
                }
                return reject;
            }

            TouchArea {
                clicked => { root.close-cities(); }
            }

            Rectangle {
                x: Theme.space-3;
                y: Theme.space-3;
                width: parent.width - Theme.space-6;
                height: parent.height - Theme.space-6;
                background: Theme.gradient-glass;
                border-radius: Theme.radius-xl;
                border-width: Theme.hairline;
                border-color: Theme.border-strong;
                drop-shadow-blur: Theme.elev-3-blur;
                drop-shadow-offset-y: Theme.elev-3-y;
                drop-shadow-color: Theme.shadow-key;

                TouchArea { }

                VerticalLayout {
                    padding: Theme.space-4;
                    spacing: Theme.space-3;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: space-between;

                        Text {
                            text: model.picker-title;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-lg;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: "close";
                            size: ControlSize.sm;
                            tooltip: model.close-picker-label;
                            tooltip-flip: true;
                            clicked => { root.close-cities(); }
                        }
                    }

                    search-input := SearchField {
                        query: model.search-query;
                        placeholder: model.search-placeholder;
                        edited(q) => { root.search-cities(q); }
                        escape-pressed => { root.close-cities(); }
                    }

                    if model.cities.length > 1 : Flickable {
                        height: min(140px, saved-list.preferred-height);
                        viewport-width: self.width;
                        viewport-height: saved-list.preferred-height;
                        interactive: true;

                        saved-list := VerticalLayout {
                            spacing: Theme.space-1;

                            for city[i] in model.cities : HorizontalLayout {
                                height: city.is-local ? 0px : Theme.row-height;
                                visible: !city.is-local;
                                spacing: Theme.space-1;

                                // ListTile owns the label; action buttons stay siblings so their
                                // TouchAreas are not covered by the tile hit target.
                                ListTile {
                                    horizontal-stretch: 1;
                                    title: city.name;
                                }

                                IconButton {
                                    icon: "chevron-up";
                                    size: ControlSize.sm;
                                    clicked => { root.move-city(i, -1); }
                                }
                                IconButton {
                                    icon: "chevron-down";
                                    size: ControlSize.sm;
                                    clicked => { root.move-city(i, 1); }
                                }
                                IconButton {
                                    icon: "trash";
                                    size: ControlSize.sm;
                                    danger: true;
                                    tooltip: model.remove-city-hint;
                                    tooltip-flip: true;
                                    clicked => { root.remove-city(i); }
                                }
                            }
                        }
                    }

                    Divider { }

                    if model.search-busy : Text {
                        text: model.searching-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                    }

                    if !model.search-busy && model.search-query != "" && model.search-results.length == 0 : Text {
                        text: model.no-results-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: results-list.preferred-height.max(self.height);
                        interactive: true;

                        results-list := VerticalLayout {
                            spacing: Theme.space-1;

                            for hit[i] in model.search-results : Rectangle {
                                height: hit-tile.preferred-height;

                                hit-tile := ListTile {
                                    width: 100%;
                                    title: hit.name;
                                    subtitle: hit.detail != "" ? hit.detail : hit.timezone;
                                    clicked => {
                                        root.add-city(hit.name, hit.timezone);
                                    }
                                }

                                Tooltip {
                                    text: model.add-city-hint;
                                    shown: hit-tile.hovered;
                                    x: Theme.space-2;
                                    y: parent.height - Theme.space-1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
