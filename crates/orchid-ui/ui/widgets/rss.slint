import { Theme } from "../theme_global.slint";
import { Badge, EmptyState, Tooltip } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { Strings } from "../strings_global.slint";
import { RssModel } from "../workspace/defs.slint";

export component RssView inherits Rectangle {
    in property <RssModel> model;

    callback item-clicked(string);

    background: transparent;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        if model.error-summary != "" : Rectangle {
            background: Theme.feedback-danger-soft;
            border-radius: Theme.radius-md;
            border-width: Theme.hairline;
            border-color: Theme.feedback-danger.with-alpha(0.4);
            horizontal-stretch: 1;

            HorizontalLayout {
                padding: Theme.space-3;
                spacing: Theme.space-2;

                Icon {
                    name: "warning";
                    size: Theme.font-size-lg;
                    tint: Theme.feedback-danger;
                }

                Text {
                    text: model.error-summary;
                    color: Theme.feedback-danger;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if !model.has-items : EmptyState {
            vertical-stretch: 1;
            icon: "bell";
            title: model.empty-state-text;
        }

        if model.has-items : Flickable {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            interactive: true;
            viewport-width: self.width;
            viewport-height: rss-list.preferred-height.max(self.height);

            rss-list := VerticalLayout {
                width: parent.viewport-width;
                spacing: Theme.space-2;

                for item[i] in model.items : Rectangle {
                    height: 96px;
                    background: item-ta.has-hover ? Theme.surface-raised : Theme.surface-sunken;
                    border-radius: Theme.radius-lg;
                    border-width: Theme.hairline;
                    border-color: item-ta.has-hover ? Theme.border-subtle : Colors.transparent;

                    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

                    item-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.item-clicked(item.link);
                        }
                    }

                    Tooltip {
                        x: Theme.space-3;
                        y: parent.height - Theme.space-1;
                        shown: item-ta.has-hover;
                        text: item.summary != ""
                            ? (item.title != "" ? item.title + " — " + item.summary : item.summary)
                            : item.title != ""
                                ? (item.source != "" ? item.title + " — " + item.source : item.title)
                                : Strings.rss-open-item-hint;
                    }

                    // Unread rail keeps the feed scannable in a glance.
                    Rectangle {
                        x: 0;
                        width: Theme.indicator-thickness;
                        height: parent.height - Theme.space-4;
                        y: Theme.space-2;
                        border-radius: Theme.radius-pill;
                        background: item-ta.has-hover ? Theme.accent-brand : Theme.accent-muted;
                    }

                    VerticalLayout {
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-3;
                        padding-top: Theme.space-2;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-1;

                        Text {
                            text: item.title;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            font-weight: Theme.weight-semibold;
                            wrap: no-wrap;
                            overflow: elide;
                            horizontal-alignment: left;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: start;

                            Badge {
                                text: item.source;
                            }

                            Text {
                                text: item.published;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-xs;
                                vertical-alignment: center;
                            }
                        }

                        if item.summary != "" : Text {
                            text: item.summary;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            wrap: word-wrap;
                            overflow: elide;
                            horizontal-alignment: left;
                            vertical-stretch: 1;
                        }
                    }
                }
            }
        }

        if model.last-updated != "" : Text {
            text: model.last-updated;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-xs;
            horizontal-alignment: end;
        }
    }
}
