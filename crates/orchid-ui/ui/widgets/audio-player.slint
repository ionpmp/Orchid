import { ListView } from "std-widgets.slint";
import { Theme } from "../theme_global.slint";
import { ButtonTone, ControlSize, IconButton, TouchButton, TouchSlider } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { AudioPlayerModel } from "../workspace/defs.slint";
import { SearchField } from "search-field.slint";

component PlayerTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();

    height: Theme.control-sm;
    min-width: tab-label.preferred-width + Theme.space-6;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-pill;
    background: root.selected ? Theme.accent-soft : (tab-hit.has-hover ? Theme.surface-base : transparent);
    border-width: Theme.hairline;
    border-color: root.selected ? Theme.accent-muted : transparent;

    animate background { duration: Theme.motion-fast; easing: ease-out; }

    tab-label := Text {
        x: Theme.space-3;
        width: parent.width - Theme.space-6;
        height: 100%;
        text: root.label;
        color: root.selected ? Theme.accent-brand : Theme.text-secondary;
        font-size: Theme.font-size-sm;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    tab-hit := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
}

component HeroPlay inherits Rectangle {
    in property <bool> playing;
    callback activated();

    width: Theme.control-lg;
    height: Theme.control-lg;
    border-radius: self.width / 2;
    background: Theme.gradient-accent;
    drop-shadow-blur: play-hit.has-hover ? Theme.elev-glow-blur : Theme.elev-1-blur;
    drop-shadow-color: Theme.accent-glow;
    accessible-role: AccessibleRole.button;

    animate drop-shadow-blur { duration: Theme.motion-fast; easing: ease-out; }

    play-hit := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.playing ? "pause" : "play";
        size: Theme.font-size-2xl;
        tint: Theme.accent-contrast;
    }
}

export component AudioPlayerView inherits Rectangle {
    in property <AudioPlayerModel> model;

    callback command(string);

    background: transparent;
    clip: true;

    property <string> q-drag-path: "";
    property <int> q-drag-from: -1;
    property <int> q-drop-index: -1;
    property <length> q-row-stride: Theme.row-height + Theme.space-1;
    property <int> applied-scroll-gen: -1;
    property <bool> seeking: false;
    property <float> seek-hold: 0;
    property <bool> vol-drag: false;
    property <float> vol-hold: 0;

    function begin-seek(v: float) {
        root.seeking = true;
        root.seek-hold = v;
        root.command("seek-frac:" + v);
    }

    function begin-volume(v: float) {
        root.vol-drag = true;
        root.vol-hold = v;
        root.command("volume:" + (v * 150));
    }

    scroll-apply-timer := Timer {
        interval: 16ms;
        running: root.model.browse-tab == 6 && root.model.scroll-gen != root.applied-scroll-gen;
        triggered => {
            root.scroll-to-current();
            root.applied-scroll-gen = root.model.scroll-gen;
        }
    }

    public function scroll-to-current() {
        if root.model.current-track-index < 0 {
            return;
        }
        let y = root.q-row-stride * root.model.current-track-index;
        let margin = browse-list.visible-height / 3;
        let max-y = max(0px, browse-list.viewport-height - browse-list.visible-height);
        browse-list.viewport-y = -min(max-y, max(0px, y - margin));
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == " " {
                root.command("play-pause");
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.command(event.modifiers.shift ? "seek-back-10" : "seek-back-5");
                return accept;
            }
            if event.text == Key.RightArrow {
                root.command(event.modifiers.shift ? "seek-fwd-10" : "seek-fwd-5");
                return accept;
            }
            if event.text == Key.UpArrow {
                root.command("vol-up");
                return accept;
            }
            if event.text == Key.DownArrow {
                root.command("vol-down");
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                root.command("mute");
                return accept;
            }
            if event.text == "s" || event.text == "S" {
                root.command("shuffle");
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                root.command("repeat");
                return accept;
            }
            if event.text == "n" || event.text == "N" {
                root.command("next");
                return accept;
            }
            if event.text == "p" || event.text == "P" {
                root.command("prev");
                return accept;
            }
            if event.text == "u" || event.text == "U" {
                root.command("rg");
                return accept;
            }
            if event.text == "t" || event.text == "T" {
                root.command("sleep");
                return accept;
            }
            if event.text == "e" || event.text == "E" {
                root.command("eq");
                return accept;
            }
            if event.text == "k" || event.text == "K" {
                root.command("speed");
                return accept;
            }
            if event.text == "x" || event.text == "X" {
                root.command("crossfade");
                return accept;
            }
            if event.text == "l" || event.text == "L" {
                if root.model.has-lyrics {
                    root.command("toggle-lyrics");
                    return accept;
                }
            }
            if event.text == "f" || event.text == "F" {
                if root.model.has-track {
                    root.command("toggle-favorite-current");
                    return accept;
                }
            }
            if event.text == "g" || event.text == "G" {
                if root.model.has-track {
                    root.command("show-in-fm");
                    return accept;
                }
            }
            if event.text == "c" || event.text == "C" {
                if root.model.has-track && !event.modifiers.control {
                    root.command("copy-track-path");
                    return accept;
                }
            }
            if event.text == Key.Return {
                if root.model.search-query != "" {
                    root.command("play-search");
                    return accept;
                }
            }
            if event.text == Key.Delete {
                if root.model.browse-tab == 6 {
                    root.command("remove-current-from-queue");
                    return accept;
                }
            }
            if event.text == Key.Home {
                if root.model.browse-tab == 6 {
                    root.command("queue-first");
                    return accept;
                }
            }
            if event.text == Key.End {
                if root.model.browse-tab == 6 {
                    root.command("queue-last");
                    return accept;
                }
            }
            if event.text == "." {
                if root.model.browse-tab == 6 {
                    root.scroll-to-current();
                    return accept;
                }
            }
            if event.text == "h" || event.text == "H" {
                if root.model.browse-tab == 6 {
                    root.command("reshuffle");
                    return accept;
                }
            }
            if event.text == Key.Backspace {
                root.command("stop");
                return accept;
            }
            if event.text == Key.Escape {
                root.command("escape");
                return accept;
            }
            if event.text == "1" {
                root.command("tab:0");
                return accept;
            }
            if event.text == "2" {
                root.command("tab:1");
                return accept;
            }
            if event.text == "3" {
                root.command("tab:2");
                return accept;
            }
            if event.text == "4" {
                root.command("tab:3");
                return accept;
            }
            if event.text == "5" {
                root.command("tab:4");
                return accept;
            }
            if event.text == "6" {
                root.command("tab:5");
                return accept;
            }
            if event.text == "7" {
                root.command("tab:6");
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: Theme.space-2;
            spacing: Theme.space-1;

            Flickable {
                height: Theme.toolbar-height;
                vertical-stretch: 0;
                viewport-height: self.height;
                viewport-width: tab-row.preferred-width;
                tab-row := HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    PlayerTab {
                        label: root.model.tab-songs;
                        selected: root.model.browse-tab == 0;
                        activated => { focus-scope.focus(); root.command("tab:0"); }
                    }
                    PlayerTab {
                        label: root.model.tab-artists;
                        selected: root.model.browse-tab == 1;
                        activated => { focus-scope.focus(); root.command("tab:1"); }
                    }
                    PlayerTab {
                        label: root.model.tab-albums;
                        selected: root.model.browse-tab == 2;
                        activated => { focus-scope.focus(); root.command("tab:2"); }
                    }
                    PlayerTab {
                        label: root.model.tab-folders;
                        selected: root.model.browse-tab == 3;
                        activated => { focus-scope.focus(); root.command("tab:3"); }
                    }
                    PlayerTab {
                        label: root.model.tab-genres;
                        selected: root.model.browse-tab == 4;
                        activated => { focus-scope.focus(); root.command("tab:4"); }
                    }
                    PlayerTab {
                        label: root.model.tab-playlists;
                        selected: root.model.browse-tab == 5;
                        activated => { focus-scope.focus(); root.command("tab:5"); }
                    }
                    PlayerTab {
                        label: root.model.tab-now-playing;
                        selected: root.model.browse-tab == 6;
                        activated => { focus-scope.focus(); root.command("tab:6"); }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-1;
                height: Theme.toolbar-height;
                vertical-stretch: 0;

                if root.model.browse-filter != "" : TouchButton {
                    icon: "chevron-left";
                    text: root.model.browse-filter-label != "" ? root.model.browse-filter-label : root.model.back-label;
                    max-width: 220px;
                    size: ControlSize.sm;
                    tone: ButtonTone.ghost;
                    clicked => { focus-scope.focus(); root.command("clear-filter"); }
                }

                SearchField {
                    horizontal-stretch: 1;
                    field-height: Theme.control-sm;
                    query: root.model.search-query;
                    placeholder: root.model.search-placeholder;
                    edited(q) => { root.command("search:" + q); }
                    escape-pressed => { root.command("clear-search"); }
                }

                if root.model.search-query != "" && root.model.tracks.length > 0 : IconButton {
                    icon: "play";
                    size: ControlSize.sm;
                    tooltip: root.model.play-group-label;
                    clicked => { focus-scope.focus(); root.command("play-search"); }
                }

                if root.model.search-query != "" && root.model.tracks.length > 0 : IconButton {
                    icon: "plus";
                    size: ControlSize.sm;
                    tooltip: root.model.enqueue-label;
                    clicked => { focus-scope.focus(); root.command("enqueue-search"); }
                }
            }

            Flickable {
                height: Theme.toolbar-height;
                vertical-stretch: 0;
                viewport-height: self.height;
                viewport-width: tool-row.preferred-width;
                tool-row := HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;

                    if root.model.browse-tab == 6 && root.model.current-track-index >= 0 : TouchButton {
                        text: root.model.jump-to-current-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.scroll-to-current(); }
                    }
                    if root.model.browse-tab == 6 && root.model.tracks.length > 1 : TouchButton {
                        icon: "shuffle";
                        text: root.model.reshuffle-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("reshuffle"); }
                    }
                    if root.model.browse-tab == 6 && root.model.tracks.length > 0 : TouchButton {
                        text: root.model.save-queue-as-playlist-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("save-queue-as-playlist"); }
                    }
                    if root.model.browse-tab == 6 && root.model.tracks.length > 0 : TouchButton {
                        text: root.model.clear-queue-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.danger;
                        clicked => { root.command("clear-queue"); }
                    }
                    if root.model.browse-tab == 5 : TouchButton {
                        icon: "plus";
                        text: root.model.new-playlist-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("new-playlist"); }
                    }
                    if root.model.browse-tab == 5 && root.model.active-playlist-id != "" && root.model.active-playlist-id != "__recent__" : TouchButton {
                        text: root.model.rename-playlist-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("start-rename-playlist"); }
                    }
                    if root.model.browse-tab == 5 : TouchButton {
                        text: root.model.delete-playlist-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.danger;
                        clicked => { root.command("delete-playlist"); }
                    }
                    if (root.model.browse-tab == 5 || root.model.browse-tab == 6) && root.model.tracks.length > 0 : TouchButton {
                        text: root.model.export-m3u-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("export-m3u"); }
                    }
                    if root.model.browse-tab == 5 || root.model.browse-tab == 6 : TouchButton {
                        text: root.model.import-m3u-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("import-m3u"); }
                    }
                    if root.model.browse-tab != 6 : TouchButton {
                        icon: "sliders";
                        text: root.model.sort-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("sort"); }
                    }
                    TouchButton {
                        icon: "plus";
                        text: root.model.add-folder-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("add-root"); }
                    }
                    TouchButton {
                        icon: "refresh";
                        text: root.model.rescan-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.ghost;
                        clicked => { root.command("rescan"); }
                    }
                    if root.model.has-library-roots : TouchButton {
                        text: root.model.remove-root-label;
                        size: ControlSize.sm;
                        tone: ButtonTone.danger;
                        clicked => { root.command("remove-last-root"); }
                    }
                    if root.model.browse-tab == 6 && root.model.queue-stats-label != "" : Text {
                        text: root.model.queue-stats-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
            }

            if root.model.roots.length > 0 : Flickable {
                height: Theme.control-sm;
                vertical-stretch: 0;
                viewport-height: self.height;
                viewport-width: root-row.preferred-width;
                root-row := HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    for r in root.model.roots : Rectangle {
                        height: Theme.control-xs;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: Theme.radius-pill;
                        background: Theme.surface-base;
                        HorizontalLayout {
                            padding-left: Theme.space-3;
                            padding-right: Theme.space-1;
                            spacing: Theme.space-1;
                            alignment: center;
                            Text {
                                text: r.label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: "close";
                                size: ControlSize.xs;
                                tooltip: root.model.remove-root-label;
                                clicked => { root.command("remove-root:" + r.path); }
                            }
                        }
                    }
                }
            }

            if root.model.roots-label != "" : Text {
                text: root.model.roots-label;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                vertical-stretch: 0;
            }

            if root.model.browse-tab == 5 && root.model.renaming-playlist : SearchField {
                field-height: Theme.control-sm;
                vertical-stretch: 0;
                query: root.model.rename-playlist-draft;
                placeholder: root.model.rename-playlist-label;
                edited(q) => { root.command("rename-playlist:" + q); }
                escape-pressed => { root.command("cancel-rename-playlist"); }
            }

            if root.model.browse-tab == 5 && root.model.empty-hint == "" : Flickable {
                height: Theme.control-sm;
                vertical-stretch: 0;
                viewport-height: self.height;
                viewport-width: pl-row.preferred-width;
                pl-row := HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: center;
                    for pl in root.model.playlists : Rectangle {
                        height: Theme.control-sm;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        border-radius: Theme.radius-pill;
                        background: pl.is-active ? Theme.accent-soft : (pl-hit.has-hover ? Theme.surface-base : transparent);
                        border-width: Theme.hairline;
                        border-color: pl.is-active ? Theme.accent-muted : transparent;
                        min-width: pl-txt.preferred-width + Theme.space-6;
                        pl-hit := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { focus-scope.focus(); root.command("select-playlist:" + pl.id); }
                        }
                        pl-txt := Text {
                            x: Theme.space-3;
                            width: parent.width - Theme.space-6;
                            height: 100%;
                            text: pl.name + " (" + pl.count + ")";
                            color: pl.is-active ? Theme.accent-brand : Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            font-weight: pl.is-active ? Theme.weight-semibold : Theme.weight-medium;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                clip: true;
                background: transparent;

                if root.model.empty-hint != "" : VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    padding: Theme.space-4;
                    Text {
                        text: root.model.empty-hint;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.model.empty-hint == "" && root.model.groups.length > 0 : ListView {
                    width: 100%;
                    height: 100%;
                    for g in root.model.groups : Rectangle {
                        height: root.q-row-stride;
                        Rectangle {
                            y: 0;
                            height: Theme.row-height;
                            background: g-ta.has-hover ? Theme.surface-base : transparent;
                            border-radius: Theme.radius-md;
                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-1;
                                spacing: Theme.space-2;
                                alignment: center;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    g-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { focus-scope.focus(); root.command("open-group:" + g.key); }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: Theme.space-2;
                                        Text {
                                            text: g.label;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: g.count;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                IconButton {
                                    icon: "play";
                                    size: ControlSize.sm;
                                    tooltip: root.model.play-group-label;
                                    clicked => { focus-scope.focus(); root.command("play-group:" + g.key); }
                                }
                                IconButton {
                                    icon: "plus";
                                    size: ControlSize.sm;
                                    tooltip: root.model.enqueue-label;
                                    clicked => { focus-scope.focus(); root.command("enqueue-group:" + g.key); }
                                }
                                if root.model.browse-tab == 3 && g.is-library-root : IconButton {
                                    icon: "close";
                                    size: ControlSize.sm;
                                    danger: true;
                                    tooltip: root.model.remove-root-label;
                                    clicked => { root.command("remove-root:" + g.key); }
                                }
                            }
                        }
                    }
                }

                browse-list := ListView {
                    width: 100%;
                    height: 100%;
                    visible: root.model.empty-hint == "" && root.model.tracks.length > 0 && root.model.groups.length == 0;
                    for t[i] in root.model.tracks : track-row := Rectangle {
                        height: root.q-row-stride;
                        Rectangle {
                            y: 0;
                            height: Theme.row-height;
                            background: root.q-drag-path == t.path
                                ? Theme.surface-base
                                : (t.is-current ? Theme.accent-soft : (row-ta.has-hover ? Theme.surface-base : transparent));
                            opacity: root.q-drag-path == t.path ? 0.55 : 1.0;
                            border-radius: Theme.radius-md;

                            if root.q-drag-path != "" && root.q-drop-index == i && root.q-drag-path != t.path : Rectangle {
                                y: 0;
                                height: 2px;
                                width: 100%;
                                background: Theme.accent-brand;
                            }

                            if t.is-current : Rectangle {
                                x: Theme.space-1;
                                y: Theme.space-2;
                                width: 3px;
                                height: parent.height - Theme.space-4;
                                border-radius: 2px;
                                background: Theme.accent-brand;
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-1;
                                spacing: Theme.space-1;
                                alignment: center;

                                if root.model.browse-tab == 6 : Rectangle {
                                    width: Theme.control-xs;
                                    height: Theme.control-xs;
                                    vertical-stretch: 0;
                                    Icon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "grip";
                                        size: Theme.font-size-md;
                                        tint: Theme.text-tertiary;
                                    }
                                    TouchArea {
                                        mouse-cursor: root.q-drag-path == t.path ? MouseCursor.grabbing : MouseCursor.grab;
                                        pointer-event(e) => {
                                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                                root.q-drag-path = t.path;
                                                root.q-drag-from = i;
                                                root.q-drop-index = i;
                                            }
                                            if root.q-drag-path == t.path && e.kind == PointerEventKind.move {
                                                let content-y = track-row.y + self.absolute-position.y - track-row.absolute-position.y + self.mouse-y;
                                                let raw = content-y / root.q-row-stride;
                                                let idx = min(root.model.tracks.length - 1, max(0, floor(raw)));
                                                root.q-drop-index = idx;
                                            }
                                            if root.q-drag-path == t.path && e.kind == PointerEventKind.up {
                                                if root.q-drop-index >= 0 && root.q-drop-index != root.q-drag-from {
                                                    root.command("queue-move-to:" + root.q-drop-index + "|" + root.q-drag-path);
                                                }
                                                root.q-drag-path = "";
                                                root.q-drag-from = -1;
                                                root.q-drop-index = -1;
                                            }
                                            if e.kind == PointerEventKind.cancel {
                                                root.q-drag-path = "";
                                                root.q-drag-from = -1;
                                                root.q-drop-index = -1;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    width: Theme.space-10;
                                    height: Theme.space-10;
                                    vertical-stretch: 0;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.surface-base;
                                    clip: true;
                                    if t.has-cover : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: t.cover;
                                        image-fit: cover;
                                    }
                                    if !t.has-cover : Text {
                                        text: "♪";
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    row-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            focus-scope.focus();
                                            if root.model.browse-tab == 6 {
                                                root.command("queue-play:" + t.path);
                                            } else {
                                                root.command("play-track:" + t.path);
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: t.title;
                                            color: t.is-current ? Theme.accent-brand : Theme.text-primary;
                                            font-size: Theme.font-size-md;
                                            font-weight: t.is-current ? Theme.weight-semibold : Theme.weight-regular;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: t.subtitle;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            overflow: elide;
                                        }
                                    }
                                }

                                if t.duration-label != "" : Text {
                                    text: t.duration-label;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    font-family: Theme.font-family-mono;
                                    vertical-alignment: center;
                                }

                                if root.model.browse-tab != 6 : IconButton {
                                    icon: "star";
                                    size: ControlSize.xs;
                                    active: t.is-favorite;
                                    clicked => { root.command("toggle-favorite:" + t.path); }
                                }
                                if root.model.browse-tab != 6 : IconButton {
                                    icon: "plus";
                                    size: ControlSize.xs;
                                    tooltip: root.model.enqueue-label;
                                    clicked => { root.command("enqueue:" + t.path); }
                                }
                                if root.model.browse-tab != 6 : IconButton {
                                    icon: "skip-next";
                                    size: ControlSize.xs;
                                    tooltip: root.model.play-next-label;
                                    clicked => { root.command("play-next:" + t.path); }
                                }
                                if root.model.browse-tab != 6 && root.model.active-playlist-id != "__recent__" : IconButton {
                                    icon: "layers";
                                    size: ControlSize.xs;
                                    tooltip: root.model.add-to-playlist-label;
                                    clicked => { root.command("add-to-active-playlist:" + t.path); }
                                }
                                if root.model.browse-tab == 5 : IconButton {
                                    icon: "minus";
                                    size: ControlSize.xs;
                                    tooltip: root.model.remove-from-playlist-label;
                                    clicked => { root.command("remove-from-active-playlist:" + t.path); }
                                }
                                if root.model.browse-tab == 6 : IconButton {
                                    icon: "chevron-up";
                                    size: ControlSize.xs;
                                    tooltip: root.model.move-up-label;
                                    clicked => { root.command("queue-up:" + t.path); }
                                }
                                if root.model.browse-tab == 6 : IconButton {
                                    icon: "chevron-down";
                                    size: ControlSize.xs;
                                    tooltip: root.model.move-down-label;
                                    clicked => { root.command("queue-down:" + t.path); }
                                }
                                if root.model.browse-tab == 6 : IconButton {
                                    icon: "close";
                                    size: ControlSize.xs;
                                    tooltip: root.model.remove-label;
                                    clicked => { root.command("remove-from-queue:" + t.path); }
                                }
                            }
                        }
                    }
                }
            }

            if root.model.lyrics-open && root.model.has-lyrics : Rectangle {
                vertical-stretch: 0;
                height: root.model.lyrics-panel-height * 1px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                clip: true;

                property <int> applied-lyrics-idx: -2;
                property <length> lyrics-row-stride: Theme.control-sm;

                lyrics-scroll-timer := Timer {
                    interval: 16ms;
                    running: root.model.lyrics-active-index != parent.applied-lyrics-idx;
                    triggered => {
                        if root.model.lyrics-active-index >= 0 {
                            let y = root.model.lyrics-active-index * parent.lyrics-row-stride;
                            let max-y = max(0px, lyrics-flick.viewport-height - lyrics-flick.height);
                            lyrics-flick.viewport-y = -min(max-y, max(0px, y - lyrics-flick.height / 3));
                        }
                        parent.applied-lyrics-idx = root.model.lyrics-active-index;
                    }
                }

                lyrics-flick := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: self.width;
                    viewport-height: lyrics-col.preferred-height;
                    lyrics-col := VerticalLayout {
                        width: parent.width;
                        spacing: 0px;
                        for line[idx] in root.model.lyrics-lines : Rectangle {
                            height: Theme.control-sm;
                            border-radius: Theme.radius-sm;
                            background: line.is-current ? Theme.accent-soft : (line-hit.has-hover && line.time-ms > 0 ? Theme.surface-base : transparent);
                            line-hit := TouchArea {
                                enabled: line.time-ms > 0;
                                mouse-cursor: line.time-ms > 0 ? MouseCursor.pointer : MouseCursor.default;
                                clicked => {
                                    focus-scope.focus();
                                    root.command("lyrics-seek:" + idx);
                                }
                            }
                            Text {
                                x: Theme.space-3;
                                width: parent.width - Theme.space-6;
                                height: 100%;
                                text: line.text;
                                color: line.is-current ? Theme.accent-brand : Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                font-weight: line.is-current ? Theme.weight-semibold : Theme.weight-regular;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            if !root.model.engine-available : Text {
                text: root.model.engine-missing-label;
                color: Theme.feedback-warning;
                font-size: Theme.font-size-sm;
                vertical-stretch: 0;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 0;
                background: Theme.gradient-chrome;
                border-radius: Theme.radius-lg;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: Theme.space-1;

                    HorizontalLayout {
                        spacing: Theme.space-3;
                        height: root.model.has-lyrics ? Theme.control-lg : Theme.control-md;
                        Rectangle {
                            width: parent.height;
                            height: parent.height;
                            vertical-stretch: 0;
                            background: root.model.has-cover ? Theme.surface-sunken : Theme.gradient-hero;
                            border-radius: Theme.radius-md;
                            clip: true;
                            if root.model.has-cover : Image {
                                width: 100%;
                                height: 100%;
                                source: root.model.cover;
                                image-fit: cover;
                            }
                            if !root.model.has-cover : Text {
                                text: "♪";
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-xl;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            if root.model.is-playing && root.model.has-track : Rectangle {
                                x: parent.width - self.width - Theme.space-1;
                                y: parent.height - self.height - Theme.space-1;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.feedback-success;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 0px;
                            Text {
                                text: root.model.has-track ? root.model.title : root.model.no-track-label;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-lg;
                                font-weight: Theme.weight-bold;
                                overflow: elide;
                            }
                            Text {
                                text: root.model.artist;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if root.model.album != "" : Text {
                                text: root.model.album;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if root.model.has-lyrics : lyrics-chip := TouchArea {
                                height: Theme.space-5;
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { focus-scope.focus(); root.command("toggle-lyrics"); }
                                Text {
                                    text: root.model.lyrics-open ? root.model.lyrics-label : (root.model.lyrics-line != "" ? root.model.lyrics-line : root.model.lyrics-label);
                                    color: lyrics-chip.has-hover ? Theme.accent-strong : Theme.accent-brand;
                                    font-size: Theme.font-size-sm;
                                    overflow: elide;
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.model.has-track : IconButton {
                            icon: "star";
                            size: ControlSize.sm;
                            active: root.model.is-current-favorite;
                            tooltip-flip: true;
                            clicked => { root.command("toggle-favorite-current"); }
                        }
                    }

                    HorizontalLayout {
                        height: Theme.touch-target;
                        spacing: Theme.space-2;
                        Text {
                            min-width: Theme.space-10 + Theme.space-6;
                            text: root.model.position-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-mono;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        seek-slider := TouchSlider {
                            value: root.seeking ? root.seek-hold : root.model.progress;
                            value-changed(v) => { root.begin-seek(v); }
                            changed scrubbing => {
                                if !self.scrubbing {
                                    root.seeking = false;
                                }
                            }
                        }
                        Text {
                            min-width: Theme.space-10 + Theme.space-6;
                            text: root.model.duration-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-mono;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        height: Theme.control-lg;
                        alignment: center;
                        spacing: Theme.space-3;
                        IconButton {
                            icon: "skip-prev";
                            size: ControlSize.md;
                            clicked => { focus-scope.focus(); root.command("prev"); }
                        }
                        HeroPlay {
                            playing: root.model.is-playing;
                            activated => { focus-scope.focus(); root.command("play-pause"); }
                        }
                        IconButton {
                            icon: "skip-next";
                            size: ControlSize.md;
                            clicked => { focus-scope.focus(); root.command("next"); }
                        }
                    }

                    HorizontalLayout {
                        height: Theme.touch-target;
                        spacing: Theme.space-1;
                        IconButton {
                            icon: "shuffle";
                            size: ControlSize.sm;
                            active: root.model.shuffle;
                            clicked => { root.command("shuffle"); }
                        }
                        IconButton {
                            icon: root.model.repeat == 2 ? "repeat-one" : "repeat";
                            size: ControlSize.sm;
                            active: root.model.repeat > 0;
                            clicked => { root.command("repeat"); }
                        }
                        IconButton {
                            icon: root.model.muted ? "volume-off" : "volume";
                            size: ControlSize.sm;
                            active: root.model.muted;
                            clicked => { root.command("mute"); }
                        }
                        Text {
                            min-width: Theme.space-10;
                            text: root.model.volume + "%";
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-mono;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        vol-slider := TouchSlider {
                            value: root.vol-drag ? root.vol-hold : min(1.0, root.model.volume / 150.0);
                            value-changed(v) => { root.begin-volume(v); }
                            changed scrubbing => {
                                if !self.scrubbing {
                                    root.vol-drag = false;
                                }
                            }
                        }
                    }

                    Flickable {
                        height: Theme.control-sm;
                        vertical-stretch: 0;
                        viewport-height: self.height;
                        viewport-width: extra-row.preferred-width;
                        extra-row := HorizontalLayout {
                            spacing: Theme.space-1;
                            alignment: center;
                            TouchButton {
                                text: root.model.sleep-label != "" ? root.model.sleep-label : root.model.sleep-off-label;
                                active: root.model.sleep-label != "";
                                size: ControlSize.xs;
                                tone: ButtonTone.ghost;
                                clicked => { root.command("sleep"); }
                            }
                            TouchButton {
                                text: root.model.eq-label != "" ? root.model.eq-label : root.model.eq-off-label;
                                active: root.model.eq-label != "";
                                size: ControlSize.xs;
                                tone: ButtonTone.ghost;
                                clicked => { root.command("eq"); }
                            }
                            TouchButton {
                                text: root.model.rg-label != "" ? root.model.rg-label : root.model.rg-off-label;
                                active: root.model.rg-label != "";
                                size: ControlSize.xs;
                                tone: ButtonTone.ghost;
                                clicked => { root.command("rg"); }
                            }
                            TouchButton {
                                text: root.model.speed-label != "" ? root.model.speed-label : root.model.speed-off-label;
                                active: root.model.speed-label != "";
                                size: ControlSize.xs;
                                tone: ButtonTone.ghost;
                                clicked => { root.command("speed"); }
                            }
                            TouchButton {
                                text: root.model.crossfade-label != "" ? root.model.crossfade-label : root.model.crossfade-off-label;
                                active: root.model.crossfade-label != "";
                                size: ControlSize.xs;
                                tone: ButtonTone.ghost;
                                clicked => { root.command("crossfade"); }
                            }
                            if root.model.has-track : TouchButton {
                                text: root.model.show-in-fm-label;
                                size: ControlSize.xs;
                                tone: ButtonTone.ghost;
                                clicked => { root.command("show-in-fm"); }
                            }
                        }
                    }
                }
            }
        }
    }
}
