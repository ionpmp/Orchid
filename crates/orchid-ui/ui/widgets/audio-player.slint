import { Theme } from "../theme_global.slint";
import { ControlSize, IconButton, TouchButton } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { AudioPlayerModel } from "../workspace/defs.slint";
import { SearchField } from "search-field.slint";

export component AudioPlayerView inherits Rectangle {
    in property <AudioPlayerModel> model;

    callback command(string);

    background: transparent;
    clip: true;

    /// Queue drag-reorder: source path while the grip is held.
    property <string> q-drag-path: "";
    property <int> q-drag-from: -1;
    property <int> q-drop-index: -1;
    property <length> q-row-stride: Theme.space-10 + Theme.hairline;
    property <int> applied-scroll-gen: -1;

    scroll-apply-timer := Timer {
        interval: 1ms;
        running: root.model.browse-tab == 6 && root.model.scroll-gen != root.applied-scroll-gen;
        triggered => {
            root.scroll-to-current();
            root.applied-scroll-gen = root.model.scroll-gen;
        }
    }

    public function scroll-to-current() {
        if root.model.current-track-index < 0 {
            return;
        }
        let y = root.q-row-stride * root.model.current-track-index;
        let margin = browse-flick.height / 3;
        let max-y = max(0px, browse-flick.viewport-height - browse-flick.height);
        browse-flick.viewport-y = min(max-y, max(0px, y - margin));
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == " " {
                root.command("play-pause");
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.command(event.modifiers.shift ? "seek-back-10" : "seek-back-5");
                return accept;
            }
            if event.text == Key.RightArrow {
                root.command(event.modifiers.shift ? "seek-fwd-10" : "seek-fwd-5");
                return accept;
            }
            if event.text == Key.UpArrow {
                root.command("vol-up");
                return accept;
            }
            if event.text == Key.DownArrow {
                root.command("vol-down");
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                root.command("mute");
                return accept;
            }
            if event.text == "s" || event.text == "S" {
                root.command("shuffle");
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                root.command("repeat");
                return accept;
            }
            if event.text == "n" || event.text == "N" {
                root.command("next");
                return accept;
            }
            if event.text == "p" || event.text == "P" {
                root.command("prev");
                return accept;
            }
            if event.text == "u" || event.text == "U" {
                root.command("rg");
                return accept;
            }
            if event.text == "t" || event.text == "T" {
                root.command("sleep");
                return accept;
            }
            if event.text == "e" || event.text == "E" {
                root.command("eq");
                return accept;
            }
            if event.text == "k" || event.text == "K" {
                root.command("speed");
                return accept;
            }
            if event.text == "x" || event.text == "X" {
                root.command("crossfade");
                return accept;
            }
            if event.text == "l" || event.text == "L" {
                if root.model.has-lyrics {
                    root.command("toggle-lyrics");
                    return accept;
                }
            }
            if event.text == "f" || event.text == "F" {
                if root.model.has-track {
                    root.command("toggle-favorite-current");
                    return accept;
                }
            }
            if event.text == "g" || event.text == "G" {
                if root.model.has-track {
                    root.command("show-in-fm");
                    return accept;
                }
            }
            if event.text == "c" || event.text == "C" {
                if root.model.has-track && !event.modifiers.control {
                    root.command("copy-track-path");
                    return accept;
                }
            }
            if event.text == Key.Return {
                if root.model.search-query != "" {
                    root.command("play-search");
                    return accept;
                }
            }
            if event.text == Key.Delete {
                if root.model.browse-tab == 6 {
                    root.command("remove-current-from-queue");
                    return accept;
                }
            }
            if event.text == Key.Home {
                if root.model.browse-tab == 6 {
                    root.command("queue-first");
                    return accept;
                }
            }
            if event.text == Key.End {
                if root.model.browse-tab == 6 {
                    root.command("queue-last");
                    return accept;
                }
            }
            if event.text == "." {
                if root.model.browse-tab == 6 {
                    root.scroll-to-current();
                    return accept;
                }
            }
            if event.text == "h" || event.text == "H" {
                if root.model.browse-tab == 6 {
                    root.command("reshuffle");
                    return accept;
                }
            }
            if event.text == Key.Backspace {
                root.command("stop");
                return accept;
            }
            if event.text == Key.Escape {
                root.command("escape");
                return accept;
            }
            if event.text == "1" {
                root.command("tab:0");
                return accept;
            }
            if event.text == "2" {
                root.command("tab:1");
                return accept;
            }
            if event.text == "3" {
                root.command("tab:2");
                return accept;
            }
            if event.text == "4" {
                root.command("tab:3");
                return accept;
            }
            if event.text == "5" {
                root.command("tab:4");
                return accept;
            }
            if event.text == "6" {
                root.command("tab:5");
                return accept;
            }
            if event.text == "7" {
                root.command("tab:6");
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: Theme.space-2;
            spacing: Theme.space-1;

            HorizontalLayout {
                spacing: Theme.space-1;
                height: Theme.control-xs;
                vertical-stretch: 0;

                Rectangle {
                    border-radius: Theme.radius-md;
                    background: root.model.browse-tab == 0 ? Theme.accent-brand : Theme.surface-base;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { focus-scope.focus(); root.command("tab:0"); } }
                    Text {
                        text: root.model.tab-songs;
                        color: root.model.browse-tab == 0 ? Theme.surface-base : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: root.model.browse-tab == 1 ? Theme.accent-brand : Theme.surface-base;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { focus-scope.focus(); root.command("tab:1"); } }
                    Text {
                        text: root.model.tab-artists;
                        color: root.model.browse-tab == 1 ? Theme.surface-base : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: root.model.browse-tab == 2 ? Theme.accent-brand : Theme.surface-base;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { focus-scope.focus(); root.command("tab:2"); } }
                    Text {
                        text: root.model.tab-albums;
                        color: root.model.browse-tab == 2 ? Theme.surface-base : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: root.model.browse-tab == 3 ? Theme.accent-brand : Theme.surface-base;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { focus-scope.focus(); root.command("tab:3"); } }
                    Text {
                        text: root.model.tab-folders;
                        color: root.model.browse-tab == 3 ? Theme.surface-base : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: root.model.browse-tab == 4 ? Theme.accent-brand : Theme.surface-base;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { focus-scope.focus(); root.command("tab:4"); } }
                    Text {
                        text: root.model.tab-genres;
                        color: root.model.browse-tab == 4 ? Theme.surface-base : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: root.model.browse-tab == 5 ? Theme.accent-brand : Theme.surface-base;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { focus-scope.focus(); root.command("tab:5"); } }
                    Text {
                        text: root.model.tab-playlists;
                        color: root.model.browse-tab == 5 ? Theme.surface-base : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: root.model.browse-tab == 6 ? Theme.accent-brand : Theme.surface-base;
                    horizontal-stretch: 1;
                    TouchArea { clicked => { focus-scope.focus(); root.command("tab:6"); } }
                    Text {
                        text: root.model.tab-now-playing;
                        color: root.model.browse-tab == 6 ? Theme.surface-base : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-1;
                height: Theme.control-xs;
                vertical-stretch: 0;

                if root.model.browse-filter != "" : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: back-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("clear-filter"); } }
                    back-txt := Text {
                        text: root.model.browse-filter-label != ""
                            ? root.model.back-label + " · " + root.model.browse-filter-label
                            : root.model.back-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                SearchField {
                    horizontal-stretch: 1;
                    field-height: Theme.control-xs;
                    query: root.model.search-query;
                    placeholder: root.model.search-placeholder;
                    edited(q) => { root.command("search:" + q); }
                    escape-pressed => { root.command("clear-search"); }
                }

                if root.model.search-query != "" && root.model.tracks.length > 0 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: play-search-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("play-search"); } }
                    play-search-txt := Text {
                        text: root.model.play-group-label;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.search-query != "" && root.model.tracks.length > 0 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: enq-search-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("enqueue-search"); } }
                    enq-search-txt := Text {
                        text: root.model.enqueue-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab != 6 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: sort-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("sort"); } }
                    sort-txt := Text {
                        text: root.model.sort-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: add-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("add-root"); } }
                    add-txt := Text {
                        text: root.model.add-folder-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: rescan-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("rescan"); } }
                    rescan-txt := Text {
                        text: root.model.rescan-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.has-library-roots : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: rem-root-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("remove-last-root"); } }
                    rem-root-txt := Text {
                        text: root.model.remove-root-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 5 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: new-pl-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("new-playlist"); } }
                    new-pl-txt := Text {
                        text: root.model.new-playlist-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 5 && root.model.active-playlist-id != "" && root.model.active-playlist-id != "__recent__" : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: rename-pl-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("start-rename-playlist"); } }
                    rename-pl-txt := Text {
                        text: root.model.rename-playlist-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 5 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: del-pl-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("delete-playlist"); } }
                    del-pl-txt := Text {
                        text: root.model.delete-playlist-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if (root.model.browse-tab == 5 || root.model.browse-tab == 6) && root.model.tracks.length > 0 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: export-m3u-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("export-m3u"); } }
                    export-m3u-txt := Text {
                        text: root.model.export-m3u-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 5 || root.model.browse-tab == 6 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: import-m3u-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("import-m3u"); } }
                    import-m3u-txt := Text {
                        text: root.model.import-m3u-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 6 && root.model.queue-stats-label != "" : Text {
                    text: root.model.queue-stats-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                if root.model.browse-tab == 6 && root.model.tracks.length > 0 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: save-q-pl-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("save-queue-as-playlist"); } }
                    save-q-pl-txt := Text {
                        text: root.model.save-queue-as-playlist-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 6 && root.model.current-track-index >= 0 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: jump-cur-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.scroll-to-current(); } }
                    jump-cur-txt := Text {
                        text: root.model.jump-to-current-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 6 && root.model.tracks.length > 1 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: reshuffle-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("reshuffle"); } }
                    reshuffle-txt := Text {
                        text: root.model.reshuffle-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }

                if root.model.browse-tab == 6 && root.model.tracks.length > 0 : Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-base;
                    width: clear-q-txt.preferred-width + Theme.space-4;
                    TouchArea { clicked => { root.command("clear-queue"); } }
                    clear-q-txt := Text {
                        text: root.model.clear-queue-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%; height: 100%;
                    }
                }
            }

            if root.model.roots.length > 0 : Flickable {
                height: Theme.control-xs;
                vertical-stretch: 0;
                viewport-height: self.height;
                HorizontalLayout {
                    spacing: Theme.space-1;
                    for r in root.model.roots : Rectangle {
                        border-radius: Theme.radius-md;
                        background: Theme.surface-base;
                        height: Theme.space-6;
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-1;
                            spacing: Theme.space-1;
                            Text {
                                text: r.label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: Theme.space-5;
                                height: Theme.space-5;
                                clicked => { root.command("remove-root:" + r.path); }
                                Text {
                                    text: "x";
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                        }
                    }
                }
            }

            if root.model.roots-label != "" : Text {
                text: root.model.roots-label;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
                vertical-stretch: 0;
            }

            if root.model.browse-tab == 5 && root.model.renaming-playlist : SearchField {
                field-height: Theme.control-xs;
                vertical-stretch: 0;
                query: root.model.rename-playlist-draft;
                placeholder: root.model.rename-playlist-label;
                edited(q) => { root.command("rename-playlist:" + q); }
                escape-pressed => { root.command("cancel-rename-playlist"); }
            }

            if root.model.browse-tab == 5 && root.model.empty-hint == "" : Flickable {
                height: Theme.control-xs;
                vertical-stretch: 0;
                viewport-width: pl-row.preferred-width;
                pl-row := HorizontalLayout {
                    spacing: Theme.space-1;
                    for pl in root.model.playlists : Rectangle {
                        border-radius: Theme.radius-md;
                        background: pl.is-active ? Theme.accent-brand : Theme.surface-base;
                        width: pl-txt.preferred-width + Theme.space-3 + Theme.hairline * 2;
                        height: Theme.control-xs;
                        TouchArea { clicked => { root.command("select-playlist:" + pl.id); } }
                        pl-txt := Text {
                            text: pl.name + " (" + pl.count + ")";
                            color: pl.is-active ? Theme.surface-base : Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                    }
                }
            }

            // Library / queue body — takes remaining height; lists scroll inside.
            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                clip: true;
                background: transparent;

                browse-flick := Flickable {
                    width: 100%;
                    height: 100%;
                    visible: root.model.empty-hint == "";
                    viewport-width: self.width;
                    viewport-height: browse-col.preferred-height;

                    browse-col := VerticalLayout {
                        spacing: Theme.hairline * 2;
                        width: parent.width;

                        if root.model.groups.length > 0 : VerticalLayout {
                            spacing: Theme.hairline * 2;
                            for g in root.model.groups : Rectangle {
                                height: Theme.space-8;
                                background: g-ta.has-hover ? Theme.surface-raised : transparent;
                                border-radius: Theme.radius-md;
                                HorizontalLayout {
                                    padding-left: Theme.space-2;
                                    padding-right: Theme.space-2;
                                    spacing: Theme.space-1;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        g-ta := TouchArea { clicked => { root.command("open-group:" + g.key); } }
                                        HorizontalLayout {
                                            Text {
                                                text: g.label;
                                                color: Theme.text-primary;
                                                font-size: Theme.font-size-md;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: g.count;
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-size-sm;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: Theme.control-xs;
                                        height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("play-group:" + g.key); } }
                                        Text {
                                            text: root.model.play-group-label;
                                            color: Theme.accent-brand;
                                            font-size: Theme.font-size-sm;
                                            font-weight: Theme.weight-semibold;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    Rectangle {
                                        width: Theme.control-xs;
                                        height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("enqueue-group:" + g.key); } }
                                        Text {
                                            text: root.model.enqueue-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab == 3 && g.is-library-root : Rectangle {
                                        width: Theme.control-xs;
                                        height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("remove-root:" + g.key); } }
                                        Text {
                                            text: root.model.remove-root-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                }
                            }
                        }

                        if root.model.tracks.length > 0 : VerticalLayout {
                            spacing: Theme.hairline;
                            for t[i] in root.model.tracks : Rectangle {
                                height: Theme.space-10;
                                background: root.q-drag-path == t.path
                                    ? Theme.surface-base
                                    : (root.q-drag-path != "" && root.q-drop-index == i
                                        ? Theme.accent-brand
                                        : (t.is-current ? Theme.surface-raised : (t-ta.has-hover ? Theme.surface-base : transparent)));
                                opacity: root.q-drag-path == t.path ? 0.55 : 1.0;
                                border-radius: Theme.radius-md;
                                    HorizontalLayout {
                                    padding-left: Theme.space-2;
                                    padding-right: Theme.space-2;
                                    spacing: Theme.space-1;
                                    if root.model.browse-tab == 6 : Rectangle {
                                        width: Theme.space-4 + Theme.hairline * 2;
                                        height: Theme.control-xs;
                                        Text {
                                            text: "⋮⋮";
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                        TouchArea {
                                            pointer-event(e) => {
                                                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                                    root.q-drag-path = t.path;
                                                    root.q-drag-from = i;
                                                    root.q-drop-index = i;
                                                }
                                                if root.q-drag-path == t.path && e.kind == PointerEventKind.move {
                                                    let pointer-y = self.absolute-position.y - browse-flick.absolute-position.y + self.mouse-y;
                                                    let content-y = pointer-y + browse-flick.viewport-y;
                                                    let raw = content-y / root.q-row-stride;
                                                    let idx = min(root.model.tracks.length - 1, max(0, floor(raw)));
                                                    root.q-drop-index = idx;
                                                }
                                                if root.q-drag-path == t.path && e.kind == PointerEventKind.up {
                                                    if root.q-drop-index >= 0 && root.q-drop-index != root.q-drag-from {
                                                        root.command("queue-move-to:" + root.q-drop-index + "|" + root.q-drag-path);
                                                    }
                                                    root.q-drag-path = "";
                                                    root.q-drag-from = -1;
                                                    root.q-drop-index = -1;
                                                }
                                                if e.kind == PointerEventKind.cancel {
                                                    root.q-drag-path = "";
                                                    root.q-drag-from = -1;
                                                    root.q-drop-index = -1;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: Theme.space-8;
                                        height: Theme.space-8;
                                        border-radius: Theme.radius-md;
                                        background: Theme.surface-base;
                                        clip: true;
                                        if t.has-cover : Image {
                                            width: 100%;
                                            height: 100%;
                                            source: t.cover;
                                            image-fit: cover;
                                        }
                                        if !t.has-cover : Text {
                                            text: "♪";
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        t-ta := TouchArea {
                                            clicked => {
                                                if root.model.browse-tab == 6 {
                                                    root.command("queue-play:" + t.path);
                                                } else {
                                                    root.command("play-track:" + t.path);
                                                }
                                            }
                                            double-clicked => {
                                                if root.model.browse-tab != 6 {
                                                    root.command("enqueue:" + t.path);
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: t.title;
                                                color: Theme.text-primary;
                                                font-size: Theme.font-size-md;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: t.subtitle;
                                                color: Theme.text-tertiary;
                                                font-size: Theme.font-size-sm;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    if t.duration-label != "" : Text {
                                        text: t.duration-label;
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: Theme.control-xs; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("toggle-favorite:" + t.path); } }
                                        Text {
                                            text: t.is-favorite ? "*" : "+";
                                            color: t.is-favorite ? Theme.accent-brand : Theme.text-tertiary;
                                            font-size: Theme.font-size-md;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab != 6 : Rectangle {
                                        width: Theme.control-xs; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("enqueue:" + t.path); } }
                                        Text {
                                            text: root.model.enqueue-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab != 6 : Rectangle {
                                        width: Theme.control-xs; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("play-next:" + t.path); } }
                                        Text {
                                            text: root.model.play-next-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab != 6 && root.model.active-playlist-id != "__recent__" : Rectangle {
                                        width: Theme.control-xs; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("add-to-active-playlist:" + t.path); } }
                                        Text {
                                            text: root.model.add-to-playlist-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab == 5 : Rectangle {
                                        width: Theme.control-xs; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("remove-from-active-playlist:" + t.path); } }
                                        Text {
                                            text: root.model.remove-from-playlist-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab == 6 : Rectangle {
                                        width: Theme.space-5 + Theme.hairline * 2; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("queue-up:" + t.path); } }
                                        Text {
                                            text: root.model.move-up-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab == 6 : Rectangle {
                                        width: Theme.space-5 + Theme.hairline * 2; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("queue-down:" + t.path); } }
                                        Text {
                                            text: root.model.move-down-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                    if root.model.browse-tab == 6 : Rectangle {
                                        width: Theme.control-xs; height: Theme.control-xs;
                                        TouchArea { clicked => { root.command("remove-from-queue:" + t.path); } }
                                        Text {
                                            text: root.model.remove-label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-size-sm;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%; height: 100%;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.model.empty-hint != "" : Text {
                    width: 100%;
                    height: 100%;
                    text: root.model.empty-hint;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.model.lyrics-open && root.model.has-lyrics : Rectangle {
                vertical-stretch: 0;
                height: root.model.lyrics-panel-height * 1px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                clip: true;

                property <int> applied-lyrics-idx: -2;
                property <length> lyrics-row-stride: Theme.space-5 + Theme.hairline * 2;

                lyrics-scroll-timer := Timer {
                    interval: 1ms;
                    running: root.model.lyrics-active-index != parent.applied-lyrics-idx;
                    triggered => {
                        if root.model.lyrics-active-index >= 0 {
                            let y = root.model.lyrics-active-index * parent.lyrics-row-stride;
                            let max-y = max(0px, lyrics-flick.viewport-height - lyrics-flick.height);
                            lyrics-flick.viewport-y = min(max-y, max(0px, y - lyrics-flick.height / 3));
                        }
                        parent.applied-lyrics-idx = root.model.lyrics-active-index;
                    }
                }

                lyrics-flick := Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: self.width;
                    viewport-height: lyrics-col.preferred-height;
                    VerticalLayout {
                        padding: Theme.space-2;
                        spacing: Theme.hairline * 2;
                        width: parent.width;
                        lyrics-col := VerticalLayout {
                            spacing: Theme.hairline * 2;
                            for line[idx] in root.model.lyrics-lines : Rectangle {
                                height: Theme.space-5;
                                HorizontalLayout {
                                    Text {
                                        width: 100%;
                                        height: Theme.space-5;
                                        text: line.text;
                                        color: line.is-current ? Theme.accent-brand : Theme.text-secondary;
                                        font-size: Theme.font-size-sm;
                                        font-weight: line.is-current ? Theme.weight-semibold : Theme.weight-regular;
                                        overflow: elide;
                                    }
                                }
                                if line.time-ms > 0 : TouchArea {
                                    clicked => {
                                        focus-scope.focus();
                                        root.command("lyrics-seek:" + idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Now-playing chrome — sized to content, never pushed outside the widget.
            Rectangle {
                vertical-stretch: 0;
                min-height: Theme.control-lg * 2 + Theme.space-2;
                background: Theme.gradient-chrome;
                border-radius: Theme.radius-lg;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;
                clip: true;

                VerticalLayout {
                    padding: Theme.space-3;
                    spacing: Theme.space-2;

                    HorizontalLayout {
                        spacing: Theme.space-3;
                        height: Theme.control-lg + Theme.space-1;
                        // Cover art doubles as the widget's light source.
                        Rectangle {
                            width: Theme.control-lg + Theme.space-1;
                            height: Theme.control-lg + Theme.space-1;
                            background: root.model.has-cover ? Theme.surface-sunken : Theme.gradient-hero;
                            border-radius: Theme.radius-md;
                            drop-shadow-blur: Theme.elev-2-blur;
                            drop-shadow-offset-y: Theme.elev-1-y;
                            drop-shadow-color: Theme.shadow-ambient;
                            clip: true;
                            if root.model.has-cover : Image {
                                width: 100%; height: 100%;
                                source: root.model.cover;
                                image-fit: cover;
                            }
                            if !root.model.has-cover : Text {
                                text: "♪";
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-2xl;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: Theme.hairline * 2;
                            Text {
                                text: root.model.has-track ? root.model.title : root.model.no-track-label;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-lg;
                                font-weight: Theme.weight-bold;
                                overflow: elide;
                            }
                            Text {
                                text: root.model.artist;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if root.model.album != "" : Text {
                                text: root.model.album;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if root.model.has-lyrics : Rectangle {
                                height: Theme.space-4 + Theme.hairline * 2;
                                TouchArea { clicked => { root.command("toggle-lyrics"); } }
                                Text {
                                    text: root.model.lyrics-open ? root.model.lyrics-label : (root.model.lyrics-line != "" ? root.model.lyrics-line : root.model.lyrics-label);
                                    color: Theme.accent-brand;
                                    font-size: Theme.font-size-sm;
                                    overflow: elide;
                                    width: 100%; height: 100%;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.model.has-track : IconButton {
                            icon: "star";
                            size: ControlSize.sm;
                            active: root.model.is-current-favorite;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.command("toggle-favorite-current"); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-1;
                        height: Theme.space-4;
                        Text {
                            text: root.model.position-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                        // Seek strip: a thin track with a finger-sized hit area.
                        progress-bar := Rectangle {
                            height: Theme.control-xs;
                            background: transparent;
                            horizontal-stretch: 1;
                            seek-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                moved => {
                                    if self.pressed && progress-bar.width > 0 {
                                        root.command("seek-frac:" + (self.mouse-x / progress-bar.width));
                                    }
                                }
                                clicked => {
                                    if progress-bar.width > 0 {
                                        root.command("seek-frac:" + (self.mouse-x / progress-bar.width));
                                    }
                                }
                            }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: seek-ta.has-hover ? Theme.track-height-lg : Theme.track-height;
                                width: parent.width;
                                background: Theme.surface-sunken;
                                border-radius: self.height / 2;

                                animate height { duration: Theme.motion-fast; easing: ease-out; }
                            }
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: seek-ta.has-hover ? Theme.track-height-lg : Theme.track-height;
                                width: parent.width * root.model.progress;
                                background: Theme.gradient-accent;
                                border-radius: self.height / 2;

                                animate height { duration: Theme.motion-fast; easing: ease-out; }
                            }
                        }
                        Text {
                            text: root.model.duration-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }

                    Flickable {
                        height: Theme.control-lg;
                        viewport-height: self.height;
                        viewport-width: max(self.width, transport-row.preferred-width);

                        transport-row := HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: center;
                            height: parent.height;

                            IconButton {
                                icon: "shuffle";
                                size: ControlSize.sm;
                                active: root.model.shuffle;
                                clicked => { root.command("shuffle"); }
                            }
                            IconButton {
                                icon: "skip-prev";
                                size: ControlSize.md;
                                clicked => { root.command("prev"); }
                            }
                            // Play is the hero control: bigger, filled, glowing.
                            Rectangle {
                                width: Theme.control-lg;
                                height: Theme.control-lg;
                                y: (parent.height - self.height) / 2;
                                border-radius: self.width / 2;
                                background: Theme.gradient-accent;
                                drop-shadow-blur: play-ta.has-hover ? Theme.elev-glow-blur : Theme.elev-1-blur;
                                drop-shadow-color: Theme.accent-glow;

                                animate drop-shadow-blur {
                                    duration: Theme.motion-fast;
                                    easing: ease-out;
                                }

                                play-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.command("play-pause"); }
                                }
                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    name: root.model.is-playing ? "pause" : "play";
                                    size: Theme.font-size-2xl;
                                    tint: Theme.accent-contrast;
                                }
                            }
                            IconButton {
                                icon: "skip-next";
                                size: ControlSize.md;
                                clicked => { root.command("next"); }
                            }
                            IconButton {
                                icon: root.model.repeat == 2 ? "repeat-one" : "repeat";
                                size: ControlSize.sm;
                                active: root.model.repeat > 0;
                                clicked => { root.command("repeat"); }
                            }
                            if root.model.has-track : TouchButton {
                                text: root.model.show-in-fm-label;
                                size: ControlSize.sm;
                                clicked => { root.command("show-in-fm"); }
                            }
                            vol-chip := Rectangle {
                                width: Theme.control-lg - Theme.space-1;
                                height: Theme.space-6;
                                VerticalLayout {
                                    spacing: Theme.hairline * 2;
                                    alignment: center;
                                    Text {
                                        text: root.model.muted ? "M" : (root.model.volume + "%");
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        height: Theme.indicator-thickness;
                                        background: Theme.surface-base;
                                        border-radius: Theme.hairline;
                                        Rectangle {
                                            height: parent.height;
                                            width: parent.width * min(1.0, root.model.volume / 150);
                                            background: Theme.accent-brand;
                                            border-radius: Theme.hairline;
                                        }
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        if self.width > 0 {
                                            root.command("volume:" + (self.mouse-x / self.width * 150));
                                        }
                                    }
                                    moved => {
                                        if self.pressed && self.width > 0 {
                                            root.command("volume:" + (self.mouse-x / self.width * 150));
                                        }
                                    }
                                    double-clicked => { root.command("mute"); }
                                    scroll-event(event) => {
                                        if event.delta-y > 0 {
                                            root.command("volume:" + min(150, root.model.volume + 5));
                                        }
                                        if event.delta-y < 0 {
                                            root.command("volume:" + max(0, root.model.volume - 5));
                                        }
                                        return accept;
                                    }
                                }
                            }
                            Rectangle {
                                width: sleep-txt.preferred-width + Theme.space-2 + Theme.hairline * 2; height: Theme.space-6;
                                TouchArea { clicked => { root.command("sleep"); } }
                                sleep-txt := Text {
                                    text: root.model.sleep-label != "" ? root.model.sleep-label : root.model.sleep-off-label;
                                    color: root.model.sleep-label != "" ? Theme.accent-brand : Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                            Rectangle {
                                width: eq-txt.preferred-width + Theme.space-2 + Theme.hairline * 2; height: Theme.space-6;
                                TouchArea { clicked => { root.command("eq"); } }
                                eq-txt := Text {
                                    text: root.model.eq-label != "" ? root.model.eq-label : root.model.eq-off-label;
                                    color: root.model.eq-label != "" ? Theme.accent-brand : Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                            Rectangle {
                                width: rg-txt.preferred-width + Theme.space-2 + Theme.hairline * 2; height: Theme.space-6;
                                TouchArea { clicked => { root.command("rg"); } }
                                rg-txt := Text {
                                    text: root.model.rg-label != "" ? root.model.rg-label : root.model.rg-off-label;
                                    color: root.model.rg-label != "" ? Theme.accent-brand : Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                            Rectangle {
                                width: speed-txt.preferred-width + Theme.space-2 + Theme.hairline * 2; height: Theme.space-6;
                                TouchArea { clicked => { root.command("speed"); } }
                                speed-txt := Text {
                                    text: root.model.speed-label != "" ? root.model.speed-label : root.model.speed-off-label;
                                    color: root.model.speed-label != "" ? Theme.accent-brand : Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                            Rectangle {
                                width: xf-txt.preferred-width + Theme.space-2 + Theme.hairline * 2; height: Theme.space-6;
                                TouchArea { clicked => { root.command("crossfade"); } }
                                xf-txt := Text {
                                    text: root.model.crossfade-label != "" ? root.model.crossfade-label : root.model.crossfade-off-label;
                                    color: root.model.crossfade-label != "" ? Theme.accent-brand : Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                            if !root.model.engine-available : Text {
                                text: root.model.engine-missing-label;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
