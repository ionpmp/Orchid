import { Theme } from "../theme_global.slint";
import { ButtonTone, Chip, ControlSize, Divider, Eyebrow, TouchButton } from "../kit.slint";
import { Icon } from "../kit-icons.slint";
import { PasswordAddDialogState } from "../workspace/defs.slint";

export component PasswordAddDialog inherits Rectangle {
    in property <PasswordAddDialogState> state;
    callback commit(string, string, string, string, string, string);
    callback cancel();
    callback generate-password();

    property <string> title-value: "";
    property <string> username-value: "";
    property <string> password-value: "";
    property <string> url-value: "";
    property <string> notes-value: "";
    property <string> group-id: "";
    property <string> new-group-value: "";
    property <int> gen-seq: state.gen-seq;
    property <string> gen-password: state.gen-password;
    property <int> seed-seq: state.seed-seq;
    property <bool> entered: false;

    changed gen-seq => {
        root.password-value = root.gen-password;
    }

    changed seed-seq => {
        root.title-value = state.initial-title;
        root.username-value = state.initial-username;
        root.url-value = state.initial-url;
        root.notes-value = state.initial-notes;
        root.group-id = state.initial-group-id;
        root.new-group-value = "";
        if (state.mode != 1) {
            root.password-value = "";
        }
    }

    init => { self.entered = true; }

    background: Theme.scrim;
    opacity: self.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.motion-fast; easing: ease-out; }

    backdrop-ta := TouchArea {
        clicked => { root.cancel(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.entered ? 0px : Theme.space-5);
        width: min(440px, parent.width - Theme.space-8);
        height: min(lay.preferred-height, parent.height - Theme.space-8);

        animate y { duration: Theme.motion-base; easing: ease-out; }
        background: Theme.gradient-glass;
        border-radius: Theme.radius-xl;
        border-width: Theme.hairline;
        border-color: Theme.border-strong;
        drop-shadow-blur: Theme.elev-3-blur;
        drop-shadow-offset-y: Theme.elev-3-y;
        drop-shadow-color: Theme.shadow-key;
        clip: true;

        TouchArea { }

        lay := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-4;

            HorizontalLayout {
                spacing: Theme.space-3;

                Rectangle {
                    min-width: Theme.control-md;
                    max-width: Theme.control-md;
                    min-height: Theme.control-md;
                    max-height: Theme.control-md;
                    border-radius: Theme.radius-md;
                    background: Theme.accent-soft;

                    Icon {
                        name: state.mode == 2 ? "refresh" : "plus";
                        size: Theme.font-size-xl;
                        tint: Theme.accent-brand;
                    }
                }

                Text {
                    text: state.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-xl;
                    font-weight: Theme.weight-bold;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }

            Divider { }

            if state.mode != 2 : VerticalLayout {
                spacing: Theme.space-2;
                Eyebrow { text: state.title-label; }
                Rectangle {
                    height: Theme.control-md;
                    background: Theme.surface-sunken;
                    border-radius: Theme.radius-pill;
                    border-width: Theme.hairline;
                    border-color: title-fs.has-focus ? Theme.border-focus : Theme.border-default;
                    title-fs := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        init => { if (state.request-autofocus) { self.focus(); } }
                        TouchArea { clicked => { title-fs.focus(); } }
                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-4;
                            TextInput {
                                text: root.title-value;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                single-line: true;
                                edited => { root.title-value = self.text; }
                            }
                        }
                    }
                }
            }

            if state.mode != 2 : VerticalLayout {
                spacing: Theme.space-2;
                Eyebrow { text: state.username-label; }
                Rectangle {
                    height: Theme.control-md;
                    background: Theme.surface-sunken;
                    border-radius: Theme.radius-pill;
                    border-width: Theme.hairline;
                    border-color: user-fs.has-focus ? Theme.border-focus : Theme.border-default;
                    user-fs := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        TouchArea { clicked => { user-fs.focus(); } }
                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-4;
                            TextInput {
                                text: root.username-value;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                single-line: true;
                                edited => { root.username-value = self.text; }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.space-2;
                Eyebrow { text: state.password-label; }
                if state.password-hint != "" : Text {
                    text: state.password-hint;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: center;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.control-md;
                        background: Theme.surface-sunken;
                        border-radius: Theme.radius-pill;
                        border-width: Theme.hairline;
                        border-color: pw-fs.has-focus ? Theme.border-focus : Theme.border-default;
                        pw-fs := FocusScope {
                            width: parent.width;
                            height: parent.height;
                            TouchArea { clicked => { pw-fs.focus(); } }
                            HorizontalLayout {
                                padding-left: Theme.space-4;
                                padding-right: Theme.space-4;
                                TextInput {
                                    text: root.password-value;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-md;
                                    font-family: Theme.font-family-mono;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    single-line: true;
                                    input-type: state.mode == 2 ? text : password;
                                    edited => { root.password-value = self.text; }
                                }
                            }
                        }
                    }
                    TouchButton {
                        text: state.generate-label;
                        icon: "refresh";
                        tone: ButtonTone.neutral;
                        size: ControlSize.md;
                        tooltip: state.generate-label;
                        clicked => { root.generate-password(); }
                    }
                }
            }

            if state.mode != 2 : VerticalLayout {
                spacing: Theme.space-2;
                Eyebrow { text: state.url-label; }
                Rectangle {
                    height: Theme.control-md;
                    background: Theme.surface-sunken;
                    border-radius: Theme.radius-pill;
                    border-width: Theme.hairline;
                    border-color: url-fs.has-focus ? Theme.border-focus : Theme.border-default;
                    url-fs := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        TouchArea { clicked => { url-fs.focus(); } }
                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-4;
                            TextInput {
                                text: root.url-value;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                single-line: true;
                                edited => { root.url-value = self.text; }
                            }
                        }
                    }
                }
            }

            if state.mode != 2 : VerticalLayout {
                spacing: Theme.space-2;
                Eyebrow { text: state.notes-label; }
                Rectangle {
                    min-height: Theme.control-md;
                    background: Theme.surface-sunken;
                    border-radius: Theme.radius-md;
                    border-width: Theme.hairline;
                    border-color: notes-fs.has-focus ? Theme.border-focus : Theme.border-default;
                    notes-fs := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        TouchArea { clicked => { notes-fs.focus(); } }
                        TextInput {
                            x: Theme.space-4;
                            y: Theme.space-2;
                            width: parent.width - Theme.space-8;
                            height: parent.height - Theme.space-4;
                            text: root.notes-value;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            wrap: word-wrap;
                            edited => { root.notes-value = self.text; }
                        }
                    }
                }
            }

            if state.mode != 2 : VerticalLayout {
                spacing: Theme.space-2;
                Eyebrow { text: state.group-label; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    for g[i] in state.groups : Chip {
                        text: g.name;
                        selected: root.group-id == g.id;
                        clicked => { root.group-id = g.id; }
                    }
                }
                Eyebrow { text: state.new-group-label; }
                Rectangle {
                    height: Theme.control-md;
                    background: Theme.surface-sunken;
                    border-radius: Theme.radius-pill;
                    border-width: Theme.hairline;
                    border-color: ng-fs.has-focus ? Theme.border-focus : Theme.border-default;
                    ng-fs := FocusScope {
                        width: parent.width;
                        height: parent.height;
                        TouchArea { clicked => { ng-fs.focus(); } }
                        HorizontalLayout {
                            padding-left: Theme.space-4;
                            padding-right: Theme.space-4;
                            TextInput {
                                text: root.new-group-value;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                single-line: true;
                                edited => { root.new-group-value = self.text; }
                            }
                        }
                    }
                }
            }

            if state.error != "" : Rectangle {
                background: Theme.feedback-danger-soft;
                border-radius: Theme.radius-md;
                border-width: Theme.hairline;
                border-color: Theme.feedback-danger.with-alpha(0.4);
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: Theme.space-3;
                    spacing: Theme.space-2;
                    Icon {
                        name: "warning";
                        size: Theme.font-size-lg;
                        tint: Theme.feedback-danger;
                    }
                    Text {
                        text: state.error;
                        color: Theme.feedback-danger;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;
                TouchButton {
                    text: state.cancel-label;
                    tone: ButtonTone.ghost;
                    size: ControlSize.md;
                    tooltip: state.cancel-label;
                    clicked => { root.cancel(); }
                }
                TouchButton {
                    text: state.submit-label;
                    icon: "check";
                    tone: ButtonTone.filled;
                    size: ControlSize.md;
                    tooltip: state.submit-label;
                    clicked => {
                        root.commit(
                            root.title-value,
                            root.username-value,
                            root.password-value,
                            root.url-value,
                            root.notes-value,
                            root.new-group-value != "" ? root.new-group-value : root.group-id,
                        );
                    }
                }
            }
        }
    }
}
