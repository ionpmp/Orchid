import { Theme } from "../theme_global.slint";
import { ContactsModel } from "../workspace/defs.slint";

export component ContactsView inherits Rectangle {
    in property <ContactsModel> model;
    property <string> account-password;

    callback select-contact(string);
    callback new-contact();
    callback set-field(string, string);
    callback save-contact();
    callback delete-contact();
    callback save-account(string, string, string);
    callback sync();

    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.space-2;
        padding: Theme.space-2;

        if root.model.status != "" : Text {
            text: root.model.status;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.space-2;
            vertical-stretch: 1;

            Rectangle {
                width: 180px;
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                VerticalLayout {
                    padding: Theme.space-1;
                    spacing: Theme.space-1;
                    Rectangle {
                        height: Theme.control-sm;
                        border-radius: Theme.radius-pill;
                        background: Theme.accent-brand;
                        TouchArea { clicked => { root.new-contact(); } }
                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.model.new-label;
                            color: Theme.text-on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        VerticalLayout {
                            width: parent.width;
                            spacing: Theme.space-1;
                            if root.model.rows.length == 0 : Text {
                                text: root.model.empty-label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                wrap: word-wrap;
                            }
                            for row in root.model.rows : Rectangle {
                                height: Theme.control-sm;
                                border-radius: Theme.radius-sm;
                                background: row.selected ? Theme.accent-soft : Theme.surface-base;
                                TouchArea { clicked => { root.select-contact(row.id); } }
                                Text {
                                    x: Theme.space-2;
                                    width: parent.width - Theme.space-3;
                                    height: 100%;
                                    text: row.label;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            if root.model.has-selection : VerticalLayout {
                spacing: Theme.space-1;
                horizontal-stretch: 1;
                Text { text: root.model.name-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                TextInput {
                    text: root.model.name;
                    color: Theme.text-primary;
                    single-line: true;
                    edited => { root.set-field("name", self.text); }
                }
                Text { text: root.model.email-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                TextInput {
                    text: root.model.email;
                    color: Theme.text-primary;
                    single-line: true;
                    edited => { root.set-field("email", self.text); }
                }
                Text { text: root.model.phone-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                TextInput {
                    text: root.model.phone;
                    color: Theme.text-primary;
                    single-line: true;
                    edited => { root.set-field("phone", self.text); }
                }
                Text { text: root.model.notes-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                TextInput {
                    text: root.model.notes;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                    edited => { root.set-field("notes", self.text); }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Rectangle {
                        height: Theme.control-sm;
                        border-radius: Theme.radius-pill;
                        background: Theme.accent-brand;
                        TouchArea { clicked => { root.save-contact(); } }
                        Text {
                            width: 100%; height: 100%;
                            text: root.model.save-label;
                            color: Theme.text-on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Rectangle {
                        height: Theme.control-sm;
                        border-radius: Theme.radius-pill;
                        background: Theme.state-hover;
                        TouchArea { clicked => { root.delete-contact(); } }
                        Text {
                            width: 100%; height: 100%;
                            text: root.model.delete-label;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: Theme.font-size-sm;
                        }
                    }
                }
            }
        }

        Text {
            text: root.model.hint;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
        Text { text: root.model.url-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
        TextInput {
            text: root.model.account-url;
            color: Theme.text-primary;
            single-line: true;
            edited => { root.set-field("account_url", self.text); }
        }
        Text { text: root.model.user-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
        TextInput {
            text: root.model.account-user;
            color: Theme.text-primary;
            single-line: true;
            edited => { root.set-field("account_user", self.text); }
        }
        Text { text: root.model.password-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
        password-edit := TextInput {
            color: Theme.text-primary;
            single-line: true;
            input-type: InputType.password;
            edited => { root.account-password = self.text; }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            Rectangle {
                height: Theme.control-sm;
                border-radius: Theme.radius-pill;
                background: Theme.accent-soft;
                TouchArea {
                    clicked => {
                        root.save-account(root.model.account-url, root.model.account-user, root.account-password);
                        root.account-password = "";
                        password-edit.text = "";
                    }
                }
                Text {
                    width: 100%; height: 100%;
                    text: root.model.save-account-label;
                    color: Theme.accent-brand;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.font-size-sm;
                }
            }
            Rectangle {
                height: Theme.control-sm;
                border-radius: Theme.radius-pill;
                background: Theme.state-hover;
                TouchArea { clicked => { root.sync(); } }
                Text {
                    width: 100%; height: 100%;
                    text: root.model.sync-label;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.font-size-sm;
                }
            }
        }
    }
}
