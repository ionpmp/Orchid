import { Theme } from "../theme_global.slint";
import { ButtonTone, Chip, ControlSize, ToggleSwitch, TouchButton } from "../kit.slint";
import { ProtectModel } from "../workspace/defs.slint";

export component ProtectView inherits Rectangle {
    in property <ProtectModel> model;

    callback tab-changed(int);
    callback toggled(string);
    callback scan();
    callback clean();
    callback select-drive(int);
    callback set-passes(int);
    callback wipe();
    callback cancel();
    callback refresh();

    background: transparent;

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-1;
            Chip {
                text: model.tab-traces;
                selected: model.tab == 0;
                clicked => { root.tab-changed(0); }
            }
            Chip {
                text: model.tab-histories;
                selected: model.tab == 1;
                clicked => { root.tab-changed(1); }
            }
            Chip {
                text: model.tab-wipe;
                selected: model.tab == 2;
                clicked => { root.tab-changed(2); }
            }
            Chip {
                text: model.tab-network;
                selected: model.tab == 3;
                clicked => { root.tab-changed(3); }
            }
        }

        Text {
            text: model.hint;
            wrap: word-wrap;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
        }

        if model.tab == 2 : VerticalLayout {
            spacing: Theme.space-2;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: Theme.space-1;
                for drive[index] in root.model.drives : Chip {
                    text: drive.label;
                    selected: drive.selected;
                    clicked => { root.select-drive(index); }
                }
            }

            Text {
                text: model.free-caption + " " + model.free-label;
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
            }

            HorizontalLayout {
                spacing: Theme.space-1;
                alignment: start;
                Text {
                    text: model.passes-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Chip {
                    text: "1";
                    selected: model.passes == 1;
                    clicked => { root.set-passes(1); }
                }
                Chip {
                    text: "3";
                    selected: model.passes == 3;
                    clicked => { root.set-passes(3); }
                }
            }

            if model.wipe-progress >= 0 : Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.border-default;
                Rectangle {
                    x: 0;
                    width: parent.width * model.wipe-progress;
                    height: parent.height;
                    border-radius: 3px;
                    background: Theme.accent-brand;
                }
            }
        }

        if model.tab != 2 : Flickable {
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                spacing: Theme.space-2;
                alignment: start;
                for row in root.model.rows : Rectangle {
                    background: Theme.surface-base;
                    border-radius: Theme.radius-md;
                    border-width: Theme.hairline;
                    border-color: Theme.border-default;
                    HorizontalLayout {
                        padding: Theme.space-3;
                        spacing: Theme.space-2;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.space-1;
                            Text {
                                text: row.title;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-md;
                            }
                            Text {
                                text: row.detail;
                                wrap: word-wrap;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.space-1;
                            Text {
                                text: row.size;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: right;
                            }
                            ToggleSwitch {
                                checked: row.checked;
                                label: row.title;
                                enabled: !root.model.busy;
                                toggled => { root.toggled(row.id); }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: center;
            if model.tab == 0 || model.tab == 1 : TouchButton {
                text: model.scan-label;
                size: ControlSize.sm;
                enabled: !model.busy;
                clicked => { root.scan(); }
            }
            if model.tab == 0 || model.tab == 1 : TouchButton {
                text: model.clean-label;
                size: ControlSize.sm;
                tone: ButtonTone.neutral;
                enabled: !model.busy;
                clicked => { root.clean(); }
            }
            if model.tab == 2 : TouchButton {
                text: model.wipe-label;
                size: ControlSize.sm;
                enabled: !model.busy;
                clicked => { root.wipe(); }
            }
            if model.tab == 2 : TouchButton {
                text: model.cancel-label;
                size: ControlSize.sm;
                tone: ButtonTone.neutral;
                enabled: model.busy;
                clicked => { root.cancel(); }
            }
            if model.tab == 3 : TouchButton {
                text: model.refresh-label;
                size: ControlSize.sm;
                enabled: !model.busy;
                clicked => { root.refresh(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if model.status != "" : Text {
                text: model.status;
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
