import { Theme } from "../theme_global.slint";
import { Icon } from "../kit-icons.slint";

/// Shared single-line search field with a placeholder that follows the
/// *input* text (not a possibly-stale model binding). When `query` is cleared
/// from outside (e.g. after picking a city), the draft resets so leftover
/// glyphs do not stack on top of the placeholder.
export component SearchField inherits Rectangle {
    in property <string> query;
    in property <string> placeholder;
    in property <length> field-height: Theme.control-md;
    callback edited(string);
    callback escape-pressed();

    height: root.field-height;
    background: Theme.surface-sunken;
    border-radius: Theme.radius-pill;
    border-width: Theme.hairline;
    border-color: input.has-focus ? Theme.border-focus : Theme.border-default;
    forward-focus: input;

    animate border-color { duration: Theme.motion-fast; easing: ease-out; }

    property <string> draft: root.query;
    property <string> synced: root.query;

    changed query => {
        if root.query != root.synced {
            root.draft = root.query;
            root.synced = root.query;
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;

        Icon {
            name: "search";
            size: Theme.font-size-lg;
            tint: input.has-focus ? Theme.accent-brand : Theme.text-tertiary;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            background: transparent;

            if input.text == "" : Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.text-tertiary;
                font-size: Theme.font-size-md;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }

            input := TextInput {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.draft;
                color: Theme.text-primary;
                font-size: Theme.font-size-md;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.draft = self.text;
                    root.edited(self.text);
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.escape-pressed();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}
