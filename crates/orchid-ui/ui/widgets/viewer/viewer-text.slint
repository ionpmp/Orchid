import { Theme } from "../../theme_global.slint";
import { ControlSize, IconButton, Tooltip } from "../../kit.slint";
import { ViewerTextModel } from "../../workspace/defs.slint";
import { DocToolBtn } from "viewer-doc-toolbtn.slint";

export component ViewerTextView inherits Rectangle {
    in property <ViewerTextModel> model;

    callback toggle-edit();
    callback save();
    callback text-edited(string);
    callback text-scroll(int);
    callback text-action(string);
    callback text-set-encoding(string);
    callback text-find-request(string, bool, bool, bool);
    callback text-replace-request(string, string, bool, bool, bool);

    background: transparent;

    property <string> draft-text: model.plain-text;
    property <bool> was-read-only: true;
    property <bool> locally-dirty: false;
    property <bool> wrap-on: false;
    property <bool> find-open: false;
    property <string> find-query: "";
    property <string> replace-query: "";
    property <bool> find-regex: false;
    property <bool> find-multiline: false;
    property <bool> encoding-open: false;

    changed model => {
        if model.read-only {
            root.draft-text = model.plain-text;
            root.was-read-only = true;
            root.locally-dirty = false;
        } else if root.was-read-only {
            root.draft-text = model.plain-text;
            root.was-read-only = false;
            root.locally-dirty = model.dirty;
        } else if root.draft-text == model.plain-text {
            root.locally-dirty = model.dirty;
        } else {
            root.locally-dirty = true;
        }
    }

    VerticalLayout {
        spacing: 0;

        // Main chrome
        Rectangle {
            height: Theme.control-xs + Theme.space-2;
            background: Theme.surface-sunken;
            clip: false;
            z: 20;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;
                alignment: start;

                DocToolBtn {
                    label: model.mode-label;
                    tip: model.mode-label;
                    active: !model.read-only;
                    clicked => { root.toggle-edit(); }
                }

                if !model.read-only : DocToolBtn {
                    label: model.save-label;
                    tip: model.save-label;
                    active: model.dirty || root.locally-dirty;
                    clicked => { root.save(); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.mode-text-label;
                    tip: model.mode-text-label;
                    active: model.display-mode == 0;
                    clicked => { root.text-action("text"); }
                }
                DocToolBtn {
                    label: model.mode-hex-label;
                    tip: model.mode-hex-label;
                    active: model.display-mode == 1;
                    clicked => { root.text-action("hex"); }
                }
                DocToolBtn {
                    label: model.mode-bin-label;
                    tip: model.mode-bin-label;
                    active: model.display-mode == 2;
                    clicked => { root.text-action("bin"); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: root.wrap-on ? model.wrap-label : model.no-wrap-label;
                    tip: root.wrap-on ? model.wrap-label : model.no-wrap-label;
                    active: root.wrap-on;
                    clicked => { root.wrap-on = !root.wrap-on; }
                }

                DocToolBtn {
                    label: model.find-label;
                    tip: model.find-label;
                    active: root.find-open;
                    clicked => { root.find-open = !root.find-open; }
                }

                if !model.read-only : DocToolBtn {
                    label: model.undo-label;
                    tip: model.undo-label;
                    enabled: model.can-undo;
                    clicked => { root.text-action("undo"); }
                }
                if !model.read-only : DocToolBtn {
                    label: model.redo-label;
                    tip: model.redo-label;
                    enabled: model.can-redo;
                    clicked => { root.text-action("redo"); }
                }

                DocToolBtn {
                    label: model.print-label;
                    tip: model.print-label;
                    clicked => { root.text-action("print"); }
                }

                Rectangle { horizontal-stretch: 1; }

                if model.dirty || root.locally-dirty : Rectangle {
                    width: Theme.space-4;
                    height: Theme.space-4;
                    y: (parent.height - self.height) / 2;
                    dirty-ta := TouchArea { }
                    Text {
                        text: "●";
                        color: Theme.feedback-warning;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Tooltip {
                        text: model.save-label;
                        shown: dirty-ta.has-hover;
                        x: (parent.width - self.width) / 2;
                        y: -self.height - Theme.space-2;
                    }
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        // Find / replace bar
        if root.find-open : Rectangle {
            height: root.find-multiline
                ? Theme.control-xs * 2 + Theme.space-6
                : Theme.control-xs * 2 + Theme.space-4;
            background: Theme.surface-sunken;

            VerticalLayout {
                padding-top: Theme.space-1;
                padding-bottom: Theme.space-1;
                spacing: Theme.space-1;

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    alignment: center;

                    Text {
                        text: model.find-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: root.find-multiline ? Theme.control-sm + Theme.space-2 : Theme.control-xs;
                        y: (parent.height - self.height) / 2;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: Theme.hairline;
                        border-color: Theme.border-default;

                        if find-input.text == "" : Text {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: 100%;
                            text: model.find-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        find-input := TextInput {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: 100%;
                            text <=> root.find-query;
                            single-line: !root.find-multiline;
                            wrap: word-wrap;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-mono;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return && !root.find-multiline) {
                                    root.text-find-request(root.find-query, !event.modifiers.shift, root.find-regex, root.find-multiline);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    IconButton {
                        icon: "chevron-up";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: model.find-label;
                        clicked => { root.text-find-request(root.find-query, false, root.find-regex, root.find-multiline); }
                    }
                    IconButton {
                        icon: "chevron-down";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: model.find-label;
                        clicked => { root.text-find-request(root.find-query, true, root.find-regex, root.find-multiline); }
                    }

                    Text {
                        min-width: 36px;
                        text: root.find-query == "" ? ""
                            : model.find-match-count <= 0 ? model.find-no-match-label
                            : "\{model.find-match-index}/\{model.find-match-count}";
                        color: model.find-match-count <= 0 && root.find-query != ""
                            ? Theme.text-tertiary : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    DocToolBtn {
                        label: model.regex-label;
                        tip: model.regex-label;
                        active: root.find-regex;
                        clicked => { root.find-regex = !root.find-regex; }
                    }
                    DocToolBtn {
                        label: model.multiline-label;
                        tip: model.multiline-label;
                        active: root.find-multiline;
                        clicked => { root.find-multiline = !root.find-multiline; }
                    }

                    IconButton {
                        icon: "close";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: model.find-label;
                        clicked => { root.find-open = false; }
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    alignment: center;

                    Text {
                        text: model.replace-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: root.find-multiline ? Theme.control-sm + Theme.space-2 : Theme.control-xs;
                        y: (parent.height - self.height) / 2;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: Theme.hairline;
                        border-color: Theme.border-default;

                        if replace-input.text == "" : Text {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: 100%;
                            text: model.replace-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        replace-input := TextInput {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: 100%;
                            text <=> root.replace-query;
                            single-line: !root.find-multiline;
                            wrap: word-wrap;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-mono;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return && !root.find-multiline) {
                                    root.text-replace-request(root.find-query, root.replace-query, false, root.find-regex, root.find-multiline);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    DocToolBtn {
                        label: model.replace-one-label;
                        tip: model.replace-one-label;
                        clicked => {
                            root.text-replace-request(root.find-query, root.replace-query, false, root.find-regex, root.find-multiline);
                        }
                    }
                    DocToolBtn {
                        label: model.replace-all-label;
                        tip: model.replace-all-label;
                        clicked => {
                            root.text-replace-request(root.find-query, root.replace-query, true, root.find-regex, root.find-multiline);
                        }
                    }
                }
            }
        }

        if root.find-open : Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        Rectangle {
            background: Theme.surface-base;
            vertical-stretch: 1;
            clip: true;

            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, edit-pad.preferred-height);

                edit-pad := HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    padding-top: Theme.space-1;
                    padding-bottom: Theme.space-1;

                    edit-input := TextInput {
                        width: parent.width - Theme.space-4;
                        text: root.draft-text;
                        single-line: false;
                        wrap: root.wrap-on ? word-wrap : no-wrap;
                        read-only: model.read-only;
                        color: Theme.text-primary;
                        font-family: Theme.font-family-mono;
                        font-size: Theme.font-size-sm;
                        property <int> sync-find-gen: model.find-gen;
                        changed sync-find-gen => {
                            edit-input.set-selection-offsets(model.find-anchor, model.find-cursor);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.F7 || (event.modifiers.control && (event.text == "f" || event.text == "F"))) {
                                root.find-open = true;
                                return accept;
                            }
                            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt) {
                                if (event.text == "s" || event.text == "S") {
                                    if (!model.read-only) {
                                        root.save();
                                        return accept;
                                    }
                                }
                                if (event.text == "z" || event.text == "Z") {
                                    if (!model.read-only) {
                                        root.text-action("undo");
                                        return accept;
                                    }
                                }
                                if (event.text == "y" || event.text == "Y") {
                                    if (!model.read-only) {
                                        root.text-action("redo");
                                        return accept;
                                    }
                                }
                            }
                            return reject;
                        }
                        edited => {
                            if (model.read-only) {
                                return;
                            }
                            root.draft-text = self.text;
                            root.locally-dirty = true;
                            root.text-edited(self.text);
                        }
                    }
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        Rectangle {
            height: Theme.control-xs - Theme.space-1;
            background: Theme.surface-sunken;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-3;

                DocToolBtn {
                    label: model.encoding;
                    tip: model.encoding;
                    active: root.encoding-open;
                    clicked => { root.encoding-open = !root.encoding-open; }
                }
                Text {
                    text: model.line-ending;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Text {
                    text: model.language;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Text {
                    text: model.lines-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if model.dirty || root.locally-dirty : Text {
                    text: "●";
                    color: Theme.feedback-warning;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.encoding-open : Rectangle {
        x: Theme.space-2;
        y: parent.height - (Theme.control-xs - Theme.space-1) - enc-flyout.preferred-height - Theme.space-1;
        width: max(140px, enc-flyout.preferred-width);
        height: min(220px, enc-flyout.preferred-height);
        background: Theme.surface-raised;
        border-radius: Theme.radius-md;
        border-width: Theme.hairline;
        border-color: Theme.border-default;
        drop-shadow-blur: Theme.elev-2-blur;
        drop-shadow-offset-y: Theme.elev-2-y;
        drop-shadow-color: Theme.shadow-key;
        z: 200;
        clip: true;

        enc-flyout := VerticalLayout {
            padding: Theme.space-1;
            spacing: Theme.space-1;
            for enc in model.encodings : Rectangle {
                height: Theme.control-xs - Theme.space-2;
                background: enc-item-ta.has-hover ? Theme.state-hover : Colors.transparent;
                border-radius: Theme.radius-md;
                enc-item-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.text-set-encoding(enc);
                        root.encoding-open = false;
                    }
                }
                Text {
                    x: Theme.space-2;
                    text: enc;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
