import { Theme } from "../../theme_global.slint";
import { ViewerTextModel } from "../../workspace/defs.slint";

export component ViewerTextView inherits Rectangle {
    in property <ViewerTextModel> model;

    callback toggle-edit();
    callback save();
    callback text-edited(string);
    callback text-scroll(int);
    callback text-action(string);
    callback text-set-encoding(string);
    callback text-find-request(string, bool, bool, bool);
    callback text-replace-request(string, string, bool, bool, bool);

    background: transparent;

    property <string> draft-text: model.plain-text;
    property <bool> was-read-only: true;
    property <bool> locally-dirty: false;
    property <bool> wrap-on: false;
    property <bool> find-open: false;
    property <string> find-query: "";
    property <string> replace-query: "";
    property <bool> find-regex: false;
    property <bool> find-multiline: false;
    property <bool> encoding-open: false;

    changed model => {
        if model.read-only {
            root.draft-text = model.plain-text;
            root.was-read-only = true;
            root.locally-dirty = false;
        } else if root.was-read-only {
            root.draft-text = model.plain-text;
            root.was-read-only = false;
            root.locally-dirty = model.dirty;
        } else if root.draft-text == model.plain-text {
            root.locally-dirty = model.dirty;
        } else {
            root.locally-dirty = true;
        }
    }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 36px;
            background: Theme.surface-base;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: start;

                Rectangle {
                    width: max(72px, mode-label.preferred-width + 16px);
                    height: 28px;
                    background: !model.read-only ? Theme.surface-raised
                        : mode-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    mode-ta := TouchArea { clicked => { root.toggle-edit(); } }
                    mode-label := Text {
                        text: model.mode-label;
                        color: model.read-only ? Theme.text-secondary : Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !model.read-only : Rectangle {
                    width: max(56px, save-label.preferred-width + 16px);
                    height: 28px;
                    background: (model.dirty || root.locally-dirty) ? Theme.surface-raised
                        : save-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    save-ta := TouchArea { clicked => { root.save(); } }
                    save-label := Text {
                        text: model.save-label;
                        color: (model.dirty || root.locally-dirty)
                            ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(40px, text-mode-label.preferred-width + 12px);
                    height: 28px;
                    background: model.display-mode == 0 ? Theme.surface-raised
                        : text-mode-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    text-mode-ta := TouchArea { clicked => { root.text-action("text"); } }
                    text-mode-label := Text {
                        text: model.mode-text-label;
                        color: model.display-mode == 0 ? Theme.accent-brand : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: max(40px, hex-mode-label.preferred-width + 12px);
                    height: 28px;
                    background: model.display-mode == 1 ? Theme.surface-raised
                        : hex-mode-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    hex-mode-ta := TouchArea { clicked => { root.text-action("hex"); } }
                    hex-mode-label := Text {
                        text: model.mode-hex-label;
                        color: model.display-mode == 1 ? Theme.accent-brand : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: max(40px, bin-mode-label.preferred-width + 12px);
                    height: 28px;
                    background: model.display-mode == 2 ? Theme.surface-raised
                        : bin-mode-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    bin-mode-ta := TouchArea { clicked => { root.text-action("bin"); } }
                    bin-mode-label := Text {
                        text: model.mode-bin-label;
                        color: model.display-mode == 2 ? Theme.accent-brand : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(48px, wrap-label.preferred-width + 12px);
                    height: 28px;
                    background: root.wrap-on ? Theme.surface-raised
                        : wrap-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    wrap-ta := TouchArea { clicked => { root.wrap-on = !root.wrap-on; } }
                    wrap-label := Text {
                        text: root.wrap-on ? model.wrap-label : model.no-wrap-label;
                        color: root.wrap-on ? Theme.accent-brand : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(40px, find-btn-label.preferred-width + 12px);
                    height: 28px;
                    background: root.find-open ? Theme.surface-raised
                        : find-btn-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    find-btn-ta := TouchArea { clicked => { root.find-open = !root.find-open; } }
                    find-btn-label := Text {
                        text: model.find-label;
                        color: root.find-open ? Theme.accent-brand : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if !model.read-only : Rectangle {
                    width: max(40px, undo-label.preferred-width + 12px);
                    height: 28px;
                    background: undo-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    undo-ta := TouchArea { clicked => { root.text-action("undo"); } }
                    undo-label := Text {
                        text: model.undo-label;
                        color: model.can-undo ? Theme.text-primary : Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if !model.read-only : Rectangle {
                    width: max(40px, redo-label.preferred-width + 12px);
                    height: 28px;
                    background: redo-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    redo-ta := TouchArea { clicked => { root.text-action("redo"); } }
                    redo-label := Text {
                        text: model.redo-label;
                        color: model.can-redo ? Theme.text-primary : Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(40px, print-label.preferred-width + 12px);
                    height: 28px;
                    background: print-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    print-ta := TouchArea { clicked => { root.text-action("print"); } }
                    print-label := Text {
                        text: model.print-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if model.dirty || root.locally-dirty : Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    Text {
                        text: "●";
                        color: #eab308;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.find-open : Rectangle {
            height: root.find-multiline ? 92px : 68px;
            background: Theme.surface-raised;

            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 4px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: model.find-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: root.find-multiline ? 40px : 26px;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        if find-input.text == "" : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: model.find-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        find-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.find-query;
                            single-line: !root.find-multiline;
                            wrap: word-wrap;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-mono;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return && !root.find-multiline) {
                                    root.text-find-request(root.find-query, !event.modifiers.shift, root.find-regex, root.find-multiline);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 26px;
                        background: find-prev-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        find-prev-ta := TouchArea {
                            clicked => { root.text-find-request(root.find-query, false, root.find-regex, root.find-multiline); }
                        }
                        Text {
                            text: "↑";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 28px;
                        height: 26px;
                        background: find-next-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        find-next-ta := TouchArea {
                            clicked => { root.text-find-request(root.find-query, true, root.find-regex, root.find-multiline); }
                        }
                        Text {
                            text: "↓";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        min-width: 36px;
                        text: root.find-query == "" ? ""
                            : model.find-match-count <= 0 ? model.find-no-match-label
                            : "\{model.find-match-index}/\{model.find-match-count}";
                        color: model.find-match-count <= 0 && root.find-query != ""
                            ? Theme.text-tertiary : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: max(44px, regex-label.preferred-width + 10px);
                        height: 26px;
                        background: root.find-regex ? Theme.surface-base
                            : regex-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        regex-ta := TouchArea { clicked => { root.find-regex = !root.find-regex; } }
                        regex-label := Text {
                            text: model.regex-label;
                            color: root.find-regex ? Theme.accent-brand : Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: max(56px, multi-label.preferred-width + 10px);
                        height: 26px;
                        background: root.find-multiline ? Theme.surface-base
                            : multi-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        multi-ta := TouchArea { clicked => { root.find-multiline = !root.find-multiline; } }
                        multi-label := Text {
                            text: model.multiline-label;
                            color: root.find-multiline ? Theme.accent-brand : Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 26px;
                        background: find-close-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        find-close-ta := TouchArea { clicked => { root.find-open = false; } }
                        Text {
                            text: "×";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: model.replace-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: root.find-multiline ? 40px : 26px;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        if replace-input.text == "" : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: model.replace-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        replace-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.replace-query;
                            single-line: !root.find-multiline;
                            wrap: word-wrap;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-mono;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return && !root.find-multiline) {
                                    root.text-replace-request(root.find-query, root.replace-query, false, root.find-regex, root.find-multiline);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    Rectangle {
                        width: max(52px, replace-one-label.preferred-width + 12px);
                        height: 26px;
                        background: replace-one-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        replace-one-ta := TouchArea {
                            clicked => {
                                root.text-replace-request(root.find-query, root.replace-query, false, root.find-regex, root.find-multiline);
                            }
                        }
                        replace-one-label := Text {
                            text: model.replace-one-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: max(40px, replace-all-label.preferred-width + 12px);
                        height: 26px;
                        background: replace-all-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        replace-all-ta := TouchArea {
                            clicked => {
                                root.text-replace-request(root.find-query, root.replace-query, true, root.find-regex, root.find-multiline);
                            }
                        }
                        replace-all-label := Text {
                            text: model.replace-all-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if root.find-open : Rectangle { height: 1px; background: Theme.border-default; }

        Rectangle {
            background: Theme.surface-base;
            vertical-stretch: 1;
            clip: true;

            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, edit-pad.preferred-height);

                edit-pad := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    edit-input := TextInput {
                        width: parent.width - 16px;
                        text: root.draft-text;
                        single-line: false;
                        wrap: root.wrap-on ? word-wrap : no-wrap;
                        read-only: model.read-only;
                        color: Theme.text-primary;
                        font-family: Theme.font-family-mono;
                        font-size: Theme.font-size-sm;
                        property <int> sync-find-gen: model.find-gen;
                        changed sync-find-gen => {
                            edit-input.set-selection-offsets(model.find-anchor, model.find-cursor);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.F7 || (event.modifiers.control && (event.text == "f" || event.text == "F"))) {
                                root.find-open = true;
                                return accept;
                            }
                            if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt) {
                                if (event.text == "s" || event.text == "S") {
                                    if (!model.read-only) {
                                        root.save();
                                        return accept;
                                    }
                                }
                                if (event.text == "z" || event.text == "Z") {
                                    if (!model.read-only) {
                                        root.text-action("undo");
                                        return accept;
                                    }
                                }
                                if (event.text == "y" || event.text == "Y") {
                                    if (!model.read-only) {
                                        root.text-action("redo");
                                        return accept;
                                    }
                                }
                            }
                            return reject;
                        }
                        edited => {
                            if (model.read-only) {
                                return;
                            }
                            root.draft-text = self.text;
                            root.locally-dirty = true;
                            root.text-edited(self.text);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 24px;
            background: Theme.surface-raised;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;

                Rectangle {
                    width: max(48px, enc-label.preferred-width + 8px);
                    height: 100%;
                    enc-ta := TouchArea { clicked => { root.encoding-open = !root.encoding-open; } }
                    enc-label := Text {
                        text: model.encoding;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: model.line-ending;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Text {
                    text: model.language;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                Text {
                    text: model.lines-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if model.dirty || root.locally-dirty : Text {
                    text: "●";
                    color: #eab308;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.encoding-open : Rectangle {
        x: 8px;
        y: parent.height - 24px - enc-flyout.preferred-height - 4px;
        width: max(140px, enc-flyout.preferred-width);
        height: min(220px, enc-flyout.preferred-height);
        background: Theme.surface-raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-default;
        z: 200;
        clip: true;

        enc-flyout := VerticalLayout {
            padding: 4px;
            spacing: 2px;
            for enc in model.encodings : Rectangle {
                height: 22px;
                background: enc-item-ta.has-hover ? Theme.surface-base : transparent;
                border-radius: Theme.radius-md;
                enc-item-ta := TouchArea {
                    clicked => {
                        root.text-set-encoding(enc);
                        root.encoding-open = false;
                    }
                }
                Text {
                    x: 8px;
                    text: enc;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
