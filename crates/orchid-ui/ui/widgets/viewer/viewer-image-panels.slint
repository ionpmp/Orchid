/// Histogram, GPS, editable EXIF / IPTC fields.
export component ImageMetaPanel inherits GlassCard {
    in property <ViewerImageModel> model;
    callback command(string);

    elevation: 2;
    clip: true;

    property <string> edit-title: model.meta-edit-title;
    property <string> edit-creator: model.meta-edit-creator;
    property <string> edit-copyright: model.meta-edit-copyright;
    property <string> edit-keywords: model.meta-edit-keywords;
    property <string> edit-description: model.meta-edit-description;
    property <string> edit-date: model.meta-edit-date;
    property <string> edit-gps: model.meta-edit-gps;

    changed model => {
        root.edit-title = model.meta-edit-title;
        root.edit-creator = model.meta-edit-creator;
        root.edit-copyright = model.meta-edit-copyright;
        root.edit-keywords = model.meta-edit-keywords;
        root.edit-description = model.meta-edit-description;
        root.edit-date = model.meta-edit-date;
        root.edit-gps = model.meta-edit-gps;
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        Eyebrow { text: model.meta-label; }

        if model.hist-width > 0 : Image {
            source: model.hist-image;
            width: parent.width - Theme.space-3 * 2;
            height: 72px;
            image-fit: fill;
        }
        if model.probe-text != "" : Text {
            text: model.probe-text;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            font-family: Theme.font-family-mono;
            wrap: word-wrap;
        }
        if model.has-gps : TouchButton {
            text: model.gps-map-label + "  " + model.gps-label;
            tone: ButtonTone.tonal;
            size: ControlSize.sm;
            wide: true;
            clicked => { root.command("gps-map"); }
        }

        Divider { }

        MetaFieldRow { label: model.meta-title-field-label; value <=> root.edit-title; }
        MetaFieldRow { label: model.meta-creator-field-label; value <=> root.edit-creator; }
        MetaFieldRow { label: model.meta-copyright-field-label; value <=> root.edit-copyright; }
        MetaFieldRow { label: model.meta-keywords-field-label; value <=> root.edit-keywords; }
        MetaFieldRow { label: model.meta-description-field-label; value <=> root.edit-description; }
        MetaFieldRow { label: model.meta-date-field-label; value <=> root.edit-date; }
        MetaFieldRow { label: model.meta-gps-field-label; value <=> root.edit-gps; }

        HorizontalLayout {
            spacing: Theme.space-1;
            TouchButton {
                text: model.meta-save-label;
                tone: ButtonTone.filled;
                size: ControlSize.sm;
                wide: true;
                clicked => {
                    root.command("meta-save:title=" + root.edit-title
                        + "\ncreator=" + root.edit-creator
                        + "\ncopyright=" + root.edit-copyright
                        + "\nkeywords=" + root.edit-keywords
                        + "\ndescription=" + root.edit-description
                        + "\ndate=" + root.edit-date
                        + "\ngps=" + root.edit-gps);
                }
            }
            TouchButton {
                text: model.meta-strip-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("meta-strip"); }
            }
            TouchButton {
                text: model.meta-strip-gps-label;
                tone: ButtonTone.ghost;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("meta-strip-gps"); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            TouchButton {
                text: model.meta-export-csv-label;
                tone: ButtonTone.ghost;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("meta-export-csv"); }
            }
            TouchButton {
                text: model.meta-export-xml-label;
                tone: ButtonTone.ghost;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("meta-export-xml"); }
            }
        }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: max(self.height, meta-body.preferred-height);
            meta-body := Text {
                width: parent.width;
                text: model.meta-text;
                color: Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-family: Theme.font-family-mono;
                wrap: word-wrap;
            }
        }
    }
}

/// Multi-frame / animation transport strip.
export component ImageAnimBar inherits GlassCard {
    in property <ViewerImageModel> model;
    callback command(string);

    elevation: 2;
    clip: true;
    background: Theme.surface-floating;

    VerticalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-1;
            alignment: center;
            height: Theme.control-sm;

            if model.anim-can-play : IconButton {
                icon: model.anim-playing ? "pause" : "play";
                size: ControlSize.sm;
                active: model.anim-playing;
                tooltip: model.anim-playing ? model.anim-pause-label : model.anim-play-label;
                clicked => { root.command("anim-toggle"); }
            }
            IconButton {
                icon: "skip-prev";
                size: ControlSize.sm;
                tooltip: model.anim-first-label;
                clicked => { root.command("anim-first"); }
            }
            IconButton {
                icon: "chevron-left";
                size: ControlSize.sm;
                tooltip: model.anim-prev-label;
                clicked => { root.command("anim-prev"); }
            }
            IconButton {
                icon: "chevron-right";
                size: ControlSize.sm;
                tooltip: model.anim-next-label;
                clicked => { root.command("anim-next"); }
            }
            IconButton {
                icon: "skip-next";
                size: ControlSize.sm;
                tooltip: model.anim-last-label;
                clicked => { root.command("anim-last"); }
            }
            Text {
                text: model.anim-label + "  " + model.anim-index-label;
                color: Theme.text-primary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            TouchButton {
                text: model.anim-extract-label;
                tone: ButtonTone.tonal;
                size: ControlSize.sm;
                clicked => { root.command("anim-extract"); }
            }
            if model.anim-can-play : TouchButton {
                text: model.anim-export-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                clicked => { root.command("anim-export"); }
            }
        }

        Flickable {
            height: 44px;
            viewport-width: max(self.width, model.anim-thumbs.length * 40px + 8px);
            viewport-height: self.height;
            HorizontalLayout {
                spacing: Theme.space-1;
                for item in model.anim-thumbs : Rectangle {
                    width: 36px;
                    height: 40px;
                    background: item.selected ? Theme.accent-soft : Colors.transparent;
                    border-radius: Theme.radius-md;
                    border-width: item.selected ? Theme.hairline : 0px;
                    border-color: Theme.accent-brand;
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.command("anim-goto:" + item.index); }
                    }
                    VerticalLayout {
                        Image {
                            source: item.thumbnail;
                            width: 32px;
                            height: 24px;
                            image-fit: contain;
                        }
                        Text {
                            text: item.name;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-xs;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
