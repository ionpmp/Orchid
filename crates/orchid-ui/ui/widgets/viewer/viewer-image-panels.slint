import { Theme } from "../../theme_global.slint";
import { ViewerImageModel } from "../../workspace/defs.slint";
import {
    ButtonTone, Chip, ControlSize, Divider, Eyebrow, GlassCard, IconButton, TouchButton,
} from "../../kit.slint";

/// Compact sunken text field for dense image-viewer panels.
component PanelField inherits Rectangle {
    in-out property <string> text;
    in property <bool> mono: false;
    callback accepted();

    height: Theme.control-sm;
    background: Theme.surface-sunken;
    border-radius: Theme.radius-md;
    border-width: Theme.hairline;
    border-color: field-fs.has-focus ? Theme.border-focus : Theme.border-subtle;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    animate border-color { duration: Theme.motion-fast; easing: ease-out; }

    field-fs := FocusScope {
        width: parent.width;
        height: parent.height;
        TouchArea { clicked => { field-fs.focus(); } }

        HorizontalLayout {
            padding-left: Theme.space-2;
            padding-right: Theme.space-2;

            TextInput {
                text <=> root.text;
                color: Theme.text-primary;
                font-size: Theme.font-size-sm;
                font-family: root.mono ? Theme.font-family-mono : Theme.font-family-sans;
                vertical-alignment: center;
                horizontal-stretch: 1;
                single-line: true;
                accepted => { root.accepted(); }
            }
        }
    }
}

/// Label + field row for metadata editing.
component MetaFieldRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;

    spacing: Theme.space-2;
    min-height: Theme.control-sm;
    max-height: Theme.control-sm;
    alignment: center;

    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font-size-xs;
        font-weight: Theme.weight-medium;
        width: 76px;
        vertical-alignment: center;
    }

    PanelField {
        text <=> root.value;
        horizontal-stretch: 1;
    }
}

/// Annotation tools: shapes, privacy, watermark, stamp.
export component ImageAnnotatePanel inherits GlassCard {
    in property <ViewerImageModel> model;
    in-out property <int> ann-mode;
    in-out property <bool> ann-pixel;
    in-out property <string> ann-color;
    in-out property <string> ann-width;
    in-out property <string> ann-size;
    in-out property <string> ann-font;
    in-out property <string> ann-opacity;
    in-out property <string> ann-pos;
    in-out property <string> ann-text;
    in-out property <string> ann-wm;
    in-out property <string> ann-wm-path;
    in-out property <string> poly-pts;

    callback command(string);

    elevation: 2;
    clip: true;

    function ann-style() -> string {
        return "color=" + root.ann-color + " | width=" + root.ann-width + " | size=" + root.ann-size
            + " | font=" + root.ann-font + " | opacity=" + root.ann-opacity + " | pos=" + root.ann-pos;
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        Eyebrow { text: model.annotate-label; }
        Text {
            text: model.annotate-hint-label;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
        Divider { }

        HorizontalLayout {
            spacing: Theme.space-1;
            Chip { text: model.annotate-line-label; selected: root.ann-mode == 1; clicked => { root.ann-mode = 1; } }
            Chip { text: model.annotate-arrow-label; selected: root.ann-mode == 2; clicked => { root.ann-mode = 2; } }
            Chip { text: model.annotate-rect-label; selected: root.ann-mode == 3; clicked => { root.ann-mode = 3; } }
            Chip { text: model.annotate-ellipse-label; selected: root.ann-mode == 4; clicked => { root.ann-mode = 4; } }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            Chip {
                text: model.annotate-poly-label;
                selected: root.ann-mode == 5;
                clicked => { root.ann-mode = 5; root.poly-pts = ""; }
            }
            Chip { text: model.annotate-pen-label; selected: root.ann-mode == 6; clicked => { root.ann-mode = 6; } }
            Chip { text: model.annotate-text-label; selected: root.ann-mode == 7; clicked => { root.ann-mode = 7; } }
            Chip { text: model.annotate-callout-label; selected: root.ann-mode == 8; clicked => { root.ann-mode = 8; } }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            Chip { text: model.annotate-privacy-label; selected: root.ann-mode == 9; clicked => { root.ann-mode = 9; } }
            Chip {
                text: root.ann-pixel ? "px" : "blur";
                selected: root.ann-pixel;
                clicked => { root.ann-pixel = !root.ann-pixel; }
            }
            Chip { text: model.annotate-highlight-label; selected: root.ann-mode == 10; clicked => { root.ann-mode = 10; } }
            TouchButton {
                text: model.annotate-apply-label;
                tone: ButtonTone.tonal;
                size: ControlSize.sm;
                clicked => {
                    if (root.poly-pts != "") {
                        root.command("annotate-view:poly:" + root.poly-pts + " | " + root.ann-style());
                        root.poly-pts = "";
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-1;
            PanelField { text <=> root.ann-text; }
            PanelField { text <=> root.ann-color; width: 72px; horizontal-stretch: 0; }
            PanelField { text <=> root.ann-width; width: 40px; horizontal-stretch: 0; }
            PanelField { text <=> root.ann-size; width: 40px; horizontal-stretch: 0; }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            PanelField { text <=> root.ann-font; }
            PanelField { text <=> root.ann-opacity; width: 40px; horizontal-stretch: 0; }
            PanelField { text <=> root.ann-pos; width: 40px; horizontal-stretch: 0; }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            PanelField { text <=> root.ann-wm; }
            TouchButton {
                text: model.annotate-watermark-label;
                tone: ButtonTone.tonal;
                size: ControlSize.sm;
                clicked => { root.command("annotate:watermark=" + root.ann-wm + " | " + root.ann-style()); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            PanelField { text <=> root.ann-wm-path; }
            TouchButton {
                text: model.annotate-wm-image-label;
                tone: ButtonTone.tonal;
                size: ControlSize.sm;
                clicked => {
                    root.command("annotate:wm-image=" + root.ann-wm-path + " | " + root.ann-style() + " | scale=0.22");
                }
            }
        }
        TouchButton {
            text: model.annotate-stamp-label;
            tone: ButtonTone.filled;
            size: ControlSize.sm;
            wide: true;
            clicked => { root.command("annotate:stamp | " + root.ann-style()); }
        }
    }
}

/// Print paper / N-up / preview controls.
export component ImagePrintPanel inherits GlassCard {
    in property <ViewerImageModel> model;
    in-out property <string> print-paper;
    in-out property <string> print-margin;
    in-out property <string> print-nup;
    in-out property <string> print-fit;
    in-out property <string> print-header;
    in-out property <string> print-footer;
    in-out property <string> print-icc;

    callback command(string);

    elevation: 2;
    clip: true;

    function print-spec() -> string {
        return "paper=" + root.print-paper + " | margin=" + root.print-margin + " | nup=" + root.print-nup
            + " | fit=" + root.print-fit + " | header=" + root.print-header + " | footer=" + root.print-footer
            + " | icc=" + root.print-icc;
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        Eyebrow { text: model.print-label; }
        Text {
            text: model.print-hint-label;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
        Divider { }

        HorizontalLayout {
            spacing: Theme.space-1;
            PanelField { text <=> root.print-paper; width: 64px; horizontal-stretch: 0; }
            PanelField { text <=> root.print-margin; width: 44px; horizontal-stretch: 0; }
            PanelField { text <=> root.print-nup; width: 36px; horizontal-stretch: 0; }
            PanelField { text <=> root.print-fit; }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            PanelField { text <=> root.print-header; }
            PanelField { text <=> root.print-footer; }
        }
        PanelField { text <=> root.print-icc; }

        HorizontalLayout {
            spacing: Theme.space-2;
            TouchButton {
                text: model.print-preview-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("print-preview:" + root.print-spec()); }
            }
            TouchButton {
                text: model.print-label;
                tone: ButtonTone.filled;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("print:" + root.print-spec()); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            alignment: center;
            TouchButton {
                text: model.print-sheet-label;
                tone: ButtonTone.tonal;
                size: ControlSize.sm;
                clicked => { root.command("print-preview:sheet | folder | " + root.print-spec()); }
            }
            Chip {
                text: "2";
                selected: root.print-nup == "2";
                clicked => { root.print-nup = "2"; root.command("print-preview:folder | " + root.print-spec()); }
            }
            Chip {
                text: "4";
                selected: root.print-nup == "4";
                clicked => { root.print-nup = "4"; root.command("print-preview:folder | " + root.print-spec()); }
            }
            Chip {
                text: "6";
                selected: root.print-nup == "6";
                clicked => { root.print-nup = "6"; root.command("print-preview:folder | " + root.print-spec()); }
            }
            Chip {
                text: "9";
                selected: root.print-nup == "9";
                clicked => { root.print-nup = "9"; root.command("print-preview:folder | " + root.print-spec()); }
            }
        }
    }
}

/// Export / share / screenshot actions.
export component ImageSharePanel inherits GlassCard {
    in property <ViewerImageModel> model;
    in-out property <string> export-fmt;
    in-out property <string> export-q;
    in-out property <string> export-max;

    callback command(string);

    elevation: 2;
    clip: true;

    function export-spec() -> string {
        return root.export-fmt + " | q=" + root.export-q + " | max=" + root.export-max;
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        Eyebrow { text: model.export-label; }
        Text {
            text: model.export-hint-label;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
        Divider { }

        HorizontalLayout {
            spacing: Theme.space-1;
            PanelField { text <=> root.export-fmt; width: 64px; horizontal-stretch: 0; }
            PanelField { text <=> root.export-q; width: 44px; horizontal-stretch: 0; }
            PanelField { text <=> root.export-max; }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            TouchButton {
                text: model.export-save-label;
                tone: ButtonTone.filled;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("export:" + root.export-spec()); }
            }
            TouchButton {
                text: model.export-ico-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                clicked => { root.command("export:ico"); }
            }
            TouchButton {
                text: model.export-favicon-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                clicked => { root.command("export:favicon"); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            TouchButton {
                text: model.export-copy-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("copy-image"); }
            }
            TouchButton {
                text: model.export-paste-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("paste-image"); }
            }
            TouchButton {
                text: model.export-wallpaper-label;
                tone: ButtonTone.neutral;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("wallpaper"); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            TouchButton {
                text: model.export-email-label;
                tone: ButtonTone.tonal;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("email:max=" + root.export-max); }
            }
            TouchButton {
                text: model.export-share-label;
                tone: ButtonTone.tonal;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("share:twitter"); }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            TouchButton {
                text: model.export-shot-label;
                tone: ButtonTone.ghost;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("screenshot:screen"); }
            }
            TouchButton {
                text: model.export-shot-window-label;
                tone: ButtonTone.ghost;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("screenshot:window | delay=2"); }
            }
            TouchButton {
                text: model.export-shot-delay-label;
                tone: ButtonTone.ghost;
                size: ControlSize.sm;
                wide: true;
                clicked => { root.command("screenshot:screen | delay=3"); }
            }
        }
    }
}

/// Quick filters and looks.
export component ImageFilterPanel inherits GlassCard {
    in property <ViewerImageModel> model;
    callback command(string);

    elevation: 2;
    clip: true;

    property <string> filter-expr: "sharpen=1 | vignette=20";

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-2;

        Eyebrow { text: model.filter-label; }
        Text {
            text: model.filter-hint-label;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
        Divider { }

        PanelField {
            text <=> root.filter-expr;
            mono: true;
            accepted => { root.command("filter:" + root.filter-expr); }
        }
        TouchButton {
            text: model.filter-apply-label;
            tone: ButtonTone.filled;
            size: ControlSize.sm;
            wide: true;
            clicked => { root.command("filter:" + root.filter-expr); }
        }

        HorizontalLayout {
            spacing: Theme.space-1;
            Chip { text: model.filter-sharpen-label; clicked => { root.command("filter:sharpen"); } }
            Chip { text: model.filter-blur-label; clicked => { root.command("filter:blur=1.5"); } }
            Chip { text: model.filter-despeckle-label; clicked => { root.command("filter:despeckle"); } }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            Chip { text: model.filter-cartoon-label; clicked => { root.command("filter:cartoon"); } }
            Chip { text: model.filter-sketch-label; clicked => { root.command("filter:sketch"); } }
            Chip { text: model.filter-vignette-label; clicked => { root.command("filter:vignette=40"); } }
            Chip { text: model.filter-redeye-label; clicked => { root.command("filter:redeye"); } }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            Chip { text: model.filter-look-vivid-label; clicked => { root.command("filter:look=vivid"); } }
            Chip { text: model.filter-look-soft-label; clicked => { root.command("filter:look=soft"); } }
            Chip { text: model.filter-look-drama-label; clicked => { root.command("filter:look=drama"); } }
            Chip { text: model.filter-look-clean-label; clicked => { root.command("filter:look=clean"); } }
        }
    }
}

