import { Theme } from "../../theme_global.slint";
import { EmptyState, Tooltip } from "../../kit.slint";
import { Icon } from "../../kit-icons.slint";
import { ViewerArchiveModel } from "../../workspace/defs.slint";
import { DocToolBtn } from "viewer-doc-toolbtn.slint";

export component ViewerArchiveView inherits Rectangle {
    in property <ViewerArchiveModel> model;

    callback navigate-into(string);
    callback navigate-up();
    callback select(string);
    callback extract-selected();
    callback extract-all();

    // Map entry kind → kit Icon name (stroke glyphs stay visible on Windows).
    pure function archive-entry-icon(icon: string) -> string {
        return
            icon == "up" ? "arrow-up" :
            icon == "folder" ? "dock" :
            icon == "file" ? "layers" :
            "dot";
    }

    background: transparent;

    VerticalLayout {
        spacing: 0;

        // Main chrome
        Rectangle {
            height: Theme.control-xs + Theme.space-2;
            background: Theme.surface-sunken;
            clip: false;
            z: 20;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;
                alignment: start;

                Text {
                    text: model.header-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-medium;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: Theme.control-xs;
                    y: (parent.height - self.height) / 2;
                    background: Theme.surface-base;
                    border-radius: Theme.radius-md;
                    border-width: Theme.hairline;
                    border-color: Theme.border-default;
                    clip: false;

                    path-ta := TouchArea { }

                    Text {
                        x: Theme.space-2;
                        width: parent.width - Theme.space-4;
                        height: 100%;
                        text: model.path-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    Tooltip {
                        text: model.path-label;
                        shown: path-ta.has-hover && model.path-label != "";
                        x: Theme.space-1;
                        y: -self.height - Theme.space-2;
                    }
                }

                DocToolBtn {
                    label: model.extract-all-label;
                    tip: model.extract-all-label;
                    clicked => { root.extract-all(); }
                }

                // Stay clickable when disabled so the tooltip can explain why.
                Rectangle {
                    width: max(Theme.control-xs, extract-sel-lbl.preferred-width + Theme.space-3);
                    height: Theme.control-xs;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-md;
                    background: !model.has-file-selected ? Colors.transparent :
                        extract-sel-ta.pressed ? Theme.state-press :
                        extract-sel-ta.has-hover ? Theme.state-hover : Colors.transparent;
                    opacity: model.has-file-selected ? 1.0 : 0.35;

                    animate background { duration: Theme.motion-fast; easing: ease-out; }

                    extract-sel-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            if model.has-file-selected {
                                root.extract-selected();
                            }
                        }
                    }

                    extract-sel-lbl := Text {
                        width: 100%;
                        height: 100%;
                        text: model.extract-selected-label;
                        color: model.has-file-selected ? Theme.text-primary : Theme.text-disabled;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-medium;
                        font-family: Theme.font-family-sans;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Tooltip {
                        text: model.has-file-selected
                            ? model.extract-selected-label
                            : model.nothing-selected-label;
                        shown: extract-sel-ta.has-hover;
                        x: (parent.width - self.width) / 2;
                        y: -self.height - Theme.space-2;
                    }
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        if model.info-text != "" : Rectangle {
            height: Theme.control-xs - Theme.space-1;
            background: Theme.surface-sunken;
            clip: false;

            info-ta := TouchArea { }

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                Text {
                    text: model.info-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            Tooltip {
                text: model.info-text;
                shown: info-ta.has-hover && model.info-text != "";
                x: Theme.space-2;
                y: -self.height - Theme.space-2;
            }
        }

        if model.info-text != "" : Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            Rectangle {
                width: parent.width * 0.55;
                background: Theme.surface-base;

                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: list-stack.preferred-height;

                    list-stack := VerticalLayout {
                        spacing: 0;

                        for entry[i] in model.entries : Rectangle {
                            height: Theme.control-xs - Theme.space-2;
                            background: entry.path-in-archive == model.selected-path
                                ? Theme.accent-soft
                                : (entry-ta.has-hover ? Theme.state-hover : Colors.transparent);

                            entry-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    if (entry.is-up) {
                                        root.navigate-up();
                                    } else if (entry.is-dir) {
                                        root.navigate-into(entry.path-in-archive);
                                    } else {
                                        root.select(entry.path-in-archive);
                                    }
                                }
                            }

                            Tooltip {
                                text: entry.is-up ? entry.name
                                    : entry.path-in-archive != "" ? entry.path-in-archive
                                    : entry.name;
                                shown: entry-ta.has-hover;
                                x: Theme.space-2;
                                y: -self.height - Theme.space-2;
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-2;
                                spacing: Theme.space-2;

                                Icon {
                                    name: archive-entry-icon(entry.icon);
                                    size: Theme.font-size-sm;
                                    tint: entry.path-in-archive == model.selected-path
                                        ? Theme.accent-brand
                                        : Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: entry.is-up ? ".." : entry.name;
                                    color: entry.path-in-archive == model.selected-path
                                        ? Theme.accent-brand
                                        : Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                if !entry.is-up && !entry.is-dir : Text {
                                    text: entry.size-text;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                }

                                if !entry.is-up : Text {
                                    text: entry.modified-text;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: Theme.hairline;
                background: Theme.border-subtle;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-base;

                if model.preview-kind == 0 : EmptyState {
                    width: 100%;
                    height: 100%;
                    icon: "layers";
                    title: model.preview-text;
                }

                if model.preview-kind == 1 : Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: preview-text-element.preferred-width;
                    viewport-height: preview-text-element.preferred-height;

                    preview-text-element := Text {
                        text: model.preview-text;
                        color: Theme.text-primary;
                        font-family: Theme.font-family-mono;
                        font-size: Theme.font-size-sm;
                        wrap: no-wrap;
                    }
                }

                if model.preview-kind == 2 : EmptyState {
                    width: 100%;
                    height: 100%;
                    icon: "info";
                    title: model.preview-binary-size;
                }
            }
        }
    }
}
