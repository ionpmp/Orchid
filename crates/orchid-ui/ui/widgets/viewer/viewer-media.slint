import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme_global.slint";
import { ViewerMediaModel } from "../../workspace/defs.slint";

export component ViewerMediaView inherits Rectangle {
    in property <ViewerMediaModel> model;
    callback command(string);
    callback seek-frac(float);
    callback open-external();

    background: #000000;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " {
                root.command("play-pause");
                return accept;
            }
            if event.text == Key.Backspace {
                root.command("stop");
                return accept;
            }
            if event.text == Key.Home {
                root.command("first");
                return accept;
            }
            if event.text == Key.End {
                root.command("last");
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.command(event.modifiers.shift ? "seek-back-10" : "seek-back-5");
                return accept;
            }
            if event.text == Key.RightArrow {
                root.command(event.modifiers.shift ? "seek-fwd-10" : "seek-fwd-5");
                return accept;
            }
            if event.text == Key.UpArrow {
                root.command("vol-up");
                return accept;
            }
            if event.text == Key.DownArrow {
                root.command("vol-down");
                return accept;
            }
            if event.text == "f" || event.text == "F" || event.text == Key.F11 {
                root.command("fullscreen");
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                root.command("mute");
                return accept;
            }
            if event.text == "[" {
                if event.modifiers.control {
                    root.command("audio-delay-down");
                } else {
                    root.command("speed-down");
                }
                return accept;
            }
            if event.text == "]" {
                if event.modifiers.control {
                    root.command("audio-delay-up");
                } else {
                    root.command("speed-up");
                }
                return accept;
            }
            if event.text == "s" || event.text == "S" {
                if event.modifiers.control && event.modifiers.shift {
                    root.command("screenshot");
                } else if event.modifiers.control {
                    root.command("sub-add");
                } else {
                    root.command(event.modifiers.shift ? "toggle-sub" : "cycle-sub");
                }
                return accept;
            }
            if event.text == "." {
                root.command("frame-fwd");
                return accept;
            }
            if event.text == "," {
                root.command("frame-back");
                return accept;
            }
            if event.text == "{" {
                root.command("sub-scale-down");
                return accept;
            }
            if event.text == "}" {
                root.command("sub-scale-up");
                return accept;
            }
            if event.modifiers.alt && event.text == Key.UpArrow {
                root.command("sub-pos-up");
                return accept;
            }
            if event.modifiers.alt && event.text == Key.DownArrow {
                root.command("sub-pos-down");
                return accept;
            }
            if event.text == "0" && !event.modifiers.control && !event.modifiers.shift {
                root.command("speed-reset");
                return accept;
            }
            if event.modifiers.control && event.text == "0" {
                root.command("sub-style-reset");
                return accept;
            }
            if (event.text == "a" || event.text == "A") && event.modifiers.shift {
                root.command("ab-a");
                return accept;
            }
            if event.text == "a" || event.text == "A" {
                root.command("cycle-audio");
                return accept;
            }
            if (event.text == "b" || event.text == "B") && event.modifiers.shift {
                root.command("ab-b");
                return accept;
            }
            if event.text == "c" || event.text == "C" {
                root.command(event.modifiers.shift ? "chapter-prev" : "chapter-next");
                return accept;
            }
            if (event.text == "l" || event.text == "L") && event.modifiers.shift {
                root.command("ab-clear");
                return accept;
            }
            if event.text == "l" || event.text == "L" {
                root.command("loop");
                return accept;
            }
            if event.text == "e" || event.text == "E" {
                root.command("cycle-eq");
                return accept;
            }
            if event.text == "h" || event.text == "H" {
                root.command("cycle-hwdec");
                return accept;
            }
            if event.text == "t" || event.text == "T" {
                root.command("cycle-sleep");
                return accept;
            }
            if event.text == "v" || event.text == "V" {
                root.command("cycle-aspect");
                return accept;
            }
            if (event.text == "r" || event.text == "R") && event.modifiers.control {
                root.command("cycle-rotate");
                return accept;
            }
            if event.text == "y" || event.text == "Y" {
                root.command("shuffle");
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                root.command("random");
                return accept;
            }
            if event.text == "n" || event.text == "N" || event.text == Key.PageDown {
                root.command("next");
                return accept;
            }
            if event.text == "p" || event.text == "P" || event.text == Key.PageUp {
                root.command("prev");
                return accept;
            }
            if event.text == "q" || event.text == "Q" {
                root.command("playlist-toggle");
                return accept;
            }
            if event.text == "o" || event.text == "O" {
                root.open-external();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            // Video / audio surface
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

            if model.has-video : Image {
                width: parent.width;
                height: parent.height;
                source: model.frame;
                image-fit: contain;
            }

            if !model.has-video : VerticalLayout {
                alignment: center;
                padding: 24px;
                spacing: 10px;
                if model.has-cover : Image {
                    width: min(220px, parent.width - 48px);
                    height: min(220px, parent.width - 48px);
                    source: model.cover;
                    image-fit: contain;
                }
                Text {
                    text: model.title-label != "" ? model.title-label : model.path-display;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-md;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if model.artist-label != "" : Text {
                    text: model.artist-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: model.kind-label;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
                if model.available : Text {
                    text: model.playing ? model.pause-label : model.play-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
                if model.audio-label != "" : Text {
                    text: model.audio-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
                if model.unavailable-label != "" : Text {
                    text: model.unavailable-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if model.error-text != "" : Text {
                    text: model.error-text;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Click / wheel / double-click on the media surface
            TouchArea {
                clicked => {
                    if model.available {
                        root.command("play-pause");
                    } else {
                        root.open-external();
                    }
                }
                double-clicked => {
                    root.command("fullscreen");
                }
                scroll-event(event) => {
                    if event.delta-y > 0 {
                        root.command("seek-fwd-5");
                    }
                    if event.delta-y < 0 {
                        root.command("seek-back-5");
                    }
                    return accept;
                }
            }

            if model.osd-text != "" : Rectangle {
                x: parent.width / 2 - self.width / 2;
                y: 16px;
                width: max(80px, osd-lab.preferred-width + 24px);
                height: max(28px, osd-lab.preferred-height + 12px);
                border-radius: Theme.radius-md;
                background: #000000aa;
                osd-lab := Text {
                    text: model.osd-text;
                    color: #ffffff;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

            if model.playlist-panel-open && model.playlist-items.length > 0 : HorizontalLayout {
                spacing: 0;
                Rectangle {
                    width: 1px;
                    background: Theme.border-default;
                }
                Rectangle {
                    width: 200px;
                    background: Theme.surface-base;

                    ListView {
                        width: parent.width;
                        height: parent.height;
                        for item in model.playlist-items : Rectangle {
                            height: 28px;
                            background: item.selected ? Theme.surface-raised
                                : row-ta.has-hover ? Theme.surface-raised : transparent;
                            row-ta := TouchArea {
                                clicked => {
                                    root.command("goto:" + (item.index + 1));
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text {
                                    text: (item.index + 1);
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    width: 28px;
                                }
                                Text {
                                    text: item.name;
                                    color: item.selected ? Theme.accent-brand : Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Transport chrome
        Rectangle {
            height: 72px;
            background: Theme.surface-base;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 6px;

                // Scrubber
                Rectangle {
                    height: 14px;
                    background: transparent;
                    scrub := TouchArea {
                        moved => {
                            if self.pressed && self.width > 0 {
                                root.seek-frac((self.mouse-x / self.width));
                            }
                        }
                        clicked => {
                            if self.width > 0 {
                                root.seek-frac((self.mouse-x / self.width));
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height / 2 - 2px;
                        height: 4px;
                        width: parent.width;
                        background: Theme.border-default;
                        border-radius: 2px;
                    }
                    Rectangle {
                        y: parent.height / 2 - 2px;
                        height: 4px;
                        width: parent.width * model.progress;
                        background: Theme.accent-brand;
                        border-radius: 2px;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    Text {
                        text: model.position-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    // Transport buttons
                    HorizontalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        alignment: center;

                        btn-prev := Rectangle {
                            width: max(28px, prev-lab.preferred-width + 8px);
                            height: 28px;
                            border-radius: Theme.radius-md;
                            background: prev-ta.has-hover ? Theme.surface-raised : transparent;
                            prev-ta := TouchArea { clicked => { root.command("prev"); } }
                            prev-lab := Text {
                                text: model.prev-label;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        btn-back := Rectangle {
                            width: max(28px, back-lab.preferred-width + 8px);
                            height: 28px;
                            border-radius: Theme.radius-md;
                            background: back-ta.has-hover ? Theme.surface-raised : transparent;
                            back-ta := TouchArea { clicked => { root.command("seek-back-5"); } }
                            back-lab := Text {
                                text: model.seek-back-label;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        btn-play := Rectangle {
                            width: max(36px, play-lab.preferred-width + 12px);
                            height: 28px;
                            border-radius: Theme.radius-md;
                            background: play-ta.has-hover ? Theme.surface-raised : Theme.surface-raised;
                            border-width: 1px;
                            border-color: Theme.border-default;
                            play-ta := TouchArea {
                                clicked => {
                                    if model.available {
                                        root.command("play-pause");
                                    } else {
                                        root.open-external();
                                    }
                                }
                            }
                            play-lab := Text {
                                text: model.available ? (model.playing ? model.pause-label : model.play-label) : model.play-label;
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        btn-fwd := Rectangle {
                            width: max(28px, fwd-lab.preferred-width + 8px);
                            height: 28px;
                            border-radius: Theme.radius-md;
                            background: fwd-ta.has-hover ? Theme.surface-raised : transparent;
                            fwd-ta := TouchArea { clicked => { root.command("seek-fwd-5"); } }
                            fwd-lab := Text {
                                text: model.seek-fwd-label;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        btn-next := Rectangle {
                            width: max(28px, next-lab.preferred-width + 8px);
                            height: 28px;
                            border-radius: Theme.radius-md;
                            background: next-ta.has-hover ? Theme.surface-raised : transparent;
                            next-ta := TouchArea { clicked => { root.command("next"); } }
                            next-lab := Text {
                                text: model.next-label;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: model.duration-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    vol-chip := Rectangle {
                        width: max(40px, vol-lab.preferred-width + 8px);
                        height: 24px;
                        background: transparent;
                        vol-ta := TouchArea {
                            clicked => { root.command("mute"); }
                            scroll-event(event) => {
                                if event.delta-y > 0 {
                                    root.command("vol-up");
                                }
                                if event.delta-y < 0 {
                                    root.command("vol-down");
                                }
                                return accept;
                            }
                        }
                        vol-lab := Text {
                            text: model.volume-label;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: model.speed-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.playlist-label != "" : Text {
                        text: model.playlist-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        TouchArea {
                            clicked => { root.command("playlist-toggle"); }
                        }
                    }
                    if model.sub-label != "" : Text {
                        text: model.sub-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.audio-label != "" : Text {
                        text: model.audio-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.chapter-label != "" : Text {
                        text: model.chapter-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.ab-label != "" : Text {
                        text: model.ab-label;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.eq-label != "" : Text {
                        text: model.eq-label;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.hwdec-label != "" : Text {
                        text: model.hwdec-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.sleep-label != "" : Text {
                        text: model.sleep-label;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.aspect-label != "" : Text {
                        text: model.aspect-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.rotate-label != "" : Text {
                        text: model.rotate-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                    if model.audio-delay-label != "" : Text {
                        text: model.audio-delay-label;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: max(64px, ext-label.preferred-width + 16px);
                        height: 24px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        background: ext-ta.has-hover ? Theme.surface-raised : transparent;
                        ext-ta := TouchArea { clicked => { root.open-external(); } }
                        ext-label := Text {
                            text: model.open-external-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
