import { ListView } from "std-widgets.slint";
import { Theme } from "../../theme_global.slint";
import { ControlSize, IconButton, Tooltip } from "../../kit.slint";
import { Icon } from "../../kit-icons.slint";
import { ViewerMediaModel } from "../../workspace/defs.slint";
import { DocToolBtn } from "viewer-doc-toolbtn.slint";

export component ViewerMediaView inherits Rectangle {
    in property <ViewerMediaModel> model;
    callback command(string);
    callback seek-frac(float);
    callback open-external();

    background: #000000;

    // Transport auto-hides during video; audio-only keeps chrome visible.
    property <bool> chrome-peek: true;
    property <bool> chrome-hover: false;
    property <bool> chapters-open: false;
    property <int> activity-gen: 0;
    property <int> hide-seen: 0;
    property <bool> chrome-on: !model.has-video || root.chrome-peek || root.chrome-hover || root.chapters-open;

    function bump-chrome() {
        root.chrome-peek = true;
        root.activity-gen = root.activity-gen + 1;
    }

    hide-chrome-timer := Timer {
        interval: 2500ms;
        running: model.has-video && model.available && root.chrome-peek && !root.chrome-hover;
        triggered => {
            if (root.activity-gen == root.hide-seen) {
                root.chrome-peek = false;
            } else {
                root.hide-seen = root.activity-gen;
            }
        }
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            root.bump-chrome();
            if event.text == " " {
                root.command("play-pause");
                return accept;
            }
            if event.text == Key.Backspace {
                root.command("stop");
                return accept;
            }
            if event.text == Key.Home {
                root.command("first");
                return accept;
            }
            if event.text == Key.End {
                root.command("last");
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.command(event.modifiers.shift ? "seek-back-10" : "seek-back-5");
                return accept;
            }
            if event.text == Key.RightArrow {
                root.command(event.modifiers.shift ? "seek-fwd-10" : "seek-fwd-5");
                return accept;
            }
            if event.text == Key.UpArrow {
                root.command("vol-up");
                return accept;
            }
            if event.text == Key.DownArrow {
                root.command("vol-down");
                return accept;
            }
            if event.text == "f" || event.text == "F" || event.text == Key.F11 {
                root.command(event.modifiers.shift ? "kiosk" : "fullscreen");
                return accept;
            }
            if event.text == Key.Escape {
                root.command("exit-immersive");
                return accept;
            }
            if (event.text == "m" || event.text == "M") && event.modifiers.shift {
                root.command("next-monitor");
                return accept;
            }
            if event.text == "m" || event.text == "M" {
                root.command("mute");
                return accept;
            }
            if event.text == "[" {
                if event.modifiers.control {
                    root.command("audio-delay-down");
                } else {
                    root.command("speed-down");
                }
                return accept;
            }
            if event.text == "]" {
                if event.modifiers.control {
                    root.command("audio-delay-up");
                } else {
                    root.command("speed-up");
                }
                return accept;
            }
            if event.text == "s" || event.text == "S" {
                if event.modifiers.control && event.modifiers.shift {
                    root.command("screenshot");
                } else if event.modifiers.control {
                    root.command("sub-add");
                } else if event.modifiers.shift {
                    root.command("toggle-sub");
                } else {
                    root.command("cycle-sub");
                }
                return accept;
            }
            if event.text == "g" || event.text == "G" {
                root.command("cycle-sub-style");
                return accept;
            }
            if event.text == "u" || event.text == "U" {
                root.command("cycle-replaygain");
                return accept;
            }
            if event.text == "." {
                root.command("frame-fwd");
                return accept;
            }
            if event.text == "," {
                root.command("frame-back");
                return accept;
            }
            if event.text == "{" {
                root.command("sub-scale-down");
                return accept;
            }
            if event.text == "}" {
                root.command("sub-scale-up");
                return accept;
            }
            if event.modifiers.alt && event.text == Key.UpArrow {
                root.command("sub-pos-up");
                return accept;
            }
            if event.modifiers.alt && event.text == Key.DownArrow {
                root.command("sub-pos-down");
                return accept;
            }
            if event.text == "0" && !event.modifiers.control && !event.modifiers.shift {
                root.command("speed-reset");
                return accept;
            }
            if event.text == "k" || event.text == "K" {
                root.command("pitch-toggle");
                return accept;
            }
            if event.modifiers.control && event.text == "0" {
                root.command("sub-style-reset");
                return accept;
            }
            if (event.text == "a" || event.text == "A") && event.modifiers.shift {
                root.command("ab-a");
                return accept;
            }
            if event.text == "a" || event.text == "A" {
                root.command("cycle-audio");
                return accept;
            }
            if (event.text == "b" || event.text == "B") && event.modifiers.shift {
                root.command("ab-b");
                return accept;
            }
            if event.text == "c" || event.text == "C" {
                root.command(event.modifiers.shift ? "chapter-prev" : "chapter-next");
                return accept;
            }
            if (event.text == "l" || event.text == "L") && event.modifiers.shift {
                root.command("ab-clear");
                return accept;
            }
            if event.text == "l" || event.text == "L" {
                root.command("loop");
                return accept;
            }
            if event.text == "e" || event.text == "E" {
                root.command("cycle-eq");
                return accept;
            }
            if event.text == "h" || event.text == "H" {
                root.command("cycle-hwdec");
                return accept;
            }
            if event.text == "t" || event.text == "T" {
                root.command("cycle-sleep");
                return accept;
            }
            if event.text == "v" || event.text == "V" {
                root.command("cycle-aspect");
                return accept;
            }
            if (event.text == "r" || event.text == "R") && event.modifiers.control {
                root.command("cycle-rotate");
                return accept;
            }
            if event.text == "y" || event.text == "Y" {
                root.command("shuffle");
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                root.command("random");
                return accept;
            }
            if event.text == "n" || event.text == "N" || event.text == Key.PageDown {
                root.command("next");
                return accept;
            }
            if event.text == "p" || event.text == "P" || event.text == Key.PageUp {
                root.command("prev");
                return accept;
            }
            if event.text == "q" || event.text == "Q" {
                root.command("playlist-toggle");
                return accept;
            }
            if event.text == "o" || event.text == "O" {
                root.open-external();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            // Video / audio surface
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

            if model.has-video : Image {
                width: parent.width;
                height: parent.height;
                source: model.frame;
                image-fit: contain;
            }

            if !model.has-video : VerticalLayout {
                alignment: center;
                padding: Theme.space-4;
                spacing: Theme.space-2;
                if model.has-cover : Image {
                    width: min(220px, parent.width - Theme.space-8);
                    height: min(220px, parent.width - Theme.space-8);
                    source: model.cover;
                    image-fit: contain;
                }
                Text {
                    text: model.title-label != "" ? model.title-label : model.path-display;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-md;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if model.artist-label != "" : Text {
                    text: model.artist-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: model.kind-label;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
                if model.available : Text {
                    text: model.playing ? model.pause-label : model.play-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
                if model.audio-label != "" : Text {
                    text: model.audio-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                }
                if model.unavailable-label != "" : Text {
                    text: model.unavailable-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if model.error-text != "" : Text {
                    text: model.error-text;
                    color: Theme.accent-brand;
                    font-size: Theme.font-size-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Click / wheel / double-click on the media surface
            TouchArea {
                moved => { root.bump-chrome(); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.bump-chrome();
                    }
                }
                clicked => {
                    root.bump-chrome();
                    if model.available {
                        root.command("play-pause");
                    } else {
                        root.open-external();
                    }
                }
                double-clicked => {
                    root.bump-chrome();
                    root.command("fullscreen");
                }
                scroll-event(event) => {
                    root.bump-chrome();
                    if event.delta-y > 0 {
                        root.command("seek-fwd-5");
                    }
                    if event.delta-y < 0 {
                        root.command("seek-back-5");
                    }
                    return accept;
                }
            }

            if model.osd-text != "" : Rectangle {
                x: parent.width / 2 - self.width / 2;
                y: Theme.space-3;
                width: max(80px, osd-lab.preferred-width + Theme.space-4);
                height: max(Theme.control-xs, osd-lab.preferred-height + Theme.space-3);
                border-radius: Theme.radius-md;
                background: Theme.scrim;
                osd-lab := Text {
                    text: model.osd-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

            if model.playlist-panel-open && model.playlist-items.length > 0 : HorizontalLayout {
                spacing: 0;
                Rectangle {
                    width: Theme.hairline;
                    background: Theme.border-subtle;
                }
                Rectangle {
                    width: 200px;
                    background: Theme.surface-sunken;

                    ListView {
                        width: parent.width;
                        height: parent.height;
                        for item in model.playlist-items : Rectangle {
                            height: Theme.control-xs - Theme.space-2;
                            background: item.selected ? Theme.accent-soft
                                : row-ta.has-hover ? Theme.state-hover : Colors.transparent;
                            row-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.command("goto:" + (item.index + 1));
                                }
                            }
                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-2;
                                spacing: Theme.space-2;
                                Text {
                                    text: (item.index + 1);
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    width: 28px;
                                }
                                Text {
                                    text: item.name;
                                    color: item.selected ? Theme.accent-brand : Theme.text-primary;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Transport chrome (collapses when auto-hidden so the video can expand)
        if root.chrome-on : Rectangle {
            height: root.chapters-open && model.chapter-items.length > 0
                ? Theme.control-xs * 5 + Theme.space-4
                : Theme.control-xs * 2 + Theme.space-4;
            background: Theme.surface-sunken;
            chrome-ta := TouchArea {
                changed has-hover => {
                    root.chrome-hover = self.has-hover;
                    if self.has-hover {
                        root.bump-chrome();
                    }
                }
            }

            VerticalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                padding-top: Theme.space-1;
                padding-bottom: Theme.space-1;
                spacing: Theme.space-1;

                if root.chapters-open && model.chapter-items.length > 0 : ListView {
                    height: Theme.control-xs * 3 + Theme.space-2;
                    for item in model.chapter-items : Rectangle {
                        height: Theme.control-xs - Theme.space-2;
                        background: item.selected ? Theme.accent-soft
                            : ch-ta.has-hover ? Theme.state-hover : Colors.transparent;
                        ch-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.command("chapter:" + item.index);
                                root.chapters-open = false;
                                root.bump-chrome();
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-2;
                            spacing: Theme.space-2;
                            Text {
                                text: (item.index + 1);
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                width: 28px;
                            }
                            Text {
                                text: item.name;
                                color: item.selected ? Theme.accent-brand : Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                // Scrubber — finger-sized hit area, rail thickens on hover
                scrub := TouchArea {
                    height: Theme.control-xs - Theme.space-2;
                    mouse-cursor: MouseCursor.pointer;
                    moved => {
                        root.bump-chrome();
                        if self.pressed && self.width > 0 {
                            root.seek-frac((self.mouse-x / self.width));
                        }
                    }
                    clicked => {
                        root.bump-chrome();
                        if self.width > 0 {
                            root.seek-frac((self.mouse-x / self.width));
                        }
                    }
                    Rectangle {
                        height: scrub.has-hover || scrub.pressed ? Theme.track-height-lg : Theme.track-height;
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        background: Theme.surface-base;
                        border-radius: self.height / 2;
                        border-width: Theme.hairline;
                        border-color: Theme.border-subtle;
                        animate height { duration: Theme.motion-fast; easing: ease-out; }

                        Rectangle {
                            height: 100%;
                            width: parent.width * model.progress;
                            background: Theme.gradient-accent;
                            border-radius: self.height / 2;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-1;
                    alignment: stretch;

                    Text {
                        text: model.position-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        font-family: Theme.font-family-mono;
                        vertical-alignment: center;
                    }

                    // Transport buttons
                    HorizontalLayout {
                        spacing: Theme.space-1;
                        horizontal-stretch: 1;
                        alignment: center;

                        IconButton {
                            icon: "skip-prev";
                            size: ControlSize.xs;
                            y: (parent.height - self.height) / 2;
                            tooltip: model.prev-label;
                            clicked => { root.command("prev"); }
                        }
                        IconButton {
                            icon: "arrow-left";
                            size: ControlSize.xs;
                            y: (parent.height - self.height) / 2;
                            tooltip: model.seek-back-label;
                            clicked => { root.command("seek-back-5"); }
                        }

                        // Hero play control
                        Rectangle {
                            width: Theme.control-sm;
                            height: Theme.control-sm;
                            y: (parent.height - self.height) / 2;
                            border-radius: self.width / 2;
                            background: Theme.gradient-accent;
                            drop-shadow-blur: play-ta.has-hover ? Theme.elev-glow-blur : Theme.elev-1-blur;
                            drop-shadow-color: Theme.accent-glow;
                            animate drop-shadow-blur { duration: Theme.motion-fast; easing: ease-out; }

                            play-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    if model.available {
                                        root.command("play-pause");
                                    } else {
                                        root.open-external();
                                    }
                                }
                            }
                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: model.available && model.playing ? "pause" : "play";
                                size: Theme.font-size-lg;
                                tint: Theme.accent-contrast;
                            }
                            Tooltip {
                                text: model.available
                                    ? (model.playing ? model.pause-label : model.play-label)
                                    : model.play-label;
                                shown: play-ta.has-hover;
                                x: (parent.width - self.width) / 2;
                                y: -self.height - Theme.space-2;
                            }
                        }

                        IconButton {
                            icon: "arrow-right";
                            size: ControlSize.xs;
                            y: (parent.height - self.height) / 2;
                            tooltip: model.seek-fwd-label;
                            clicked => { root.command("seek-fwd-5"); }
                        }
                        IconButton {
                            icon: "skip-next";
                            size: ControlSize.xs;
                            y: (parent.height - self.height) / 2;
                            tooltip: model.next-label;
                            clicked => { root.command("next"); }
                        }
                    }

                    Text {
                        text: model.duration-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        font-family: Theme.font-family-mono;
                        vertical-alignment: center;
                    }

                    vol-chip := Rectangle {
                        width: 72px;
                        height: Theme.control-xs;
                        y: (parent.height - self.height) / 2;
                        background: Colors.transparent;
                        VerticalLayout {
                            spacing: Theme.space-1;
                            alignment: center;
                            vol-lab := Text {
                                text: model.volume-label;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                height: Theme.track-height;
                                width: parent.width;
                                background: Theme.surface-base;
                                border-radius: self.height / 2;
                                border-width: Theme.hairline;
                                border-color: Theme.border-subtle;
                                Rectangle {
                                    height: parent.height;
                                    width: parent.width * model.volume-frac;
                                    background: Theme.gradient-accent;
                                    border-radius: self.height / 2;
                                }
                            }
                        }
                        vol-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                if self.width > 0 {
                                    root.command("volume:" + (self.mouse-x / self.width * 150));
                                }
                            }
                            moved => {
                                if self.pressed && self.width > 0 {
                                    root.command("volume:" + (self.mouse-x / self.width * 150));
                                }
                            }
                            double-clicked => { root.command("mute"); }
                            scroll-event(event) => {
                                if event.delta-y > 0 {
                                    root.command("vol-up");
                                }
                                if event.delta-y < 0 {
                                    root.command("vol-down");
                                }
                                return accept;
                            }
                        }
                    }

                    DocToolBtn {
                        label: model.speed-label;
                        tip: model.speed-label;
                        clicked => { root.command("pitch-toggle"); }
                    }
                    if model.playlist-label != "" : DocToolBtn {
                        label: model.playlist-label;
                        tip: model.playlist-label;
                        active: model.playlist-panel-open;
                        clicked => { root.command("playlist-toggle"); }
                    }
                    if model.sub-label != "" : DocToolBtn {
                        label: model.sub-label;
                        tip: model.sub-label;
                        clicked => { root.command("cycle-sub-style"); }
                    }
                    if model.sub-style-label != "" : DocToolBtn {
                        label: model.sub-style-label;
                        tip: model.sub-style-label;
                        active: true;
                        clicked => { root.command("cycle-sub-style"); }
                    }
                    if model.audio-label != "" : DocToolBtn {
                        label: model.audio-label;
                        tip: model.audio-label;
                        clicked => { root.command("cycle-audio"); }
                    }
                    if model.chapter-label != "" : DocToolBtn {
                        label: model.chapter-label;
                        tip: model.chapter-label;
                        active: root.chapters-open;
                        clicked => {
                            root.chapters-open = !root.chapters-open;
                            root.bump-chrome();
                        }
                    }
                    if model.ab-label != "" : DocToolBtn {
                        label: model.ab-label;
                        tip: model.ab-label;
                        active: true;
                    }
                    if model.eq-label != "" : DocToolBtn {
                        label: model.eq-label;
                        tip: model.eq-label;
                        active: true;
                        clicked => { root.command("cycle-eq"); }
                    }
                    if model.replaygain-label != "" : DocToolBtn {
                        label: model.replaygain-label;
                        tip: model.replaygain-label;
                        active: true;
                        clicked => { root.command("cycle-replaygain"); }
                    }
                    if model.hwdec-label != "" : DocToolBtn {
                        label: model.hwdec-label;
                        tip: model.hwdec-label;
                    }
                    if model.sleep-label != "" : DocToolBtn {
                        label: model.sleep-label;
                        tip: model.sleep-label;
                        active: true;
                    }
                    if model.aspect-label != "" : DocToolBtn {
                        label: model.aspect-label;
                        tip: model.aspect-label;
                    }
                    if model.rotate-label != "" : DocToolBtn {
                        label: model.rotate-label;
                        tip: model.rotate-label;
                    }
                    if model.audio-delay-label != "" : DocToolBtn {
                        label: model.audio-delay-label;
                        tip: model.audio-delay-label;
                    }

                    DocToolBtn {
                        label: model.open-external-label;
                        tip: model.open-external-label;
                        clicked => { root.open-external(); }
                    }
                }
            }
        }
    }
}
