import { Theme } from "../../theme_global.slint";
import { ControlSize, EmptyState, IconButton } from "../../kit.slint";
import { ViewerHtmlModel } from "../../workspace/defs.slint";
import { DocToolBtn } from "viewer-doc-toolbtn.slint";

export component ViewerHtmlView inherits Rectangle {
    in property <ViewerHtmlModel> model;
    callback open-browser();
    callback html-command(string);
    callback embed-bounds(length, length, length, length, bool);

    background: transparent;
    property <bool> show-source: !model.webview-available;

    function fire-embed() {
        if (model.webview-available && !root.show-source && host.width > 8px && host.height > 8px) {
            root.embed-bounds(host.absolute-position.x, host.absolute-position.y, host.width, host.height, true);
        } else {
            root.embed-bounds(0, 0, 0, 0, false);
        }
    }

    changed show-source => { root.fire-embed(); }
    changed model => { root.fire-embed(); }

    VerticalLayout {
        spacing: 0;

        // Main chrome
        Rectangle {
            height: Theme.control-xs + Theme.space-2;
            background: Theme.surface-sunken;
            clip: false;
            z: 20;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;
                alignment: start;

                if model.webview-available : IconButton {
                    icon: "chevron-left";
                    size: ControlSize.xs;
                    y: (parent.height - self.height) / 2;
                    opacity: model.can-go-back ? 1.0 : 0.4;
                    tooltip: model.back-label;
                    clicked => {
                        if (model.can-go-back) {
                            root.html-command("back");
                        }
                    }
                }

                if model.webview-available : IconButton {
                    icon: "chevron-right";
                    size: ControlSize.xs;
                    y: (parent.height - self.height) / 2;
                    opacity: model.can-go-forward ? 1.0 : 0.4;
                    tooltip: model.forward-label;
                    clicked => {
                        if (model.can-go-forward) {
                            root.html-command("forward");
                        }
                    }
                }

                if model.webview-available : IconButton {
                    icon: "refresh";
                    size: ControlSize.xs;
                    y: (parent.height - self.height) / 2;
                    tooltip: model.reload-label;
                    clicked => { root.html-command("reload"); }
                }

                if model.webview-available : DocToolBtn {
                    label: model.source-label;
                    tip: model.source-label;
                    active: root.show-source;
                    clicked => { root.show-source = !root.show-source; }
                }

                Rectangle { horizontal-stretch: 1; }

                DocToolBtn {
                    label: model.open-label;
                    tip: model.open-label;
                    clicked => { root.open-browser(); }
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        Rectangle {
            height: Theme.control-xs - Theme.space-1;
            background: Theme.surface-sunken;
            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                Text {
                    text: model.webview-available ? model.hint-label : model.unavailable-label;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

        embed-slot := Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-base;
            clip: true;

            host := Rectangle {
                width: parent.width;
                height: parent.height;
                visible: model.webview-available && !root.show-source;
                changed width => { root.fire-embed(); }
                changed height => { root.fire-embed(); }
                changed absolute-position => { root.fire-embed(); }
                changed visible => { root.fire-embed(); }
                property <length> ax: self.absolute-position.x;
                property <length> ay: self.absolute-position.y;
                changed ax => { root.fire-embed(); }
                changed ay => { root.fire-embed(); }
            }

            Flickable {
                width: parent.width;
                height: parent.height;
                visible: root.show-source || !model.webview-available;
                viewport-width: self.width;
                viewport-height: max(self.height, src.preferred-height + Theme.space-2);

                if model.source-preview == "" : EmptyState {
                    width: parent.width;
                    height: parent.height;
                    icon: model.webview-available ? "layers" : "warning";
                    title: model.webview-available ? model.source-label : model.unavailable-label;
                    hint: model.hint-label;
                }

                src := Text {
                    x: Theme.space-2;
                    width: parent.width - Theme.space-4;
                    visible: model.source-preview != "";
                    text: model.source-preview;
                    wrap: no-wrap;
                    color: Theme.text-primary;
                    font-family: Theme.font-family-mono;
                    font-size: Theme.font-size-sm;
                }
            }
        }
    }
}
