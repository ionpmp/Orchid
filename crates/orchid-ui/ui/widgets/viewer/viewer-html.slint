import { Theme } from "../../theme_global.slint";
import { ViewerHtmlModel } from "../../workspace/defs.slint";

export component ViewerHtmlView inherits Rectangle {
    in property <ViewerHtmlModel> model;
    callback open-browser();
    callback html-command(string);
    callback embed-bounds(length, length, length, length, bool);

    background: transparent;
    property <bool> show-source: !model.webview-available;

    function fire-embed() {
        if (model.webview-available && !root.show-source && host.width > 8px && host.height > 8px) {
            root.embed-bounds(host.absolute-position.x, host.absolute-position.y, host.width, host.height, true);
        } else {
            root.embed-bounds(0, 0, 0, 0, false);
        }
    }

    changed show-source => { root.fire-embed(); }
    changed model => { root.fire-embed(); }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 36px;
            background: Theme.surface-base;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: start;

                if model.webview-available : Rectangle {
                    width: max(56px, back-lbl.preferred-width + 12px);
                    height: 28px;
                    background: back-ta.has-hover && model.can-go-back ? Theme.surface-raised : transparent;
                    opacity: model.can-go-back ? 1.0 : 0.45;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    back-ta := TouchArea {
                        clicked => { if (model.can-go-back) { root.html-command("back"); } }
                    }
                    back-lbl := Text {
                        text: model.back-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if model.webview-available : Rectangle {
                    width: max(68px, fwd-lbl.preferred-width + 12px);
                    height: 28px;
                    background: fwd-ta.has-hover && model.can-go-forward ? Theme.surface-raised : transparent;
                    opacity: model.can-go-forward ? 1.0 : 0.45;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fwd-ta := TouchArea {
                        clicked => { if (model.can-go-forward) { root.html-command("forward"); } }
                    }
                    fwd-lbl := Text {
                        text: model.forward-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if model.webview-available : Rectangle {
                    width: max(64px, reload-lbl.preferred-width + 12px);
                    height: 28px;
                    background: reload-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    reload-ta := TouchArea { clicked => { root.html-command("reload"); } }
                    reload-lbl := Text {
                        text: model.reload-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if model.webview-available : Rectangle {
                    width: max(64px, src-lbl.preferred-width + 12px);
                    height: 28px;
                    background: src-ta.has-hover || root.show-source ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    src-ta := TouchArea { clicked => { root.show-source = !root.show-source; } }
                    src-lbl := Text {
                        text: model.source-label;
                        color: root.show-source ? Theme.accent-brand : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: max(96px, open-label.preferred-width + 16px);
                    height: 28px;
                    background: open-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    open-ta := TouchArea { clicked => { root.open-browser(); } }
                    open-label := Text {
                        text: model.open-label;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            height: 20px;
            text: model.webview-available ? model.hint-label : model.unavailable-label;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }

        embed-slot := Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-base;
            clip: true;

            host := Rectangle {
                width: parent.width;
                height: parent.height;
                visible: model.webview-available && !root.show-source;
                changed width => { root.fire-embed(); }
                changed height => { root.fire-embed(); }
                changed absolute-position => { root.fire-embed(); }
                changed visible => { root.fire-embed(); }
                property <length> ax: self.absolute-position.x;
                property <length> ay: self.absolute-position.y;
                changed ax => { root.fire-embed(); }
                changed ay => { root.fire-embed(); }
            }

            Flickable {
                width: parent.width;
                height: parent.height;
                visible: root.show-source || !model.webview-available;
                viewport-width: self.width;
                viewport-height: max(self.height, src.preferred-height + 8px);
                src := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: model.source-preview;
                    wrap: no-wrap;
                    color: Theme.text-primary;
                    font-family: Theme.font-family-mono;
                    font-size: Theme.font-size-sm;
                }
            }
        }
    }
}
