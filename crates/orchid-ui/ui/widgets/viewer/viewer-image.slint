import { Theme } from "../../theme_global.slint";
import { Strings } from "../../strings_global.slint";
import { ViewerImageModel } from "../../workspace/defs.slint";

export component ViewerImageView inherits Rectangle {
    in property <ViewerImageModel> model;

    callback zoom-in();
    callback zoom-out();
    callback fit();
    callback actual-size();
    callback rotate-cw();
    callback rotate-ccw();
    callback flip-h();
    callback flip-v();
    callback pan(length, length);
    callback command(string);

    background: transparent;

    property <length> last-mx: 0px;
    property <length> last-my: 0px;
    property <length> swipe-x: 0px;
    property <length> swipe-y: 0px;
    property <length> pan-step: 40px;
    property <bool> show-recent: false;
    property <color> canvas-bg: model.bg-kind == 1 ? #000000
        : model.bg-kind == 2 ? #ffffff
        : model.bg-kind == 3 ? #808080
        : model.bg-kind == 4 ? #707070
        : model.bg-kind == 5 ? rgb(model.bg-r, model.bg-g, model.bg-b)
        : Theme.surface-base;

    img-keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }

        key-pressed(event) => {
            if (event.text == "+" || event.text == "=") {
                root.zoom-in();
                return accept;
            }
            if (event.text == "-" || event.text == "−") {
                root.zoom-out();
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                root.fit();
                return accept;
            }
            if (event.text == "1") {
                root.actual-size();
                return accept;
            }
            if (event.text == "w" || event.text == "W") {
                root.command("fit-width");
                return accept;
            }
            if (event.text == "e" || event.text == "E") {
                root.command("fit-height");
                return accept;
            }
            if (event.text == "0") {
                root.command("fit-shrink");
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                root.command("bg-next");
                return accept;
            }
            if (event.text == Key.F11) {
                root.command("fullscreen");
                return accept;
            }
            if (event.text == "k" || event.text == "K") {
                root.command("kiosk");
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.command("next-monitor");
                return accept;
            }
            if (event.text == Key.Escape && (model.chrome-hidden || model.kiosk)) {
                root.command("exit-immersive");
                return accept;
            }
            if (event.text == "r" || event.text == "R") {
                if (event.modifiers.shift) {
                    root.rotate-ccw();
                } else {
                    root.rotate-cw();
                }
                return accept;
            }
            if (event.text == "v" || event.text == "V") {
                root.flip-v();
                return accept;
            }
            if (event.text == Key.PageDown || event.text == Key.Space) {
                root.command("next");
                return accept;
            }
            if (event.text == Key.PageUp || event.text == Key.Backspace) {
                root.command("prev");
                return accept;
            }
            if (event.text == Key.Home) {
                root.command("first");
                return accept;
            }
            if (event.text == Key.End) {
                root.command("last");
                return accept;
            }
            if (event.text == "*" ) {
                root.command("random");
                return accept;
            }
            if (event.text == "l" || event.text == "L") {
                root.command("loop");
                return accept;
            }
            if (event.text == "o" || event.text == "O") {
                root.command("reveal-folder");
                return accept;
            }
            if (event.text == "h" || event.text == "H") {
                // H is flip when not Shift? Keep H as flip; use Shift+H for recent.
                if (event.modifiers.shift) {
                    root.show-recent = !root.show-recent;
                    return accept;
                }
                root.flip-h();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                if (model.fit-mode == 0) {
                    root.pan(root.pan-step, 0px);
                } else {
                    root.command("prev");
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (model.fit-mode == 0) {
                    root.pan(-root.pan-step, 0px);
                } else {
                    root.command("next");
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.pan(0px, root.pan-step);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.pan(0px, -root.pan-step);
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        spacing: 0;

        if !model.chrome-hidden : Rectangle {
            height: 36px;
            background: Theme.surface-base;
            border-radius: Theme.radius-md;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: start;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: zoom-out-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    zoom-out-ta := TouchArea {
                        clicked => {
                            root.zoom-out();
                            img-keys.focus();
                        }
                    }
                    if zoom-out-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: zoom-out-hint.preferred-width + 12px;
                        height: zoom-out-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        zoom-out-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-zoom-out;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text { text: "−"; color: Theme.text-primary; font-size: Theme.font-size-lg; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 56px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    Text {
                        text: floor(model.zoom * 100) + "%";
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: zoom-in-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    zoom-in-ta := TouchArea {
                        clicked => {
                            root.zoom-in();
                            img-keys.focus();
                        }
                    }
                    if zoom-in-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: zoom-in-hint.preferred-width + 12px;
                        height: zoom-in-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        zoom-in-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-zoom-in;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text { text: "+"; color: Theme.text-primary; font-size: Theme.font-size-lg; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle { width: 8px; }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: prev-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    prev-ta := TouchArea {
                        clicked => { root.command("prev"); img-keys.focus(); }
                    }
                    if prev-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: prev-hint.preferred-width + 12px;
                        height: prev-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        prev-hint := Text { x: 6px; y: 3px; text: model.prev-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text { text: "⟨"; color: Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    min-width: 48px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    goto-in := TextInput {
                        text: "" + model.folder-index;
                        input-type: number;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accepted => {
                            root.command("goto:" + self.text);
                            img-keys.focus();
                        }
                    }
                }

                Text {
                    text: "/ " + model.folder-count;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: next-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    next-ta := TouchArea {
                        clicked => { root.command("next"); img-keys.focus(); }
                    }
                    if next-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: next-hint.preferred-width + 12px;
                        height: next-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        next-hint := Text { x: 6px; y: 3px; text: model.next-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text { text: "⟩"; color: Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: first-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    first-ta := TouchArea {
                        clicked => { root.command("first"); img-keys.focus(); }
                    }
                    if first-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: first-hint.preferred-width + 12px;
                        height: first-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        first-hint := Text { x: 6px; y: 3px; text: model.first-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text { text: "⟨⟨"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: last-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    last-ta := TouchArea {
                        clicked => { root.command("last"); img-keys.focus(); }
                    }
                    if last-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: last-hint.preferred-width + 12px;
                        height: last-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        last-hint := Text { x: 6px; y: 3px; text: model.last-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text { text: "⟩⟩"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: rnd-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    rnd-ta := TouchArea {
                        clicked => { root.command("random"); img-keys.focus(); }
                    }
                    if rnd-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: rnd-hint.preferred-width + 12px;
                        height: rnd-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        rnd-hint := Text { x: 6px; y: 3px; text: model.random-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text { text: "*"; color: Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.loop-folder ? Theme.surface-raised
                        : loop-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    loop-ta := TouchArea {
                        clicked => { root.command("loop"); img-keys.focus(); }
                    }
                    if loop-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: loop-hint.preferred-width + 12px;
                        height: loop-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        loop-hint := Text { x: 6px; y: 3px; text: model.loop-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text {
                            text: model.loop-label;
                            color: model.loop-folder ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: folder-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    folder-ta := TouchArea {
                        clicked => { root.command("reveal-folder"); img-keys.focus(); }
                    }
                    if folder-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: folder-hint.preferred-width + 12px;
                        height: folder-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        folder-hint := Text { x: 6px; y: 3px; text: model.folder-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text { text: model.folder-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: root.show-recent ? Theme.surface-raised
                        : recent-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    recent-ta := TouchArea {
                        clicked => { root.show-recent = !root.show-recent; img-keys.focus(); }
                    }
                    if recent-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: recent-hint.preferred-width + 12px;
                        height: recent-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        recent-hint := Text { x: 6px; y: 3px; text: model.recent-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Text {
                            text: model.recent-label;
                            color: root.show-recent ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }

                Rectangle { width: 8px; }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.fit-mode == 1 ? Theme.surface-raised
                        : fit-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fit-ta := TouchArea {
                        clicked => {
                            root.fit();
                            img-keys.focus();
                        }
                    }
                    if fit-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: fit-hint.preferred-width + 12px;
                        height: fit-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        fit-hint := Text {
                            x: 6px; y: 3px;
                            text: model.fit-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.fit-label;
                            color: model.fit-mode == 1 ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.fit-mode == 2 ? Theme.surface-raised
                        : fit-w-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fit-w-ta := TouchArea {
                        clicked => {
                            root.command("fit-width");
                            img-keys.focus();
                        }
                    }
                    if fit-w-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: fit-w-hint.preferred-width + 12px;
                        height: fit-w-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        fit-w-hint := Text {
                            x: 6px; y: 3px;
                            text: model.fit-width-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.fit-width-label;
                            color: model.fit-mode == 2 ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.fit-mode == 3 ? Theme.surface-raised
                        : fit-h-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fit-h-ta := TouchArea {
                        clicked => {
                            root.command("fit-height");
                            img-keys.focus();
                        }
                    }
                    if fit-h-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: fit-h-hint.preferred-width + 12px;
                        height: fit-h-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        fit-h-hint := Text {
                            x: 6px; y: 3px;
                            text: model.fit-height-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.fit-height-label;
                            color: model.fit-mode == 3 ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.fit-mode == 4 ? Theme.surface-raised
                        : fit-s-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fit-s-ta := TouchArea {
                        clicked => {
                            root.command("fit-shrink");
                            img-keys.focus();
                        }
                    }
                    if fit-s-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: fit-s-hint.preferred-width + 12px;
                        height: fit-s-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        fit-s-hint := Text {
                            x: 6px; y: 3px;
                            text: model.fit-shrink-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.fit-shrink-label;
                            color: model.fit-mode == 4 ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.fit-mode == 0 ? Theme.surface-raised
                        : actual-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    actual-ta := TouchArea {
                        clicked => {
                            root.actual-size();
                            img-keys.focus();
                        }
                    }
                    if actual-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: actual-hint.preferred-width + 12px;
                        height: actual-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        actual-hint := Text {
                            x: 6px; y: 3px;
                            text: model.actual-size-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.actual-size-label;
                            color: model.fit-mode == 0 ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { width: 8px; }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: rcw-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    rcw-ta := TouchArea {
                        clicked => {
                            root.rotate-cw();
                            img-keys.focus();
                        }
                    }
                    if rcw-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: rcw-hint.preferred-width + 12px;
                        height: rcw-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        rcw-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-rotate-cw;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text { text: "↻"; color: Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: rccw-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    rccw-ta := TouchArea {
                        clicked => {
                            root.rotate-ccw();
                            img-keys.focus();
                        }
                    }
                    if rccw-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: rccw-hint.preferred-width + 12px;
                        height: rccw-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        rccw-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-rotate-ccw;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text { text: "↺"; color: Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle { width: 8px; }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: model.flipped-h ? Theme.surface-raised
                        : flip-h-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    flip-h-ta := TouchArea {
                        clicked => {
                            root.flip-h();
                            img-keys.focus();
                        }
                    }
                    if flip-h-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: flip-h-hint.preferred-width + 12px;
                        height: flip-h-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        flip-h-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-flip-h;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text {
                        text: "⇄";
                        color: model.flipped-h ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: model.flipped-v ? Theme.surface-raised
                        : flip-v-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    flip-v-ta := TouchArea {
                        clicked => {
                            root.flip-v();
                            img-keys.focus();
                        }
                    }
                    if flip-v-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: flip-v-hint.preferred-width + 12px;
                        height: flip-v-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        flip-v-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-flip-v;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text {
                        text: "⇅";
                        color: model.flipped-v ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { width: 8px; }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.bg-kind != 0 ? Theme.surface-raised
                        : bg-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    bg-ta := TouchArea {
                        clicked => {
                            root.command("bg-next");
                            img-keys.focus();
                        }
                    }
                    if bg-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: bg-hint.preferred-width + 12px;
                        height: bg-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        bg-hint := Text {
                            x: 6px; y: 3px;
                            text: model.bg-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.bg-label;
                            color: model.bg-kind != 0 ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.chrome-hidden ? Theme.surface-raised
                        : fs-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fs-ta := TouchArea {
                        clicked => {
                            root.command("fullscreen");
                            img-keys.focus();
                        }
                    }
                    if fs-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: fs-hint.preferred-width + 12px;
                        height: fs-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        fs-hint := Text {
                            x: 6px; y: 3px;
                            text: model.fullscreen-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.fullscreen-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: model.kiosk ? Theme.surface-raised
                        : kiosk-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    kiosk-ta := TouchArea {
                        clicked => {
                            root.command("kiosk");
                            img-keys.focus();
                        }
                    }
                    if kiosk-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: kiosk-hint.preferred-width + 12px;
                        height: kiosk-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        kiosk-hint := Text {
                            x: 6px; y: 3px;
                            text: model.kiosk-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.kiosk-label;
                            color: model.kiosk ? Theme.accent-brand : Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    min-width: 40px;
                    height: 28px;
                    background: mon-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    mon-ta := TouchArea {
                        clicked => {
                            root.command("next-monitor");
                            img-keys.focus();
                        }
                    }
                    if mon-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: mon-hint.preferred-width + 12px;
                        height: mon-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        mon-hint := Text {
                            x: 6px; y: 3px;
                            text: model.next-monitor-label;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: model.next-monitor-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        Rectangle {
            background: root.canvas-bg;
            vertical-stretch: 1;
            clip: true;

            Image {
                source: model.rgba-image;
                x: (parent.width - self.width) / 2 + model.pan-x;
                y: (parent.height - self.height) / 2 + model.pan-y;
                width: model.width-px * 1px * model.zoom;
                height: model.height-px * 1px * model.zoom;
                image-fit: fill;
                transform-rotation: model.rotation-deg * 1deg;
                transform-scale-x: model.flipped-h ? -1 : 1;
                transform-scale-y: model.flipped-v ? -1 : 1;
            }

            pan-area := TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                        root.swipe-x = self.mouse-x;
                        root.swipe-y = self.mouse-y;
                        img-keys.focus();
                    }
                    if (e.kind == PointerEventKind.up) {
                        if (model.fit-mode != 0
                            && abs(self.mouse-x - root.swipe-x) > 80px
                            && abs(self.mouse-x - root.swipe-x) > abs(self.mouse-y - root.swipe-y) * 2) {
                            if (self.mouse-x - root.swipe-x < 0px) {
                                root.command("next");
                            } else {
                                root.command("prev");
                            }
                        }
                    }
                }
                moved => {
                    if (self.pressed && model.fit-mode == 0) {
                        root.pan(self.mouse-x - root.last-mx, self.mouse-y - root.last-my);
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                    }
                }
                scroll-event(event) => {
                    if (event.modifiers.control) {
                        if (event.delta-y < 0) {
                            root.zoom-in();
                        } else {
                            root.zoom-out();
                        }
                    } else if (event.delta-y < 0 || event.delta-x < 0) {
                        root.command("next");
                    } else {
                        root.command("prev");
                    }
                    return accept;
                }
            }

            if root.show-recent && model.recent-paths.length > 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: min(parent.width - 16px, 360px);
                height: min(parent.height - 16px, 8px + model.recent-paths.length * 28px);
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 50;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for p in model.recent-paths : Rectangle {
                        height: 26px;
                        background: rec-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        rec-ta := TouchArea {
                            clicked => {
                                root.command("recent:" + p);
                                root.show-recent = false;
                                img-keys.focus();
                            }
                        }
                        Text {
                            x: 8px;
                            text: p;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            width: parent.width - 16px;
                        }
                    }
                }
            }
        }

        if model.info-text != "" && !model.chrome-hidden : Rectangle {
            height: 24px;
            background: Theme.surface-base;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: model.info-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    } // VerticalLayout
    } // FocusScope
}
