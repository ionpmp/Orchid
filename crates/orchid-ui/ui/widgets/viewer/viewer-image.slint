        canvas := Rectangle {
            background: root.canvas-bg;
            vertical-stretch: 1;
            clip: true;

            property <length> img-left: (self.width - model.width-px * 1px * model.zoom) / 2 + model.pan-x;
            property <length> img-top: (self.height - model.height-px * 1px * model.zoom) / 2 + model.pan-y;
            property <bool> overflows: model.width-px * 1px * model.zoom > self.width + 4px
                || model.height-px * 1px * model.zoom > self.height + 4px;

            property <float> slide-t: model.slideshow-playing && model.prev-width-px > 0 && model.slideshow-transition-ms > 0
                ? min(1.0, model.slideshow-gen * 50.0 / model.slideshow-transition-ms)
                : 1.0;

            if model.slideshow-playing && model.prev-width-px > 0 && model.slideshow-transition != 0 : Image {
                source: model.prev-rgba-image;
                x: canvas.img-left + (model.slideshow-transition == 2 ? canvas.width * canvas.slide-t : 0px);
                y: canvas.img-top;
                width: model.width-px * 1px * model.zoom;
                height: model.height-px * 1px * model.zoom;
                image-fit: fill;
                opacity: model.slideshow-transition == 4 ? 1.0 : (1.0 - canvas.slide-t);
                transform-rotation: model.rotation-deg * 1deg;
            }

            if model.slideshow-playing && model.slideshow-transition == 4 : Rectangle {
                x: canvas.img-left;
                y: canvas.img-top;
                width: model.width-px * 1px * model.zoom * canvas.slide-t;
                height: model.height-px * 1px * model.zoom;
                clip: true;
                Image {
                    source: model.rgba-image;
                    width: model.width-px * 1px * model.zoom;
                    height: model.height-px * 1px * model.zoom;
                    image-fit: fill;
                    transform-rotation: model.rotation-deg * 1deg;
                    transform-scale-x: model.flipped-h ? -1 : 1;
                    transform-scale-y: model.flipped-v ? -1 : 1;
                }
            }

            if !(model.slideshow-playing && model.slideshow-transition == 4) : Image {
                source: model.rgba-image;
                x: canvas.img-left - (model.slideshow-playing && model.slideshow-transition == 2
                    ? canvas.width * (1.0 - canvas.slide-t) : 0px);
                y: canvas.img-top;
                width: model.width-px * 1px * model.zoom;
                height: model.height-px * 1px * model.zoom;
                image-fit: fill;
                opacity: !model.slideshow-playing || model.slideshow-transition == 0
                    ? 1.0
                    : canvas.slide-t;
                transform-rotation: model.rotation-deg * 1deg;
                transform-scale-x: model.flipped-h ? -1 : 1;
                transform-scale-y: model.flipped-v ? -1 : 1;
            }

            if model.meta-overlay && model.meta-overlay-text != "" : Rectangle {
                x: 16px;
                y: 16px;
                width: min(parent.width - 32px, meta-ovl.preferred-width + 20px);
                height: meta-ovl.preferred-height + 12px;
                background: #000000aa;
                border-radius: Theme.radius-md;
                z: 25;
                meta-ovl := Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    text: model.meta-overlay-text;
                    color: #ffffff;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }

            if model.slideshow-playing && model.slideshow-overlay && model.slideshow-overlay-text != "" : Rectangle {
                x: 16px;
                y: parent.height - self.height - 16px;
                width: min(parent.width - 32px, ovl-txt.preferred-width + 20px);
                height: ovl-txt.preferred-height + 12px;
                background: #000000aa;
                border-radius: Theme.radius-md;
                ovl-txt := Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    text: model.slideshow-overlay-text;
                    color: #ffffff;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }

            pan-area := TouchArea {
                width: parent.width;
                height: parent.height;
                double-clicked => {
                    if (model.fit-mode == 0) { root.fit(); } else { root.actual-size(); }
                    img-keys.focus();
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.bump-overlay();
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                        root.swipe-x = self.mouse-x;
                        root.swipe-y = self.mouse-y;
                        root.middle-pan = e.button == PointerEventButton.middle;
                        root.pointer-right = e.button == PointerEventButton.right;
                        if (root.select-perspective) {
                            if (root.persp-n == 0) { root.persp-x0 = self.mouse-x; root.persp-y0 = self.mouse-y; }
                            if (root.persp-n == 1) { root.persp-x1 = self.mouse-x; root.persp-y1 = self.mouse-y; }
                            if (root.persp-n == 2) { root.persp-x2 = self.mouse-x; root.persp-y2 = self.mouse-y; }
                            if (root.persp-n == 3) {
                                root.command("edit-perspective:"
                                    + (root.persp-x0 / 1px) + ":" + (root.persp-y0 / 1px) + ":"
                                    + (root.persp-x1 / 1px) + ":" + (root.persp-y1 / 1px) + ":"
                                    + (root.persp-x2 / 1px) + ":" + (root.persp-y2 / 1px) + ":"
                                    + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                                root.select-perspective = false;
                                root.persp-n = 0;
                            } else {
                                root.persp-n = root.persp-n + 1;
                            }
                        } else if (root.ann-mode == 5) {
                            if (root.poly-pts == "") {
                                root.poly-pts = (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                            } else {
                                root.poly-pts = root.poly-pts + " " + (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                            }
                        } else if (root.ann-mode == 6) {
                            root.pen-pts = (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                            root.selecting = true;
                        } else if (root.ann-mode == 7) {
                            root.command("annotate-view:text:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px) + " | text=" + root.ann-text + " | " + root.ann-style());
                        } else if (root.ann-mode == 8) {
                            root.command("annotate-view:callout:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px) + " | callout=" + root.ann-text + " | w=180 | h=72 | " + root.ann-style());
                        } else if (root.ann-mode >= 1) {
                            root.selecting = true;
                            root.sel-x0 = self.mouse-x;
                            root.sel-y0 = self.mouse-y;
                            root.sel-x1 = self.mouse-x;
                            root.sel-y1 = self.mouse-y;
                        } else if (e.modifiers.shift || root.select-zoom || root.select-crop || root.select-edit-crop || root.select-straighten) {
                            root.selecting = true;
                            root.sel-x0 = self.mouse-x;
                            root.sel-y0 = self.mouse-y;
                            root.sel-x1 = self.mouse-x;
                            root.sel-y1 = self.mouse-y;
                        }
                        img-keys.focus();
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.middle-pan = false;
                        if (root.selecting && root.ann-mode == 6) {
                            root.command("annotate-view:pen:" + root.pen-pts + " | " + root.ann-style());
                            root.pen-pts = "";
                            root.selecting = false;
                        } else if (root.selecting && root.ann-mode >= 1 && root.ann-mode <= 4) {
                            root.command("annotate-view:" + (root.ann-mode == 1 ? "line" : root.ann-mode == 2 ? "arrow" : root.ann-mode == 3 ? "rect" : "ellipse")
                                + ":" + (root.sel-x0 / 1px) + ":" + (root.sel-y0 / 1px) + ":" + (root.sel-x1 / 1px) + ":" + (root.sel-y1 / 1px)
                                + " | " + root.ann-style());
                            root.selecting = false;
                        } else if (root.selecting && root.ann-mode == 9) {
                            root.command("annotate-view:privacy:" + (root.sel-x0 / 1px) + ":" + (root.sel-y0 / 1px) + ":" + (root.sel-x1 / 1px) + ":" + (root.sel-y1 / 1px)
                                + " | mode=" + (root.ann-pixel ? "pixel" : "blur"));
                            root.selecting = false;
                        } else if (root.selecting && root.ann-mode == 10) {
                            root.command("annotate-view:highlight:" + (root.sel-x0 / 1px) + ":" + (root.sel-y0 / 1px) + ":" + (root.sel-x1 / 1px) + ":" + (root.sel-y1 / 1px)
                                + " | color=#ffff66 | opacity=45");
                            root.selecting = false;
                        } else if (root.selecting) {
                            if (root.select-crop) {
                                root.command("lossless-crop:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            } else if (root.select-edit-crop) {
                                root.command("edit-crop:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px) + ":"
                                    + root.crop-aspect + ":"
                                    + root.crop-keep);
                            } else if (root.select-straighten) {
                                root.command("edit-straighten:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            } else {
                                root.command("zoom-rect:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            }
                            root.selecting = false;
                            root.select-zoom = false;
                            root.select-crop = false;
                            root.select-edit-crop = false;
                            root.select-straighten = false;
                        } else if ((model.fit-mode != 0 || root.pointer-right)
                            && abs(self.mouse-x - root.swipe-x) > 80px
                            && abs(self.mouse-x - root.swipe-x) > abs(self.mouse-y - root.swipe-y) * 2) {
                            if (self.mouse-x - root.swipe-x < 0px) {
                                root.command("next");
                            } else {
                                root.command("prev");
                            }
                        } else if (abs(self.mouse-y - root.swipe-y) > 80px
                            && abs(self.mouse-y - root.swipe-y) > abs(self.mouse-x - root.swipe-x) * 2) {
                            root.overlay-peek = self.mouse-y - root.swipe-y > 0px;
                        } else if (model.overlay-autohide
                            && abs(self.mouse-x - root.swipe-x) < 12px
                            && abs(self.mouse-y - root.swipe-y) < 12px) {
                            root.overlay-peek = !root.overlay-peek;
                        }
                        root.pointer-right = false;
                    }
                }
                moved => {
                    if (root.selecting && self.pressed && root.ann-mode == 6) {
                        root.pen-pts = root.pen-pts + " " + (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                    } else if (root.selecting && self.pressed) {
                        root.sel-x1 = self.mouse-x;
                        if (root.select-edit-crop && root.crop-aspect > 0.05) {
                            root.sel-y1 = root.sel-y0 + ((self.mouse-x - root.sel-x0) / 1px / root.crop-aspect) * 1px;
                        } else {
                            root.sel-y1 = self.mouse-y;
                        }
                    } else if (self.pressed && (model.fit-mode == 0 || root.middle-pan)) {
                        root.pan(self.mouse-x - root.last-mx, self.mouse-y - root.last-my);
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                    }
                    if (model.meta-panel || model.meta-overlay) {
                        root.command("probe:"
                            + floor((self.mouse-x - canvas.img-left) / 1px / max(0.01, model.zoom))
                            + ":"
                            + floor((self.mouse-y - canvas.img-top) / 1px / max(0.01, model.zoom)));
                    }
                }
                scroll-event(event) => {
                    if (event.modifiers.control) {
                        if (event.delta-y < 0) {
                            root.command("zoom-at:1.1:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                        } else {
                            root.command("zoom-at:0.909:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                        }
                    } else if (event.delta-y < 0 || event.delta-x < 0) {
                        root.command("next");
                    } else {
                        root.command("prev");
                    }
                    return accept;
                }
            }

            if model.anim-count > 1 && !model.slideshow-playing && root.chrome-on : Rectangle {
                x: 8px;
                y: parent.height - self.height - 8px;
                width: parent.width - 16px;
                height: 86px;
                background: #00000099;
                border-radius: Theme.radius-md;
                z: 40;
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        height: 24px;
                        if model.anim-can-play : Rectangle {
                            width: 28px;
                            background: Theme.surface-base;
                            border-radius: Theme.radius-md;
                            TouchArea { clicked => { root.command("anim-toggle"); img-keys.focus(); } }
                            Text { text: model.anim-playing ? "❚❚" : "▶"; color: Theme.accent-brand; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        Rectangle {
                            width: 28px;
                            background: Theme.surface-base;
                            border-radius: Theme.radius-md;
                            TouchArea { clicked => { root.command("anim-first"); img-keys.focus(); } }
                            Text { text: "⏮"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        Rectangle {
                            width: 28px;
                            background: Theme.surface-base;
                            border-radius: Theme.radius-md;
                            TouchArea { clicked => { root.command("anim-prev"); img-keys.focus(); } }
                            Text { text: "◀"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        Rectangle {
                            width: 28px;
                            background: Theme.surface-base;
                            border-radius: Theme.radius-md;
                            TouchArea { clicked => { root.command("anim-next"); img-keys.focus(); } }
                            Text { text: "▶"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        Rectangle {
                            width: 28px;
                            background: Theme.surface-base;
                            border-radius: Theme.radius-md;
                            TouchArea { clicked => { root.command("anim-last"); img-keys.focus(); } }
                            Text { text: "⏭"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        Text {
                            text: model.anim-label + "  " + model.anim-index-label;
                            color: #ffffff;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            min-width: 72px;
                            background: Theme.surface-base;
                            border-radius: Theme.radius-md;
                            TouchArea { clicked => { root.command("anim-extract"); img-keys.focus(); } }
                            Text { text: model.anim-extract-label; color: Theme.accent-brand; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                        if model.anim-can-play : Rectangle {
                            min-width: 72px;
                            background: Theme.surface-base;
                            border-radius: Theme.radius-md;
                            TouchArea { clicked => { root.command("anim-export"); img-keys.focus(); } }
                            Text { text: model.anim-export-label; color: Theme.accent-brand; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
                        }
                    }
                    Flickable {
                        height: 44px;
                        viewport-width: max(self.width, model.anim-thumbs.length * 40px + 8px);
                        viewport-height: self.height;
                        HorizontalLayout {
                            spacing: 4px;
                            for item in model.anim-thumbs : Rectangle {
                                width: 36px;
                                height: 40px;
                                background: item.selected ? Theme.surface-raised : transparent;
                                border-radius: Theme.radius-md;
                                border-width: item.selected ? 2px : 0px;
                                border-color: Theme.accent-brand;
                                TouchArea { clicked => { root.command("anim-goto:" + item.index); img-keys.focus(); } }
                                VerticalLayout {
                                    Image {
                                        source: item.thumbnail;
                                        width: 32px;
                                        height: 24px;
                                        image-fit: contain;
                                    }
                                    Text {
                                        text: item.name;
                                        color: #ffffff;
                                        font-size: Theme.font-size-sm;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.selecting : Rectangle {
                x: min(root.sel-x0, root.sel-x1);
                y: min(root.sel-y0, root.sel-y1);
                width: abs(root.sel-x1 - root.sel-x0);
                height: abs(root.sel-y1 - root.sel-y0);
                border-width: 1px;
                border-color: Theme.accent-brand;
                background: #3d8bfd33;
                z: 20;
            }

            if model.lens : Rectangle {
                x: pan-area.mouse-x - 64px;
                y: pan-area.mouse-y - 64px;
                width: 128px;
                height: 128px;
                border-radius: 64px;
                clip: true;
                border-width: 2px;
                border-color: Theme.accent-brand;
                z: 30;
                Image {
                    source: model.rgba-image;
                    width: model.width-px * 1px * model.zoom * 2.5;
                    height: model.height-px * 1px * model.zoom * 2.5;
                    x: 64px - (pan-area.mouse-x - canvas.img-left) * 2.5;
                    y: 64px - (pan-area.mouse-y - canvas.img-top) * 2.5;
                    image-fit: fill;
                    transform-rotation: model.rotation-deg * 1deg;
                    transform-scale-x: model.flipped-h ? -1 : 1;
                    transform-scale-y: model.flipped-v ? -1 : 1;
                }
            }

            if (model.meta-panel || model.meta-overlay) && model.probe-text != "" : Rectangle {
                x: min(pan-area.mouse-x + 14px, parent.width - self.width - 8px);
                y: min(pan-area.mouse-y + 14px, parent.height - self.height - 8px);
                width: probe-txt.preferred-width + 16px;
                height: probe-txt.preferred-height + 10px;
                background: #000000cc;
                border-radius: Theme.radius-md;
                z: 60;
                probe-txt := Text {
                    x: 8px;
                    y: 5px;
                    text: model.probe-text;
                    color: #ffffff;
                    font-size: Theme.font-size-sm;
                    font-family: Theme.font-family-mono;
                }
            }

            if root.show-annotate : Rectangle {
                x: 8px;
                y: 8px;
                width: min(400px, parent.width * 0.56);
                height: min(parent.height - 16px, 420px);
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 56;
                clip: true;
                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;
                    Text { text: model.annotate-label; color: Theme.text-primary; font-size: Theme.font-size-sm; }
                    Text { text: model.annotate-hint-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 4px; height: 24px;
                        Rectangle { background: root.ann-mode == 1 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 1; } } Text { text: model.annotate-line-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-mode == 2 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 2; } } Text { text: model.annotate-arrow-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-mode == 3 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 3; } } Text { text: model.annotate-rect-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-mode == 4 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 4; } } Text { text: model.annotate-ellipse-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                    }
                    HorizontalLayout {
                        spacing: 4px; height: 24px;
                        Rectangle { background: root.ann-mode == 5 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 5; root.poly-pts = ""; } } Text { text: model.annotate-poly-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-mode == 6 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 6; } } Text { text: model.annotate-pen-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-mode == 7 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 7; } } Text { text: model.annotate-text-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-mode == 8 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 8; } } Text { text: model.annotate-callout-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                    }
                    HorizontalLayout {
                        spacing: 4px; height: 24px;
                        Rectangle { background: root.ann-mode == 9 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 9; } } Text { text: model.annotate-privacy-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-pixel ? Theme.accent-brand : Theme.surface-base; border-radius: Theme.radius-md; width: 52px; TouchArea { clicked => { root.ann-pixel = !root.ann-pixel; } } Text { text: root.ann-pixel ? "px" : "blur"; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: root.ann-mode == 10 ? Theme.surface-raised : Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { root.ann-mode = 10; } } Text { text: model.annotate-highlight-label; color: Theme.text-primary; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                        Rectangle { background: Theme.surface-base; border-radius: Theme.radius-md; TouchArea { clicked => { if (root.poly-pts != "") { root.command("annotate-view:poly:" + root.poly-pts + " | " + root.ann-style()); root.poly-pts = ""; } } } Text { text: model.annotate-apply-label; color: Theme.accent-brand; font-size: Theme.font-size-sm; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; } }
                    }
                    HorizontalLayout {
                        spacing: 4px; height: 24px;
                        TextInput { text <=> root.ann-text; color: Theme.text-primary; font-size: Theme.font-size-sm; }
                        TextInput { text <=> root.ann-color; color: Theme.text-primary; font-size: Theme.font-size-sm; width: 72px; }
                        TextInput { text <=> root.ann-width; color: Theme.text-primary; font-size: Theme.font-size-sm; width: 36px; }
                        TextInput { text <=> root.ann-size; color: Theme.text-primary; font-size: Theme.font-size-sm; width: 36px; }
                    }
                    HorizontalLayout {
                        spacing: 4px; height: 24px;
