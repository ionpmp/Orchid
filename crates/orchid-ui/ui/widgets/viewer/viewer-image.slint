            height: root.thumb-strip-h;
            background: Theme.surface-base;
            thumb-strip-top := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: max(self.width, model.thumbs.length * (root.thumb-cell + 10px) + 8px);
                viewport-height: self.height;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 6px;
                    for item in model.thumbs : Rectangle {
                        width: root.thumb-cell + 4px;
                        height: parent.height - 8px;
                        background: item.selected ? Theme.surface-raised : transparent;
                        border-radius: Theme.radius-md;
                        border-width: item.selected ? 2px : 0px;
                        border-color: Theme.accent-brand;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 2px;
                            Image {
                                source: item.thumbnail;
                                width: root.thumb-cell;
                                height: root.thumb-cell;
                                image-fit: contain;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.size-text + " · " + item.date-text;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta && item.rating > 0 : Text {
                                text: root.rating-stars(item.rating);
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.command("goto:" + item.index);
                                img-keys.focus();
                            }
                        }
                    }
                }
            }
