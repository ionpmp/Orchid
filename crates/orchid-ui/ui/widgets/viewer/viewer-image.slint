                    Text {
                        text: root.crop-aspect < 0.5 ? "free"
                            : root.crop-aspect < 1.1 ? "1:1"
                            : root.crop-aspect < 1.4 ? "4:3"
                            : root.crop-aspect < 1.6 ? "3:2"
                            : "16:9";
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center; vertical-alignment: center;
