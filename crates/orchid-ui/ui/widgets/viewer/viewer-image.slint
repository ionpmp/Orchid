        canvas := Rectangle {
            background: root.canvas-bg;
            vertical-stretch: 1;
            clip: true;

            property <length> img-left: (self.width - model.width-px * 1px * model.zoom) / 2 + model.pan-x;
            property <length> img-top: (self.height - model.height-px * 1px * model.zoom) / 2 + model.pan-y;
            property <bool> overflows: model.width-px * 1px * model.zoom > self.width + 4px
                || model.height-px * 1px * model.zoom > self.height + 4px;

            Image {
                source: model.rgba-image;
                x: canvas.img-left;
                y: canvas.img-top;
                width: model.width-px * 1px * model.zoom;
                height: model.height-px * 1px * model.zoom;
                image-fit: fill;
                transform-rotation: model.rotation-deg * 1deg;
                transform-scale-x: model.flipped-h ? -1 : 1;
                transform-scale-y: model.flipped-v ? -1 : 1;
            }

            pan-area := TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                        root.swipe-x = self.mouse-x;
                        root.swipe-y = self.mouse-y;
                        root.middle-pan = e.button == PointerEventButton.middle;
                        if (e.modifiers.shift || root.select-zoom || root.select-crop) {
                            root.selecting = true;
                            root.sel-x0 = self.mouse-x;
                            root.sel-y0 = self.mouse-y;
                            root.sel-x1 = self.mouse-x;
                            root.sel-y1 = self.mouse-y;
                        }
                        img-keys.focus();
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.middle-pan = false;
                        if (root.selecting) {
                            if (root.select-crop) {
                                root.command("lossless-crop:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            } else {
                                root.command("zoom-rect:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            }
                            root.selecting = false;
                            root.select-zoom = false;
                            root.select-crop = false;
                        } else if (model.fit-mode != 0
                            && abs(self.mouse-x - root.swipe-x) > 80px
                            && abs(self.mouse-x - root.swipe-x) > abs(self.mouse-y - root.swipe-y) * 2) {
                            if (self.mouse-x - root.swipe-x < 0px) {
                                root.command("next");
                            } else {
                                root.command("prev");
                            }
                        }
                    }
                }
                moved => {
                    if (root.selecting && self.pressed) {
                        root.sel-x1 = self.mouse-x;
                        root.sel-y1 = self.mouse-y;
                    } else if (self.pressed && (model.fit-mode == 0 || root.middle-pan)) {
                        root.pan(self.mouse-x - root.last-mx, self.mouse-y - root.last-my);
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                    }
                }
                scroll-event(event) => {
                    if (event.modifiers.control) {
                        if (event.delta-y < 0) {
                            root.command("zoom-at:1.1:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                        } else {
                            root.command("zoom-at:0.909:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                        }
                    } else if (event.delta-y < 0 || event.delta-x < 0) {
                        root.command("next");
                    } else {
                        root.command("prev");
                    }
                    return accept;
                }
            }

            if root.selecting : Rectangle {
                x: min(root.sel-x0, root.sel-x1);
                y: min(root.sel-y0, root.sel-y1);
                width: abs(root.sel-x1 - root.sel-x0);
                height: abs(root.sel-y1 - root.sel-y0);
                border-width: 1px;
                border-color: Theme.accent-brand;
                background: #3d8bfd33;
                z: 20;
            }

            if model.lens : Rectangle {
                x: pan-area.mouse-x - 64px;
                y: pan-area.mouse-y - 64px;
                width: 128px;
                height: 128px;
                border-radius: 64px;
                clip: true;
                border-width: 2px;
                border-color: Theme.accent-brand;
                z: 30;
                Image {
                    source: model.rgba-image;
                    width: model.width-px * 1px * model.zoom * 2.5;
                    height: model.height-px * 1px * model.zoom * 2.5;
                    x: 64px - (pan-area.mouse-x - canvas.img-left) * 2.5;
                    y: 64px - (pan-area.mouse-y - canvas.img-top) * 2.5;
                    image-fit: fill;
                    transform-rotation: model.rotation-deg * 1deg;
                    transform-scale-x: model.flipped-h ? -1 : 1;
                    transform-scale-y: model.flipped-v ? -1 : 1;
                }
            }

            if canvas.overflows && !root.nav-hidden : Rectangle {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                width: 140px;
                height: max(48px, 140px * model.height-px / max(1, model.width-px));
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 40;
                clip: true;

                property <float> vis-x0: max(0, (0 - canvas.img-left / 1px) / max(0.01, model.zoom * model.width-px));
                property <float> vis-y0: max(0, (0 - canvas.img-top / 1px) / max(0.01, model.zoom * model.height-px));
                property <float> vis-x1: min(1, (canvas.width / 1px - canvas.img-left / 1px) / max(0.01, model.zoom * model.width-px));
                property <float> vis-y1: min(1, (canvas.height / 1px - canvas.img-top / 1px) / max(0.01, model.zoom * model.height-px));

                Image {
                    source: model.rgba-image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                }
                Rectangle {
                    x: parent.vis-x0 * parent.width;
                    y: parent.vis-y0 * parent.height;
                    width: max(4px, (parent.vis-x1 - parent.vis-x0) * parent.width);
                    height: max(4px, (parent.vis-y1 - parent.vis-y0) * parent.height);
                    border-width: 1px;
                    border-color: Theme.accent-brand;
                    background: #3d8bfd33;
                }
                nav-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        root.command("nav-pan:" + (self.mouse-x / parent.width) + ":" + (self.mouse-y / parent.height));
                    }
                    moved => {
                        if (self.pressed) {
                            root.command("nav-pan:" + (self.mouse-x / parent.width) + ":" + (self.mouse-y / parent.height));
                        }
                    }
                }
            }

            if root.show-recent && model.recent-paths.length > 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: min(parent.width - 16px, 360px);
                height: min(parent.height - 16px, 8px + model.recent-paths.length * 28px);
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 50;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for p in model.recent-paths : Rectangle {
                        height: 26px;
                        background: rec-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        rec-ta := TouchArea {
                            clicked => {
                                root.command("recent:" + p);
                                root.show-recent = false;
                                img-keys.focus();
                            }
                        }
                        Text {
                            x: 8px;
                            text: p;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            width: parent.width - 16px;
                        }
                    }
                }
            }
        }

        if model.info-text != "" && !model.chrome-hidden : Rectangle {
            height: 24px;
            background: Theme.surface-base;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: model.info-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    } // VerticalLayout
    } // FocusScope
}
