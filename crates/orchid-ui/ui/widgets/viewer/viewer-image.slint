import { Theme } from "../../theme_global.slint";
import { Strings } from "../../strings_global.slint";
import { ViewerImageModel } from "../../workspace/defs.slint";

export component ViewerImageView inherits Rectangle {
    in property <ViewerImageModel> model;

    callback zoom-in();
    callback zoom-out();
    callback fit();
    callback actual-size();
    callback rotate-cw();
    callback rotate-ccw();
    callback flip-h();
    callback flip-v();
    callback pan(length, length);
    callback command(string);

    function rating-stars(n: int) -> string {
        if (n <= 0) { return ""; }
        if (n == 1) { return "★"; }
        if (n == 2) { return "★★"; }
        if (n == 3) { return "★★★"; }
        if (n == 4) { return "★★★★"; }
        return "★★★★★";
    }

    background: transparent;

    property <length> last-mx: 0px;
    property <length> last-my: 0px;
    property <length> swipe-x: 0px;
    property <length> swipe-y: 0px;
    property <length> pan-step: 40px;
    property <bool> show-recent: false;
    property <bool> select-zoom: false;
    property <bool> select-crop: false;
    property <bool> select-edit-crop: false;
    property <bool> select-straighten: false;
    property <bool> select-perspective: false;
    property <bool> show-adjust: false;
    property <bool> show-filter: false;
    property <bool> show-annotate: false;
    property <bool> show-print: false;
    property <bool> show-share: false;
    property <string> export-fmt: "jpg";
    property <string> export-q: "85";
    property <string> export-max: "1920";
    property <string> print-paper: "a4";
    property <string> print-margin: "12";
    property <string> print-nup: "1";
    property <string> print-fit: "contain";
    property <string> print-header: "";
    property <string> print-footer: "name  date";
    property <string> print-icc: "srgb";

    function print-spec() -> string {
        return "paper=" + root.print-paper + " | margin=" + root.print-margin + " | nup=" + root.print-nup + " | fit=" + root.print-fit + " | header=" + root.print-header + " | footer=" + root.print-footer + " | icc=" + root.print-icc;
    }
    function export-spec() -> string {
        return root.export-fmt + " | q=" + root.export-q + " | max=" + root.export-max;
    }
    /// 0 off, 1 line, 2 arrow, 3 rect, 4 ellipse, 5 poly, 6 pen, 7 text, 8 callout, 9 privacy, 10 highlight.
    property <int> ann-mode: 0;
    property <string> pen-pts: "";
    property <string> poly-pts: "";
    property <bool> ann-pixel: true;
    property <string> ann-color: "#ff3344";
    property <string> ann-width: "3";
    property <string> ann-size: "22";
    property <string> ann-font: "Segoe UI";
    property <string> ann-opacity: "40";
    property <string> ann-pos: "br";
    property <string> ann-text: "Note";
    property <string> ann-wm: "© Orchid";
    property <string> ann-wm-path: "logo.png";

    function ann-style() -> string {
        return "color=" + root.ann-color + " | width=" + root.ann-width + " | size=" + root.ann-size + " | font=" + root.ann-font + " | opacity=" + root.ann-opacity + " | pos=" + root.ann-pos;
    }
    property <int> persp-n: 0;
    property <length> persp-x0: 0px;
    property <length> persp-y0: 0px;
    property <length> persp-x1: 0px;
    property <length> persp-y1: 0px;
    property <length> persp-x2: 0px;
    property <length> persp-y2: 0px;
    property <float> crop-aspect: 0;
    property <int> crop-keep: 0;
    property <bool> selecting: false;
    property <length> sel-x0: 0px;
    property <length> sel-y0: 0px;
    property <length> sel-x1: 0px;
    property <length> sel-y1: 0px;
    property <bool> nav-hidden: false;
    property <bool> middle-pan: false;
    property <bool> pointer-right: false;
    property <bool> overlay-peek: true;
    property <int> activity-gen: 0;
    property <int> hide-seen: 0;
    property <bool> chrome-on: !model.chrome-hidden && (root.overlay-peek || !model.overlay-autohide);

    function bump-overlay() {
        root.overlay-peek = true;
        root.activity-gen = root.activity-gen + 1;
    }
    property <length> thumb-cell: model.thumb-size == 0 ? 64px
        : model.thumb-size == 2 ? 256px
        : 128px;
    property <length> thumb-strip-h: root.thumb-cell
        + (model.thumb-show-meta ? 42px : 6px)
        + 10px;
    property <color> canvas-bg: model.bg-kind == 1 ? #000000
        : model.bg-kind == 2 ? #ffffff
        : model.bg-kind == 3 ? #808080
        : model.bg-kind == 4 ? #707070
        : model.bg-kind == 5 ? rgb(model.bg-r, model.bg-g, model.bg-b)
        : Theme.surface-base;

    hide-chrome-timer := Timer {
        interval: 2800ms;
        running: model.overlay-autohide && root.overlay-peek && !model.chrome-hidden
            && !root.show-adjust && !root.show-filter && !root.show-annotate
            && !root.show-print && !root.show-share && model.browse-mode == 0;
        triggered => {
            if (root.activity-gen == root.hide-seen) {
                root.overlay-peek = false;
            } else {
                root.hide-seen = root.activity-gen;
            }
        }
    }

    img-keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }

        key-pressed(event) => {
            root.bump-overlay();
            if (event.text == "+" || event.text == "=") {
                root.zoom-in();
                return accept;
            }
            if (event.text == "-" || event.text == "−") {
                root.zoom-out();
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                if (event.modifiers.shift) {
                    root.show-filter = !root.show-filter;
                    if (root.show-filter) { root.show-adjust = false; root.show-annotate = false; root.show-print = false; root.show-share = false; }
                } else {
                    root.fit();
                }
                return accept;
            }
            if (event.text == "1") {
                root.actual-size();
                return accept;
            }
            if (event.text == "w" || event.text == "W") {
                root.command("fit-width");
                return accept;
            }
            if (event.text == "e" || event.text == "E") {
                root.command("fit-height");
                return accept;
            }
            if (event.text == "0") {
                root.command("fit-shrink");
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                root.command("bg-next");
                return accept;
            }
            if (event.text == Key.F5) {
                root.command("slideshow");
                return accept;
            }
            if (event.text == Key.F11) {
                root.command("fullscreen");
                return accept;
            }
            if (event.text == "k" || event.text == "K") {
                root.command("kiosk");
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                if (event.modifiers.shift) {
                    root.command("slideshow-music");
                } else {
                    root.command("next-monitor");
                }
                return accept;
            }
            if (event.text == Key.Escape && model.slideshow-playing) {
                root.command("slideshow-stop");
                return accept;
            }
            if (event.text == Key.Escape && model.browse-mode != 0) {
                root.command("browse-off");
                return accept;
            }
            if (event.text == Key.Escape && (model.chrome-hidden || model.kiosk)) {
                root.command("exit-immersive");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "t" || event.text == "T")) {
                root.command("browse-timeline");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "m" || event.text == "M")) {
                root.command("browse-map");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "c" || event.text == "C")) {
                root.command("browse-calendar");
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (event.modifiers.alt) {
                    root.command("lossless-folder:cw");
                } else if (event.modifiers.shift) {
                    root.command("lossless-ccw");
                } else {
                    root.command("lossless-cw");
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "u" || event.text == "U")) {
                root.command("lossless-180");
                return accept;
            }
            if (event.modifiers.control && (event.text == "e" || event.text == "E")) {
                if (event.modifiers.shift) {
                    root.command("lossless-folder:exif");
                } else {
                    root.command("lossless-exif");
                }
                return accept;
            }
            if (event.modifiers.control && event.modifiers.alt && (event.text == "h" || event.text == "H")) {
                root.command("lossless-flip-h");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.alt && (event.text == "v" || event.text == "V")) {
                root.command("lossless-flip-v");
                return accept;
            }
            if (!event.modifiers.control && (event.text == "c" || event.text == "C")) {
                if (event.modifiers.shift) {
                    root.select-edit-crop = !root.select-edit-crop;
                    root.select-crop = false;
                } else {
                    root.select-crop = !root.select-crop;
                    root.select-edit-crop = false;
                }
                return accept;
            }
            if (event.modifiers.shift && (event.text == "a" || event.text == "A")) {
                if (root.crop-aspect < 0.5) { root.crop-aspect = 1; }
                else if (root.crop-aspect < 1.1) { root.crop-aspect = 1.333333; }
                else if (root.crop-aspect < 1.4) { root.crop-aspect = 1.5; }
                else if (root.crop-aspect < 1.6) { root.crop-aspect = 1.777778; }
                else { root.crop-aspect = 0; }
                return accept;
            }
            if (event.modifiers.shift && (event.text == "k" || event.text == "K")) {
                root.crop-keep = (root.crop-keep + 1) > 2 ? 0 : root.crop-keep + 1;
                return accept;
            }
            if (event.modifiers.shift && event.text == "/") {
                root.select-straighten = !root.select-straighten;
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "a" || event.text == "A")) {
                root.command("edit-auto-straighten");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.alt && (event.text == "p" || event.text == "P")) {
                root.select-perspective = !root.select-perspective;
                root.persp-n = 0;
                return accept;
            }
            if (event.text == "r" || event.text == "R") {
                if (event.modifiers.shift) {
                    root.rotate-ccw();
                } else {
                    root.rotate-cw();
                }
                return accept;
            }
            if (event.text == "u" || event.text == "U") {
                root.command("rotate-180");
                return accept;
            }
            if (event.text == "x" || event.text == "X") {
                root.command("reset-transform");
                return accept;
            }
            if (event.text == "[") {
                root.command(event.modifiers.shift ? "rotate-by:-15" : "rotate-by:-1");
                return accept;
            }
            if (event.text == "]") {
                root.command(event.modifiers.shift ? "rotate-by:15" : "rotate-by:1");
                return accept;
            }
            if (event.text == "v" || event.text == "V") {
                root.flip-v();
                return accept;
            }
            if (event.text == Key.Space) {
                if (model.slideshow-playing) {
                    root.command("slideshow-pause");
                } else if (model.anim-can-play && model.anim-count > 1) {
                    root.command("anim-toggle");
                } else {
                    root.command("next");
                }
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.command("next");
                return accept;
            }
            if (event.text == Key.PageUp || event.text == Key.Backspace) {
                root.command("prev");
                return accept;
            }
            if (event.text == Key.Home) {
                root.command("first");
                return accept;
            }
            if (event.text == Key.End) {
                root.command("last");
                return accept;
            }
            if (event.text == "*" ) {
                root.command("random");
                return accept;
            }
            if (event.text == "l" || event.text == "L") {
                if (event.modifiers.shift) {
                    root.show-adjust = !root.show-adjust;
                    if (root.show-adjust) { root.show-filter = false; root.show-annotate = false; root.show-print = false; root.show-share = false; }
                } else {
                    root.command("loop");
                }
                return accept;
            }
            if (event.text == "o" || event.text == "O") {
                if (event.modifiers.control && event.modifiers.shift) {
                    root.command("meta-overlay");
                } else if (event.modifiers.shift) {
                    root.command("slideshow-overlay");
                } else {
                    root.command("reveal-folder");
                }
                return accept;
            }
            if (event.text == "z" || event.text == "Z") {
                root.command("lens");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "s" || event.text == "S")) {
                root.command("export:" + root.export-spec());
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.command("copy-image");
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.alt && (event.text == "v" || event.text == "V")) {
                root.command("paste-image");
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                if (event.modifiers.shift) {
                    root.show-share = !root.show-share;
                    if (root.show-share) { root.show-adjust = false; root.show-filter = false; root.show-annotate = false; root.show-print = false; }
                } else {
                    root.select-zoom = !root.select-zoom;
                }
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                root.nav-hidden = !root.nav-hidden;
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                root.command("thumbs");
                return accept;
            }
            if (event.text == "g" || event.text == "G") {
                root.command("thumb-grid");
                return accept;
            }
            if (event.text == "d" || event.text == "D") {
                if (event.modifiers.shift) {
                    root.show-annotate = !root.show-annotate;
                    if (root.show-annotate) { root.show-adjust = false; root.show-filter = false; root.show-print = false; root.show-share = false; }
                    else { root.ann-mode = 0; }
                } else {
                    root.command("thumb-size");
                }
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                if (event.modifiers.shift) {
                    root.command("meta-panel");
                } else {
                    root.command("thumb-meta");
                }
                return accept;
            }
            if (event.text == "p" || event.text == "P") {
                if (event.modifiers.control && event.modifiers.shift) {
                    root.command("slideshow-export-html");
                } else if (event.modifiers.control) {
                    root.command("print:" + root.print-spec());
                } else if (event.modifiers.shift) {
                    root.show-print = !root.show-print;
                    if (root.show-print) { root.show-adjust = false; root.show-filter = false; root.show-annotate = false; root.show-share = false; }
                } else {
                    root.command("contact-sheet");
                }
                return accept;
            }
            if (event.text == "y" || event.text == "Y") {
                root.command("slideshow-random");
                return accept;
            }
            if (event.text == "j" || event.text == "J") {
                if (event.modifiers.shift) {
                    root.command("slideshow-trans-ms");
                } else {
                    root.command("slideshow-transition");
                }
                return accept;
            }
            if (event.text == ",") {
                root.command("slideshow-slower");
                return accept;
            }
            if (event.text == ".") {
                root.command("slideshow-faster");
                return accept;
            }
            if (event.text == "h" || event.text == "H") {
                if (event.modifiers.control) {
                    root.command("hist-mode");
                    return accept;
                }
                // H is flip when not Shift? Keep H as flip; use Shift+H for recent.
                if (event.modifiers.shift) {
                    root.show-recent = !root.show-recent;
                    return accept;
                }
                root.flip-h();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.shift && model.anim-count > 1) {
                    root.command("anim-prev");
                } else if (model.fit-mode == 0) {
                    root.pan(root.pan-step, 0px);
                } else {
                    root.command("prev");
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.shift && model.anim-count > 1) {
                    root.command("anim-next");
                } else if (model.fit-mode == 0) {
                    root.pan(-root.pan-step, 0px);
                } else {
                    root.command("next");
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.pan(0px, root.pan-step);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.pan(0px, -root.pan-step);
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        spacing: 0;

        if root.chrome-on : Rectangle {
            height: 36px;
            background: Theme.surface-base;
            border-radius: Theme.radius-md;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: start;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: zoom-out-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    zoom-out-ta := TouchArea {
                        clicked => {
                            root.zoom-out();
                            img-keys.focus();
                        }
                    }
                    if zoom-out-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: zoom-out-hint.preferred-width + 12px;
                        height: zoom-out-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        zoom-out-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-zoom-out;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text { text: "−"; color: Theme.text-primary; font-size: Theme.font-size-lg; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 56px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    zoom-pct := TextInput {
                        text: "" + floor(model.zoom * 100);
                        input-type: number;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accepted => {
                            root.command("zoom:" + self.text);
                            img-keys.focus();
                        }
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: root.select-zoom ? Theme.surface-raised
                        : sel-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    sel-ta := TouchArea {
                        clicked => { root.select-zoom = !root.select-zoom; img-keys.focus(); }
                    }
                    if sel-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: sel-hint.preferred-width + 12px;
                        height: sel-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        sel-hint := Text { x: 6px; y: 3px; text: model.zoom-selection-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text {
                        text: "▭";
                        color: root.select-zoom ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: model.lens ? Theme.surface-raised
                        : lens-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    lens-ta := TouchArea {
                        clicked => { root.command("lens"); img-keys.focus(); }
                    }
                    if lens-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: lens-hint.preferred-width + 12px;
                        height: lens-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        lens-hint := Text { x: 6px; y: 3px; text: model.lens-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text {
                        text: "⌕";
                        color: model.lens ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-md;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: zoom-in-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    zoom-in-ta := TouchArea {
                        clicked => {
                            root.zoom-in();
                            img-keys.focus();
                        }
                    }
                    if zoom-in-ta.has-hover : Rectangle {
                        x: parent.x;
                        y: parent.height + 2px;
                        width: zoom-in-hint.preferred-width + 12px;
                        height: zoom-in-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;
                        z: 100;
                        zoom-in-hint := Text {
                            x: 6px;
                            y: 3px;
                            text: Strings.viewer-image-zoom-in;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    Text { text: "+"; color: Theme.text-primary; font-size: Theme.font-size-lg; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle { width: 8px; }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: prev-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    prev-ta := TouchArea {
                        clicked => { root.command("prev"); img-keys.focus(); }
                    }
                    if prev-ta.has-hover : Rectangle {
                        x: parent.x; y: parent.height + 2px;
                        width: prev-hint.preferred-width + 12px;
                        height: prev-hint.preferred-height + 6px;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-md;
                        border-width: 1px; border-color: Theme.border-default; z: 100;
                        prev-hint := Text { x: 6px; y: 3px; text: model.prev-label; color: Theme.text-secondary; font-size: Theme.font-size-sm; }
                    }
                    Text { text: "⟨"; color: Theme.text-primary; font-size: Theme.font-size-md; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
