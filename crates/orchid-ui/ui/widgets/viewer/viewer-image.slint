import { Theme } from "../../theme_global.slint";
import { Strings } from "../../strings_global.slint";
import { ViewerImageModel } from "../../workspace/defs.slint";
import { Chip, ControlSize, IconButton } from "../../kit.slint";
import { ImageToolBtn } from "viewer-image-toolbtn.slint";
import {
    ImageAdjustPanel, ImageAnnotatePanel, ImageAnimBar, ImageFilterPanel,
    ImageMetaPanel, ImagePrintPanel, ImageSharePanel,
} from "viewer-image-panels.slint";

export component ViewerImageView inherits Rectangle {
    in property <ViewerImageModel> model;

    callback zoom-in();
    callback zoom-out();
    callback fit();
    callback actual-size();
    callback rotate-cw();
    callback rotate-ccw();
    callback flip-h();
    callback flip-v();
    callback pan(length, length);
    callback command(string);

    function rating-stars(n: int) -> string {
        if (n <= 0) { return ""; }
        if (n == 1) { return "★"; }
        if (n == 2) { return "★★"; }
        if (n == 3) { return "★★★"; }
        if (n == 4) { return "★★★★"; }
        return "★★★★★";
    }

    background: transparent;

    property <length> last-mx: 0px;
    property <length> last-my: 0px;
    property <length> swipe-x: 0px;
    property <length> swipe-y: 0px;
    property <length> pan-step: 40px;
    property <bool> show-recent: false;
    property <bool> select-zoom: false;
    property <bool> select-crop: false;
    property <bool> select-edit-crop: false;
    property <bool> select-straighten: false;
    property <bool> select-perspective: false;
    property <bool> show-adjust: false;
    property <bool> show-filter: false;
    property <bool> show-annotate: false;
    property <bool> show-print: false;
    property <bool> show-share: false;
    property <string> export-fmt: "jpg";
    property <string> export-q: "85";
    property <string> export-max: "1920";
    property <string> print-paper: "a4";
    property <string> print-margin: "12";
    property <string> print-nup: "1";
    property <string> print-fit: "contain";
    property <string> print-header: "";
    property <string> print-footer: "name  date";
    property <string> print-icc: "srgb";

    function print-spec() -> string {
        return "paper=" + root.print-paper + " | margin=" + root.print-margin + " | nup=" + root.print-nup + " | fit=" + root.print-fit + " | header=" + root.print-header + " | footer=" + root.print-footer + " | icc=" + root.print-icc;
    }
    function export-spec() -> string {
        return root.export-fmt + " | q=" + root.export-q + " | max=" + root.export-max;
    }
    /// 0 off, 1 line, 2 arrow, 3 rect, 4 ellipse, 5 poly, 6 pen, 7 text, 8 callout, 9 privacy, 10 highlight.
    property <int> ann-mode: 0;
    property <string> pen-pts: "";
    property <string> poly-pts: "";
    property <bool> ann-pixel: true;
    property <string> ann-color: "#ff3344";
    property <string> ann-width: "3";
    property <string> ann-size: "22";
    property <string> ann-font: "Segoe UI";
    property <string> ann-opacity: "40";
    property <string> ann-pos: "br";
    property <string> ann-text: "Note";
    property <string> ann-wm: "© Orchid";
    property <string> ann-wm-path: "logo.png";

    function ann-style() -> string {
        return "color=" + root.ann-color + " | width=" + root.ann-width + " | size=" + root.ann-size + " | font=" + root.ann-font + " | opacity=" + root.ann-opacity + " | pos=" + root.ann-pos;
    }
    property <int> persp-n: 0;
    property <length> persp-x0: 0px;
    property <length> persp-y0: 0px;
    property <length> persp-x1: 0px;
    property <length> persp-y1: 0px;
    property <length> persp-x2: 0px;
    property <length> persp-y2: 0px;
    property <float> crop-aspect: 0;
    property <int> crop-keep: 0;
    property <bool> selecting: false;
    property <length> sel-x0: 0px;
    property <length> sel-y0: 0px;
    property <length> sel-x1: 0px;
    property <length> sel-y1: 0px;
    property <bool> nav-hidden: false;
    property <bool> middle-pan: false;
    property <bool> pointer-right: false;
    property <bool> overlay-peek: true;
    property <int> activity-gen: 0;
    property <int> hide-seen: 0;
    property <bool> chrome-on: !model.chrome-hidden && (root.overlay-peek || !model.overlay-autohide);
    property <bool> show-more: false;
    property <string> bar-tip: "";

    function bump-overlay() {
        root.overlay-peek = true;
        root.activity-gen = root.activity-gen + 1;
    }
    property <length> thumb-cell: model.thumb-size == 0 ? 64px
        : model.thumb-size == 2 ? 256px
        : 128px;
    property <length> thumb-strip-h: root.thumb-cell
        + (model.thumb-show-meta ? 42px : 6px)
        + 10px;
    property <color> canvas-bg: model.bg-kind == 1 ? #000000
        : model.bg-kind == 2 ? #ffffff
        : model.bg-kind == 3 ? #808080
        : model.bg-kind == 4 ? #707070
        : model.bg-kind == 5 ? rgb(model.bg-r, model.bg-g, model.bg-b)
        : Theme.surface-base;

    hide-chrome-timer := Timer {
        interval: 2800ms;
        running: model.overlay-autohide && root.overlay-peek && !model.chrome-hidden
            && !root.show-adjust && !root.show-filter && !root.show-annotate
            && !root.show-print && !root.show-share && model.browse-mode == 0;
        triggered => {
            if (root.activity-gen == root.hide-seen) {
                root.overlay-peek = false;
            } else {
                root.hide-seen = root.activity-gen;
            }
        }
    }

    img-keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }

        key-pressed(event) => {
            root.bump-overlay();
            if (event.text == "+" || event.text == "=") {
                root.zoom-in();
                return accept;
            }
            if (event.text == "-" || event.text == "−") {
                root.zoom-out();
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                if (event.modifiers.shift) {
                    root.show-filter = !root.show-filter;
                    if (root.show-filter) { root.show-adjust = false; root.show-annotate = false; root.show-print = false; root.show-share = false; }
                } else {
                    root.fit();
                }
                return accept;
            }
            if (event.text == "1") {
                root.actual-size();
                return accept;
            }
            if (event.text == "w" || event.text == "W") {
                root.command("fit-width");
                return accept;
            }
            if (event.text == "e" || event.text == "E") {
                root.command("fit-height");
                return accept;
            }
            if (event.text == "0") {
                root.command("fit-shrink");
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                root.command("bg-next");
                return accept;
            }
            if (event.text == Key.F5) {
                root.command("slideshow");
                return accept;
            }
            if (event.text == Key.F11) {
                root.command("fullscreen");
                return accept;
            }
            if (event.text == "k" || event.text == "K") {
                root.command("kiosk");
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                if (event.modifiers.shift) {
                    root.command("slideshow-music");
                } else {
                    root.command("next-monitor");
                }
                return accept;
            }
            if (event.text == Key.Escape && model.slideshow-playing) {
                root.command("slideshow-stop");
                return accept;
            }
            if (event.text == Key.Escape && model.browse-mode != 0) {
                root.command("browse-off");
                return accept;
            }
            if (event.text == Key.Escape && (model.chrome-hidden || model.kiosk)) {
                root.command("exit-immersive");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "t" || event.text == "T")) {
                root.command("browse-timeline");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "m" || event.text == "M")) {
                root.command("browse-map");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "c" || event.text == "C")) {
                root.command("browse-calendar");
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (event.modifiers.alt) {
                    root.command("lossless-folder:cw");
                } else if (event.modifiers.shift) {
                    root.command("lossless-ccw");
                } else {
                    root.command("lossless-cw");
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "u" || event.text == "U")) {
                root.command("lossless-180");
                return accept;
            }
            if (event.modifiers.control && (event.text == "e" || event.text == "E")) {
                if (event.modifiers.shift) {
                    root.command("lossless-folder:exif");
                } else {
                    root.command("lossless-exif");
                }
                return accept;
            }
            if (event.modifiers.control && event.modifiers.alt && (event.text == "h" || event.text == "H")) {
                root.command("lossless-flip-h");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.alt && (event.text == "v" || event.text == "V")) {
                root.command("lossless-flip-v");
                return accept;
            }
            if (!event.modifiers.control && (event.text == "c" || event.text == "C")) {
                if (event.modifiers.shift) {
                    root.select-edit-crop = !root.select-edit-crop;
                    root.select-crop = false;
                } else {
                    root.select-crop = !root.select-crop;
                    root.select-edit-crop = false;
                }
                return accept;
            }
            if (event.modifiers.shift && (event.text == "a" || event.text == "A")) {
                if (root.crop-aspect < 0.5) { root.crop-aspect = 1; }
                else if (root.crop-aspect < 1.1) { root.crop-aspect = 1.333333; }
                else if (root.crop-aspect < 1.4) { root.crop-aspect = 1.5; }
                else if (root.crop-aspect < 1.6) { root.crop-aspect = 1.777778; }
                else { root.crop-aspect = 0; }
                return accept;
            }
            if (event.modifiers.shift && (event.text == "k" || event.text == "K")) {
                root.crop-keep = (root.crop-keep + 1) > 2 ? 0 : root.crop-keep + 1;
                return accept;
            }
            if (event.modifiers.shift && event.text == "/") {
                root.select-straighten = !root.select-straighten;
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "a" || event.text == "A")) {
                root.command("edit-auto-straighten");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.alt && (event.text == "p" || event.text == "P")) {
                root.select-perspective = !root.select-perspective;
                root.persp-n = 0;
                return accept;
            }
            if (event.text == "r" || event.text == "R") {
                if (event.modifiers.shift) {
                    root.rotate-ccw();
                } else {
                    root.rotate-cw();
                }
                return accept;
            }
            if (event.text == "u" || event.text == "U") {
                root.command("rotate-180");
                return accept;
            }
            if (event.text == "x" || event.text == "X") {
                root.command("reset-transform");
                return accept;
            }
            if (event.text == "[") {
                root.command(event.modifiers.shift ? "rotate-by:-15" : "rotate-by:-1");
                return accept;
            }
            if (event.text == "]") {
                root.command(event.modifiers.shift ? "rotate-by:15" : "rotate-by:1");
                return accept;
            }
            if (event.text == "v" || event.text == "V") {
                root.flip-v();
                return accept;
            }
            if (event.text == Key.Space) {
                if (model.slideshow-playing) {
                    root.command("slideshow-pause");
                } else if (model.anim-can-play && model.anim-count > 1) {
                    root.command("anim-toggle");
                } else {
                    root.command("next");
                }
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.command("next");
                return accept;
            }
            if (event.text == Key.PageUp || event.text == Key.Backspace) {
                root.command("prev");
                return accept;
            }
            if (event.text == Key.Home) {
                root.command("first");
                return accept;
            }
            if (event.text == Key.End) {
                root.command("last");
                return accept;
            }
            if (event.text == "*" ) {
                root.command("random");
                return accept;
            }
            if (event.text == "l" || event.text == "L") {
                if (event.modifiers.shift) {
                    root.show-adjust = !root.show-adjust;
                    if (root.show-adjust) { root.show-filter = false; root.show-annotate = false; root.show-print = false; root.show-share = false; }
                } else {
                    root.command("loop");
                }
                return accept;
            }
            if (event.text == "o" || event.text == "O") {
                if (event.modifiers.control && event.modifiers.shift) {
                    root.command("meta-overlay");
                } else if (event.modifiers.shift) {
                    root.command("slideshow-overlay");
                } else {
                    root.command("reveal-folder");
                }
                return accept;
            }
            if (event.text == "z" || event.text == "Z") {
                root.command("lens");
                return accept;
            }
            if (event.modifiers.control && event.modifiers.shift && (event.text == "s" || event.text == "S")) {
                root.command("export:" + root.export-spec());
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.command("copy-image");
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.alt && (event.text == "v" || event.text == "V")) {
                root.command("paste-image");
                return accept;
            }
            if (event.text == "s" || event.text == "S") {
                if (event.modifiers.shift) {
                    root.show-share = !root.show-share;
                    if (root.show-share) { root.show-adjust = false; root.show-filter = false; root.show-annotate = false; root.show-print = false; }
                } else {
                    root.select-zoom = !root.select-zoom;
                }
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                root.nav-hidden = !root.nav-hidden;
                return accept;
            }
            if (event.text == "t" || event.text == "T") {
                root.command("thumbs");
                return accept;
            }
            if (event.text == "g" || event.text == "G") {
                root.command("thumb-grid");
                return accept;
            }
            if (event.text == "d" || event.text == "D") {
                if (event.modifiers.shift) {
                    root.show-annotate = !root.show-annotate;
                    if (root.show-annotate) { root.show-adjust = false; root.show-filter = false; root.show-print = false; root.show-share = false; }
                    else { root.ann-mode = 0; }
                } else {
                    root.command("thumb-size");
                }
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                if (event.modifiers.shift) {
                    root.command("meta-panel");
                } else {
                    root.command("thumb-meta");
                }
                return accept;
            }
            if (event.text == "p" || event.text == "P") {
                if (event.modifiers.control && event.modifiers.shift) {
                    root.command("slideshow-export-html");
                } else if (event.modifiers.control) {
                    root.command("print:" + root.print-spec());
                } else if (event.modifiers.shift) {
                    root.show-print = !root.show-print;
                    if (root.show-print) { root.show-adjust = false; root.show-filter = false; root.show-annotate = false; root.show-share = false; }
                } else {
                    root.command("contact-sheet");
                }
                return accept;
            }
            if (event.text == "y" || event.text == "Y") {
                root.command("slideshow-random");
                return accept;
            }
            if (event.text == "j" || event.text == "J") {
                if (event.modifiers.shift) {
                    root.command("slideshow-trans-ms");
                } else {
                    root.command("slideshow-transition");
                }
                return accept;
            }
            if (event.text == ",") {
                root.command("slideshow-slower");
                return accept;
            }
            if (event.text == ".") {
                root.command("slideshow-faster");
                return accept;
            }
            if (event.text == "h" || event.text == "H") {
                if (event.modifiers.control) {
                    root.command("hist-mode");
                    return accept;
                }
                // H is flip when not Shift? Keep H as flip; use Shift+H for recent.
                if (event.modifiers.shift) {
                    root.show-recent = !root.show-recent;
                    return accept;
                }
                root.flip-h();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.shift && model.anim-count > 1) {
                    root.command("anim-prev");
                } else if (model.fit-mode == 0) {
                    root.pan(root.pan-step, 0px);
                } else {
                    root.command("prev");
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.shift && model.anim-count > 1) {
                    root.command("anim-next");
                } else if (model.fit-mode == 0) {
                    root.pan(-root.pan-step, 0px);
                } else {
                    root.command("next");
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.pan(0px, root.pan-step);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.pan(0px, -root.pan-step);
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        spacing: 0;

        if root.chrome-on : Rectangle {
            height: 52px;
            background: Theme.surface-base;
            border-radius: Theme.radius-md;
            clip: true;

            VerticalLayout {
                spacing: 0;

                bar-flick := Flickable {
                    height: 36px;
                    viewport-height: 36px;
                    viewport-width: max(self.width, bar-row.preferred-width);

                    bar-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: start;

                ImageToolBtn {
                    icon-id: "zoom-out";
                    tip: Strings.viewer-image-zoom-out;
                    clicked => {
                        root.zoom-out();
                        img-keys.focus();
                    }
                }

                Rectangle {
                    width: 56px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    zoom-pct := TextInput {
                        text: "" + floor(model.zoom * 100);
                        input-type: number;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accepted => {
                            root.command("zoom:" + self.text);
                            img-keys.focus();
                        }
                    }
                }

                ImageToolBtn {
                    icon-id: "zoom-sel";
                    tip: model.zoom-selection-label;
                    active: root.select-zoom;
                    clicked => { root.select-zoom = !root.select-zoom; img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "lens";
                    tip: model.lens-label;
                    active: model.lens;
                    clicked => { root.command("lens"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "zoom-in";
                    tip: Strings.viewer-image-zoom-in;
                    clicked => {
                        root.zoom-in();
                        img-keys.focus();
                    }
                }

                Rectangle { width: 8px; }

                ImageToolBtn {
                    icon-id: "more";
                    tip: model.more-label;
                    active: root.show-more;
                    clicked => { root.show-more = !root.show-more; img-keys.focus(); }
                }

                Rectangle { width: 8px; }

                ImageToolBtn {
                    icon-id: "prev";
                    tip: model.prev-label;
                    clicked => { root.command("prev"); img-keys.focus(); }
                }

                Rectangle {
                    min-width: 48px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    goto-in := TextInput {
                        text: "" + model.folder-index;
                        input-type: number;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accepted => {
                            root.command("goto:" + self.text);
                            img-keys.focus();
                        }
                    }
                }

                Text {
                    text: "/ " + model.folder-count;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                ImageToolBtn {
                    icon-id: "next";
                    tip: model.next-label;
                    clicked => { root.command("next"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "first";
                    tip: model.first-label;
                    clicked => { root.command("first"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "last";
                    tip: model.last-label;
                    clicked => { root.command("last"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "random";
                    tip: model.random-label;
                    clicked => { root.command("random"); img-keys.focus(); }
                }

                if root.show-more : HorizontalLayout {
                    spacing: 4px;

                ImageToolBtn {
                    icon-id: "loop";
                    tip: model.loop-label;
                    active: model.loop-folder;
                    clicked => { root.command("loop"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "folder";
                    tip: model.folder-label;
                    clicked => { root.command("reveal-folder"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "recent";
                    tip: model.recent-label;
                    active: root.show-recent;
                    clicked => { root.show-recent = !root.show-recent; img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "thumbs";
                    tip: model.thumbs-label;
                    active: model.thumb-strip != 0;
                    clicked => { root.command("thumbs"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "grid";
                    tip: model.thumb-grid-label;
                    active: model.thumb-grid;
                    clicked => { root.command("thumb-grid"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "timeline";
                    tip: model.timeline-label;
                    active: model.browse-mode == 1;
                    clicked => { root.command("browse-timeline"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "map";
                    tip: model.map-view-label;
                    active: model.browse-mode == 2;
                    clicked => { root.command("browse-map"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "calendar";
                    tip: model.calendar-label;
                    active: model.browse-mode == 3;
                    clicked => { root.command("browse-calendar"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "autohide";
                    tip: model.overlay-autohide-label;
                    active: model.overlay-autohide;
                    clicked => { root.command("overlay-autohide"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "thumb-size";
                    tip: model.thumb-size-label;
                    clicked => { root.command("thumb-size"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "thumb-meta";
                    tip: model.thumb-meta-label;
                    active: model.thumb-show-meta;
                    clicked => { root.command("thumb-meta"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "contact";
                    tip: model.contact-sheet-label;
                    clicked => { root.command("contact-sheet"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "meta";
                    tip: model.meta-label;
                    active: model.meta-panel;
                    clicked => { root.command("meta-panel"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "overlay";
                    tip: model.meta-overlay-label;
                    active: model.meta-overlay;
                    clicked => { root.command("meta-overlay"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "histogram";
                    tip: model.histogram-label;
                    clicked => { root.command("hist-mode"); img-keys.focus(); }
                }
                }

                Rectangle { width: 8px; }

                ImageToolBtn {
                    icon-id: "play";
                    tip: model.slideshow-label;
                    active: model.slideshow-playing;
                    clicked => { root.command("slideshow"); img-keys.focus(); }
                }
                if model.slideshow-playing : ImageToolBtn {
     icon-id: "pause";
     tip: model.slideshow-pause-label;
     active: model.slideshow-paused;
     clicked => { root.command("slideshow-pause"); img-keys.focus(); }
 }
                if model.slideshow-playing : HorizontalLayout {
                    spacing: 4px;
                ImageToolBtn {
                    icon-id: "speed";
                    tip: model.slideshow-speed-label;
                    clicked => { root.command("slideshow-faster"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "slide-random";
                    tip: model.slideshow-random-label;
                    active: model.slideshow-random;
                    clicked => { root.command("slideshow-random"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "transition";
                    tip: model.slideshow-transition-label;
                    clicked => { root.command("slideshow-transition"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "slide-overlay";
                    tip: model.slideshow-overlay-label;
                    active: model.slideshow-overlay;
                    clicked => { root.command("slideshow-overlay"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "music";
                    tip: model.slideshow-music-label;
                    active: model.slideshow-music != "";
                    clicked => { root.command("slideshow-music"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "export-html";
                    tip: model.slideshow-export-html-label;
                    clicked => { root.command("slideshow-export-html"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "export-video";
                    tip: model.slideshow-export-video-label;
                    clicked => { root.command("slideshow-export-video"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "export-exe";
                    tip: model.slideshow-export-exe-label;
                    clicked => { root.command("slideshow-export-exe"); img-keys.focus(); }
                }
                ImageToolBtn {
                    icon-id: "export-scr";
                    tip: model.slideshow-export-scr-label;
                    clicked => { root.command("slideshow-export-scr"); img-keys.focus(); }
                }
                }

                Rectangle { width: 8px; }

                ImageToolBtn {
                    icon-id: "fit";
                    tip: model.fit-label;
                    active: model.fit-mode == 1;
                    clicked => {
                            root.fit();
                            img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "fit-width";
                    tip: model.fit-width-label;
                    active: model.fit-mode == 2;
                    clicked => {
                        root.command("fit-width");
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "fit-height";
                    tip: model.fit-height-label;
                    active: model.fit-mode == 3;
                    clicked => {
                        root.command("fit-height");
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "fit-shrink";
                    tip: model.fit-shrink-label;
                    active: model.fit-mode == 4;
                    clicked => {
                        root.command("fit-shrink");
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "actual";
                    tip: model.actual-size-label;
                    active: model.fit-mode == 0;
                    clicked => {
                            root.actual-size();
                            img-keys.focus();
                    }
                }

                Rectangle { width: 8px; }

                ImageToolBtn {
                    icon-id: "rotate-cw";
                    tip: Strings.viewer-image-rotate-cw;
                    clicked => {
                            root.rotate-cw();
                            img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "rotate-ccw";
                    tip: Strings.viewer-image-rotate-ccw;
                    clicked => {
                            root.rotate-ccw();
                            img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "rotate-180";
                    tip: model.rotate-180-label;
                    clicked => { root.command("rotate-180"); img-keys.focus(); }
                }

                Rectangle {
                    width: 48px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    rot-in := TextInput {
                        text: "" + floor(model.rotation-deg);
                        input-type: number;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accepted => {
                            root.command("rotate:" + self.text);
                            img-keys.focus();
                        }
                    }
                }

                ImageToolBtn {
                    icon-id: "reset";
                    tip: model.reset-transform-label;
                    clicked => { root.command("reset-transform"); img-keys.focus(); }
                }

                if root.show-more : HorizontalLayout {
                    spacing: 4px;
                ImageToolBtn {
                    icon-id: "ll-rotate";
                    tip: model.lossless-rotate-label;
                    clicked => { root.command("lossless-cw"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "ll-flip";
                    tip: model.lossless-flip-label;
                    clicked => { root.command("lossless-flip-h"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "crop";
                    tip: model.lossless-crop-label;
                    active: root.select-crop;
                    clicked => { root.select-crop = !root.select-crop; img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "edit-crop";
                    tip: model.edit-crop-label;
                    active: root.select-edit-crop;
                    clicked => { root.select-edit-crop = !root.select-edit-crop; root.select-crop = false; img-keys.focus(); }
                }

                Chip {
                    y: (parent.height - self.height) / 2;
                    text: root.crop-aspect < 0.5 ? "free"
                        : root.crop-aspect < 1.1 ? "1:1"
                        : root.crop-aspect < 1.4 ? "4:3"
                        : root.crop-aspect < 1.6 ? "3:2"
                        : "16:9";
                    selected: root.crop-aspect >= 0.5;
                    clicked => {
                        if (root.crop-aspect < 0.5) { root.crop-aspect = 1; }
                        else if (root.crop-aspect < 1.1) { root.crop-aspect = 1.333333; }
                        else if (root.crop-aspect < 1.4) { root.crop-aspect = 1.5; }
                        else if (root.crop-aspect < 1.6) { root.crop-aspect = 1.777778; }
                        else { root.crop-aspect = 0; }
                        img-keys.focus();
                    }
                }

                Chip {
                    y: (parent.height - self.height) / 2;
                    text: root.crop-keep == 1 ? "W" : root.crop-keep == 2 ? "H" : "·";
                    selected: root.crop-keep > 0;
                    clicked => { root.crop-keep = (root.crop-keep + 1) > 2 ? 0 : root.crop-keep + 1; img-keys.focus(); }
                }

                Rectangle {
                    width: 72px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    ed-resize-in := TextInput {
                        text: "50%";
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accepted => { root.command("edit-resize:" + self.text); img-keys.focus(); }
                    }
                }

                Rectangle {
                    width: 72px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    ed-canvas-in := TextInput {
                        text: "+40+40";
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accepted => { root.command("edit-canvas:" + self.text); img-keys.focus(); }
                    }
                }

                ImageToolBtn {
                    icon-id: "straighten";
                    tip: model.edit-straighten-label;
                    active: root.select-straighten;
                    clicked => { root.select-straighten = !root.select-straighten; img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "auto-straighten";
                    tip: model.edit-auto-straighten-label;
                    clicked => { root.command("edit-auto-straighten"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "perspective";
                    tip: model.edit-perspective-label;
                    active: root.select-perspective;
                    clicked => { root.select-perspective = !root.select-perspective; root.persp-n = 0; img-keys.focus(); }
                }
                }

                ImageToolBtn {
                    icon-id: "adjust";
                    tip: model.adjust-label;
                    active: root.show-adjust;
                    clicked => {
                        root.show-adjust = !root.show-adjust;
                        if (root.show-adjust) { root.show-filter = false; root.show-annotate = false; root.show-print = false; root.show-share = false; }
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "filter";
                    tip: model.filter-label;
                    active: root.show-filter;
                    clicked => {
                        root.show-filter = !root.show-filter;
                        if (root.show-filter) { root.show-adjust = false; root.show-annotate = false; root.show-print = false; root.show-share = false; }
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "annotate";
                    tip: model.annotate-label;
                    active: root.show-annotate;
                    clicked => {
                        root.show-annotate = !root.show-annotate;
                        if (root.show-annotate) { root.show-adjust = false; root.show-filter = false; root.show-print = false; root.show-share = false; }
                        else { root.ann-mode = 0; }
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "print";
                    tip: model.print-label;
                    active: root.show-print;
                    clicked => {
                        root.show-print = !root.show-print;
                        if (root.show-print) { root.show-adjust = false; root.show-filter = false; root.show-annotate = false; root.show-share = false; }
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "export";
                    tip: model.export-label;
                    active: root.show-share;
                    clicked => {
                        root.show-share = !root.show-share;
                        if (root.show-share) { root.show-adjust = false; root.show-filter = false; root.show-annotate = false; root.show-print = false; }
                        img-keys.focus();
                    }
                }

                if model.anim-count > 1 && model.anim-can-play : ImageToolBtn {
                    icon-id: model.anim-playing ? "pause" : "play";
                    tip: "";
                    active: model.anim-playing;
                    clicked => { root.command("anim-toggle"); img-keys.focus(); }
                }

                if root.show-more : HorizontalLayout {
                    spacing: 4px;
                ImageToolBtn {
                    icon-id: "exif";
                    tip: model.lossless-exif-label;
                    clicked => { root.command("lossless-exif"); img-keys.focus(); }
                }

                ImageToolBtn {
                    icon-id: "ll-folder";
                    tip: model.lossless-folder-label;
                    clicked => { root.command("lossless-folder:cw"); img-keys.focus(); }
                }
                }

                Rectangle { width: 8px; }

                ImageToolBtn {
                    icon-id: "flip-h";
                    tip: Strings.viewer-image-flip-h;
                    active: model.flipped-h;
                    clicked => {
                        root.flip-h();
                        img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "flip-v";
                    tip: Strings.viewer-image-flip-v;
                    active: model.flipped-v;
                    clicked => {
                        root.flip-v();
                        img-keys.focus();
                    }
                }

                Rectangle { width: 8px; }

                if root.show-more : HorizontalLayout {
                    spacing: 4px;
                ImageToolBtn {
                    icon-id: "bg";
                    tip: model.bg-label;
                    active: model.bg-kind != 0;
                    clicked => {
                            root.command("bg-next");
                            img-keys.focus();
                    }
                }
                }

                ImageToolBtn {
                    icon-id: "fullscreen";
                    tip: model.fullscreen-label;
                    active: model.chrome-hidden;
                    clicked => {
                            root.command("fullscreen");
                            img-keys.focus();
                    }
                }

                if root.show-more : HorizontalLayout {
                    spacing: 4px;
                ImageToolBtn {
                    icon-id: "kiosk";
                    tip: model.kiosk-label;
                    active: model.kiosk;
                    clicked => {
                            root.command("kiosk");
                            img-keys.focus();
                    }
                }

                ImageToolBtn {
                    icon-id: "monitor";
                    tip: model.next-monitor-label;
                    clicked => {
                            root.command("next-monitor");
                            img-keys.focus();
                    }
                }
                }
                    }
                }

                Rectangle {
                    height: 16px;
                    Text {
                        text: root.bar-tip;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        x: 10px;
                    }
                }
            }
        }

        if model.thumb-strip == 2 && root.chrome-on && !model.thumb-grid && model.browse-mode == 0 && !model.slideshow-playing && model.thumbs.length > 0 : Rectangle {
            height: root.thumb-strip-h;
            background: Theme.surface-base;
            thumb-strip-top := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: max(self.width, model.thumbs.length * (root.thumb-cell + 10px) + 8px);
                viewport-height: self.height;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 6px;
                    for item in model.thumbs : Rectangle {
                        width: root.thumb-cell + 4px;
                        height: parent.height - 8px;
                        background: item.selected ? Theme.surface-raised : transparent;
                        border-radius: Theme.radius-md;
                        border-width: item.selected ? 2px : 0px;
                        border-color: Theme.accent-brand;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 2px;
                            Image {
                                source: item.thumbnail;
                                width: root.thumb-cell;
                                height: root.thumb-cell;
                                image-fit: contain;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.size-text + " · " + item.date-text;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta && item.rating > 0 : Text {
                                text: root.rating-stars(item.rating);
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.command("goto:" + item.index);
                                img-keys.focus();
                            }
                        }
                    }
                }
            }
        }

        canvas := Rectangle {
            background: root.canvas-bg;
            vertical-stretch: 1;
            clip: true;

            property <length> img-left: (self.width - model.width-px * 1px * model.zoom) / 2 + model.pan-x;
            property <length> img-top: (self.height - model.height-px * 1px * model.zoom) / 2 + model.pan-y;
            property <bool> overflows: model.width-px * 1px * model.zoom > self.width + 4px
                || model.height-px * 1px * model.zoom > self.height + 4px;

            property <float> slide-t: model.slideshow-playing && model.prev-width-px > 0 && model.slideshow-transition-ms > 0
                ? min(1.0, model.slideshow-gen * 50.0 / model.slideshow-transition-ms)
                : 1.0;

            if model.slideshow-playing && model.prev-width-px > 0 && model.slideshow-transition != 0 : Image {
                source: model.prev-rgba-image;
                x: canvas.img-left + (model.slideshow-transition == 2 ? canvas.width * canvas.slide-t : 0px);
                y: canvas.img-top;
                width: model.width-px * 1px * model.zoom;
                height: model.height-px * 1px * model.zoom;
                image-fit: fill;
                opacity: model.slideshow-transition == 4 ? 1.0 : (1.0 - canvas.slide-t);
                transform-rotation: model.rotation-deg * 1deg;
            }

            if model.slideshow-playing && model.slideshow-transition == 4 : Rectangle {
                x: canvas.img-left;
                y: canvas.img-top;
                width: model.width-px * 1px * model.zoom * canvas.slide-t;
                height: model.height-px * 1px * model.zoom;
                clip: true;
                Image {
                    source: model.rgba-image;
                    width: model.width-px * 1px * model.zoom;
                    height: model.height-px * 1px * model.zoom;
                    image-fit: fill;
                    transform-rotation: model.rotation-deg * 1deg;
                    transform-scale-x: model.flipped-h ? -1 : 1;
                    transform-scale-y: model.flipped-v ? -1 : 1;
                }
            }

            if !(model.slideshow-playing && model.slideshow-transition == 4) : Image {
                source: model.rgba-image;
                x: canvas.img-left - (model.slideshow-playing && model.slideshow-transition == 2
                    ? canvas.width * (1.0 - canvas.slide-t) : 0px);
                y: canvas.img-top;
                width: model.width-px * 1px * model.zoom;
                height: model.height-px * 1px * model.zoom;
                image-fit: fill;
                opacity: !model.slideshow-playing || model.slideshow-transition == 0
                    ? 1.0
                    : canvas.slide-t;
                transform-rotation: model.rotation-deg * 1deg;
                transform-scale-x: model.flipped-h ? -1 : 1;
                transform-scale-y: model.flipped-v ? -1 : 1;
            }

            if model.meta-overlay && model.meta-overlay-text != "" : Rectangle {
                x: 16px;
                y: 16px;
                width: min(parent.width - 32px, meta-ovl.preferred-width + 20px);
                height: meta-ovl.preferred-height + 12px;
                background: #000000aa;
                border-radius: Theme.radius-md;
                z: 25;
                meta-ovl := Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    text: model.meta-overlay-text;
                    color: #ffffff;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }

            if model.slideshow-playing && model.slideshow-overlay && model.slideshow-overlay-text != "" : Rectangle {
                x: 16px;
                y: parent.height - self.height - 16px;
                width: min(parent.width - 32px, ovl-txt.preferred-width + 20px);
                height: ovl-txt.preferred-height + 12px;
                background: #000000aa;
                border-radius: Theme.radius-md;
                ovl-txt := Text {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    text: model.slideshow-overlay-text;
                    color: #ffffff;
                    font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }

            pan-area := TouchArea {
                width: parent.width;
                height: parent.height;
                double-clicked => {
                    if (model.fit-mode == 0) { root.fit(); } else { root.actual-size(); }
                    img-keys.focus();
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.bump-overlay();
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                        root.swipe-x = self.mouse-x;
                        root.swipe-y = self.mouse-y;
                        root.middle-pan = e.button == PointerEventButton.middle;
                        root.pointer-right = e.button == PointerEventButton.right;
                        if (root.select-perspective) {
                            if (root.persp-n == 0) { root.persp-x0 = self.mouse-x; root.persp-y0 = self.mouse-y; }
                            if (root.persp-n == 1) { root.persp-x1 = self.mouse-x; root.persp-y1 = self.mouse-y; }
                            if (root.persp-n == 2) { root.persp-x2 = self.mouse-x; root.persp-y2 = self.mouse-y; }
                            if (root.persp-n == 3) {
                                root.command("edit-perspective:"
                                    + (root.persp-x0 / 1px) + ":" + (root.persp-y0 / 1px) + ":"
                                    + (root.persp-x1 / 1px) + ":" + (root.persp-y1 / 1px) + ":"
                                    + (root.persp-x2 / 1px) + ":" + (root.persp-y2 / 1px) + ":"
                                    + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                                root.select-perspective = false;
                                root.persp-n = 0;
                            } else {
                                root.persp-n = root.persp-n + 1;
                            }
                        } else if (root.ann-mode == 5) {
                            if (root.poly-pts == "") {
                                root.poly-pts = (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                            } else {
                                root.poly-pts = root.poly-pts + " " + (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                            }
                        } else if (root.ann-mode == 6) {
                            root.pen-pts = (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                            root.selecting = true;
                        } else if (root.ann-mode == 7) {
                            root.command("annotate-view:text:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px) + " | text=" + root.ann-text + " | " + root.ann-style());
                        } else if (root.ann-mode == 8) {
                            root.command("annotate-view:callout:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px) + " | callout=" + root.ann-text + " | w=180 | h=72 | " + root.ann-style());
                        } else if (root.ann-mode >= 1) {
                            root.selecting = true;
                            root.sel-x0 = self.mouse-x;
                            root.sel-y0 = self.mouse-y;
                            root.sel-x1 = self.mouse-x;
                            root.sel-y1 = self.mouse-y;
                        } else if (e.modifiers.shift || root.select-zoom || root.select-crop || root.select-edit-crop || root.select-straighten) {
                            root.selecting = true;
                            root.sel-x0 = self.mouse-x;
                            root.sel-y0 = self.mouse-y;
                            root.sel-x1 = self.mouse-x;
                            root.sel-y1 = self.mouse-y;
                        }
                        img-keys.focus();
                    }
                    if (e.kind == PointerEventKind.up) {
                        root.middle-pan = false;
                        if (root.selecting && root.ann-mode == 6) {
                            root.command("annotate-view:pen:" + root.pen-pts + " | " + root.ann-style());
                            root.pen-pts = "";
                            root.selecting = false;
                        } else if (root.selecting && root.ann-mode >= 1 && root.ann-mode <= 4) {
                            root.command("annotate-view:" + (root.ann-mode == 1 ? "line" : root.ann-mode == 2 ? "arrow" : root.ann-mode == 3 ? "rect" : "ellipse")
                                + ":" + (root.sel-x0 / 1px) + ":" + (root.sel-y0 / 1px) + ":" + (root.sel-x1 / 1px) + ":" + (root.sel-y1 / 1px)
                                + " | " + root.ann-style());
                            root.selecting = false;
                        } else if (root.selecting && root.ann-mode == 9) {
                            root.command("annotate-view:privacy:" + (root.sel-x0 / 1px) + ":" + (root.sel-y0 / 1px) + ":" + (root.sel-x1 / 1px) + ":" + (root.sel-y1 / 1px)
                                + " | mode=" + (root.ann-pixel ? "pixel" : "blur"));
                            root.selecting = false;
                        } else if (root.selecting && root.ann-mode == 10) {
                            root.command("annotate-view:highlight:" + (root.sel-x0 / 1px) + ":" + (root.sel-y0 / 1px) + ":" + (root.sel-x1 / 1px) + ":" + (root.sel-y1 / 1px)
                                + " | color=#ffff66 | opacity=45");
                            root.selecting = false;
                        } else if (root.selecting) {
                            if (root.select-crop) {
                                root.command("lossless-crop:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            } else if (root.select-edit-crop) {
                                root.command("edit-crop:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px) + ":"
                                    + root.crop-aspect + ":"
                                    + root.crop-keep);
                            } else if (root.select-straighten) {
                                root.command("edit-straighten:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            } else {
                                root.command("zoom-rect:"
                                    + (root.sel-x0 / 1px) + ":"
                                    + (root.sel-y0 / 1px) + ":"
                                    + (root.sel-x1 / 1px) + ":"
                                    + (root.sel-y1 / 1px));
                            }
                            root.selecting = false;
                            root.select-zoom = false;
                            root.select-crop = false;
                            root.select-edit-crop = false;
                            root.select-straighten = false;
                        } else if ((model.fit-mode != 0 || root.pointer-right)
                            && abs(self.mouse-x - root.swipe-x) > 80px
                            && abs(self.mouse-x - root.swipe-x) > abs(self.mouse-y - root.swipe-y) * 2) {
                            if (self.mouse-x - root.swipe-x < 0px) {
                                root.command("next");
                            } else {
                                root.command("prev");
                            }
                        } else if (abs(self.mouse-y - root.swipe-y) > 80px
                            && abs(self.mouse-y - root.swipe-y) > abs(self.mouse-x - root.swipe-x) * 2) {
                            root.overlay-peek = self.mouse-y - root.swipe-y > 0px;
                        } else if (model.overlay-autohide
                            && abs(self.mouse-x - root.swipe-x) < 12px
                            && abs(self.mouse-y - root.swipe-y) < 12px) {
                            root.overlay-peek = !root.overlay-peek;
                        }
                        root.pointer-right = false;
                    }
                }
                moved => {
                    if (root.selecting && self.pressed && root.ann-mode == 6) {
                        root.pen-pts = root.pen-pts + " " + (self.mouse-x / 1px) + "," + (self.mouse-y / 1px);
                    } else if (root.selecting && self.pressed) {
                        root.sel-x1 = self.mouse-x;
                        if (root.select-edit-crop && root.crop-aspect > 0.05) {
                            root.sel-y1 = root.sel-y0 + ((self.mouse-x - root.sel-x0) / 1px / root.crop-aspect) * 1px;
                        } else {
                            root.sel-y1 = self.mouse-y;
                        }
                    } else if (self.pressed && (model.fit-mode == 0 || root.middle-pan)) {
                        root.pan(self.mouse-x - root.last-mx, self.mouse-y - root.last-my);
                        root.last-mx = self.mouse-x;
                        root.last-my = self.mouse-y;
                    }
                    if (model.meta-panel || model.meta-overlay) {
                        root.command("probe:"
                            + floor((self.mouse-x - canvas.img-left) / 1px / max(0.01, model.zoom))
                            + ":"
                            + floor((self.mouse-y - canvas.img-top) / 1px / max(0.01, model.zoom)));
                    }
                }
                scroll-event(event) => {
                    if (event.modifiers.control) {
                        if (event.delta-y < 0) {
                            root.command("zoom-at:1.1:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                        } else {
                            root.command("zoom-at:0.909:" + (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
                        }
                    } else if (event.delta-y < 0 || event.delta-x < 0) {
                        root.command("next");
                    } else {
                        root.command("prev");
                    }
                    return accept;
                }
            }

            if model.anim-count > 1 && !model.slideshow-playing && root.chrome-on : ImageAnimBar {
                x: Theme.space-2;
                y: parent.height - self.height - Theme.space-2;
                width: parent.width - Theme.space-2 * 2;
                height: 86px;
                z: 40;
                model: root.model;
                command(cmd) => { root.command(cmd); img-keys.focus(); }
            }

            if root.selecting : Rectangle {
                x: min(root.sel-x0, root.sel-x1);
                y: min(root.sel-y0, root.sel-y1);
                width: abs(root.sel-x1 - root.sel-x0);
                height: abs(root.sel-y1 - root.sel-y0);
                border-width: 1px;
                border-color: Theme.accent-brand;
                background: #3d8bfd33;
                z: 20;
            }

            if model.lens : Rectangle {
                x: pan-area.mouse-x - 64px;
                y: pan-area.mouse-y - 64px;
                width: 128px;
                height: 128px;
                border-radius: 64px;
                clip: true;
                border-width: 2px;
                border-color: Theme.accent-brand;
                z: 30;
                Image {
                    source: model.rgba-image;
                    width: model.width-px * 1px * model.zoom * 2.5;
                    height: model.height-px * 1px * model.zoom * 2.5;
                    x: 64px - (pan-area.mouse-x - canvas.img-left) * 2.5;
                    y: 64px - (pan-area.mouse-y - canvas.img-top) * 2.5;
                    image-fit: fill;
                    transform-rotation: model.rotation-deg * 1deg;
                    transform-scale-x: model.flipped-h ? -1 : 1;
                    transform-scale-y: model.flipped-v ? -1 : 1;
                }
            }

            if (model.meta-panel || model.meta-overlay) && model.probe-text != "" : Rectangle {
                x: min(pan-area.mouse-x + 14px, parent.width - self.width - 8px);
                y: min(pan-area.mouse-y + 14px, parent.height - self.height - 8px);
                width: probe-txt.preferred-width + 16px;
                height: probe-txt.preferred-height + 10px;
                background: Theme.surface-floating;
                border-radius: Theme.radius-md;
                border-width: Theme.hairline;
                border-color: Theme.border-subtle;
                drop-shadow-blur: Theme.elev-2-blur;
                drop-shadow-offset-y: Theme.elev-2-y;
                drop-shadow-color: Theme.shadow-key;
                z: 60;
                probe-txt := Text {
                    x: Theme.space-2;
                    y: 5px;
                    text: model.probe-text;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    font-family: Theme.font-family-mono;
                }
            }

            if root.show-annotate : ImageAnnotatePanel {
                x: Theme.space-2;
                y: Theme.space-2;
                width: min(420px, parent.width * 0.56);
                height: min(parent.height - Theme.space-2 * 2, 480px);
                z: 56;
                model: root.model;
                ann-mode <=> root.ann-mode;
                ann-pixel <=> root.ann-pixel;
                ann-color <=> root.ann-color;
                ann-width <=> root.ann-width;
                ann-size <=> root.ann-size;
                ann-font <=> root.ann-font;
                ann-opacity <=> root.ann-opacity;
                ann-pos <=> root.ann-pos;
                ann-text <=> root.ann-text;
                ann-wm <=> root.ann-wm;
                ann-wm-path <=> root.ann-wm-path;
                poly-pts <=> root.poly-pts;
                command(cmd) => { root.command(cmd); img-keys.focus(); }
            }

            if root.show-print : ImagePrintPanel {
                x: Theme.space-2;
                y: Theme.space-2;
                width: min(400px, parent.width * 0.54);
                height: min(parent.height - Theme.space-2 * 2, 360px);
                z: 56;
                model: root.model;
                print-paper <=> root.print-paper;
                print-margin <=> root.print-margin;
                print-nup <=> root.print-nup;
                print-fit <=> root.print-fit;
                print-header <=> root.print-header;
                print-footer <=> root.print-footer;
                print-icc <=> root.print-icc;
                command(cmd) => { root.command(cmd); img-keys.focus(); }
            }

            if root.show-share : ImageSharePanel {
                x: Theme.space-2;
                y: Theme.space-2;
                width: min(420px, parent.width * 0.56);
                height: min(parent.height - Theme.space-2 * 2, 380px);
                z: 56;
                model: root.model;
                export-fmt <=> root.export-fmt;
                export-q <=> root.export-q;
                export-max <=> root.export-max;
                command(cmd) => { root.command(cmd); img-keys.focus(); }
            }

            if root.show-filter : ImageFilterPanel {
                x: Theme.space-2;
                y: Theme.space-2;
                width: min(400px, parent.width * 0.54);
                height: min(parent.height - Theme.space-2 * 2, 400px);
                z: 56;
                model: root.model;
                command(cmd) => { root.command(cmd); img-keys.focus(); }
            }

            if root.show-adjust : ImageAdjustPanel {
                x: Theme.space-2;
                y: Theme.space-2;
                width: min(380px, parent.width * 0.52);
                height: min(parent.height - Theme.space-2 * 2, 360px);
                z: 56;
                model: root.model;
                command(cmd) => { root.command(cmd); img-keys.focus(); }
            }

            if model.meta-panel : ImageMetaPanel {
                x: parent.width - self.width - Theme.space-2;
                y: Theme.space-2;
                width: min(360px, parent.width * 0.48);
                height: min(parent.height - Theme.space-2 * 2, 640px);
                z: 55;
                model: root.model;
                command(cmd) => { root.command(cmd); img-keys.focus(); }
            }

            if canvas.overflows && !root.nav-hidden : Rectangle {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                width: 140px;
                height: max(48px, 140px * model.height-px / max(1, model.width-px));
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 40;
                clip: true;

                property <float> vis-x0: max(0, (0 - canvas.img-left / 1px) / max(0.01, model.zoom * model.width-px));
                property <float> vis-y0: max(0, (0 - canvas.img-top / 1px) / max(0.01, model.zoom * model.height-px));
                property <float> vis-x1: min(1, (canvas.width / 1px - canvas.img-left / 1px) / max(0.01, model.zoom * model.width-px));
                property <float> vis-y1: min(1, (canvas.height / 1px - canvas.img-top / 1px) / max(0.01, model.zoom * model.height-px));

                Image {
                    source: model.rgba-image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                }
                Rectangle {
                    x: parent.vis-x0 * parent.width;
                    y: parent.vis-y0 * parent.height;
                    width: max(4px, (parent.vis-x1 - parent.vis-x0) * parent.width);
                    height: max(4px, (parent.vis-y1 - parent.vis-y0) * parent.height);
                    border-width: 1px;
                    border-color: Theme.accent-brand;
                    background: #3d8bfd33;
                }
                nav-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        root.command("nav-pan:" + (self.mouse-x / parent.width) + ":" + (self.mouse-y / parent.height));
                    }
                    moved => {
                        if (self.pressed) {
                            root.command("nav-pan:" + (self.mouse-x / parent.width) + ":" + (self.mouse-y / parent.height));
                        }
                    }
                }
            }

            if model.thumb-grid && model.browse-mode == 0 && !model.slideshow-playing : thumb-grid-host := Rectangle {
                width: parent.width;
                height: parent.height;
                background: root.canvas-bg;
                z: 60;
                property <int> cols: max(1, floor((self.width - 8px) / (root.thumb-cell + 16px)));
                property <length> tile-h: root.thumb-cell + (model.thumb-show-meta ? 48px : 8px);
                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: max(self.height, ceil(model.thumbs.length / thumb-grid-host.cols) * (thumb-grid-host.tile-h + 8px) + 8px);
                    for item[i] in model.thumbs : Rectangle {
                        x: 8px + mod(i, thumb-grid-host.cols) * (root.thumb-cell + 16px);
                        y: 8px + floor(i / thumb-grid-host.cols) * (thumb-grid-host.tile-h + 8px);
                        width: root.thumb-cell + 8px;
                        height: thumb-grid-host.tile-h;
                        background: item.selected ? Theme.surface-raised : Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: item.selected ? 2px : 1px;
                        border-color: item.selected ? Theme.accent-brand : Theme.border-default;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            Image {
                                source: item.thumbnail;
                                width: root.thumb-cell;
                                height: root.thumb-cell;
                                image-fit: contain;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.size-text + " · " + item.date-text;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta && item.rating > 0 : Text {
                                text: root.rating-stars(item.rating);
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.command("open-thumb:" + item.path);
                                img-keys.focus();
                            }
                        }
                    }
                }
            }

            if model.browse-mode == 1 && !model.slideshow-playing : Rectangle {
                width: parent.width;
                height: parent.height;
                background: root.canvas-bg;
                z: 61;
                if model.timeline.length == 0 : Text {
                    text: model.browse-empty-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if model.timeline.length > 0 : Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: max(self.height, model.timeline.length * 76px + 16px);
                    for item[i] in model.timeline : Rectangle {
                        x: 8px;
                        y: 8px + i * 76px;
                        width: parent.width - 16px;
                        height: 70px;
                        background: item.selected ? Theme.surface-raised : Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: item.selected ? 2px : 1px;
                        border-color: item.selected ? Theme.accent-brand : Theme.border-default;
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 10px;
                            Image {
                                source: item.thumbnail;
                                width: 58px;
                                height: 58px;
                                image-fit: contain;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: item.name; color: Theme.text-primary; font-size: Theme.font-size-sm; overflow: elide; }
                                Text { text: item.date-text + " · " + item.size-text; color: Theme.text-tertiary; font-size: Theme.font-size-sm; overflow: elide; }
                            }
                        }
                        TouchArea {
                            clicked => { root.command("open-thumb:" + item.path); img-keys.focus(); }
                        }
                    }
                }
            }

            if model.browse-mode == 2 && !model.slideshow-playing : Rectangle {
                width: parent.width;
                height: parent.height;
                background: #1a2430;
                z: 61;
                if model.map-pins.length == 0 : Text {
                    text: model.map-empty-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-md;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                for pin in model.map-pins : Rectangle {
                    x: pin.x * parent.width - 18px;
                    y: pin.y * parent.height - 18px;
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: pin.selected ? Theme.accent-brand : Theme.surface-raised;
                    border-width: 2px;
                    border-color: #ffffffaa;
                    Image {
                        source: pin.thumbnail;
                        width: 28px;
                        height: 28px;
                        x: 4px;
                        y: 4px;
                        image-fit: cover;
                    }
                    TouchArea {
                        clicked => { root.command("open-thumb:" + pin.path); img-keys.focus(); }
                    }
                }
            }

            if model.browse-mode == 3 && !model.slideshow-playing : calendar-host := Rectangle {
                width: parent.width;
                height: parent.height;
                background: root.canvas-bg;
                z: 61;
                property <length> cell-w: max(36px, (self.width - 24px) / 7);
                property <length> cell-h: max(36px, (self.height - 52px) / max(1, ceil(model.cal-days.length / 7)));
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: center;
                        IconButton {
                            icon: "chevron-left";
                            size: ControlSize.sm;
                            tooltip: model.cal-prev-label;
                            clicked => { root.command("cal-prev"); }
                        }
                        Text {
                            text: model.cal-title;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-md;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: "chevron-right";
                            size: ControlSize.sm;
                            tooltip: model.cal-next-label;
                            clicked => { root.command("cal-next"); }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        for day[i] in model.cal-days : Rectangle {
                            x: mod(i, 7) * calendar-host.cell-w;
                            y: floor(i / 7) * calendar-host.cell-h;
                            width: calendar-host.cell-w - 4px;
                            height: calendar-host.cell-h - 4px;
                            background: day.day == 0 ? transparent
                                : day.selected ? Theme.surface-raised
                                : day.count > 0 ? Theme.surface-base
                                : transparent;
                            border-radius: Theme.radius-md;
                            border-width: day.selected ? 2px : 0px;
                            border-color: Theme.accent-brand;
                            if day.day > 0 : VerticalLayout {
                                padding: 3px;
                                spacing: 2px;
                                Text {
                                    text: day.day;
                                    color: day.count > 0 ? Theme.text-primary : Theme.text-tertiary;
                                    font-size: Theme.font-size-sm;
                                }
                                if day.has-image : Image {
                                    source: day.thumbnail;
                                    height: min(48px, parent.height - 22px);
                                    image-fit: cover;
                                }
                                if day.count > 1 : Text {
                                    text: day.count;
                                    color: Theme.accent-brand;
                                    font-size: Theme.font-size-sm;
                                }
                            }
                            if day.count > 0 : TouchArea {
                                clicked => { root.command("open-thumb:" + day.path); img-keys.focus(); }
                            }
                        }
                    }
                }
            }

            if root.show-recent && model.recent-paths.length > 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: min(parent.width - 16px, 360px);
                height: min(parent.height - 16px, 8px + model.recent-paths.length * 28px);
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                z: 50;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    for p in model.recent-paths : Rectangle {
                        height: 26px;
                        background: rec-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        rec-ta := TouchArea {
                            clicked => {
                                root.command("recent:" + p);
                                root.show-recent = false;
                                img-keys.focus();
                            }
                        }
                        Text {
                            x: 8px;
                            text: p;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            width: parent.width - 16px;
                        }
                    }
                }
            }
        }

        if model.thumb-strip == 1 && root.chrome-on && !model.thumb-grid && model.browse-mode == 0 && !model.slideshow-playing && model.thumbs.length > 0 : Rectangle {
            height: root.thumb-strip-h;
            background: Theme.surface-base;
            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: max(self.width, model.thumbs.length * (root.thumb-cell + 10px) + 8px);
                viewport-height: self.height;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 6px;
                    for item in model.thumbs : Rectangle {
                        width: root.thumb-cell + 4px;
                        height: parent.height - 8px;
                        background: item.selected ? Theme.surface-raised : transparent;
                        border-radius: Theme.radius-md;
                        border-width: item.selected ? 2px : 0px;
                        border-color: Theme.accent-brand;
                        VerticalLayout {
                            padding: 2px;
                            spacing: 2px;
                            Image {
                                source: item.thumbnail;
                                width: root.thumb-cell;
                                height: root.thumb-cell;
                                image-fit: contain;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta : Text {
                                text: item.size-text + " · " + item.date-text;
                                color: Theme.text-tertiary;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                            if model.thumb-show-meta && item.rating > 0 : Text {
                                text: root.rating-stars(item.rating);
                                color: Theme.accent-brand;
                                font-size: Theme.font-size-sm;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.command("goto:" + item.index);
                                img-keys.focus();
                            }
                        }
                    }
                }
            }
        }

        if model.info-text != "" && root.chrome-on : Rectangle {
            height: 24px;
            background: Theme.surface-base;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: model.info-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    } // VerticalLayout
    } // FocusScope
}
