import { Theme } from "../../theme_global.slint";
import { ViewerSheetModel } from "../../workspace/defs.slint";

component PreviewCell inherits Rectangle {
    in property <string> cell-text;
    in property <bool> covered;
    in property <int> width-px;
    in property <bool> selected;
    in property <bool> has-fill;
    in property <int> fill-r;
    in property <int> fill-g;
    in property <int> fill-b;
    in property <bool> has-bar;
    in property <int> bar-pct;
    in property <int> bar-r;
    in property <int> bar-g;
    in property <int> bar-b;
    in property <bool> highlight;
    callback clicked();

    visible: !root.covered;
    min-width: root.covered ? 0px : root.width-px * 1px;
    property <color> scale-fill: rgb(root.fill-r, root.fill-g, root.fill-b);
    background: root.selected ? Theme.state-selected : root.has-fill ? root.scale-fill : root.highlight ? Theme.accent-muted : cell-ta.has-hover ? Theme.state-hover : Theme.surface-raised;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent-brand;

    cell-ta := TouchArea {
        clicked => { root.clicked(); }
    }

    if root.has-bar && root.bar-pct > 0 : Rectangle {
        x: 1px;
        y: 20%;
        height: 60%;
        width: root.bar-pct * 1%;
        background: rgb(root.bar-r, root.bar-g, root.bar-b);
    }

    Text {
        x: Theme.space-1;
        width: parent.width - Theme.space-1 * 2;
        text: root.cell-text;
        color: Theme.text-primary;
        font-size: Theme.font-size-sm;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component ViewerSheetView inherits Rectangle {
    in property <ViewerSheetModel> model;

    callback edit-cell(string, string, string);

    property <int> sheet-index: 0;
    property <int> sel-row: 0;
    property <int> sel-col: 0;
    property <int> sheet: min(root.sheet-index, max(root.model.sheets.length - 1, 0));
    property <int> freeze-rows: root.model.sheets.length == 0 ? 0 : root.model.sheets[root.sheet].freeze-rows;
    property <int> freeze-cols: root.model.sheets.length == 0 ? 0 : root.model.sheets[root.sheet].freeze-cols;
    property <string> cell-address: root.model.sheets[root.sheet].rows[root.sel-row].cells[root.sel-col].address;
    property <string> cell-text: root.model.sheets[root.sheet].rows[root.sel-row].cells[root.sel-col].text;
    property <string> cell-note: root.model.sheets[root.sheet].rows[root.sel-row].cells[root.sel-col].note;
    property <string> draft: root.cell-text;
    property <bool> editing: false;

    function load-draft() {
        root.editing = false;
        root.draft = root.cell-text;
    }

    function commit-cell() {
        if (root.model.sheets.length == 0 || root.draft == root.cell-text) {
            root.editing = false;
            return;
        }
        root.editing = false;
        root.edit-cell(root.model.sheets[root.sheet].name, root.cell-address, root.draft);
    }

    changed sel-row => { root.load-draft(); }
    changed sel-col => { root.load-draft(); }
    changed sheet => { root.load-draft(); }
    changed model => {
        if (!root.editing) {
            root.draft = root.cell-text;
        }
    }

    forward-focus: keys;
    background: Theme.surface-base;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow) {
                if (root.sel-col + 1 < root.model.sheets[root.sheet].rows[root.sel-row].cells.length) {
                    root.sel-col += 1;
                }
                accept
            } else if (event.text == Key.LeftArrow) {
                if (root.sel-col > 0) {
                    root.sel-col -= 1;
                }
                accept
            } else if (event.text == Key.DownArrow) {
                if (root.sel-row + 1 < root.model.sheets[root.sheet].rows.length) {
                    root.sel-row += 1;
                    if (root.sel-col >= root.model.sheets[root.sheet].rows[root.sel-row].cells.length) {
                        root.sel-col = 0;
                    }
                }
                accept
            } else if (event.text == Key.UpArrow) {
                if (root.sel-row > 0) {
                    root.sel-row -= 1;
                    if (root.sel-col >= root.model.sheets[root.sheet].rows[root.sel-row].cells.length) {
                        root.sel-col = 0;
                    }
                }
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        padding: Theme.space-2;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            Text {
                text: root.cell-address;
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
                font-family: Theme.font-family-mono;
                vertical-alignment: center;
                min-width: 48px;
            }

            if root.model.sheets.length > 0 : Rectangle {
                horizontal-stretch: 1;
                height: Theme.row-height;
                border-radius: Theme.radius-sm;
                background: Theme.surface-raised;
                border-width: Theme.hairline;
                border-color: editor.has-focus ? Theme.accent-brand : Theme.border-subtle;

                editor := TextInput {
                    x: Theme.space-2;
                    width: parent.width - Theme.space-4;
                    height: 100%;
                    text: root.draft;
                    single-line: true;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    edited => {
                        root.editing = true;
                        root.draft = self.text;
                    }
                    accepted => { root.commit-cell(); }
                }
            }

            if root.model.sheets.length > 0 : Rectangle {
                height: Theme.row-height;
                border-radius: Theme.radius-sm;
                background: save-ta.has-hover ? Theme.state-hover : Theme.surface-raised;

                save-ta := TouchArea {
                    clicked => { root.commit-cell(); }
                }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;

                    Text {
                        text: root.model.save-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.model.info;
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }
        }

        if root.model.sheets.length > 0 && root.cell-note != "" : Text {
            text: root.cell-note;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }

        if root.model.sheets.length > 0 : Text {
            text: root.model.hint-label;
            color: Theme.text-tertiary;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }

        if root.model.sheets.length > 1 : HorizontalLayout {
            spacing: Theme.space-1;
            alignment: start;

            for page[i] in root.model.sheets : Rectangle {
                height: Theme.row-height;
                border-radius: Theme.radius-sm;
                background: i == root.sheet ? Theme.state-selected : tab-ta.has-hover ? Theme.state-hover : Colors.transparent;

                tab-ta := TouchArea {
                    clicked => {
                        root.sheet-index = i;
                        root.sel-row = 0;
                        root.sel-col = 0;
                        keys.focus();
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;

                    Text {
                        text: page.name;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.model.sheets.length == 0 : Text {
            text: root.model.empty-label;
            color: Theme.text-secondary;
            font-size: Theme.font-size-md;
            vertical-stretch: 1;
        }

        if root.model.sheets.length > 0 && root.freeze-rows == 0 && root.freeze-cols == 0 : Flickable {
            vertical-stretch: 1;
            viewport-height: grid.preferred-height;
            viewport-width: grid.preferred-width;

            grid := VerticalLayout {
                alignment: start;
                spacing: 1px;

                for row[ri] in root.model.sheets[root.sheet].rows : HorizontalLayout {
                    height: Theme.row-height;
                    spacing: 1px;
                    alignment: start;

                    for cell[ci] in row.cells : PreviewCell {
                        cell-text: cell.text;
                        covered: cell.covered;
                        width-px: cell.width-px;
                        selected: ri == root.sel-row && ci == root.sel-col;
                        has-fill: cell.has-fill;
                        fill-r: cell.fill-r;
                        fill-g: cell.fill-g;
                        fill-b: cell.fill-b;
                        highlight: cell.highlight;
                        has-bar: cell.has-bar;
                        bar-pct: cell.bar-pct;
                        bar-r: cell.bar-r;
                        bar-g: cell.bar-g;
                        bar-b: cell.bar-b;
                        clicked => {
                            root.sel-row = ri;
                            root.sel-col = ci;
                            keys.focus();
                        }
                    }
                }
            }
        }

        if root.model.sheets.length > 0 && (root.freeze-rows > 0 || root.freeze-cols > 0) : VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            if root.freeze-rows > 0 : HorizontalLayout {
                spacing: 1px;
                height: root.freeze-rows * Theme.row-height + max(root.freeze-rows - 1, 0) * 1px;

                if root.freeze-cols > 0 : VerticalLayout {
                    alignment: start;
                    spacing: 1px;

                    for row[ri] in root.model.sheets[root.sheet].rows : HorizontalLayout {
                        visible: ri < root.freeze-rows;
                        height: ri < root.freeze-rows ? Theme.row-height : 0px;
                        spacing: 1px;
                        alignment: start;

                        for cell[ci] in row.cells : PreviewCell {
                            visible: ri < root.freeze-rows && ci < root.freeze-cols && !cell.covered;
                            cell-text: cell.text;
                            covered: cell.covered;
                            width-px: cell.width-px;
                            selected: ri == root.sel-row && ci == root.sel-col;
                            has-fill: cell.has-fill;
                            fill-r: cell.fill-r;
                            fill-g: cell.fill-g;
                            fill-b: cell.fill-b;
                            highlight: cell.highlight;
                        has-bar: cell.has-bar;
                        bar-pct: cell.bar-pct;
                        bar-r: cell.bar-r;
                        bar-g: cell.bar-g;
                        bar-b: cell.bar-b;
                            clicked => {
                                root.sel-row = ri;
                                root.sel-col = ci;
                                keys.focus();
                            }
                        }
                    }
                }

                top-band := Flickable {
                    horizontal-stretch: 1;
                    viewport-x: body.viewport-x;
                    viewport-height: top-grid.preferred-height;
                    viewport-width: top-grid.preferred-width;

                    top-grid := VerticalLayout {
                        alignment: start;
                        spacing: 1px;

                        for row[ri] in root.model.sheets[root.sheet].rows : HorizontalLayout {
                            visible: ri < root.freeze-rows;
                            height: ri < root.freeze-rows ? Theme.row-height : 0px;
                            spacing: 1px;
                            alignment: start;

                            for cell[ci] in row.cells : PreviewCell {
                                visible: ri < root.freeze-rows && ci >= root.freeze-cols && !cell.covered;
                                cell-text: cell.text;
                                covered: cell.covered;
                                width-px: cell.width-px;
                                selected: ri == root.sel-row && ci == root.sel-col;
                                has-fill: cell.has-fill;
                                fill-r: cell.fill-r;
                                fill-g: cell.fill-g;
                                fill-b: cell.fill-b;
                                highlight: cell.highlight;
                        has-bar: cell.has-bar;
                        bar-pct: cell.bar-pct;
                        bar-r: cell.bar-r;
                        bar-g: cell.bar-g;
                        bar-b: cell.bar-b;
                                clicked => {
                                    root.sel-row = ri;
                                    root.sel-col = ci;
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 1px;

                if root.freeze-cols > 0 : left-band := Flickable {
                    width: left-grid.preferred-width;
                    viewport-y: body.viewport-y;
                    viewport-height: left-grid.preferred-height;
                    viewport-width: left-grid.preferred-width;

                    left-grid := VerticalLayout {
                        alignment: start;
                        spacing: 1px;

                        for row[ri] in root.model.sheets[root.sheet].rows : HorizontalLayout {
                            visible: ri >= root.freeze-rows;
                            height: ri >= root.freeze-rows ? Theme.row-height : 0px;
                            spacing: 1px;
                            alignment: start;

                            for cell[ci] in row.cells : PreviewCell {
                                visible: ri >= root.freeze-rows && ci < root.freeze-cols && !cell.covered;
                                cell-text: cell.text;
                                covered: cell.covered;
                                width-px: cell.width-px;
                                selected: ri == root.sel-row && ci == root.sel-col;
                                has-fill: cell.has-fill;
                                fill-r: cell.fill-r;
                                fill-g: cell.fill-g;
                                fill-b: cell.fill-b;
                                highlight: cell.highlight;
                        has-bar: cell.has-bar;
                        bar-pct: cell.bar-pct;
                        bar-r: cell.bar-r;
                        bar-g: cell.bar-g;
                        bar-b: cell.bar-b;
                                clicked => {
                                    root.sel-row = ri;
                                    root.sel-col = ci;
                                    keys.focus();
                                }
                            }
                        }
                    }
                }

                body := Flickable {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    viewport-height: body-grid.preferred-height;
                    viewport-width: body-grid.preferred-width;

                    body-grid := VerticalLayout {
                        alignment: start;
                        spacing: 1px;

                        for row[ri] in root.model.sheets[root.sheet].rows : HorizontalLayout {
                            visible: ri >= root.freeze-rows;
                            height: ri >= root.freeze-rows ? Theme.row-height : 0px;
                            spacing: 1px;
                            alignment: start;

                            for cell[ci] in row.cells : PreviewCell {
                                visible: ri >= root.freeze-rows && ci >= root.freeze-cols && !cell.covered;
                                cell-text: cell.text;
                                covered: cell.covered;
                                width-px: cell.width-px;
                                selected: ri == root.sel-row && ci == root.sel-col;
                                has-fill: cell.has-fill;
                                fill-r: cell.fill-r;
                                fill-g: cell.fill-g;
                                fill-b: cell.fill-b;
                                highlight: cell.highlight;
                        has-bar: cell.has-bar;
                        bar-pct: cell.bar-pct;
                        bar-r: cell.bar-r;
                        bar-g: cell.bar-g;
                        bar-b: cell.bar-b;
                                clicked => {
                                    root.sel-row = ri;
                                    root.sel-col = ci;
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.model.sheets[root.sheet].truncated : Text {
            text: root.model.truncated-label;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
        }
    }
}
