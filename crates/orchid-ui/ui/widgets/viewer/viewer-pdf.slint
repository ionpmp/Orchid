import { Theme } from "../../theme_global.slint";
import { Strings } from "../../strings_global.slint";
import { ControlSize, IconButton, Tooltip } from "../../kit.slint";
import { ViewerPdfModel } from "../../workspace/defs.slint";
import { DocToolBtn } from "viewer-doc-toolbtn.slint";

export component ViewerPdfView inherits Rectangle {
    in property <ViewerPdfModel> model;

    callback prev-page();
    callback next-page();
    callback fit-width();
    callback fit-page();
    callback zoom-in();
    callback zoom-out();
    callback go-to-page(int);
    callback copy-text();
    callback extract-page();
    callback find(string, bool, int);
    callback pointer(int, float, float);
    callback outline-goto(int);
    callback print();
    callback highlight();

    background: transparent;

    property <string> page-draft: "" + model.current-page;
    property <bool> page-editing: false;
    property <bool> find-open: false;
    property <string> find-query: "";
    property <bool> find-match-case: false;
    property <bool> outline-open: false;

    changed model => {
        if !root.page-editing {
            root.page-draft = "" + model.current-page;
        }
    }

    if !model.available : VerticalLayout {
        alignment: center;
        padding: Theme.space-4;
        spacing: Theme.space-2;
        Text {
            text: model.unavailable-reason;
            color: Theme.text-secondary;
            font-size: Theme.font-size-md;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if model.available : pdf-keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }

        key-pressed(event) => {
            // Let the page-number / find fields keep arrows / digits.
            if (page-input.has-focus || find-input.has-focus) {
                return reject;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                root.find-open = true;
                find-input.focus();
                return accept;
            }
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                root.pointer(4, 0, 0);
                return accept;
            }
            if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                root.copy-text();
                return accept;
            }
            if (event.modifiers.control && (event.text == "p" || event.text == "P")) {
                root.print();
                return accept;
            }
            if (event.text == Key.PageDown || event.text == Key.RightArrow) {
                root.next-page();
                return accept;
            }
            if (event.text == Key.PageUp || event.text == Key.LeftArrow) {
                root.prev-page();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0;

            // Main chrome
            Rectangle {
                height: Theme.control-xs + Theme.space-2;
                background: Theme.surface-sunken;
                clip: false;
                z: 20;

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    alignment: start;

                    IconButton {
                        icon: "chevron-left";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: Strings.viewer-pdf-prev-page;
                        clicked => { root.prev-page(); pdf-keys.focus(); }
                    }

                    Rectangle {
                        width: 44px;
                        height: Theme.control-xs;
                        y: (parent.height - self.height) / 2;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: Theme.hairline;
                        border-color: Theme.border-default;
                        clip: true;

                        page-input := TextInput {
                            x: Theme.space-1;
                            width: parent.width - Theme.space-2;
                            height: parent.height;
                            text: root.page-draft;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            single-line: true;
                            edited => {
                                root.page-editing = true;
                                root.page-draft = self.text;
                            }
                            accepted => {
                                root.commit-page-jump();
                            }
                        }
                    }

                    Rectangle {
                        height: Theme.control-xs;
                        y: (parent.height - self.height) / 2;
                        width: max(Theme.control-xs, page-total.preferred-width + Theme.space-2);
                        clip: false;

                        page-total-ta := TouchArea { }
                        page-total := Text {
                            text: "/ " + model.page-count;
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Tooltip {
                            text: model.page-of-label;
                            shown: page-total-ta.has-hover && model.page-of-label != "";
                            x: (parent.width - self.width) / 2;
                            y: -self.height - Theme.space-2;
                        }
                    }

                    DocToolBtn {
                        label: model.go-label;
                        tip: model.go-label;
                        clicked => {
                            root.commit-page-jump();
                            pdf-keys.focus();
                        }
                    }

                    IconButton {
                        icon: "chevron-right";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: Strings.viewer-pdf-next-page;
                        clicked => { root.next-page(); pdf-keys.focus(); }
                    }

                    Rectangle {
                        width: Theme.hairline;
                        height: Theme.space-8;
                        y: (parent.height - self.height) / 2;
                        background: Theme.border-default;
                    }

                    DocToolBtn {
                        label: model.copy-text-label;
                        tip: model.copy-text-label;
                        clicked => { root.copy-text(); pdf-keys.focus(); }
                    }

                    DocToolBtn {
                        label: model.extract-page-label;
                        tip: model.extract-page-label;
                        clicked => { root.extract-page(); pdf-keys.focus(); }
                    }

                    DocToolBtn {
                        label: model.outline-label;
                        tip: model.outline-label;
                        active: root.outline-open;
                        clicked => { root.outline-open = !root.outline-open; pdf-keys.focus(); }
                    }

                    DocToolBtn {
                        label: model.find-label;
                        tip: model.find-label;
                        active: root.find-open;
                        clicked => {
                            root.find-open = !root.find-open;
                            if (root.find-open) {
                                find-input.focus();
                            } else {
                                pdf-keys.focus();
                            }
                        }
                    }

                    DocToolBtn {
                        label: model.print-label;
                        tip: model.print-label;
                        clicked => { root.print(); pdf-keys.focus(); }
                    }

                    DocToolBtn {
                        label: model.highlight-label;
                        tip: model.highlight-label;
                        enabled: model.has-selection;
                        clicked => { root.highlight(); pdf-keys.focus(); }
                    }

                    Rectangle {
                        width: Theme.hairline;
                        height: Theme.space-8;
                        y: (parent.height - self.height) / 2;
                        background: Theme.border-default;
                    }

                    DocToolBtn {
                        label: model.fit-width-label;
                        tip: model.fit-width-label;
                        active: model.fit-mode == 0;
                        clicked => { root.fit-width(); }
                    }

                    DocToolBtn {
                        label: model.fit-page-label;
                        tip: model.fit-page-label;
                        active: model.fit-mode == 1;
                        clicked => { root.fit-page(); }
                    }

                    Rectangle {
                        width: Theme.hairline;
                        height: Theme.space-8;
                        y: (parent.height - self.height) / 2;
                        background: Theme.border-default;
                    }

                    IconButton {
                        icon: "plus";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: Strings.viewer-image-zoom-in;
                        clicked => { root.zoom-in(); }
                    }

                    IconButton {
                        icon: "minus";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: Strings.viewer-image-zoom-out;
                        clicked => { root.zoom-out(); }
                    }
                }
            }

            Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

            // Find bar
            Rectangle {
                height: root.find-open ? Theme.control-xs + Theme.space-2 : 0px;
                clip: true;
                background: Theme.surface-sunken;

                animate height { duration: Theme.motion-fast; easing: ease-out; }

                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    alignment: center;

                    Text {
                        text: model.find-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.control-xs;
                        y: (parent.height - self.height) / 2;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: Theme.hairline;
                        border-color: Theme.border-default;

                        if root.find-query == "" : Text {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: 100%;
                            text: model.find-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        find-input := TextInput {
                            x: Theme.space-2;
                            width: parent.width - Theme.space-4;
                            height: 100%;
                            text <=> root.find-query;
                            single-line: true;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return) {
                                    root.find(root.find-query, root.find-match-case, event.modifiers.shift ? -1 : 0);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    pdf-keys.focus();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    IconButton {
                        icon: "chevron-up";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: model.find-label;
                        clicked => { root.find(root.find-query, root.find-match-case, -1); }
                    }

                    IconButton {
                        icon: "chevron-down";
                        size: ControlSize.xs;
                        y: (parent.height - self.height) / 2;
                        tooltip: model.find-label;
                        clicked => { root.find(root.find-query, root.find-match-case, 1); }
                    }

                    Text {
                        min-width: 36px;
                        text: root.find-query == "" ? ""
                            : model.find-match-count <= 0 ? model.find-no-match-label
                            : "\{model.find-match-index}/\{model.find-match-count}";
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    DocToolBtn {
                        label: model.match-case-label;
                        tip: model.match-case-label;
                        active: root.find-match-case;
                        clicked => { root.find-match-case = !root.find-match-case; }
                    }
                }
            }

            if root.find-open : Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

            // Page canvas + outline
            Rectangle {
                background: #80808020;
                vertical-stretch: 1;
                clip: true;

                HorizontalLayout {
                    spacing: 0;

                    if root.outline-open : Rectangle {
                        width: 200px;
                        background: Theme.surface-sunken;
                        border-width: 0px;

                        Rectangle {
                            x: parent.width - Theme.hairline;
                            width: Theme.hairline;
                            height: 100%;
                            background: Theme.border-subtle;
                        }

                        Flickable {
                            width: 100%;
                            height: 100%;
                            viewport-width: self.width;
                            VerticalLayout {
                                padding: Theme.space-2;
                                spacing: Theme.space-1;
                                for row in model.outline : TouchArea {
                                    height: Theme.control-xs - Theme.space-2;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.outline-goto(row.page); }
                                    Text {
                                        x: Theme.space-2 + row.depth * Theme.space-3;
                                        width: parent.width - Theme.space-4;
                                        height: 100%;
                                        text: row.title == "" ? "…" : row.title;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-size-sm;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Flickable {
                        horizontal-stretch: 1;
                        width: 100%;
                        height: 100%;
                        viewport-width: model.page-width-px * 1px;
                        viewport-height: model.page-height-px * 1px;

                        Image {
                            source: model.page-image;
                            width: model.page-width-px * 1px;
                            height: model.page-height-px * 1px;
                            image-fit: fill;
                        }
                        for ov in model.overlays : Rectangle {
                            x: ov.x * 1px;
                            y: ov.y * 1px;
                            width: ov.w * 1px;
                            height: ov.h * 1px;
                            background: ov.kind == 1 ? #ff980080
                                : ov.kind == 2 ? #4c8dff80
                                : ov.kind == 3 ? #ffe00066
                                : #ffe00055;
                        }
                        TouchArea {
                            width: model.page-width-px * 1px;
                            height: model.page-height-px * 1px;
                            mouse-cursor: text;
                            moved => {
                                if (self.pressed) {
                                    root.pointer(1, self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            }
                            double-clicked => {
                                root.pointer(3, self.mouse-x / 1px, self.mouse-y / 1px);
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.pointer(0, self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                                if (e.kind == PointerEventKind.up) {
                                    root.pointer(2, self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            }
                            scroll-event(event) => {
                                if (event.modifiers.control) {
                                    if (event.delta-y < 0) {
                                        root.zoom-out();
                                    } else {
                                        root.zoom-in();
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
            }

            if model.info-text != "" : Rectangle { height: Theme.hairline; background: Theme.border-subtle; }

            if model.info-text != "" : Rectangle {
                height: Theme.control-xs - Theme.space-1;
                background: Theme.surface-sunken;
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    Text {
                        text: model.info-text;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }
            }
        } // VerticalLayout
    } // FocusScope

    function commit-page-jump() {
        root.page-editing = false;
        // Digits-only parse: ignore non-numeric draft and clamp later in Rust.
        if root.page-draft == "" || !root.page-draft.is-float() {
            root.page-draft = "" + model.current-page;
            return;
        }
        root.go-to-page(Math.round(root.page-draft.to-float()));
    }
}
