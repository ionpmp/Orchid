import { Theme } from "../../theme_global.slint";
import { Tooltip } from "../../kit.slint";

/// Dense document-viewer toolbar button (NotesToolBtn pattern + Theme tokens).
export component DocToolBtn inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    accessible-role: AccessibleRole.button;
    accessible-label: tip != "" ? tip : label;
    accessible-enabled: enabled;
    accessible-action-default => { root.clicked(); }

    keys := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    width: max(Theme.control-xs, label-txt.preferred-width + Theme.space-3);
    height: Theme.control-xs;
    border-radius: Theme.radius-md;
    background: !root.enabled ? Colors.transparent :
        root.active ? Theme.accent-soft :
        ta.pressed ? Theme.state-press :
        ta.has-hover ? Theme.state-hover : Colors.transparent;
    border-width: keys.has-focus ? 2px : (root.active ? Theme.hairline : 0px);
    border-color: keys.has-focus ? Theme.border-focus : Theme.accent-muted;
    opacity: root.enabled ? 1.0 : 0.35;

    animate background, border-color { duration: Theme.motion-fast; easing: ease-out; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    label-txt := Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: !root.enabled ? Theme.text-disabled :
            root.active ? Theme.accent-brand : Theme.text-primary;
        font-size: Theme.font-size-sm;
        font-weight: root.active ? Theme.weight-semibold : Theme.weight-medium;
        font-family: Theme.font-family-sans;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Tooltip {
        text: root.tip;
        shown: ta.has-hover && root.enabled && root.tip != "";
        x: (parent.width - self.width) / 2;
        y: -self.height - Theme.space-2;
    }
}
