import { Theme } from "../../theme_global.slint";
import { ViewerDocumentModel } from "../../workspace/defs.slint";

export component ViewerDocumentView inherits Rectangle {
    in property <ViewerDocumentModel> model;

    callback action(string);
    callback text-edited(string);
    callback selection-changed(int, int);
    callback viewport-changed(length);
    /// Preview pointer: phase 0=down, 1=move, 2=up, 3=double-click word, 4=triple-click paragraph; x/y CSS px.
    callback preview-pointer(int, float, float);
    /// Preview key: token or literal text, plus ctrl/shift.
    callback preview-key(string, bool, bool);
    /// Find next (`true`) / previous (`false`) match for the local query.
    callback find-request(string, bool);
    /// Replace current (`all=false`) or all matches (`all=true`).
    callback replace-request(string, string, bool);

    background: transparent;

    property <string> draft-text: model.plain-text;
    property <bool> locally-dirty: false;
    property <string> last-path: "";
    property <length> last-viewport-w: 0px;
    property <bool> find-open: false;
    property <string> find-query: "";
    property <string> replace-query: "";

    changed model => {
        if root.last-path != model.path-display {
            root.last-path = model.path-display;
            root.draft-text = model.plain-text;
            root.locally-dirty = model.dirty;
        } else if root.draft-text == model.plain-text {
            root.locally-dirty = model.dirty;
        } else {
            root.locally-dirty = true;
        }
    }

    function tool-btn(active: bool) -> color {
        return active ? Theme.accent-brand : Theme.text-primary;
    }

    function tool-bg(active: bool, hover: bool) -> color {
        if (active) {
            return Theme.surface-raised;
        }
        return hover ? Theme.surface-raised : transparent;
    }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 36px;
            background: Theme.surface-base;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;
                alignment: start;

                Rectangle {
                    width: max(52px, save-label.preferred-width + 12px);
                    height: 28px;
                    background: (model.dirty || root.locally-dirty) ? Theme.surface-raised
                        : save-ta.has-hover ? Theme.surface-raised : transparent;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    save-ta := TouchArea { clicked => { root.action("save"); } }
                    save-label := Text {
                        text: model.save-label;
                        color: (model.dirty || root.locally-dirty)
                            ? Theme.accent-brand : Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, undo-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    opacity: model.can-undo ? 1.0 : 0.35;
                    undo-ta := TouchArea {
                        enabled: model.can-undo;
                        clicked => { root.action("undo"); }
                    }
                    Text {
                        text: model.undo-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, redo-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    opacity: model.can-redo ? 1.0 : 0.35;
                    redo-ta := TouchArea {
                        enabled: model.can-redo;
                        clicked => { root.action("redo"); }
                    }
                    Text {
                        text: model.redo-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.bold, bold-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    bold-ta := TouchArea { clicked => { root.action("bold"); } }
                    Text {
                        text: model.bold-label;
                        color: tool-btn(model.bold);
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.italic, italic-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    italic-ta := TouchArea { clicked => { root.action("italic"); } }
                    Text {
                        text: model.italic-label;
                        color: tool-btn(model.italic);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.underline, underline-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    underline-ta := TouchArea { clicked => { root.action("underline"); } }
                    Text {
                        text: model.underline-label;
                        color: tool-btn(model.underline);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.strikethrough, strike-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    strike-ta := TouchArea { clicked => { root.action("strikethrough"); } }
                    Text {
                        text: model.strikethrough-label;
                        color: tool-btn(model.strikethrough);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.highlight, hl-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    hl-ta := TouchArea { clicked => { root.action("highlight"); } }
                    Text {
                        text: model.highlight-label;
                        color: tool-btn(model.highlight);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.superscript, super-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    super-ta := TouchArea { clicked => { root.action("superscript"); } }
                    Text {
                        text: model.superscript-label;
                        color: tool-btn(model.superscript);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.subscript, sub-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    sub-ta := TouchArea { clicked => { root.action("subscript"); } }
                    Text {
                        text: model.subscript-label;
                        color: tool-btn(model.subscript);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(28px, clear-fmt-label.preferred-width + 8px);
                    height: 28px;
                    background: tool-bg(false, clear-fmt-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    clear-fmt-ta := TouchArea { clicked => { root.action("clear-formatting"); } }
                    clear-fmt-label := Text {
                        text: model.clear-formatting-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, fs-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fs-ta := TouchArea { clicked => { root.action("font-smaller"); } }
                    Text {
                        text: model.font-smaller-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(28px, size-label.preferred-width + 8px);
                    height: 28px;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    size-label := Text {
                        text: model.font-size-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, fl-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    fl-ta := TouchArea { clicked => { root.action("font-larger"); } }
                    Text {
                        text: model.font-larger-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 22px;
                    height: 28px;
                    background: tool-bg(false, ff-prev-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    ff-prev-ta := TouchArea { clicked => { root.action("font-family-prev"); } }
                    Text {
                        text: model.font-family-prev-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(64px, min(120px, family-label.preferred-width + 12px));
                    height: 28px;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    clip: true;
                    TouchArea { clicked => { root.action("font-family-next"); } }
                    family-label := Text {
                        text: model.font-family-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle {
                    width: 22px;
                    height: 28px;
                    background: tool-bg(false, ff-next-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    ff-next-ta := TouchArea { clicked => { root.action("font-family-next"); } }
                    Text {
                        text: model.font-family-next-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Colour swatches: compare against decimal `0xRRGGBB` values.
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background: #111111;
                    border-width: model.color-rgb == 1118481 || model.color-rgb == 0 ? 2px : 1px;
                    border-color: model.color-rgb == 1118481 || model.color-rgb == 0
                        ? Theme.accent-brand : Theme.border-default;
                    TouchArea { clicked => { root.action("color-111111"); } }
                }
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background: #dc2626;
                    border-width: model.color-rgb == 14423142 ? 2px : 1px;
                    border-color: model.color-rgb == 14423142
                        ? Theme.accent-brand : Theme.border-default;
                    TouchArea { clicked => { root.action("color-dc2626"); } }
                }
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background: #2563eb;
                    border-width: model.color-rgb == 2442219 ? 2px : 1px;
                    border-color: model.color-rgb == 2442219
                        ? Theme.accent-brand : Theme.border-default;
                    TouchArea { clicked => { root.action("color-2563eb"); } }
                }
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background: #16a34a;
                    border-width: model.color-rgb == 1483594 ? 2px : 1px;
                    border-color: model.color-rgb == 1483594
                        ? Theme.accent-brand : Theme.border-default;
                    TouchArea { clicked => { root.action("color-16a34a"); } }
                }

                Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.alignment == 0, al-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    al-ta := TouchArea { clicked => { root.action("align-left"); } }
                    Text {
                        text: model.align-left-label;
                        color: tool-btn(model.alignment == 0);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.alignment == 1, ac-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    ac-ta := TouchArea { clicked => { root.action("align-center"); } }
                    Text {
                        text: model.align-center-label;
                        color: tool-btn(model.alignment == 1);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.alignment == 2, ar-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    ar-ta := TouchArea { clicked => { root.action("align-right"); } }
                    Text {
                        text: model.align-right-label;
                        color: tool-btn(model.alignment == 2);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.alignment == 3, aj-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    aj-ta := TouchArea { clicked => { root.action("align-justify"); } }
                    Text {
                        text: model.align-justify-label;
                        color: tool-btn(model.alignment == 3);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.list-kind == 1, bullet-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    bullet-ta := TouchArea { clicked => { root.action("list-bullet"); } }
                    Text {
                        text: model.list-bullet-label;
                        color: tool-btn(model.list-kind == 1);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(model.list-kind == 2, num-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    num-ta := TouchArea { clicked => { root.action("list-numbered"); } }
                    Text {
                        text: model.list-numbered-label;
                        color: tool-btn(model.list-kind == 2);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                Rectangle {
                    width: max(36px, img-ins-label.preferred-width + 12px);
                    height: 28px;
                    background: tool-bg(false, img-ins.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    img-ins := TouchArea { clicked => { root.action("image-insert"); } }
                    img-ins-label := Text {
                        text: model.image-insert-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, t-ins.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    t-ins := TouchArea { clicked => { root.action("table-insert"); } }
                    Text {
                        text: model.table-insert-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, tr-ins.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    tr-ins := TouchArea { clicked => { root.action("table-row-insert"); } }
                    Text {
                        text: model.table-row-insert-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, tr-del.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    tr-del := TouchArea { clicked => { root.action("table-row-delete"); } }
                    Text {
                        text: model.table-row-delete-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, tc-ins.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    tc-ins := TouchArea { clicked => { root.action("table-col-insert"); } }
                    Text {
                        text: model.table-col-insert-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: tool-bg(false, tc-del.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    tc-del := TouchArea { clicked => { root.action("table-col-delete"); } }
                    Text {
                        text: model.table-col-delete-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                Rectangle {
                    width: max(44px, find-btn-label.preferred-width + 12px);
                    height: 28px;
                    background: tool-bg(root.find-open, find-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    find-ta := TouchArea {
                        clicked => {
                            root.find-open = !root.find-open;
                            if (root.find-open) {
                                find-input.focus();
                            }
                        }
                    }
                    find-btn-label := Text {
                        text: model.find-label;
                        color: tool-btn(root.find-open);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: max(64px, mode-label.preferred-width + 14px);
                    height: 28px;
                    background: tool-bg(model.source-mode, mode-ta.has-hover);
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    mode-ta := TouchArea { clicked => { root.action("toggle-source"); } }
                    mode-label := Text {
                        text: model.source-mode ? model.source-label : model.preview-label;
                        color: tool-btn(model.source-mode);
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if model.dirty || root.locally-dirty : Text {
                    text: "●";
                    color: #eab308;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: root.find-open ? 68px : 0px;
            clip: true;
            background: Theme.surface-raised;

            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 4px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: model.find-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        if find-input.text == "" : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: model.find-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        find-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.find-query;
                            single-line: true;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-sans;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return) {
                                    root.find-request(root.find-query, !event.modifiers.shift);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 26px;
                        background: find-prev-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        find-prev-ta := TouchArea {
                            clicked => { root.find-request(root.find-query, false); }
                        }
                        Text {
                            text: "↑";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 26px;
                        background: find-next-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        find-next-ta := TouchArea {
                            clicked => { root.find-request(root.find-query, true); }
                        }
                        Text {
                            text: "↓";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        min-width: 36px;
                        text: root.find-query == "" ? ""
                            : model.find-match-count <= 0 ? model.find-no-match-label
                            : "\{model.find-match-index}/\{model.find-match-count}";
                        color: model.find-match-count <= 0 && root.find-query != ""
                            ? Theme.text-tertiary : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        width: 28px;
                        height: 26px;
                        background: find-close-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        find-close-ta := TouchArea {
                            clicked => { root.find-open = false; }
                        }
                        Text {
                            text: "×";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: model.replace-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        if replace-input.text == "" : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: model.replace-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        replace-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.replace-query;
                            single-line: true;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-sans;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return) {
                                    root.replace-request(root.find-query, root.replace-query, false);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    Rectangle {
                        width: max(52px, replace-one-label.preferred-width + 12px);
                        height: 26px;
                        background: replace-one-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        replace-one-ta := TouchArea {
                            clicked => {
                                root.replace-request(root.find-query, root.replace-query, false);
                            }
                        }
                        replace-one-label := Text {
                            text: model.replace-one-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: max(40px, replace-all-label.preferred-width + 12px);
                        height: 26px;
                        background: replace-all-ta.has-hover ? Theme.surface-base : transparent;
                        border-radius: Theme.radius-md;
                        replace-all-ta := TouchArea {
                            clicked => {
                                root.replace-request(root.find-query, root.replace-query, true);
                            }
                        }
                        replace-all-label := Text {
                            text: model.replace-all-label;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if root.find-open : Rectangle { height: 1px; background: Theme.border-default; }

        Rectangle {
            background: Theme.surface-base;
            vertical-stretch: 1;
            clip: true;

            changed width => {
                if (self.width != root.last-viewport-w && self.width > 0) {
                    root.last-viewport-w = self.width;
                    root.viewport-changed(self.width);
                }
            }

            if !model.source-mode : preview-keys := FocusScope {
                width: parent.width;
                height: parent.height;

                key-pressed(event) => {
                    if (event.modifiers.control
                        && !event.modifiers.alt
                        && (event.text == "f" || event.text == "F"))
                    {
                        root.find-open = true;
                        find-input.focus();
                        return accept;
                    }
                    if (event.text == Key.F3) {
                        root.find-open = true;
                        root.find-request(root.find-query, !event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.Home) {
                        root.preview-key("Home", event.modifiers.control, event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.End) {
                        root.preview-key("End", event.modifiers.control, event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.LeftArrow) {
                        root.preview-key("Left", event.modifiers.control, event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.RightArrow) {
                        root.preview-key("Right", event.modifiers.control, event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.preview-key("Up", event.modifiers.control, event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.preview-key("Down", event.modifiers.control, event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.Backspace) {
                        root.preview-key("Backspace", event.modifiers.control, false);
                        return accept;
                    }
                    if (event.text == Key.Delete) {
                        root.preview-key("Delete", event.modifiers.control, false);
                        return accept;
                    }
                    if (event.text == Key.Tab) {
                        root.preview-key("Tab", false, event.modifiers.shift);
                        return accept;
                    }
                    if (event.modifiers.control) {
                        root.preview-key(event.text, true, event.modifiers.shift);
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        // Shift+Enter → soft line break; Enter → new paragraph.
                        root.preview-key("Return", false, event.modifiers.shift);
                        return accept;
                    }
                    root.preview-key(event.text, false, event.modifiers.shift);
                    return accept;
                }

                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: max(self.width, model.preview-width-px * 1px);
                    viewport-height: max(self.height, model.preview-height-px * 1px);

                    Rectangle {
                        x: max(0px, (parent.width - self.width) / 2);
                        width: model.preview-width-px * 1px;
                        height: model.preview-height-px * 1px;
                        background: #fafafc;

                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: model.preview-image;
                            image-fit: contain;
                        }
                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            double-clicked => {
                                preview-keys.focus();
                                root.preview-pointer(3, self.mouse-x / 1px, self.mouse-y / 1px);
                            }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.left) {
                                    if (e.kind == PointerEventKind.down) {
                                        preview-keys.focus();
                                        root.preview-pointer(0, self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else if (e.kind == PointerEventKind.up) {
                                        root.preview-pointer(2, self.mouse-x / 1px, self.mouse-y / 1px);
                                    }
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.preview-pointer(1, self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            }
                        }
                    }
                }
            }

            if model.source-mode : Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, edit-pad.preferred-height);

                // `changed` only works on this element's properties — mirror find-gen locally.
                property <int> sync-find-gen: model.find-gen;
                init => {
                    edit-input.set-selection-offsets(model.find-anchor, model.find-cursor);
                }
                changed sync-find-gen => {
                    edit-input.set-selection-offsets(model.find-anchor, model.find-cursor);
                    edit-input.focus();
                }

                edit-pad := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    edit-input := TextInput {
                        width: parent.width - 24px;
                        text: root.draft-text;
                        single-line: false;
                        wrap: word-wrap;
                        color: Theme.text-primary;
                        font-family: Theme.font-family-sans;
                        font-size: Theme.font-size-md;
                        cursor-position-changed(pos) => {
                            root.selection-changed(
                                self.cursor-position-byte-offset,
                                self.anchor-position-byte-offset
                            );
                        }
                        key-pressed(event) => {
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "f" || event.text == "F"))
                            {
                                root.find-open = true;
                                find-input.focus();
                                return accept;
                            }
                            if (event.text == Key.F3) {
                                root.find-open = true;
                                root.find-request(root.find-query, !event.modifiers.shift);
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "s" || event.text == "S"))
                            {
                                root.action("save");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "z" || event.text == "Z"))
                            {
                                root.action("undo");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "z" || event.text == "Z"))
                            {
                                root.action("redo");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "y" || event.text == "Y"))
                            {
                                root.action("redo");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "b" || event.text == "B"))
                            {
                                root.action("bold");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "i" || event.text == "I"))
                            {
                                root.action("italic");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "u" || event.text == "U"))
                            {
                                root.action("underline");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "x" || event.text == "X"))
                            {
                                root.action("strikethrough");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "h" || event.text == "H"))
                            {
                                root.action("highlight");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "=" || event.text == "+"))
                            {
                                root.action("superscript");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && event.text == "=")
                            {
                                root.action("subscript");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && event.text == " ")
                            {
                                root.action("clear-formatting");
                                return accept;
                            }
                            return reject;
                        }
                        edited => {
                            root.draft-text = self.text;
                            root.locally-dirty = true;
                            root.text-edited(self.text);
                            root.selection-changed(
                                self.cursor-position-byte-offset,
                                self.anchor-position-byte-offset
                            );
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 24px;
            background: Theme.surface-raised;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;

                Text {
                    text: model.info-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if model.dirty || root.locally-dirty : Text {
                    text: "●";
                    color: #eab308;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
