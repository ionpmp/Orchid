import { Theme } from "../../theme_global.slint";
import { Tooltip } from "../../kit.slint";
import { ViewerDocumentModel } from "../../workspace/defs.slint";
import { DocToolBtn } from "viewer-doc-toolbtn.slint";

export component ViewerDocumentView inherits Rectangle {
    in property <ViewerDocumentModel> model;

    callback action(string);
    callback text-edited(string);
    callback selection-changed(int, int);
    callback viewport-changed(length);
    /// Preview pointer: phase 0=down, 1=move, 2=up, 3=double-click word, 4=triple-click paragraph, 5=hover; x/y CSS px; ctrl opens links.
    callback preview-pointer(int, float, float, bool);
    /// Preview key: token or literal text, plus ctrl/shift.
    callback preview-key(string, bool, bool);
    /// Find next (`true`) / previous (`false`) match for the local query.
    callback find-request(string, bool, bool);
    /// Replace current (`all=false`) or all matches (`all=true`).
    callback replace-request(string, string, bool, bool);
    /// Apply hyperlink URL (`""` removes the link under the selection/caret).
    callback link-request(string);
    /// Apply comment body text at the caret / selection.
    callback comment-request(string);
    /// Apply header story plain text (`""` clears).
    callback header-request(string);
    /// Apply footer story plain text (`""` clears).
    callback footer-request(string);
    /// Apply first-page header story plain text (`""` clears).
    callback header-first-request(string);
    /// Apply first-page footer story plain text (`""` clears).
    callback footer-first-request(string);
    /// Apply even-page header story plain text (`""` clears).
    callback header-even-request(string);
    /// Apply even-page footer story plain text (`""` clears).
    callback footer-even-request(string);

    background: transparent;

    property <string> draft-text: model.plain-text;
    property <bool> locally-dirty: false;
    property <string> last-path: "";
    property <length> last-viewport-w: 0px;
    property <bool> find-open: false;
    property <string> find-query: "";
    property <bool> find-match-case: false;
    property <string> replace-query: "";
    property <bool> link-open: false;
    property <string> link-query: "";
    property <bool> comment-open: false;
    property <string> comment-query: "";
    property <int> story-open: 0; // 0=closed, 1=header, 2=footer, 3=header-first, 4=footer-first, 5=header-even, 6=footer-even
    property <string> story-query: "";

    changed model => {
        if root.last-path != model.path-display {
            root.last-path = model.path-display;
            root.draft-text = model.plain-text;
            root.locally-dirty = model.dirty;
        } else if root.draft-text == model.plain-text {
            root.locally-dirty = model.dirty;
        } else {
            root.locally-dirty = true;
        }
    }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: Theme.control-xs + Theme.space-2;
            background: Theme.surface-base;
            clip: false;
            z: 20;

            HorizontalLayout {
                padding-left: Theme.space-2;
                padding-right: Theme.space-2;
                spacing: Theme.space-1;
                alignment: start;

                DocToolBtn {
                    label: model.save-label;
                    tip: model.tip-save;
                    active: (model.dirty || root.locally-dirty);
                    clicked => { root.action("save"); }
                }

                DocToolBtn {
                    label: model.save-as-label;
                    tip: model.tip-save-as;
                    clicked => { root.action("save-as"); }
                }

                DocToolBtn {
                    label: model.print-label;
                    tip: model.tip-print;
                    clicked => { root.action("print"); }
                }

                DocToolBtn {
                    label: "Un";
                    tip: model.undo-label;
                    enabled: model.can-undo;
                    clicked => { root.action("undo"); }
                }

                DocToolBtn {
                    label: "Re";
                    tip: model.redo-label;
                    enabled: model.can-redo;
                    clicked => { root.action("redo"); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.bold-label;
                    tip: model.tip-bold;
                    active: model.bold;
                    clicked => { root.action("bold"); }
                }

                DocToolBtn {
                    label: model.italic-label;
                    tip: model.tip-italic;
                    active: model.italic;
                    clicked => { root.action("italic"); }
                }

                DocToolBtn {
                    label: model.underline-label;
                    tip: model.tip-underline;
                    active: model.underline;
                    clicked => { root.action("underline"); }
                }

                DocToolBtn {
                    label: model.strikethrough-label;
                    tip: model.tip-strikethrough;
                    active: model.strikethrough;
                    clicked => { root.action("strikethrough"); }
                }

                DocToolBtn {
                    label: model.double-strikethrough-label;
                    tip: model.tip-double-strikethrough;
                    active: model.double-strikethrough;
                    clicked => { root.action("double-strikethrough"); }
                }

                DocToolBtn {
                    label: model.all-caps-label;
                    tip: model.tip-all-caps;
                    active: model.all-caps;
                    clicked => { root.action("all-caps"); }
                }

                DocToolBtn {
                    label: model.small-caps-label;
                    tip: model.tip-small-caps;
                    active: model.small-caps;
                    clicked => { root.action("small-caps"); }
                }

                DocToolBtn {
                    label: model.vanish-label;
                    tip: model.tip-vanish;
                    active: model.vanish;
                    clicked => { root.action("vanish"); }
                }

                DocToolBtn {
                    label: model.shadow-label;
                    tip: model.tip-shadow;
                    active: model.shadow;
                    clicked => { root.action("shadow"); }
                }

                DocToolBtn {
                    label: model.emboss-label;
                    tip: model.tip-emboss;
                    active: model.emboss;
                    clicked => { root.action("emboss"); }
                }

                DocToolBtn {
                    label: model.imprint-label;
                    tip: model.tip-imprint;
                    active: model.imprint;
                    clicked => { root.action("imprint"); }
                }

                DocToolBtn {
                    label: model.highlight-label;
                    tip: model.tip-highlight;
                    active: model.highlight;
                    clicked => { root.action("highlight"); }
                }

                DocToolBtn {
                    label: model.shade-label;
                    tip: model.tip-shade;
                    active: model.shade;
                    clicked => { root.action("shade"); }
                }

                DocToolBtn {
                    label: model.border-bottom-label;
                    tip: model.tip-border-bottom;
                    active: model.border-bottom;
                    clicked => { root.action("border-bottom"); }
                }

                DocToolBtn {
                    label: model.keep-next-label;
                    tip: model.tip-keep-next;
                    active: model.keep-next;
                    clicked => { root.action("keep-next"); }
                }

                DocToolBtn {
                    label: model.keep-lines-label;
                    tip: model.tip-keep-lines;
                    active: model.keep-lines;
                    clicked => { root.action("keep-lines"); }
                }

                DocToolBtn {
                    label: model.widow-control-label;
                    tip: model.tip-widow-control;
                    active: model.widow-control;
                    clicked => { root.action("widow-control"); }
                }

                DocToolBtn {
                    label: model.contextual-spacing-label;
                    tip: model.tip-contextual-spacing;
                    active: model.contextual-spacing;
                    clicked => { root.action("contextual-spacing"); }
                }

                DocToolBtn {
                    label: model.bidi-label;
                    tip: model.tip-bidi;
                    active: model.bidi;
                    clicked => { root.action("bidi"); }
                }

                DocToolBtn {
                    label: model.suppress-auto-hyphens-label;
                    tip: model.tip-suppress-auto-hyphens;
                    active: model.suppress-auto-hyphens;
                    clicked => { root.action("suppress-auto-hyphens"); }
                }

                DocToolBtn {
                    label: model.outline-level-label;
                    tip: model.tip-outline-level;
                    active: model.outline-level >= 0;
                    clicked => { root.action("outline-level-cycle"); }
                }

                DocToolBtn {
                    label: model.character-style-label;
                    tip: model.tip-character-style;
                    active: model.character-style-id != "";
                    clicked => { root.action("character-style-cycle"); }
                }

                DocToolBtn {
                    label: model.superscript-label;
                    tip: model.tip-superscript;
                    active: model.superscript;
                    clicked => { root.action("superscript"); }
                }

                DocToolBtn {
                    label: model.subscript-label;
                    tip: model.tip-subscript;
                    active: model.subscript;
                    clicked => { root.action("subscript"); }
                }

                DocToolBtn {
                    label: model.clear-formatting-label;
                    tip: model.tip-clear-formatting;
                    clicked => { root.action("clear-formatting"); }
                }

                DocToolBtn {
                    label: model.link-label;
                    tip: model.tip-link;
                    active: root.link-open || model.link-url != "";
                    clicked => {
                            root.story-open = 0;
                            root.comment-open = false;
                            root.link-open = !root.link-open;
                            if (root.link-open) {
                            root.link-query = model.link-url;
                            link-input.focus();
                            }
                        }
                }

                DocToolBtn {
                    label: model.bookmark-label;
                    tip: model.tip-bookmark;
                    clicked => { root.action("insert-bookmark"); }
                }

                DocToolBtn {
                    label: model.comment-label;
                    tip: model.tip-comment;
                    clicked => { root.action("insert-comment"); }
                }

                DocToolBtn {
                    label: model.comment-delete-label;
                    tip: model.tip-comment-delete;
                    active: model.comment-active;
                    clicked => { root.action("delete-comment"); }
                }

                DocToolBtn {
                    label: model.comment-edit-label;
                    tip: model.tip-comment-edit;
                    active: root.comment-open || model.comment-active;
                    clicked => {
                        root.story-open = 0;
                        root.link-open = false;
                        root.comment-open = !root.comment-open;
                        if (root.comment-open) {
                            root.comment-query = model.comment-edit-text;
                            comment-input.focus();
                        }
                    }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.comment-next-label;
                    tip: model.tip-comment-next;
                    clicked => { root.action("comment-next"); }
                }

                DocToolBtn {
                    label: model.comment-prev-label;
                    tip: model.tip-comment-prev;
                    clicked => { root.action("comment-prev"); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.font-smaller-label;
                    tip: model.tip-font-smaller;
                    clicked => { root.action("font-smaller"); }
                }

                Rectangle {
                    width: max(Theme.control-xs, size-label.preferred-width + Theme.space-2);
                    height: Theme.control-xs;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius-md;
                    y: (parent.height - self.height) / 2;
                    size-label := Text {
                        text: model.font-size-label;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                DocToolBtn {
                    label: model.font-larger-label;
                    tip: model.tip-font-larger;
                    clicked => { root.action("font-larger"); }
                }

                DocToolBtn {
                    label: model.font-family-prev-label;
                    tip: model.tip-font-family-prev;
                    clicked => { root.action("font-family-prev"); }
                }

                DocToolBtn {
                    label: model.font-family-label;
                    tip: model.tip-font-family-next;
                    clicked => { root.action("font-family-next"); }
                }

                DocToolBtn {
                    label: model.font-family-next-label;
                    tip: model.tip-font-family-next;
                    clicked => { root.action("font-family-next"); }
                }
// Colour swatches: compare against decimal `0xRRGGBB` values.

                Rectangle {
                    width: Theme.space-6;
                    height: Theme.space-6;
                    border-radius: Theme.radius-xs;
                    y: (parent.height - self.height) / 2;
                    background: #111111;
                    border-width: model.color-rgb == 1118481 || model.color-rgb == 0 ? 2px : 1px;
                    border-color: model.color-rgb == 1118481 || model.color-rgb == 0 ? Theme.accent-brand : Theme.border-default;
                    color-black-ta := TouchArea { clicked => { root.action("color-111111"); } }
                    Tooltip {
                        text: model.tip-color-black;
                        shown: color-black-ta.has-hover;
                        x: (parent.width - self.width) / 2;
                        y: -self.height - Theme.space-2;
                    }
                }

                Rectangle {
                    width: Theme.space-6;
                    height: Theme.space-6;
                    border-radius: Theme.radius-xs;
                    y: (parent.height - self.height) / 2;
                    background: #dc2626;
                    border-width: model.color-rgb == 14423142 ? 2px : 1px;
                    border-color: model.color-rgb == 14423142 ? Theme.accent-brand : Theme.border-default;
                    color-red-ta := TouchArea { clicked => { root.action("color-dc2626"); } }
                    Tooltip {
                        text: model.tip-color-red;
                        shown: color-red-ta.has-hover;
                        x: (parent.width - self.width) / 2;
                        y: -self.height - Theme.space-2;
                    }
                }

                Rectangle {
                    width: Theme.space-6;
                    height: Theme.space-6;
                    border-radius: Theme.radius-xs;
                    y: (parent.height - self.height) / 2;
                    background: #2563eb;
                    border-width: model.color-rgb == 2442219 ? 2px : 1px;
                    border-color: model.color-rgb == 2442219 ? Theme.accent-brand : Theme.border-default;
                    color-blue-ta := TouchArea { clicked => { root.action("color-2563eb"); } }
                    Tooltip {
                        text: model.tip-color-blue;
                        shown: color-blue-ta.has-hover;
                        x: (parent.width - self.width) / 2;
                        y: -self.height - Theme.space-2;
                    }
                }

                Rectangle {
                    width: Theme.space-6;
                    height: Theme.space-6;
                    border-radius: Theme.radius-xs;
                    y: (parent.height - self.height) / 2;
                    background: #16a34a;
                    border-width: model.color-rgb == 1483594 ? 2px : 1px;
                    border-color: model.color-rgb == 1483594 ? Theme.accent-brand : Theme.border-default;
                    color-green-ta := TouchArea { clicked => { root.action("color-16a34a"); } }
                    Tooltip {
                        text: model.tip-color-green;
                        shown: color-green-ta.has-hover;
                        x: (parent.width - self.width) / 2;
                        y: -self.height - Theme.space-2;
                    }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.align-left-label;
                    tip: model.tip-align-left;
                    active: model.alignment == 0;
                    clicked => { root.action("align-left"); }
                }

                DocToolBtn {
                    label: model.align-center-label;
                    tip: model.tip-align-center;
                    active: model.alignment == 1;
                    clicked => { root.action("align-center"); }
                }

                DocToolBtn {
                    label: model.align-right-label;
                    tip: model.tip-align-right;
                    active: model.alignment == 2;
                    clicked => { root.action("align-right"); }
                }

                DocToolBtn {
                    label: model.align-justify-label;
                    tip: model.tip-align-justify;
                    active: model.alignment == 3;
                    clicked => { root.action("align-justify"); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.list-bullet-label;
                    tip: model.tip-list-bullet;
                    active: model.list-kind == 1;
                    clicked => { root.action("list-bullet"); }
                }

                DocToolBtn {
                    label: model.list-numbered-label;
                    tip: model.tip-list-numbered;
                    active: model.list-kind == 2;
                    clicked => { root.action("list-numbered"); }
                }

                DocToolBtn {
                    label: model.space-before-less-label;
                    tip: model.tip-space-before-less;
                    clicked => { root.action("space-before-less"); }
                }

                DocToolBtn {
                    label: model.space-before-more-label;
                    tip: model.tip-space-before-more;
                    clicked => { root.action("space-before-more"); }
                }

                DocToolBtn {
                    label: model.space-after-less-label;
                    tip: model.tip-space-after-less;
                    clicked => { root.action("space-after-less"); }
                }

                DocToolBtn {
                    label: model.space-after-more-label;
                    tip: model.tip-space-after-more;
                    clicked => { root.action("space-after-more"); }
                }

                DocToolBtn {
                    label: model.line-spacing-less-label;
                    tip: model.tip-line-spacing-less;
                    clicked => { root.action("line-spacing-less"); }
                }

                DocToolBtn {
                    label: model.line-spacing-more-label;
                    tip: model.tip-line-spacing-more;
                    clicked => { root.action("line-spacing-more"); }
                }

                DocToolBtn {
                    label: model.margin-less-label;
                    tip: model.tip-margin-less;
                    clicked => { root.action("margin-less"); }
                }

                DocToolBtn {
                    label: model.margin-more-label;
                    tip: model.tip-margin-more;
                    clicked => { root.action("margin-more"); }
                }

                DocToolBtn {
                    label: model.header-distance-less-label;
                    tip: model.tip-header-distance-less;
                    clicked => { root.action("header-distance-less"); }
                }

                DocToolBtn {
                    label: model.header-distance-more-label;
                    tip: model.tip-header-distance-more;
                    clicked => { root.action("header-distance-more"); }
                }

                DocToolBtn {
                    label: model.footer-distance-less-label;
                    tip: model.tip-footer-distance-less;
                    clicked => { root.action("footer-distance-less"); }
                }

                DocToolBtn {
                    label: model.footer-distance-more-label;
                    tip: model.tip-footer-distance-more;
                    clicked => { root.action("footer-distance-more"); }
                }

                DocToolBtn {
                    label: model.indent-less-label;
                    tip: model.tip-indent-less;
                    clicked => { root.action("indent-less"); }
                }

                DocToolBtn {
                    label: model.indent-more-label;
                    tip: model.tip-indent-more;
                    clicked => { root.action("indent-more"); }
                }

                DocToolBtn {
                    label: model.indent-right-less-label;
                    tip: model.tip-indent-right-less;
                    clicked => { root.action("indent-right-less"); }
                }

                DocToolBtn {
                    label: model.indent-right-more-label;
                    tip: model.tip-indent-right-more;
                    clicked => { root.action("indent-right-more"); }
                }

                DocToolBtn {
                    label: model.first-line-less-label;
                    tip: model.tip-first-line-less;
                    clicked => { root.action("first-line-less"); }
                }

                DocToolBtn {
                    label: model.first-line-more-label;
                    tip: model.tip-first-line-more;
                    clicked => { root.action("first-line-more"); }
                }

                DocToolBtn {
                    label: model.page-size-label;
                    tip: model.tip-page-size;
                    clicked => { root.action("page-size-cycle"); }
                }

                DocToolBtn {
                    label: model.page-orientation-label;
                    tip: model.tip-page-orientation;
                    clicked => { root.action("page-orientation-toggle"); }
                }

                DocToolBtn {
                    label: model.title-page-label;
                    tip: model.tip-title-page;
                    active: model.title-page;
                    clicked => { root.action("title-page"); }
                }

                DocToolBtn {
                    label: model.even-and-odd-headers-label;
                    tip: model.tip-even-and-odd-headers;
                    active: model.even-and-odd-headers;
                    clicked => { root.action("even-and-odd-headers"); }
                }

                DocToolBtn {
                    label: model.header-label;
                    tip: model.tip-header;
                    active: root.story-open == 1 || model.header-text != "";
                    clicked => {
                            root.link-open = false;
                            root.comment-open = false;
                            if (root.story-open == 1) {
                            root.story-open = 0;
                            } else {
                            root.story-open = 1;
                            root.story-query = model.header-text;
                            }
                        }
                }

                DocToolBtn {
                    label: model.footer-label;
                    tip: model.tip-footer;
                    active: root.story-open == 2 || model.footer-text != "";
                    clicked => {
                            root.link-open = false;
                            root.comment-open = false;
                            if (root.story-open == 2) {
                            root.story-open = 0;
                            } else {
                            root.story-open = 2;
                            root.story-query = model.footer-text;
                            }
                        }
                }

                DocToolBtn {
                    label: model.header-first-label;
                    tip: model.tip-header-first;
                    active: root.story-open == 3 || model.header-first-text != "";
                    clicked => {
                            root.link-open = false;
                            root.comment-open = false;
                            if (root.story-open == 3) {
                            root.story-open = 0;
                            } else {
                            root.story-open = 3;
                            root.story-query = model.header-first-text;
                            }
                        }
                }

                DocToolBtn {
                    label: model.footer-first-label;
                    tip: model.tip-footer-first;
                    active: root.story-open == 4 || model.footer-first-text != "";
                    clicked => {
                            root.link-open = false;
                            root.comment-open = false;
                            if (root.story-open == 4) {
                            root.story-open = 0;
                            } else {
                            root.story-open = 4;
                            root.story-query = model.footer-first-text;
                            }
                        }
                }

                DocToolBtn {
                    label: model.header-even-label;
                    tip: model.tip-header-even;
                    active: root.story-open == 5 || model.header-even-text != "";
                    clicked => {
                            root.link-open = false;
                            root.comment-open = false;
                            if (root.story-open == 5) {
                            root.story-open = 0;
                            } else {
                            root.story-open = 5;
                            root.story-query = model.header-even-text;
                            }
                        }
                }

                DocToolBtn {
                    label: model.footer-even-label;
                    tip: model.tip-footer-even;
                    active: root.story-open == 6 || model.footer-even-text != "";
                    clicked => {
                            root.link-open = false;
                            root.comment-open = false;
                            if (root.story-open == 6) {
                            root.story-open = 0;
                            } else {
                            root.story-open = 6;
                            root.story-query = model.footer-even-text;
                            }
                        }
                }

                DocToolBtn {
                    label: model.page-field-label;
                    tip: model.tip-page-field;
                    clicked => { root.action("insert-page-field"); }
                }

                DocToolBtn {
                    label: model.section-break-label;
                    tip: model.tip-section-break;
                    active: model.section-break-continuous;
                    clicked => { root.action("insert-section-break"); }
                }

                DocToolBtn {
                    label: model.date-field-label;
                    tip: model.tip-date-field;
                    clicked => { root.action("insert-date-field"); }
                }

                DocToolBtn {
                    label: model.filename-field-label;
                    tip: model.tip-filename-field;
                    clicked => { root.action("insert-filename-field"); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.image-insert-label;
                    tip: model.tip-image-insert;
                    clicked => { root.action("image-insert"); }
                }

                DocToolBtn {
                    label: model.table-insert-label;
                    tip: model.tip-table-insert;
                    clicked => { root.action("table-insert"); }
                }

                DocToolBtn {
                    label: model.table-row-insert-label;
                    tip: model.tip-table-row-insert;
                    clicked => { root.action("table-row-insert"); }
                }

                DocToolBtn {
                    label: model.table-row-delete-label;
                    tip: model.tip-table-row-delete;
                    clicked => { root.action("table-row-delete"); }
                }

                DocToolBtn {
                    label: model.table-col-insert-label;
                    tip: model.tip-table-col-insert;
                    clicked => { root.action("table-col-insert"); }
                }

                DocToolBtn {
                    label: model.table-col-delete-label;
                    tip: model.tip-table-col-delete;
                    clicked => { root.action("table-col-delete"); }
                }

                DocToolBtn {
                    label: model.table-merge-label;
                    tip: model.tip-table-merge;
                    clicked => { root.action("table-merge"); }
                }

                DocToolBtn {
                    label: model.table-unmerge-label;
                    tip: model.tip-table-unmerge;
                    clicked => { root.action("table-unmerge"); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.zoom-out-label;
                    tip: model.tip-zoom-out;
                    clicked => { root.action("zoom-out"); }
                }

                DocToolBtn {
                    label: "\{model.preview-zoom-percent}%";
                    tip: model.tip-zoom-reset;
                    clicked => { root.action("zoom-reset"); }
                }

                DocToolBtn {
                    label: model.zoom-in-label;
                    tip: model.tip-zoom-in;
                    clicked => { root.action("zoom-in"); }
                }

                Rectangle {
                    width: Theme.hairline;
                    height: Theme.space-8;
                    y: (parent.height - self.height) / 2;
                    background: Theme.border-default;
                }

                DocToolBtn {
                    label: model.find-label;
                    tip: model.tip-find;
                    active: root.find-open;
                    clicked => {
                            root.find-open = !root.find-open;
                            if (root.find-open) {
                            find-input.focus();
                            }
                        }
                }

                DocToolBtn {
                    label: model.source-mode ? model.source-label : model.preview-label;
                    tip: model.tip-toggle-source;
                    active: model.source-mode;
                    clicked => { root.action("toggle-source"); }
                }

                Rectangle { horizontal-stretch: 1; }

                if model.dirty || root.locally-dirty : Text {
                    text: "*";
                    color: #eab308;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

            }
        }

        Rectangle {
            height: root.find-open ? 68px : 0px;
            clip: false;
            background: Theme.surface-raised;

            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 4px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: model.find-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        if find-input.text == "" : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: model.find-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        find-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.find-query;
                            single-line: true;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-sans;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return) {
                                    root.find-request(root.find-query, !event.modifiers.shift, root.find-match-case);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    DocToolBtn {
                        label: model.find-case-label;
                        tip: model.tip-find-case;
                        active: root.find-match-case;
                        clicked => {
                            root.find-match-case = !root.find-match-case;
                            if (root.find-query != "") {
                                root.find-request(root.find-query, true, root.find-match-case);
                            }
                        }
                    }

                    DocToolBtn {
                        label: "^";
                        tip: model.tip-find-prev;
                        clicked => { root.find-request(root.find-query, false, root.find-match-case); }
                    }

                    DocToolBtn {
                        label: "v";
                        tip: model.tip-find-next;
                        clicked => { root.find-request(root.find-query, true, root.find-match-case); }
                    }

                    Text {
                        min-width: 36px;
                        text: root.find-query == "" ? ""
                            : model.find-match-count <= 0 ? model.find-no-match-label
                            : "\{model.find-match-index}/\{model.find-match-count}";
                        color: model.find-match-count <= 0 && root.find-query != ""
                            ? Theme.text-tertiary : Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    DocToolBtn {
                        label: "x";
                        tip: model.tip-find-close;
                        clicked => { root.find-open = false; }
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: model.replace-label;
                        color: Theme.text-secondary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: Theme.surface-base;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.border-default;

                        if replace-input.text == "" : Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text: model.replace-placeholder;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        replace-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.replace-query;
                            single-line: true;
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-family: Theme.font-family-sans;
                            vertical-alignment: center;
                            key-pressed(event) => {
                                if (event.text == Key.Return) {
                                    root.replace-request(root.find-query, root.replace-query, false, root.find-match-case);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.find-open = false;
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    DocToolBtn {
                        label: model.replace-one-label;
                        tip: "";
                        clicked => {
                            root.replace-request(root.find-query, root.replace-query, false, root.find-match-case);
                        }
                    }

                    DocToolBtn {
                        label: model.replace-all-label;
                        tip: "";
                        clicked => {
                            root.replace-request(root.find-query, root.replace-query, true, root.find-match-case);
                        }
                    }
                }
            }
        }

        if root.find-open : Rectangle { height: 1px; background: Theme.border-default; }

        Rectangle {
            height: root.link-open ? 36px : 0px;
            clip: true;
            background: Theme.surface-raised;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: model.link-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    background: Theme.surface-base;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-default;

                    if link-input.text == "" : Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text: model.link-placeholder;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    link-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> root.link-query;
                        single-line: true;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        font-family: Theme.font-family-sans;
                        vertical-alignment: center;
                        key-pressed(event) => {
                            if (event.text == Key.Return) {
                                root.link-request(root.link-query);
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.link-open = false;
                                root.comment-open = false;
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                DocToolBtn {
                    label: model.link-apply-label;
                    tip: "";
                    clicked => { root.link-request(root.link-query); }
                }

                DocToolBtn {
                    label: model.link-remove-label;
                    tip: "";
                    clicked => { root.link-request(""); }
                }
            }
        }

        if root.link-open : Rectangle { height: 1px; background: Theme.border-default; }

        Rectangle {
            height: root.comment-open ? 36px : 0px;
            clip: true;
            background: Theme.surface-raised;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: model.comment-edit-label;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 26px;
                    background: Theme.surface-base;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-default;

                    if comment-input.text == "" : Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text: model.comment-placeholder;
                        color: Theme.text-tertiary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }

                    comment-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text <=> root.comment-query;
                        single-line: true;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        font-family: Theme.font-family-sans;
                        vertical-alignment: center;
                        key-pressed(event) => {
                            if (event.text == Key.Return) {
                                root.comment-request(root.comment-query);
                                root.comment-open = false;
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                root.comment-open = false;
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                DocToolBtn {
                    label: model.comment-apply-label;
                    tip: "";
                    clicked => {
                        root.comment-request(root.comment-query);
                        root.comment-open = false;
                    }
                }
            }
        }

        if root.comment-open : Rectangle { height: 1px; background: Theme.border-default; }

        if root.story-open != 0 : HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 6px;
            alignment: center;

            Text {
                text: root.story-open == 1 ? model.header-label
                    : root.story-open == 2 ? model.footer-label
                    : root.story-open == 3 ? model.header-first-label
                    : root.story-open == 4 ? model.footer-first-label
                    : root.story-open == 5 ? model.header-even-label
                    : model.footer-even-label;
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 26px;
                background: Theme.surface-base;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;

                if story-input.text == "" : Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text: root.story-open == 1 || root.story-open == 3 || root.story-open == 5 ? model.header-placeholder : model.footer-placeholder;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }

                story-input := TextInput {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text <=> root.story-query;
                    single-line: true;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    font-family: Theme.font-family-sans;
                    vertical-alignment: center;
                    key-pressed(event) => {
                        if (event.text == Key.Return) {
                            if (root.story-open == 1) {
                                root.header-request(root.story-query);
                            } else if (root.story-open == 2) {
                                root.footer-request(root.story-query);
                            } else if (root.story-open == 3) {
                                root.header-first-request(root.story-query);
                            } else if (root.story-open == 4) {
                                root.footer-first-request(root.story-query);
                            } else if (root.story-open == 5) {
                                root.header-even-request(root.story-query);
                            } else if (root.story-open == 6) {
                                root.footer-even-request(root.story-query);
                            }
                            root.story-open = 0;
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.story-open = 0;
                            return accept;
                        }
                        return reject;
                    }
                }
            }

            DocToolBtn {
                label: model.link-apply-label;
                tip: "";
                clicked => {
                    if (root.story-open == 1) {
                        root.header-request(root.story-query);
                    } else if (root.story-open == 2) {
                        root.footer-request(root.story-query);
                    } else if (root.story-open == 3) {
                        root.header-first-request(root.story-query);
                    } else if (root.story-open == 4) {
                        root.footer-first-request(root.story-query);
                    } else if (root.story-open == 5) {
                        root.header-even-request(root.story-query);
                    } else if (root.story-open == 6) {
                        root.footer-even-request(root.story-query);
                    }
                    root.story-open = 0;
                }
            }

            DocToolBtn {
                label: model.link-remove-label;
                tip: "";
                clicked => {
                    if (root.story-open == 1) {
                        root.header-request("");
                    } else if (root.story-open == 2) {
                        root.footer-request("");
                    } else if (root.story-open == 3) {
                        root.header-first-request("");
                    } else if (root.story-open == 4) {
                        root.footer-first-request("");
                    } else if (root.story-open == 5) {
                        root.header-even-request("");
                    } else if (root.story-open == 6) {
                        root.footer-even-request("");
                    }
                    root.story-query = "";
                    root.story-open = 0;
                }
            }
        }

        if root.story-open != 0 : Rectangle { height: 1px; background: Theme.border-default; }

        Rectangle {
            background: Theme.surface-base;
            vertical-stretch: 1;
            clip: true;

            changed width => {
                if (self.width != root.last-viewport-w && self.width > 0) {
                    root.last-viewport-w = self.width;
                    root.viewport-changed(self.width);
                }
            }

            if !model.source-mode : preview-host := Rectangle {
                width: parent.width;
                height: parent.height;

                // Invisible TextInput receives IME composition (same pattern as TerminalView).
                // TouchArea stays on the canvas for selection; we only steal keyboard focus.
                preview-keys := TextInput {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: 1px;
                    text: "";
                    single-line: true;
                    font-size: 0.1px;
                    color: transparent;
                    text-cursor-width: 0px;
                    input-type: text;

                    key-pressed(event) => {
                        if (event.modifiers.control
                            && !event.modifiers.alt
                            && (event.text == "f" || event.text == "F"))
                        {
                            root.find-open = true;
                            find-input.focus();
                            return accept;
                        }
                        if (event.modifiers.control
                            && !event.modifiers.shift
                            && !event.modifiers.alt
                            && (event.text == "k" || event.text == "K"))
                        {
                            root.comment-open = false;
                            root.link-open = true;
                            root.link-query = model.link-url;
                            link-input.focus();
                            return accept;
                        }
                        if (event.text == Key.F3) {
                            root.find-open = true;
                            root.find-request(root.find-query, !event.modifiers.shift, root.find-match-case);
                            return accept;
                        }
                        if (event.text == Key.Home) {
                            root.preview-key("Home", event.modifiers.control, event.modifiers.shift);
                            return accept;
                        }
                        if (event.text == Key.End) {
                            root.preview-key("End", event.modifiers.control, event.modifiers.shift);
                            return accept;
                        }
                        if (event.text == Key.LeftArrow) {
                            root.preview-key("Left", event.modifiers.control, event.modifiers.shift);
                            return accept;
                        }
                        if (event.text == Key.RightArrow) {
                            root.preview-key("Right", event.modifiers.control, event.modifiers.shift);
                            return accept;
                        }
                        if (event.text == Key.UpArrow) {
                            root.preview-key("Up", event.modifiers.control, event.modifiers.shift);
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.preview-key("Down", event.modifiers.control, event.modifiers.shift);
                            return accept;
                        }
                        if (event.text == Key.Backspace) {
                            root.preview-key("Backspace", event.modifiers.control, false);
                            return accept;
                        }
                        if (event.text == Key.Delete) {
                            root.preview-key("Delete", event.modifiers.control, false);
                            return accept;
                        }
                        if (event.text == Key.Tab) {
                            root.preview-key("Tab", false, event.modifiers.shift);
                            return accept;
                        }
                        if (event.modifiers.control) {
                            root.preview-key(event.text, true, event.modifiers.shift);
                            return accept;
                        }
                        if (event.text == Key.Return) {
                            // Shift+Enter → soft break; Enter → paragraph; Ctrl+Enter → page break (Rust).
                            root.preview-key("Return", false, event.modifiers.shift);
                            return accept;
                        }
                        // Printable / IME: let TextInput compose, then `edited` commits.
                        if (event.text != "") {
                            return reject;
                        }
                        return reject;
                    }

                    edited => {
                        if (self.text == "") {
                            return;
                        }
                        root.preview-key(self.text, false, false);
                        self.text = "";
                    }
                }

                Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: max(self.width, model.preview-width-px * 1px * max(0.5, model.preview-zoom-percent / 100) / max(1, model.preview-render-scale));
                    viewport-height: max(self.height, model.preview-height-px * 1px * max(0.5, model.preview-zoom-percent / 100) / max(1, model.preview-render-scale));

                    // Mirror find-gen so Preview can scroll to the match.
                    property <int> sync-find-gen: model.find-gen;
                    changed sync-find-gen => {
                        if (model.find-match-count > 0 && model.find-scroll-y-px >= 0) {
                            // Show match roughly one-third down the viewport (zoom-scaled).
                            self.viewport-y = max(
                                min(0px, self.height - self.viewport-height),
                                min(0px, -(model.find-scroll-y-px * 1px * max(0.5, model.preview-zoom-percent / 100) - self.height / 3))
                            );
                        }
                    }

                    Rectangle {
                        x: max(0px, (parent.width - self.width) / 2);
                        width: model.preview-width-px * 1px * max(0.5, model.preview-zoom-percent / 100) / max(1, model.preview-render-scale);
                        height: model.preview-height-px * 1px * max(0.5, model.preview-zoom-percent / 100) / max(1, model.preview-render-scale);
                        background: #fafafc;
                        property <float> zoom: max(0.5, model.preview-zoom-percent / 100);

                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: model.preview-image;
                            image-fit: contain;
                        }
                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: model.link-hover ? MouseCursor.pointer : MouseCursor.default;
                            changed has-hover => {
                                if (!self.has-hover) {
                                    root.preview-pointer(5, -1, -1, false);
                                }
                            }
                            changed mouse-x => {
                                if (self.has-hover && !self.pressed) {
                                    root.preview-pointer(5, self.mouse-x / 1px / parent.zoom, self.mouse-y / 1px / parent.zoom, false);
                                }
                            }
                            changed mouse-y => {
                                if (self.has-hover && !self.pressed) {
                                    root.preview-pointer(5, self.mouse-x / 1px / parent.zoom, self.mouse-y / 1px / parent.zoom, false);
                                }
                            }
                            double-clicked => {
                                preview-keys.focus();
                                root.preview-pointer(3, self.mouse-x / 1px / parent.zoom, self.mouse-y / 1px / parent.zoom, false);
                            }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.left) {
                                    if (e.kind == PointerEventKind.down) {
                                        preview-keys.focus();
                                        root.preview-pointer(0, self.mouse-x / 1px / parent.zoom, self.mouse-y / 1px / parent.zoom, e.modifiers.control);
                                    } else if (e.kind == PointerEventKind.up) {
                                        root.preview-pointer(2, self.mouse-x / 1px / parent.zoom, self.mouse-y / 1px / parent.zoom, e.modifiers.control);
                                    }
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.preview-pointer(1, self.mouse-x / 1px / parent.zoom, self.mouse-y / 1px / parent.zoom, false);
                                }
                            }
                            scroll-event(event) => {
                                if (event.modifiers.control) {
                                    if (event.delta-y < 0) {
                                        root.action("zoom-in");
                                    } else if (event.delta-y > 0) {
                                        root.action("zoom-out");
                                    }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

                // IME preedit (composition) strip — TextInput owns the string; canvas stays selection-first.
                if preview-keys.preedit-text != "" : Rectangle {
                    x: 8px;
                    y: parent.height - self.height - 8px;
                    width: min(parent.width - 16px, preedit-label.preferred-width + 16px);
                    height: preedit-label.preferred-height + 10px;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    z: 50;
                    preedit-label := Text {
                        x: 8px;
                        y: 5px;
                        text: preview-keys.preedit-text;
                        color: Theme.accent-brand;
                        font-size: Theme.font-size-md;
                    }
                }
            }

            if model.source-mode : Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, edit-pad.preferred-height);

                // `changed` only works on this element's properties — mirror find-gen locally.
                property <int> sync-find-gen: model.find-gen;
                init => {
                    edit-input.set-selection-offsets(model.find-anchor, model.find-cursor);
                }
                changed sync-find-gen => {
                    edit-input.set-selection-offsets(model.find-anchor, model.find-cursor);
                    edit-input.focus();
                }

                edit-pad := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    edit-input := TextInput {
                        width: parent.width - 24px;
                        text: root.draft-text;
                        single-line: false;
                        wrap: word-wrap;
                        color: Theme.text-primary;
                        font-family: Theme.font-family-sans;
                        font-size: Theme.font-size-md;
                        cursor-position-changed(pos) => {
                            root.selection-changed(
                                self.cursor-position-byte-offset,
                                self.anchor-position-byte-offset
                            );
                        }
                        key-pressed(event) => {
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "f" || event.text == "F"))
                            {
                                root.find-open = true;
                                find-input.focus();
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "k" || event.text == "K"))
                            {
                                root.comment-open = false;
                                root.link-open = true;
                                root.link-query = model.link-url;
                                link-input.focus();
                                return accept;
                            }
                            if (event.text == Key.F3) {
                                root.find-open = true;
                                root.find-request(root.find-query, !event.modifiers.shift, root.find-match-case);
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "s" || event.text == "S"))
                            {
                                root.action("save");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "s" || event.text == "S"))
                            {
                                root.action("save-as");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "z" || event.text == "Z"))
                            {
                                root.action("undo");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "z" || event.text == "Z"))
                            {
                                root.action("redo");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "y" || event.text == "Y"))
                            {
                                root.action("redo");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "b" || event.text == "B"))
                            {
                                root.action("bold");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "i" || event.text == "I"))
                            {
                                root.action("italic");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "u" || event.text == "U"))
                            {
                                root.action("underline");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "x" || event.text == "X"))
                            {
                                root.action("strikethrough");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "h" || event.text == "H"))
                            {
                                root.action("highlight");
                                return accept;
                            }
                            if (event.modifiers.control
                                && event.modifiers.shift
                                && !event.modifiers.alt
                                && (event.text == "=" || event.text == "+"))
                            {
                                root.action("superscript");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && event.text == "=")
                            {
                                root.action("subscript");
                                return accept;
                            }
                            if (event.modifiers.control
                                && !event.modifiers.shift
                                && !event.modifiers.alt
                                && event.text == " ")
                            {
                                root.action("clear-formatting");
                                return accept;
                            }
                            return reject;
                        }
                        edited => {
                            root.draft-text = self.text;
                            root.locally-dirty = true;
                            root.text-edited(self.text);
                            root.selection-changed(
                                self.cursor-position-byte-offset,
                                self.anchor-position-byte-offset
                            );
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 24px;
            background: Theme.surface-raised;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 12px;

                Text {
                    text: model.info-text;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if model.dirty || root.locally-dirty : Text {
                    text: "*";
                    color: #eab308;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }
    }
}
